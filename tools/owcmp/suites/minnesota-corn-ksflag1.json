{
  "schema_version": "owcmp-suite-manifest-v1",
  "suite_id": "minnesota-corn-ksflag1",
  "title": "Minnesota corn H1-H43 ksflag=1 validation cohort",
  "lane": "cohort-inventory",
  "run_root": "/wc1/runs/al/algebraic-radium",
  "description": "Minnesota corn WEPPcloud run with ksflag=1. This manifest declares the run-root surfaces used when preparing owcmp comparisons; it is not a complete baseline-vs-candidate comparison pair.",
  "tags": [
    "minnesota",
    "corn",
    "h1-h43",
    "ksflag=1"
  ],
  "checks": [
    {
      "name": "run_root",
      "kind": "directory",
      "path": "/wc1/runs/al/algebraic-radium",
      "required": true
    },
    {
      "name": "wepp_output_dir",
      "kind": "directory",
      "path": "/wc1/runs/al/algebraic-radium/wepp/output",
      "required": true
    },
    {
      "name": "hillslope_wat_outputs",
      "kind": "pattern-range",
      "path_pattern": "/wc1/runs/al/algebraic-radium/wepp/output/H{h}.wat.dat",
      "start": 1,
      "end": 43,
      "required": true
    },
    {
      "name": "hillslope_plot_outputs",
      "kind": "pattern-range",
      "path_pattern": "/wc1/runs/al/algebraic-radium/wepp/output/H{h}.plot.dat",
      "start": 1,
      "end": 43,
      "required": true
    }
  ],
  "artifact_policy": {
    "commit": [
      "summary.json",
      "summary.md",
      "command-log.json",
      "review/disposition evidence"
    ],
    "local_only_by_default": [
      "logs/",
      "reports/",
      "raw/"
    ]
  },
  "agent_runner": {
    "preferred_agent": "comparator_suite_runner",
    "return": "compact metrics and artifact paths only"
  }
}
