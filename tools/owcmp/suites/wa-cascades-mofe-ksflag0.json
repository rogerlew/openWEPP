{
  "schema_version": "owcmp-suite-manifest-v1",
  "suite_id": "wa-cascades-mofe-ksflag0",
  "title": "Washington Cascades MOFE H1-H36 ksflag=0 validation cohort",
  "lane": "cohort-inventory",
  "run_root": "/wc1/runs/ar/arboreal-dendrite",
  "description": "Washington Cascades multi-OFE WEPPcloud run with ksflag=0. This manifest declares the run-root surfaces used when preparing owcmp comparisons; it is not a complete baseline-vs-candidate comparison pair.",
  "tags": [
    "washington-cascades",
    "mofe",
    "h1-h36",
    "ksflag=0"
  ],
  "checks": [
    {
      "name": "run_root",
      "kind": "directory",
      "path": "/wc1/runs/ar/arboreal-dendrite",
      "required": true
    },
    {
      "name": "wepp_output_dir",
      "kind": "directory",
      "path": "/wc1/runs/ar/arboreal-dendrite/wepp/output",
      "required": true
    },
    {
      "name": "hillslope_wat_outputs",
      "kind": "pattern-range",
      "path_pattern": "/wc1/runs/ar/arboreal-dendrite/wepp/output/H{h}.wat.dat",
      "start": 1,
      "end": 36,
      "required": true
    },
    {
      "name": "hillslope_plot_outputs",
      "kind": "pattern-range",
      "path_pattern": "/wc1/runs/ar/arboreal-dendrite/wepp/output/H{h}.plot.dat",
      "start": 1,
      "end": 36,
      "required": true
    },
    {
      "name": "watershed_structure",
      "kind": "file",
      "path": "/wc1/runs/ar/arboreal-dendrite/watershed/structure.json",
      "required": true
    }
  ],
  "artifact_policy": {
    "commit": [
      "summary.json",
      "summary.md",
      "command-log.json",
      "review/disposition evidence"
    ],
    "local_only_by_default": [
      "logs/",
      "reports/",
      "raw/"
    ]
  },
  "agent_runner": {
    "preferred_agent": "comparator_suite_runner",
    "return": "compact metrics and artifact paths only"
  }
}
