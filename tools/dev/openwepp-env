#!/usr/bin/env bash
# Source from the Nix shell to allocate collision-safe agent build state.

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    echo "error: source tools/dev/openwepp-env; do not execute it" >&2
    exit 2
fi

openwepp_repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
openwepp_repo_key="$({ printf '%s' "$openwepp_repo_root" | sha256sum; } | cut -c1-12)"

if [[ -n "${OPENWEPP_CACHE_ROOT:-}" ]]; then
    openwepp_cache_root="$OPENWEPP_CACHE_ROOT"
elif [[ -d /workdir && -w /workdir ]]; then
    openwepp_cache_root="/workdir/.cache/openwepp"
else
    openwepp_cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/openwepp"
fi

openwepp_task_id="${OPENWEPP_TASK_ID:-$(basename "$openwepp_repo_root")-$openwepp_repo_key}"
openwepp_task_id="${openwepp_task_id//[^a-zA-Z0-9_.-]/_}"

export OPENWEPP_REPO_ROOT="$openwepp_repo_root"
export OPENWEPP_CACHE_ROOT="$openwepp_cache_root"
export OPENWEPP_TASK_ID="$openwepp_task_id"
export CARGO_HOME="$openwepp_cache_root/cargo-home"
export SCCACHE_DIR="$openwepp_cache_root/sccache"
export UV_CACHE_DIR="$openwepp_cache_root/uv"
export CARGO_TARGET_DIR="$openwepp_cache_root/targets/$openwepp_task_id"
export TMPDIR="/tmp/openwepp-$USER-$openwepp_task_id"

mkdir -p "$CARGO_HOME" "$SCCACHE_DIR" "$UV_CACHE_DIR" "$CARGO_TARGET_DIR" "$openwepp_cache_root/locks"
mkdir -p "$TMPDIR"
chmod 0700 "$TMPDIR"

openwepp_owner_file="$openwepp_cache_root/locks/$openwepp_task_id.lock"
exec {openwepp_claim_fd}>"$openwepp_owner_file"
flock "$openwepp_claim_fd"

read -r openwepp_owner_pid openwepp_owner_start <"$openwepp_owner_file" || true
openwepp_owner_active=false
if [[ "$openwepp_owner_pid" =~ ^[0-9]+$ && "$openwepp_owner_start" =~ ^[0-9]+$ ]]; then
    openwepp_live_start="$(awk '{ print $22 }' "/proc/$openwepp_owner_pid/stat" 2>/dev/null || true)"
    if [[ "$openwepp_live_start" == "$openwepp_owner_start" ]]; then
        openwepp_owner_active=true
    fi
fi

if [[ "$openwepp_owner_active" == true && "$openwepp_owner_pid" != "$PPID" ]]; then
    flock -u "$openwepp_claim_fd"
    exec {openwepp_claim_fd}>&-
    echo "error: task '$openwepp_task_id' already owns this Cargo target" >&2
    echo "use a separate worktree or set a unique OPENWEPP_TASK_ID" >&2
    return 1
fi

openwepp_parent_start="$(awk '{ print $22 }' "/proc/$PPID/stat")"
printf '%s %s\n' "$PPID" "$openwepp_parent_start" >"$openwepp_owner_file"
flock -u "$openwepp_claim_fd"
exec {openwepp_claim_fd}>&-
export OPENWEPP_TARGET_OWNER_FILE="$openwepp_owner_file"

unset openwepp_repo_root openwepp_repo_key openwepp_cache_root openwepp_task_id
unset openwepp_claim_fd openwepp_owner_file openwepp_owner_pid openwepp_owner_start
unset openwepp_owner_active openwepp_live_start openwepp_parent_start
