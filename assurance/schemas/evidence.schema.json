{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwepp.org/assurance/schema/evidence-manifest-v1",
  "title": "openWEPP assurance evidence manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dossier_id", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "dossier_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "kind", "role", "availability", "forcing", "claim_bearing", "note"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "kind": {"enum": ["verification", "empirical", "comparative", "provenance", "review"]},
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string"},
          "location": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "availability": {"enum": ["tracked", "external", "restricted", "unavailable"]},
          "forcing": {"enum": ["robust", "limited", "mixed", "not_applicable"]},
          "claim_bearing": {"type": "boolean"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
