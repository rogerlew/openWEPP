{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwepp.org/assurance/schema/method-v1",
  "title": "openWEPP evaluation method version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "method_id", "version", "title", "owner", "design", "question", "quantities", "domain", "datasets", "metrics", "criteria", "uncertainty", "reproduction"],
  "properties": {
    "schema_version": {"const": 1},
    "method_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string"},
    "owner": {"type": "string"},
    "design": {"enum": ["prospective", "retrospective"]},
    "question": {"type": "string"},
    "quantities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "domain": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "datasets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "uncertainty": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reproduction": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
