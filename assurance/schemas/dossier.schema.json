{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwepp.org/assurance/schema/dossier-v1",
  "title": "openWEPP assurance dossier version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dossier_id", "version", "title", "lifecycle", "evidence_as_of", "assessment_owner", "method_id", "narrative", "question", "quantities", "tested_domain", "verification", "verification_obligations", "empirical", "summary", "applies_to", "unknowns", "application_boundary", "source_identity"],
  "properties": {
    "schema_version": {"const": 1},
    "dossier_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["draft", "candidate", "published", "superseded", "withdrawn"]},
    "evidence_as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "assessment_owner": {"type": "string", "minLength": 1},
    "method_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "doc_id", "title", "nav_key"],
      "properties": {
        "path": {"type": "string"},
        "doc_id": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "nav_key": {"type": "string"}
      }
    },
    "question": {"type": "string", "minLength": 1},
    "quantities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tested_domain": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verification": {"enum": ["pass", "fail", "blocked", "not_run"]},
    "verification_obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["obligation_id", "title", "mandatory", "status", "realization", "executed_on", "requirement", "tolerance", "result", "evidence_ids"],
        "properties": {
          "obligation_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "mandatory": {"type": "boolean"},
          "status": {"enum": ["pass", "fail", "blocked", "not_run"]},
          "realization": {"type": "string", "minLength": 1},
          "executed_on": {"type": ["string", "null"]},
          "requirement": {"type": "string", "minLength": 1},
          "tolerance": {"type": "string", "minLength": 1},
          "result": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "empirical": {"enum": ["corroborated_within_tested_domain", "mixed_evidence", "contradicted_within_tested_domain", "insufficient_evidence", "not_evaluated"]},
    "summary": {"type": "string", "minLength": 1},
    "applies_to": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "unknowns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "application_boundary": {"type": "string", "minLength": 1},
    "source_identity": {"type": "string", "minLength": 1}
  }
}
