{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwepp.org/assurance/schema/authoring-v1",
  "title": "openWEPP agent-assisted authoring record version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dossier_id", "dossier_version", "procedure_version", "task", "agent_identity", "tool_version", "execution_date", "nondeterministic_settings", "input_revision", "inputs", "accepted_outputs", "accepted_decisions", "accepted_output_root_sha256", "review"],
  "properties": {
    "schema_version": {"const": 1},
    "dossier_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "dossier_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "procedure_version": {"type": "string", "minLength": 1}, "task": {"type": "string", "minLength": 1},
    "agent_identity": {"type": "string", "minLength": 1}, "tool_version": {"type": "string", "minLength": 1},
    "execution_date": {"type": "string"}, "nondeterministic_settings": {"type": "string", "minLength": 1},
    "input_revision": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
    "accepted_outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/output"}},
    "accepted_decisions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "accepted_output_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review": {"$ref": "#/$defs/review"}
  },
  "$defs": {
    "input": {"type": "object", "additionalProperties": false, "required": ["repository", "revision", "path", "sha256", "availability", "role"], "properties": {
      "repository": {"enum": ["openwepp", "wepppy"]}, "revision": {"type": "string", "minLength": 1}, "path": {"type": "string"},
      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "availability": {"enum": ["tracked", "historical", "external"]}, "role": {"type": "string", "minLength": 1}
    }},
    "output": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "role"], "properties": {
      "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "role": {"type": "string", "minLength": 1}
    }},
    "reviewer": {"type": "object", "additionalProperties": false, "required": ["name", "role", "expertise", "independent_of_authors", "independence_basis"], "properties": {
      "name": {"type": "string"}, "role": {"type": "string"}, "expertise": {"type": "string"}, "independent_of_authors": {"type": "boolean"}, "independence_basis": {"type": "string"}
    }},
    "review": {"type": "object", "additionalProperties": false, "required": ["state", "reviewer", "review_date", "findings", "disposition", "approved_output_root_sha256"], "properties": {
      "state": {"enum": ["pending", "approved", "rejected"]}, "reviewer": {"oneOf": [{"$ref": "#/$defs/reviewer"}, {"type": "null"}]},
      "review_date": {"type": ["string", "null"]}, "findings": {"type": "array", "items": {"type": "string"}},
      "disposition": {"type": ["string", "null"]}, "approved_output_root_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
    }}
  }
}
