{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwepp.org/assurance/schema/review-v1",
  "title": "openWEPP assurance review history version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dossier_id", "dossier_version", "conclusion_authors", "approvals"],
  "properties": {
    "schema_version": {"const": 1},
    "dossier_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "dossier_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "conclusion_authors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/author"}},
    "approvals": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/approval"}}
  },
  "$defs": {
    "author": {
      "type": "object", "additionalProperties": false, "required": ["name", "role"],
      "properties": {"name": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}}
    },
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "role", "expertise", "independent_of_authors", "independence_basis"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1},
        "expertise": {"type": "string", "minLength": 1}, "independent_of_authors": {"type": "boolean"},
        "independence_basis": {"type": "string", "minLength": 1}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "severity", "summary", "disposition", "rationale", "closure_blocking", "resolved"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "severity": {"enum": ["low", "medium", "high"]}, "summary": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["accepted", "rejected", "deferred", "follow_up"]},
        "rationale": {"type": "string", "minLength": 1}, "closure_blocking": {"type": "boolean"},
        "resolved": {"type": "boolean"}
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["review_id", "scope", "state", "reviewers", "review_date", "reviewed_root_sha256", "payload_sha256", "disposition_summary", "findings", "residual_disagreements"],
      "properties": {
        "review_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "scope": {"enum": ["scientific", "publication"]}, "state": {"enum": ["pending", "approved", "rejected"]},
        "reviewers": {"type": "array", "items": {"$ref": "#/$defs/reviewer"}},
        "review_date": {"type": ["string", "null"]},
        "reviewed_root_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "payload_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "disposition_summary": {"type": "string", "minLength": 1},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "residual_disagreements": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
