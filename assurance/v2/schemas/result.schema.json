{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwepp:assurance:v2:result:1",
  "title": "openWEPP assurance v2 retained result object",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_id", "values"],
  "properties": {
    "schema_version": { "const": 1 },
    "result_id": { "$ref": "#/$defs/id" },
    "values": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "unit_id", "precision"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "value": { "type": "number" },
          "unit_id": { "$ref": "#/$defs/id" },
          "precision": { "$ref": "#/$defs/text" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "text": { "type": "string", "pattern": "\\S" }
  }
}
