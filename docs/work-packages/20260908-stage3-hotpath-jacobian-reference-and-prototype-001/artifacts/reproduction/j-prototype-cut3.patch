+fn batch(cases: &[Case<'_>], arm: Arm, repetitions: u64) -> Observation {
+    let direct_session = crate::solver_residual_corpus_capture::start_direct_column_counting()
+        .expect("matched compact direct counter");
+    let mechanism_session = crate::solver_mechanism_audit::begin_mechanism_audit(false, 0)
+        .expect("matched compact mechanism posture; no detailed trace");
+    let mut total = Observation {
+        canonical_checksum: 0xcbf2_9ce4_8422_2325,
+        consumed_checksum: 0xcbf2_9ce4_8422_2325,
+        ..Observation::default()
+    };
+    for iteration in 0..repetitions {
+        for (record, case) in cases.iter().enumerate() {
+            let row =
+                repetition(black_box(case), arm).expect("cost case must remain numerically valid");
+            total.inclusive += row.inclusive;
+            total.columns += row.columns;
+            total.complete_probe_calls += row.complete_probe_calls;
+            total.direct_columns += row.direct_columns;
+            total.fd_columns += row.fd_columns;
+            total.canonical_checksum = accumulate(
+                total.canonical_checksum,
+                iteration,
+                record,
+                row.canonical_checksum,
+            );
+            total.consumed_checksum = accumulate(
+                total.consumed_checksum,
+                iteration,
+                record,
+                row.consumed_checksum,
+            );
+        }
+    }
+    total.observed_direct = direct_session
+        .finish()
+        .expect("completed actual direct counts");
+    let observed = total.observed_direct;
+    assert_eq!(
+        observed.covered_potential
+            + observed.covered_fixed_final
+            + observed.generic_v3_potential
+            + observed.generic_v3_fixed_final,
+        total.direct_columns,
+        "actual completed candidate counts"
+    );
+    let audit = mechanism_session
+        .finish()
+        .expect("complete compact mechanism counts");
+    assert_eq!(audit.dropped_events, 0);
+    total.inclusive_leaf_calls = audit.leaf_calls;
+    total
+}
