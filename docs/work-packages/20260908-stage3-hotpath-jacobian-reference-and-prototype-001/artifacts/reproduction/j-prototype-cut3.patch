+fn runtime_identity(identity: &RuntimeTileIdentity) -> Value {
+    json!({"transaction_id":identity.transaction_id,"soil_thermal_transaction_id":identity.soil_thermal_transaction_id,
+        "ofe_id":identity.ofe_id,"tile_id":identity.tile_id,"surface_id":identity.surface_id,
+        "tile_fraction_bits":identity.tile_fraction.to_bits(),"interval_s_bits":identity.interval_s.to_bits(),
+        "configuration_sha256":identity.configuration_sha256,"beginning_lse_state_sha256":identity.beginning_lse_state_sha256,
+        "beginning_hydrology_snapshot_sha256":identity.beginning_hydrology_snapshot_sha256,
+        "beginning_soil_thermal_state_sha256":identity.beginning_soil_thermal_state_sha256,
+        "beginning_vegetation_state_sha256":identity.beginning_vegetation_state_sha256,
+        "beginning_biogeochemistry_state_sha256":identity.beginning_biogeochemistry_state_sha256,
+        "lse_owner_id":identity.lse_owner_id,"hydrology_owner_id":identity.hydrology_owner_id,
+        "soil_thermal_owner_id":identity.soil_thermal_owner_id,"vegetation_owner_id":identity.vegetation_owner_id,
+        "biogeochemistry_owner_id":identity.biogeochemistry_owner_id})
+}
+
+#[must_use]
+pub fn is_active() -> bool {
+    ACTIVE.with(|active| active.borrow().is_some())
+}
+
+fn record(identity: Value, raw: Raw) {
+    ACTIVE.with(|active| {
+        let mut active = active.borrow_mut();
+        let Some(state) = active.as_mut() else { return };
+        let index = match raw.family() {
+            Family::Covered => 0,
+            Family::V3Energy => 1,
+            Family::Litter => 2,
+        };
+        let result = raw.validate();
+        let family = &mut state.report.families[index];
+        if let Some(next) = family.checked.checked_add(1) {
+            family.checked = next;
+        } else {
+            state.report.overflow = true;
+        }
+        if let Err(error) = result {
+            if let Some(next) = family.failed.checked_add(1) {
+                family.failed = next;
+            } else {
+                state.report.overflow = true;
+            }
+            if state.report.first_error.is_none() {
+                state.report.first_error = Some(error.to_string());
+            }
+        }
+        // Retain only two edge operands per family; check all intervening records.
+        let mut primitive_bits = raw.value();
+        exact_bits(&mut primitive_bits);
+        let record = Record {
+            identity,
+            primitive_bits,
+            raw,
+        };
+        if family.first.is_none() {
+            family.first = Some(record);
+        } else {
+            family.last = Some(record);
+        }
+    });
+}
