+fn emit(phase: &str, attempt: u64, pair: usize, arm: Arm, repetitions: u64, row: &Observation) {
+    println!(
+        "INACTIVE_JACOBIAN_COST {}",
+        serde_json::json!({
+            "phase":phase,"attempt":attempt,"pair":pair,"arm":arm.name(),"repetitions":repetitions,
+            "base_plus_columns_ns":row.inclusive.as_nanos(),"disjoint_columns_ns":row.columns.as_nanos(),
+            "complete_probe_calls":row.complete_probe_calls,"direct_columns":row.direct_columns,"fd_columns":row.fd_columns,
+            "canonical_checksum":row.canonical_checksum,"consumed_checksum":row.consumed_checksum,
+            "inclusive_leaf_calls":row.inclusive_leaf_calls,"actual_direct_counts":row.observed_direct,
+            "minimum_column_duration_met":row.columns>=MINIMUM_BATCH,
+        })
+    );
+}
