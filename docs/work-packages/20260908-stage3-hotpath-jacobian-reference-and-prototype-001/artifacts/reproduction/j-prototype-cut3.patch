+    pub(crate) coordinate_scales: &'a [f64],
+}
+
+enum Base<'a> {
+    Covered(&'a super::ValidatedCoveredJacobianBase<'a>),
+    V3(&'a V3DerivativeBase<'a>),
+}
+
+pub(crate) struct InactiveColumnSweep<'a> {
+    base: Base<'a>,
+    // These immutable borrows bind actual solver coordinates and branch state,
+    // not perturbation unit scales or serialized corpus identities.
+    trial: &'a [f64],
+    scales: Option<&'a [f64]>,
+    _frozen: &'a CoveredFrozenBranches,
+    next_column: usize,
+}
+
+impl<'a> InactiveColumnSweep<'a> {
+    pub(super) fn covered(
+        base: &'a super::ValidatedCoveredJacobianBase<'a>,
+    ) -> Result<Self, LandSurfaceEnergyError> {
+        let sweep = Self {
+            base: Base::Covered(base),
+            trial: &base.trial,
+            scales: None,
+            _frozen: &base.frozen,
+            next_column: 0,
+        };
+        sweep.validate_shape()?;
+        Ok(sweep)
+    }
+
+    fn operands(&self) -> (&CoveredColumnInputs, &[f64], &CoveredColumnEvaluation) {
+        match &self.base {
+            Base::Covered(base) => (base.validated.column, &base.trial, &base.evaluation),
+            Base::V3(base) => (base.column, &base.physical, &base.evaluation.predecessor),
+        }
+    }
+
+    fn validate_shape(&self) -> Result<(), LandSurfaceEnergyError> {
+        let (column, physical, detail) = self.operands();
+        let dimension = 10 * column.occupancies.len() + 3 + column.ground.soil_nodes.len();
+        if self.trial.len() != dimension
+            || physical.len() != dimension
+            || detail.normalized_residuals.len() != dimension
+            || detail.raw_residuals.len() != dimension
+            || detail.tolerances.len() != dimension
+            || detail.occupancies.len() != column.occupancies.len()
+            || self.scales.is_some_and(|scales| scales.len() != dimension)
+        {
+            return Err(integrity("successful base topology or residual order"));
+        }
+        if let Some(scales) = self.scales {
+            for ((scaled, scale), physical) in self.trial.iter().zip(scales).zip(physical) {
+                if !scale.is_finite()
+                    || *scale <= 0.0
+                    || (scaled * scale).to_bits() != physical.to_bits()
+                {
+                    return Err(integrity("successful base coordinate mapping"));
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+impl<'input> JacobianColumns<V3DerivativeBase<'input>, CoveredFrozenBranches>
+    for V3ColumnProvider<'_>
+{
+    type Sweep<'a>
+        = InactiveColumnSweep<'a>
+    where
+        Self: 'a,
+        V3DerivativeBase<'input>: 'a;
+
+    fn sweep<'a>(
+        &'a self,
+        trial: &'a [f64],
+        detail: &'a V3DerivativeBase<'input>,
+        frozen: &'a CoveredFrozenBranches,
+    ) -> Result<Self::Sweep<'a>, LandSurfaceEnergyError> {
+        if !detail.unfrozen
+            || crate::solver_litter_phase::freeze_v3_covered_branches(&detail.evaluation) != *frozen
+        {
+            return Err(integrity("successful base frozen branch binding"));
+        }
+        let sweep = InactiveColumnSweep {
+            base: Base::V3(detail),
+            trial,
+            scales: Some(self.coordinate_scales),
+            _frozen: frozen,
+            next_column: 0,
+        };
+        sweep.validate_shape()?;
+        Ok(sweep)
+    }
+}
+
+impl ColumnAssembly for InactiveColumnSweep<'_> {
+    fn assemble(
+        &mut self,
+        column_index: usize,
+        matrix: &mut [Vec<f64>],
+    ) -> Result<bool, LandSurfaceEnergyError> {
+        if column_index != self.next_column || column_index >= self.trial.len() {
+            self.next_column = usize::MAX;
+            return Err(integrity("column order or second use"));
+        }
+        // A refusal poisons this sweep, including failures before the write.
+        self.next_column = usize::MAX;
+        if matrix.len() != self.trial.len()
+            || matrix.iter().any(|row| row.len() != self.trial.len())
+        {
+            return Err(integrity("column matrix shape"));
+        }
+        let (column, physical, detail) = self.operands();
+        let occupancy_index = column_index / 10;
+        let component = column_index % 10;
+        let eligible = if occupancy_index < column.occupancies.len()
+            && (component == 6 || component == 7)
+            && column.authority.admits_nonpositive_assimilation()
+        {
+            let input = &column.occupancies[occupancy_index];
+            let area = if component == 6 {
+                input.sun.leaf_area_m2_m2_tile
+            } else {
+                input.shade.leaf_area_m2_m2_tile
+            };
+            eligible_areas(
+                area,
+                detail.occupancies[occupancy_index].component_areas_m2_m2_tile[component - 6],
+            )
+        } else {
+            false
+        };
+        if eligible {
+            let normalizer = detail.tolerances[column_index];
+            let anchor = super::inactive_component_temperature_anchor_k(
+                component - 6,
+                physical[10 * column.occupancies.len()],
+            );
+            if normalizer.to_bits() != super::energy_tolerance(1.0).to_bits()
+                || detail.raw_residuals[column_index].to_bits()
+                    != (physical[column_index] - anchor).to_bits()
+                || detail.normalized_residuals[column_index].to_bits()
+                    != ((physical[column_index] - anchor) / normalizer).to_bits()
+            {
+                return Err(integrity(
+                    "successful affine residual or normalizer binding",
+                ));
+            }
+            let scale = self.scales.map_or(1.0, |scales| scales[column_index]);
+            assemble_affine_column(matrix, column_index, scale, normalizer)?;
+            #[cfg(any(test, feature = "test-support"))]
+            {
+                use crate::solver_residual_corpus_capture::{Family, completed_direct_column};
+                let (family, fixed) = match &self.base {
+                    Base::Covered(base) => (Family::Covered, base.validated.caps.is_some()),
+                    Base::V3(base) => (Family::GenericV3, base.caps.is_some()),
+                };
+                completed_direct_column(family, fixed, column_index);
+            }
+        }
+        self.next_column = column_index + 1;
+        Ok(eligible)
+    }
+}
+
+#[cfg(any(test, feature = "test-support"))]
+pub(crate) fn snapshot_columns(
+    snapshot: &crate::solver_residual_corpus_capture::Snapshot,
+) -> Result<Vec<Option<Vec<f64>>>, LandSurfaceEnergyError> {
+    let physical: Vec<_> = snapshot
+        .x_bits
+        .iter()
+        .map(|bits| f64::from_bits(*bits))
+        .collect();
+    if let Some(v3) = &snapshot.v3 {
+        let base = V3DerivativeBase::evaluate(
+            &snapshot.inputs,
+            snapshot.caps.as_ref(),
+            physical,
+            None,
+            v3.context,
+        )?;
+        let trial: Vec<_> = v3
+            .scaled_x_bits
+            .iter()
+            .map(|bits| f64::from_bits(*bits))
+            .collect();
+        let scales: Vec<_> = v3
+            .coordinate_scale_bits
+            .iter()
+            .map(|bits| f64::from_bits(*bits))
+            .collect();
+        let provider = V3ColumnProvider {
+            coordinate_scales: &scales,
+        };
+        let frozen = crate::solver_litter_phase::freeze_v3_covered_branches(base.evaluation());
+        collect_columns(provider.sweep(&trial, &base, &frozen)?, trial.len())
+    } else {
+        let validated = super::ValidatedCoveredEvaluationInputs::try_new(
+            &snapshot.inputs,
+            snapshot.caps.as_ref(),
+        )?;
+        let base = super::ValidatedCoveredIterationMap::evaluate(&validated, &physical)?
+            .into_jacobian_base();
+        collect_columns(InactiveColumnSweep::covered(&base)?, physical.len())
+    }
+}
+
+#[cfg(any(test, feature = "test-support"))]
+fn collect_columns(
+    mut sweep: InactiveColumnSweep<'_>,
+    dimension: usize,
+) -> Result<Vec<Option<Vec<f64>>>, LandSurfaceEnergyError> {
+    let mut matrix = vec![vec![0.0; dimension]; dimension];
+    let mut columns = Vec::with_capacity(dimension);
+    for index in 0..dimension {
+        columns.push(if sweep.assemble(index, &mut matrix)? {
+            Some(matrix.iter().map(|row| row[index]).collect())
+        } else {
+            None
+        });
+    }
+    Ok(columns)
+}
+
+#[cfg(test)]
+fn verify_refusal(
+    mut sweep: InactiveColumnSweep<'_>,
+    case: usize,
+) -> Result<(), LandSurfaceEnergyError> {
+    let dimension = sweep.trial.len();
+    let mut matrix = vec![vec![71.0; dimension]; dimension];
+    let index = match case {
+        0 => 1, // wrong initial order
+        1 => {
+            sweep.assemble(0, &mut matrix)?;
+            0
+        } // second use
+        2 => dimension,
+        3 => {
+            matrix.pop();
+            0
+        }
+        4 => {
+            matrix[0].pop();
+            0
+        }
+        5 => {
+            matrix[0].push(0.0);
+            0
+        }
+        6 => {
+            matrix.clear();
+            0
+        }
+        _ => {
+            // Complete a sweep, then refuse reuse even at its first column.
+            for column in 0..dimension {
+                sweep.assemble(column, &mut matrix)?;
+            }
+            0
+        }
+    };
+    let before = matrix.clone();
+    if !matches!(
+        sweep.assemble(index, &mut matrix),
+        Err(LandSurfaceEnergyError::CoveredJacobianDerivativeIntegrity(
+            _
+        ))
+    ) || matrix != before
+    {
+        return Err(integrity("guard evidence did not refuse atomically"));
+    }
+    // A failure is terminal, never a request to try canonical FD or reuse.
+    if !matches!(
+        sweep.assemble(0, &mut matrix),
+        Err(LandSurfaceEnergyError::CoveredJacobianDerivativeIntegrity(
+            _
+        ))
+    ) || matrix != before
+    {
+        return Err(integrity("failed sweep remained usable"));
+    }
+    Ok(())
+}
