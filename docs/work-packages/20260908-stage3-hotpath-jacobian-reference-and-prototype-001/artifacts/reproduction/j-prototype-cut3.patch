+/// Common source-order copy of retained adjustment, independently reviewed.
+/// Current coordinates are the explicit shared initial hydraulic anchors; this
+/// is a column obligation, not reconstruction of original solve-initial state.
+fn adjust(case: &Case<'_>, base: &CoveredColumnEvaluation, matrix: &mut [Vec<f64>]) -> Vec<f64> {
+    let snapshot = case.snapshot;
+    let v3 = snapshot.family == Family::GenericV3;
+    let mut rhs: Vec<_> = base.normalized_residuals.iter().map(|r| -r).collect();
+    for (o, input) in snapshot.inputs.occupancies.iter().enumerate() {
+        let inactive = snapshot.inputs.authority.admits_nonpositive_assimilation()
+            && [
+                input.sun.leaf_area_m2_m2_tile,
+                input.shade.leaf_area_m2_m2_tile,
+                input.stem_area_m2_m2_tile,
+                input.lai,
+                input.sai,
+            ]
+            .iter()
+            .all(|v| v.to_bits() == 0);
+        if inactive {
+            for local in 0..6 {
+                let j = 10 * o + local;
+                matrix[j].fill(0.0);
+                let unit = if v3 { 1.0 } else { case.physical_units[j] };
+                matrix[j][j] = 1.0 / unit;
+                let target = if local < 4 {
+                    case.trial[j]
+                } else if v3 {
+                    1.0 / case.scales[j]
+                } else {
+                    1.0
+                };
+                rhs[j] = (target - case.trial[j]) / unit;
+            }
+        }
+    }
+    let canopy = case.physical[10 * snapshot.inputs.occupancies.len()];
+    for (o, occupancy) in base.occupancies.iter().enumerate() {
+        for (component, area) in occupancy.component_areas_m2_m2_tile.iter().enumerate() {
+            if area.to_bits() != 0 {
+                continue;
+            }
+            let j = 10 * o + 6 + component;
+            let unit = if v3 { 1.0 } else { case.physical_units[j] };
+            let anchor = super::inactive_component_temperature_anchor_k(component, canopy);
+            matrix[j].fill(0.0);
+            matrix[j][j] = 1.0 / unit;
+            rhs[j] = (anchor / case.scales[j] - case.trial[j]) / unit;
+        }
+    }
+    if !v3 && snapshot.caps.is_none() && super::v10_nonpositive_assimilation_active(base) {
+        for row in matrix {
+            for (entry, unit) in row.iter_mut().zip(&case.physical_units) {
+                *entry *= unit;
+            }
+        }
+    }
+    rhs
+}
+
+fn fd_columns(
+    case: &Case<'_>,
+    base: &CoveredColumnEvaluation,
+    matrix: &mut [Vec<f64>],
+    mut evaluator: impl FnMut(&[f64], usize) -> Result<Vec<f64>, LandSurfaceEnergyError>,
+) -> Result<(u64, u64), LandSurfaceEnergyError> {
+    let snapshot = case.snapshot;
+    let v3 = snapshot.family == Family::GenericV3;
+    let liquid_ground =
+        !v3 && super::covered_ground_uses_liquid_vapor_phase_domain(&snapshot.inputs);
+    let valid = |trial: &[f64]| {
+        if v3 {
+            let physical: Vec<_> = trial.iter().zip(&case.scales).map(|(x, s)| x * s).collect();
+            super::covered_trial_is_valid(&physical, snapshot.inputs.occupancies.len(), false)
+        } else {
+            super::covered_trial_is_valid(trial, snapshot.inputs.occupancies.len(), liquid_ground)
+        }
+    };
+    assert!(valid(&case.trial), "valid captured base");
+    let mut probes = 0;
+    let mut columns = 0;
+    for (j, selected) in case.selected.iter().enumerate() {
+        if !selected {
+            continue;
+        }
+        let h = f64::EPSILON.sqrt() * case.trial[j].abs().max(case.units[j]);
+        let mut minus = case.trial.clone();
+        let mut plus = case.trial.clone();
+        minus[j] -= h;
+        plus[j] += h;
+        let lo = valid(&minus);
+        let hi = valid(&plus);
+        let rm = if lo {
+            probes += 1;
+            Some(evaluator(&minus, j)?)
+        } else {
+            None
+        };
+        let rp = if hi {
+            probes += 1;
+            Some(evaluator(&plus, j)?)
+        } else {
+            None
+        };
+        for row in 0..matrix.len() {
+            // Exactly the existing production denominator, not reference abscissae.
+            matrix[row][j] = match (&rm, &rp) {
+                (Some(a), Some(b)) => (b[row] - a[row]) / (2.0 * h),
+                (Some(a), None) => (base.normalized_residuals[row] - a[row]) / h,
+                (None, Some(b)) => (b[row] - base.normalized_residuals[row]) / h,
+                (None, None) => {
+                    return Err(LandSurfaceEnergyError::ConstitutiveDomain(
+                        "normalized_jacobian_bound",
+                    ));
+                }
+            };
+        }
+        columns += 1;
+    }
+    Ok((probes, columns))
+}
+
+fn direct_columns(
+    case: &Case<'_>,
+    mut sweep: impl ColumnAssembly,
+    matrix: &mut [Vec<f64>],
+) -> Result<u64, LandSurfaceEnergyError> {
+    let mut count = 0;
+    for (j, expected) in case.selected.iter().enumerate() {
+        let direct = sweep.assemble(j, matrix)?;
+        assert_eq!(
+            direct, *expected,
+            "candidate eligibility differs from common frozen classification"
+        );
+        count += u64::from(direct);
+    }
+    Ok(count)
+}
+
+fn repetition(case: &Case<'_>, arm: Arm) -> Result<Observation, LandSurfaceEnergyError> {
+    repetition_with_output(case, arm, |_, _| {})
+}
+
+fn repetition_with_output(
+    case: &Case<'_>,
+    arm: Arm,
+    consume: impl FnOnce(&[Vec<f64>], &[f64]),
+) -> Result<Observation, LandSurfaceEnergyError> {
+    let inclusive = Instant::now();
+    let mut result = Observation::default();
+    let snapshot = case.snapshot;
+    if let Some(v3) = &snapshot.v3 {
+        // Both arms pay exactly this successful same-family base construction.
+        let base = super::inactive_jacobian::V3DerivativeBase::evaluate(
+            &snapshot.inputs,
+            snapshot.caps.as_ref(),
+            case.physical.clone(),
+            None,
+            v3.context,
+        )?;
+        let frozen = crate::solver_litter_phase::freeze_v3_covered_branches(base.evaluation());
+        let start = Instant::now();
+        let mut matrix = vec![vec![0.0; case.trial.len()]; case.trial.len()];
+        match arm {
+            Arm::A => {
+                let counts = fd_columns(
+                    case,
+                    &base.evaluation().predecessor,
+                    &mut matrix,
+                    |trial, _| {
+                        let physical: Vec<_> =
+                            trial.iter().zip(&case.scales).map(|(x, s)| x * s).collect();
+                        crate::evaluate_v3_phase_free_covered_column(
+                            &snapshot.inputs,
+                            &physical,
+                            snapshot.caps.as_ref(),
+                            Some(&frozen),
+                            v3.context,
+                        )
+                        .map(|e| e.predecessor.normalized_residuals)
+                    },
+                )?;
+                result.complete_probe_calls = counts.0;
+                result.fd_columns = counts.1;
+            }
+            Arm::J => {
+                let provider = super::inactive_jacobian::V3ColumnProvider {
+                    coordinate_scales: &case.scales,
+                };
+                result.direct_columns = direct_columns(
+                    case,
+                    provider.sweep(&case.trial, &base, &frozen)?,
+                    &mut matrix,
+                )?;
+            }
+        }
+        result.canonical_checksum = checksum(black_box(&matrix), &[]);
+        let rhs = adjust(case, &base.evaluation().predecessor, &mut matrix);
+        result.consumed_checksum = checksum(black_box(&matrix), black_box(&rhs));
+        consume(&matrix, &rhs);
+        black_box(&matrix);
+        black_box(&rhs);
+        drop(matrix);
+        drop(rhs);
+        result.columns = start.elapsed();
+    } else {
+        let validated = super::ValidatedCoveredEvaluationInputs::try_new(
+            &snapshot.inputs,
+            snapshot.caps.as_ref(),
+        )?;
+        let base = super::ValidatedCoveredIterationMap::evaluate(&validated, &case.physical)?
+            .into_jacobian_base();
+        let start = Instant::now();
+        let mut matrix = vec![vec![0.0; case.trial.len()]; case.trial.len()];
+        match arm {
+            Arm::A => {
+                let counts = fd_columns(case, &base.evaluation, &mut matrix, |trial, j| {
+                    super::covered_jacobian_probe_residuals(&base, trial, j)
+                })?;
+                result.complete_probe_calls = counts.0;
+                result.fd_columns = counts.1;
+            }
+            Arm::J => {
+                result.direct_columns = direct_columns(
+                    case,
+                    super::inactive_jacobian::InactiveColumnSweep::covered(&base)?,
+                    &mut matrix,
+                )?;
+            }
+        }
+        result.canonical_checksum = checksum(black_box(&matrix), &[]);
+        let rhs = adjust(case, &base.evaluation, &mut matrix);
+        result.consumed_checksum = checksum(black_box(&matrix), black_box(&rhs));
+        consume(&matrix, &rhs);
+        black_box(&matrix);
+        black_box(&rhs);
+        drop(matrix);
+        drop(rhs);
+        result.columns = start.elapsed();
+    }
+    result.inclusive = inclusive.elapsed();
+    Ok(result)
+}
