+#[test]
+fn inactive_jacobian_cost_output_integrity() {
+    let original = (vec![vec![1.0, 0.0], vec![0.0, 1.0]], vec![0.0, 0.5]);
+    assert!(exact_output(&original, &original));
+    for poison in 0..5 {
+        let mut changed = original.clone();
+        match poison {
+            0 => changed.0[0][1] = 1.0e-12,
+            1 => changed.1[1] += 1.0e-12,
+            2 => changed.0[0][1] = -0.0,
+            3 => {
+                changed.0[1].pop();
+            }
+            _ => {
+                changed.1.pop();
+            }
+        }
+        assert!(
+            !exact_output(&original, &changed),
+            "mutation {poison} hidden"
+        );
+    }
+    let fold = |value: u64| {
+        let mut hash = 0xcbf2_9ce4_8422_2325;
+        for repetition in 0..32 {
+            for record in 0..12 {
+                hash = accumulate(hash, repetition, record, value);
+            }
+        }
+        hash
+    };
+    assert_ne!(fold(7), fold(11), "repeated-record cancellation regressed");
+    assert_ne!(
+        accumulate(7, 0, 1, 5),
+        accumulate(7, 1, 0, 5),
+        "sequence binding"
+    );
+}
