+/// There is no constructor accepting an independently supplied evaluation.
+/// The physical trial allocation was already necessary for scaled evaluation.
+pub(crate) struct V3DerivativeBase<'a> {
+    column: &'a CoveredColumnInputs,
+    // Retained immutable custody even when instrumentation is compiled out.
+    #[cfg_attr(
+        not(any(test, feature = "test-support")),
+        expect(
+            dead_code,
+            reason = "the successful base retains exact immutable cap custody; only evidence reads its pass"
+        )
+    )]
+    caps: Option<&'a CoveredWaterCaps>,
+    _context: V3LitterResidualContext,
+    physical: Vec<f64>,
+    evaluation: V3PhaseFreeCoveredEvaluation,
+    unfrozen: bool,
+}
+
+impl<'a> V3DerivativeBase<'a> {
+    pub(crate) fn evaluate(
+        column: &'a CoveredColumnInputs,
+        caps: Option<&'a CoveredWaterCaps>,
+        physical: Vec<f64>,
+        frozen: Option<&CoveredFrozenBranches>,
+        context: V3LitterResidualContext,
+    ) -> Result<Self, LandSurfaceEnergyError> {
+        let evaluation = crate::solver_litter_phase::evaluate_v3_phase_free_covered_column(
+            column, &physical, caps, frozen, context,
+        )?;
+        Ok(Self {
+            column,
+            caps,
+            _context: context,
+            physical,
+            evaluation,
+            unfrozen: frozen.is_none(),
+        })
+    }
+
+    pub(crate) fn evaluation(&self) -> &V3PhaseFreeCoveredEvaluation {
+        &self.evaluation
+    }
+    pub(crate) fn into_evaluation(self) -> V3PhaseFreeCoveredEvaluation {
+        self.evaluation
+    }
+}
