+                (Some(a), None) => (base.normalized_residuals[row] - a[row]) / h,
+                (None, Some(b)) => (b[row] - base.normalized_residuals[row]) / h,
+                (None, None) => return Err("canonical assembly has no valid probe".into()),
+            };
+        }
+    }
+    let mut candidate = fd.clone();
+    for (column, values) in direct.iter().enumerate() {
+        if let Some(values) = values {
