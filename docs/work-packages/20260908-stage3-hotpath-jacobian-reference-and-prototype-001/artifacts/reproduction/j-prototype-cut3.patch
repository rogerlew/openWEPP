+// Three-point polynomial interpolation only for the mandatory elementary
+// reference-limit tests. Actual abscissae and Taylor's independently supplied
+// third-derivative bound give truncation, not observed J agreement.
+fn three_point(x: [f64; 3], f: [f64; 3], errors: [f64; 3], third_bound: f64) -> Estimate {
+    let a = x[1] - x[0];
+    let b = x[2] - x[0];
+    assert!(a != 0.0 && b != 0.0 && a != b);
+    let weights = [-(a + b) / (a * b), -b / (a * (a - b)), -a / (b * (b - a))];
+    let terms = std::array::from_fn::<_, 3, _>(|i| weights[i] * f[i]);
+    let value = terms.iter().sum();
+    let truncation = third_bound
+        * (weights[1].abs() * a.abs().powi(3) + weights[2].abs() * b.abs().powi(3))
+        / 6.0;
+    let uncertainty = weights
+        .iter()
+        .zip(errors)
+        .map(|(w, e)| w.abs() * e)
+        .sum::<f64>()
+        + 32.0 * EPS * terms.iter().map(|v| v.abs()).sum::<f64>()
+        + truncation;
+    Estimate { value, uncertainty }
+}
+
+#[test]
+fn inactive_reference_elementary_and_nonlinear_limits() {
+    let nodes = [2.0, 1.875, 2.25];
+    for (kind, derivative, third) in [(0, 0.0, 0.0), (1, 3.0, 0.0), (2, 4.0, 0.0), (3, 12.0, 6.0)] {
+        let f = nodes.map(|x: f64| match kind {
+            0 => 7.0,
+            1 => 3.0 * x + 9.0,
+            2 => x * x,
+            _ => x * x * x,
+        });
+        let e = f.map(|v| 8.0 * EPS * v.abs().max(1.0));
+        let r = three_point(nodes, f, e, third);
+        assert!((r.value - derivative).abs() <= r.uncertainty);
+    }
+    let nodes = [0.0, 0.125, 0.25];
+    let r = three_point(nodes, nodes.map(|x| x * x), [0.0; 3], 0.0);
+    assert!(r.value.abs() <= r.uncertainty);
+    let small = three_point(nodes, nodes.map(|x| 1.0e-12 * x), [0.0; 3], 0.0);
+    assert!((small.value - 1.0e-12).abs() <= small.uncertainty);
+    let cancelled = three_point(
+        nodes,
+        nodes.map(|x| 1.0e20 + x),
+        [8.0 * EPS * 1.0e20; 3],
+        0.0,
+    );
+    assert!(
+        !admits(1.0, cancelled, 1.0e-3),
+        "flat cancellation is unresolved"
+    );
+    let nodes = [1.0, 0.999, 1.001];
+    let q = three_point(
+        nodes,
+        nodes.map(|x| x / (1.0 + x)),
+        [8.0 * EPS; 3],
+        6.0 / (1.999_f64.powi(4)),
+    );
+    assert!(admits(0.25, q, 1.0e-3));
+    assert!(!admits(0.5, q, 1.0e-3), "omitted normalizer derivative");
+}
