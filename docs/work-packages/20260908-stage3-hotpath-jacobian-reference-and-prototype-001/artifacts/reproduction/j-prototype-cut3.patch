+#[test]
+fn inactive_jacobian_complete_column_and_nonunit_coordinate_mapping() {
+    // Independent supplied-normalizer identity, not a finite-difference
+    // perturbation unit. Distinct sentinels expose partial column writes.
+    let normalizer = 1.0e-6_f64 + 1.0e-10_f64;
+    for dimension in [14, 25, 29, 38] {
+        for column in (0..dimension).filter(|index| index % 10 == 6 || index % 10 == 7) {
+            for coordinate_scale in [0.25, 1.0, 8.0] {
+                let mut matrix = vec![vec![17.0_f64; dimension]; dimension];
+                assemble_affine_column(&mut matrix, column, coordinate_scale, normalizer)
+                    .expect("valid complete affine column");
+                for (row, entries) in matrix.iter().enumerate() {
+                    for (index, &actual) in entries.iter().enumerate() {
+                        if index != column {
+                            assert_eq!(actual.to_bits(), 17.0_f64.to_bits());
+                        } else if row != column {
+                            assert_eq!(actual.to_bits(), 0.0_f64.to_bits());
+                        } else {
+                            // The residual's supplied scale is authoritative;
+                            // this independent relation catches a missing D.
+                            assert!(
+                                (actual * normalizer - coordinate_scale).abs()
+                                    <= 4.0 * f64::EPSILON * coordinate_scale
+                            );
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
