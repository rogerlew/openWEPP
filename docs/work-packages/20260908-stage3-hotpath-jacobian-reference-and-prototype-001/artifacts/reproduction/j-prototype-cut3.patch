+#[derive(Default)]
+struct Observation {
+    inclusive: Duration,
+    columns: Duration,
+    complete_probe_calls: u64,
+    direct_columns: u64,
+    fd_columns: u64,
+    canonical_checksum: u64,
+    consumed_checksum: u64,
+    inclusive_leaf_calls: u64,
+    observed_direct: crate::solver_residual_corpus_capture::DirectColumnCounts,
+}
+
+fn checksum(matrix: &[Vec<f64>], rhs: &[f64]) -> u64 {
+    matrix
+        .iter()
+        .flatten()
+        .chain(rhs)
+        .fold(0xcbf2_9ce4_8422_2325_u64, |state, value| {
+            assert!(value.is_finite(), "nonfinite benchmark assembly");
+            state.wrapping_mul(0x0100_0000_01b3) ^ black_box(value.to_bits())
+        })
+}
