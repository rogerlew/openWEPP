+/// Evidence equality never relies on a finite checksum. This comparison covers
+/// shape, every matrix entry and every RHS entry, including signed zero.
+fn exact_output(left: &(Vec<Vec<f64>>, Vec<f64>), right: &(Vec<Vec<f64>>, Vec<f64>)) -> bool {
+    left.0.len() == right.0.len()
+        && left.1.len() == right.1.len()
+        && left.0.iter().zip(&right.0).all(|(a, b)| {
+            a.len() == b.len() && a.iter().zip(b).all(|(x, y)| x.to_bits() == y.to_bits())
+        })
+        && left
+            .1
+            .iter()
+            .zip(&right.1)
+            .all(|(x, y)| x.to_bits() == y.to_bits())
+}
+
+fn preflight(cases: &[Case<'_>]) {
+    for case in cases {
+        let mut baseline = (Vec::new(), Vec::new());
+        let mut candidate = (Vec::new(), Vec::new());
+        repetition_with_output(case, Arm::A, |matrix, rhs| {
+            baseline = (matrix.to_vec(), rhs.to_vec());
+        })
+        .expect("untimed complete A obligation");
+        repetition_with_output(case, Arm::J, |matrix, rhs| {
+            candidate = (matrix.to_vec(), rhs.to_vec());
+        })
+        .expect("untimed complete J obligation");
+        assert!(
+            exact_output(&baseline, &candidate),
+            "untimed exact consumed matrix/RHS mismatch: {:?} {:?} {:?}",
+            case.snapshot.family,
+            case.snapshot.pass,
+            case.snapshot.lifecycle
+        );
+    }
+}
+
+/// Sequence-bound work checksum. This avoids the rotate/XOR cancellation of
+/// repeated records; it is an optimization barrier, not a parity certificate.
+fn accumulate(state: u64, repetition: u64, record: usize, value: u64) -> u64 {
+    [
+        repetition,
+        u64::try_from(record).expect("record index fits u64"),
+        value,
+    ]
+    .into_iter()
+    .flat_map(u64::to_le_bytes)
+    .fold(state, |hash, byte| {
+        (hash ^ u64::from(byte)).wrapping_mul(0x0100_0000_01b3)
+    })
+}
