+                if snapshot.family == Family::GenericV3 {
+                    matrix[j][j] = 1.0;
+                    rhs[j] = anchor / scales[j] - x[j];
+                } else {
+                    matrix[j][j] = 1.0 / physical_units[j];
+                    rhs[j] = (anchor - x[j]) / physical_units[j];
+                }
+            }
+        }
+        let nonpositive = base.occupancies.iter().any(|o| {
+            o.gas_branches.iter().any(|b| {
+                matches!(
+                    b,
+                    crate::V10LeafGasBranch::Inactive
+                        | crate::V10LeafGasBranch::ExactZeroPar
+                        | crate::V10LeafGasBranch::RespirationDominated
