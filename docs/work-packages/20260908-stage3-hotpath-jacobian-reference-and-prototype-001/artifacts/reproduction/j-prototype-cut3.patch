+//! Contract-first v34 tests: complete affine columns, coordinate mapping and
+//! fail-closed assembly. These do not use candidate code as an oracle.
+#![allow(clippy::float_cmp)]
+
+use super::inactive_jacobian::assemble_affine_column;
+use crate::LandSurfaceEnergyError;
+
+fn integrity(result: &Result<(), LandSurfaceEnergyError>) {
+    assert!(matches!(
+        result,
+        Err(LandSurfaceEnergyError::CoveredJacobianDerivativeIntegrity(
+            _
+        ))
+    ));
+}
