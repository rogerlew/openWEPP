+                        } else {
+                            1.0 / scales[j] - x[j]
+                        };
+                    } else {
+                        matrix[j][j] = 1.0 / physical_units[j];
+                        rhs[j] = if local < 4 {
+                            (common_initial[j] - x[j]) / physical_units[j]
+                        } else {
+                            (1.0 - x[j]) / physical_units[j]
+                        };
+                    }
+                }
+            }
+        }
+        let canopy_temperature = x[10 * occupancy_count] * scales[10 * occupancy_count];
+        for (o, occupancy) in base.occupancies.iter().enumerate() {
+            for (component, area) in occupancy.component_areas_m2_m2_tile.iter().enumerate() {
