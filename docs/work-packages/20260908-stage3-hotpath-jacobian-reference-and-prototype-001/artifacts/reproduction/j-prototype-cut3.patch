+/// Completed direct columns only. These bounded scalar counters are independent
+/// of detailed corpus capture and their increments are charged inside timing.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct DirectColumnCounts {
+    pub covered_potential: u64,
+    pub covered_fixed_final: u64,
+    pub generic_v3_potential: u64,
+    pub generic_v3_fixed_final: u64,
+}
+
+thread_local! {
+    static DIRECT_COUNTS: RefCell<Option<(Rc<()>, DirectColumnCounts, bool)>> = const { RefCell::new(None) };
+}
+
+pub struct DirectColumnCountSession {
+    generation: Rc<()>,
+    _thread: PhantomData<Rc<()>>,
+}
+
+pub fn start_direct_column_counting() -> Result<DirectColumnCountSession, String> {
+    DIRECT_COUNTS.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        if slot.is_some() {
+            return Err("direct column counting already active".into());
+        }
+        let generation = Rc::new(());
+        *slot = Some((Rc::clone(&generation), DirectColumnCounts::default(), false));
+        Ok(DirectColumnCountSession {
+            generation,
+            _thread: PhantomData,
+        })
+    })
+}
+
+impl DirectColumnCountSession {
+    pub fn finish(self) -> Result<DirectColumnCounts, String> {
+        DIRECT_COUNTS.with(|slot| {
+            let mut slot = slot.borrow_mut();
+            if !slot
+                .as_ref()
+                .is_some_and(|(generation, _, _)| Rc::ptr_eq(generation, &self.generation))
+            {
+                return Err("direct column session mismatch".into());
+            }
+            let Some((_, counts, overflow)) = slot.take() else {
+                return Err("direct column counting inactive".into());
+            };
+            if overflow {
+                Err("direct column count overflow".into())
+            } else {
+                Ok(counts)
+            }
+        })
+    }
+}
+
+impl Drop for DirectColumnCountSession {
+    fn drop(&mut self) {
+        DIRECT_COUNTS.with(|slot| {
+            let mut slot = slot.borrow_mut();
+            if slot
+                .as_ref()
+                .is_some_and(|(generation, _, _)| Rc::ptr_eq(generation, &self.generation))
+            {
+                slot.take();
+            }
+        });
+    }
+}
+
+pub(crate) fn completed_direct_column(family: Family, fixed: bool, index: usize) {
+    column_method(index, "direct_column").finish(true);
+    DIRECT_COUNTS.with(|slot| {
+        if let Some((_, counts, overflow)) = slot.borrow_mut().as_mut() {
+            let counter = match (family, fixed) {
+                (Family::Covered, false) => &mut counts.covered_potential,
+                (Family::Covered, true) => &mut counts.covered_fixed_final,
+                (Family::GenericV3, false) => &mut counts.generic_v3_potential,
+                (Family::GenericV3, true) => &mut counts.generic_v3_fixed_final,
+            };
+            increment(counter, overflow);
+        }
+    });
+}
