+//! Private v34 affine columns. Only successful same-state evaluations mint a
+//! sweep; the sweep borrows its base and consumes canonical column order once.
+use crate::numerics::{ColumnAssembly, JacobianColumns};
+use crate::{
+    CoveredColumnEvaluation, CoveredColumnInputs, CoveredFrozenBranches, CoveredWaterCaps,
+    LandSurfaceEnergyError, V3LitterResidualContext, V3PhaseFreeCoveredEvaluation,
+};
+
+fn integrity(reason: &'static str) -> LandSurfaceEnergyError {
+    LandSurfaceEnergyError::CoveredJacobianDerivativeIntegrity(reason)
+}
+
+fn eligible_areas(input_area: f64, component_area: f64) -> bool {
+    input_area.to_bits() == 0.0_f64.to_bits() && component_area.to_bits() == 0.0_f64.to_bits()
+}
+
+pub(super) fn assemble_affine_column(
+    matrix: &mut [Vec<f64>],
+    column: usize,
+    coordinate_scale: f64,
+    normalizer: f64,
+) -> Result<(), LandSurfaceEnergyError> {
+    let dimension = matrix.len();
+    if dimension == 0 || column >= dimension || matrix.iter().any(|row| row.len() != dimension) {
+        return Err(integrity("column matrix shape"));
+    }
+    if !coordinate_scale.is_finite()
+        || coordinate_scale <= 0.0
+        || !normalizer.is_finite()
+        || normalizer <= 0.0
+    {
+        return Err(integrity("coordinate scale or normalizer"));
+    }
+    let diagonal = coordinate_scale / normalizer;
+    if !diagonal.is_finite() || diagonal <= 0.0 {
+        return Err(integrity("nonfinite or unrepresentable tangent"));
+    }
+    // All checks precede the first write. A failed column is never published.
+    for (row, entries) in matrix.iter_mut().enumerate() {
+        entries[column] = if row == column { diagonal } else { 0.0 };
+    }
+    Ok(())
+}
