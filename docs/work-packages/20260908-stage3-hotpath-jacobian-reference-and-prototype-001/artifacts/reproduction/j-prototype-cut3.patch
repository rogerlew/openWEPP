+    let common_initial = x.clone();
+    let adjustment = |matrix: &mut [Vec<f64>]| {
+        let mut rhs: Vec<_> = base.normalized_residuals.iter().map(|r| -r).collect();
+        for (o, input) in snapshot.inputs.occupancies.iter().enumerate() {
+            let all_inactive = snapshot.inputs.authority.admits_nonpositive_assimilation()
+                && [
