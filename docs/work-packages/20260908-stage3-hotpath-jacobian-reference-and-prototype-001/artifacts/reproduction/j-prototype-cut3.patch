+#[derive(Clone, Copy, Debug)]
+struct Estimate {
+    value: f64,
+    uncertainty: f64,
+}
+
+fn admits(candidate: f64, reference: Estimate, allowed: f64) -> bool {
+    candidate.is_finite()
+        && reference.value.is_finite()
+        && reference.uncertainty.is_finite()
+        && reference.uncertainty >= 0.0
+        && allowed.is_finite()
+        && allowed > 0.0
+        && (candidate - reference.value).abs() + reference.uncertainty <= allowed
+}
