+// Exact integer long division of 1 / supplied binary64 s, rounded once.
+// This deliberately does not use floating-point reciprocal or the J helper.
+fn reciprocal(s: f64) -> Estimate {
+    assert!(s.is_normal() && s > 0.0);
+    let bits = s.to_bits();
+    let exponent = i32::try_from((bits >> 52) & 0x7ff).unwrap() - 1023;
+    let significand = u128::from((bits & ((1_u64 << 52) - 1)) | (1_u64 << 52));
+    let out_exponent = -exponent - i32::from(significand != (1_u128 << 52));
+    assert!((-1022..=1023).contains(&out_exponent));
+    let shift = u32::try_from(104 - exponent - out_exponent).unwrap();
+    let numerator = 1_u128 << shift;
+    let mut quotient = numerator / significand;
+    let remainder = numerator % significand;
+    if 2 * remainder > significand || (2 * remainder == significand && quotient & 1 == 1) {
+        quotient += 1;
+    }
+    let encoded = (u64::try_from(out_exponent + 1023).unwrap() << 52)
+        + u64::try_from(quotient - (1_u128 << 52)).unwrap();
+    let value = f64::from_bits(encoded);
+    assert!(value.is_normal());
+    Estimate {
+        value,
+        uncertainty: EPS * value.abs() / (1.0 - EPS),
+    }
+}
+
+fn evaluation_allowance(t: f64, anchor: f64, s: f64, r: f64) -> f64 {
+    assert!(t.is_normal() && anchor.is_normal() && s.is_normal() && s > 0.0);
+    assert!(r == 0.0 || r.is_normal());
+    let error = 8.0 * EPS * (t.abs() + anchor.abs()) / s + 8.0 * EPS * r.abs().max(1.0);
+    assert!(error.is_normal());
+    error
+}
+
+fn secant(x0: f64, x1: f64, f0: f64, f1: f64, e0: f64, e1: f64) -> Estimate {
+    let displacement = x1 - x0;
+    assert!(displacement.is_normal() && displacement > 0.0);
+    let value = (f1 - f0) / displacement;
+    let uncertainty = (e0 + e1) / displacement + 8.0 * EPS * value.abs().max(1.0);
+    assert!(value.is_finite() && uncertainty.is_finite());
+    Estimate { value, uncertainty }
+}
+
+fn evaluate(
+    snapshot: &Snapshot,
+    x: &[f64],
+) -> Result<CoveredColumnEvaluation, LandSurfaceEnergyError> {
+    match &snapshot.v3 {
+        Some(v3) => crate::evaluate_v3_phase_free_covered_column(
+            &snapshot.inputs,
+            x,
+            snapshot.caps.as_ref(),
+            Some(&snapshot.frozen),
+            v3.context,
+        )
+        .map(|value| value.predecessor),
+        None => crate::evaluate_covered_column(
+            &snapshot.inputs,
+            x,
+            snapshot.caps.as_ref(),
+            Some(&snapshot.frozen),
+        ),
+    }
+}
+
+fn branches_equal(base: &CoveredColumnEvaluation, probe: &CoveredColumnEvaluation) -> bool {
+    base.ground_water.branch == probe.ground_water.branch
+        && base.occupancies.len() == probe.occupancies.len()
+        && base
+            .occupancies
+            .iter()
+            .zip(&probe.occupancies)
+            .all(|(a, b)| {
+                a.gas_branches == b.gas_branches
+                    && a.wet_branch == b.wet_branch
+                    && a.source_water.len() == b.source_water.len()
+                    && a.source_water
+                        .iter()
+                        .zip(&b.source_water)
+                        .all(|(x, y)| x.branch == y.branch)
+            })
+}
+
+fn supported(snapshot: &Snapshot, base: &CoveredColumnEvaluation) -> Vec<usize> {
+    if !snapshot.inputs.authority.admits_nonpositive_assimilation() {
+        return vec![];
+    }
+    snapshot
+        .inputs
+        .occupancies
+        .iter()
+        .enumerate()
+        .flat_map(|(o, inputs)| {
+            [
+                inputs.sun.leaf_area_m2_m2_tile,
+                inputs.shade.leaf_area_m2_m2_tile,
+            ]
+            .into_iter()
+            .enumerate()
+            .filter_map(move |(leaf, area)| {
+                (area.to_bits() == 0
+                    && base.occupancies[o].component_areas_m2_m2_tile[leaf].to_bits() == 0)
+                    .then_some(10 * o + 6 + leaf)
+            })
+        })
+        .collect()
+}
+
+fn lawful(snapshot: &Snapshot, x: &[f64]) -> bool {
+    super::covered_trial_is_valid(
+        x,
+        snapshot.inputs.occupancies.len(),
+        snapshot.family == Family::Covered
+            && super::covered_ground_uses_liquid_vapor_phase_domain(&snapshot.inputs),
+    )
+}
+
+fn assert_mask(base: &CoveredColumnEvaluation, probe: &CoveredColumnEvaluation, varying: &[usize]) {
+    assert!(branches_equal(base, probe), "reference branch change");
+    assert_eq!(
+        base.normalized_residuals.len(),
+        probe.normalized_residuals.len()
+    );
+    for row in 0..base.normalized_residuals.len() {
+        assert_eq!(
+            base.tolerances[row].to_bits(),
+            probe.tolerances[row].to_bits(),
+            "normalizer {row}"
+        );
+        if !varying.contains(&row) {
+            assert_eq!(
+                base.raw_residuals[row].to_bits(),
+                probe.raw_residuals[row].to_bits(),
+                "raw zero-mask row {row}"
+            );
+            assert_eq!(
+                base.normalized_residuals[row].to_bits(),
+                probe.normalized_residuals[row].to_bits(),
+                "normalized zero-mask row {row}"
+            );
+        }
+    }
+}
+
+fn first_difference(a: &serde_json::Value, b: &serde_json::Value, path: &str) -> Option<String> {
+    match (a, b) {
+        (serde_json::Value::Number(a), serde_json::Value::Number(b))
+            if a.is_f64() && b.is_f64() =>
+        {
+            let actual_bits = a.as_f64().unwrap().to_bits();
+            let captured_bits = b.as_f64().unwrap().to_bits();
+            (actual_bits != captured_bits).then(|| format!(
+                "{path}: actual={a} bits={actual_bits:016x}, captured={b} bits={captured_bits:016x}"
+            ))
+        }
+        (serde_json::Value::Object(a), serde_json::Value::Object(b)) => {
+            a.iter().find_map(|(key, value)| {
+                first_difference(
+                    value,
+                    b.get(key).unwrap_or(&serde_json::Value::Null),
+                    &format!("{path}/{key}"),
+                )
+            })
+        }
+        (serde_json::Value::Array(a), serde_json::Value::Array(b)) if a.len() == b.len() => a
+            .iter()
+            .zip(b)
+            .enumerate()
+            .find_map(|(i, (a, b))| first_difference(a, b, &format!("{path}/{i}"))),
+        _ if a != b => Some(format!("{path}: actual={a}, captured={b}")),
+        _ => None,
+    }
+}
+
+fn audit(snapshot: &Snapshot) -> serde_json::Value {
+    if let Err(error) = snapshot.replay() {
+        let x: Vec<_> = snapshot
+            .x_bits
+            .iter()
+            .copied()
+            .map(f64::from_bits)
+            .collect();
+        let actual = if let Some(v3) = &snapshot.v3 {
+            serde_json::to_value(
+                crate::evaluate_v3_phase_free_covered_column(
+                    &snapshot.inputs,
+                    &x,
+                    snapshot.caps.as_ref(),
+                    Some(&snapshot.frozen),
+                    v3.context,
+                )
+                .expect("diagnostic same-family evaluation"),
+            )
+            .unwrap()
+        } else {
+            serde_json::to_value(evaluate(snapshot, &x).expect("diagnostic covered evaluation"))
+                .unwrap()
+        };
+        let expected = if let Some(v3) = &snapshot.v3 {
+            serde_json::to_value(&v3.evaluation).unwrap()
+        } else {
+            serde_json::to_value(&snapshot.base_evaluation).unwrap()
+        };
+        panic!(
+            "lossless same-family base replay {error:?}, family={:?}, pass={:?}, first_difference={:?}",
+            snapshot.family,
+            snapshot.pass,
+            first_difference(&actual, &expected, "")
+        );
+    }
+    let x: Vec<f64> = snapshot
+        .x_bits
+        .iter()
+        .copied()
+        .map(f64::from_bits)
+        .collect();
+    let base = evaluate(snapshot, &x).expect("ordinary successful base");
+    let columns = supported(snapshot, &base);
+    assert!(
+        !columns.is_empty(),
+        "required corpus class has no target columns"
+    );
+    let allowed = 1.0e-3 / columns.len().max(1) as f64;
+    let anchor = x[10 * snapshot.inputs.occupancies.len()].max(273.15);
+    let mut references = Vec::new();
+    let mut records = Vec::new();
+    // Baseline-only route construction finishes before any candidate API call.
+    for &column in &columns {
+        let s = base.tolerances[column];
+        assert_eq!(s.to_bits(), (1.0e-6_f64 + 1.0e-10_f64).to_bits());
+        let elementary = reciprocal(s);
+        assert_eq!(
+            base.normalized_residuals[column].to_bits(),
+            ((x[column] - anchor) / s).to_bits()
+        );
+        let mut selected: Option<Estimate> = None;
+        let mut samples = Vec::new();
+        for h in STEPS_K {
+            let mut minus = x.clone();
+            let mut plus = x.clone();
+            minus[column] -= h;
+            plus[column] += h;
+            let left_result = lawful(snapshot, &minus).then(|| evaluate(snapshot, &minus));
+            let right_result = lawful(snapshot, &plus).then(|| evaluate(snapshot, &plus));
+            let left = left_result.as_ref().and_then(|result| result.as_ref().ok());
+            let right = right_result
+                .as_ref()
+                .and_then(|result| result.as_ref().ok());
+            // A constitutive probe failure is recorded, never converted into a
+            // one-sided stencil unless the outer domain excludes that endpoint.
+            if (lawful(snapshot, &minus) && left.is_none())
+                || (lawful(snapshot, &plus) && right.is_none())
+            {
+                samples.push(serde_json::json!({"h_k":h,"status":"UNRESOLVED_PROBE_ERROR",
+                    "minus_error":left_result.as_ref().and_then(|r|r.as_ref().err()).map(ToString::to_string),
+                    "plus_error":right_result.as_ref().and_then(|r|r.as_ref().err()).map(ToString::to_string)}));
+                continue;
+            }
+            let (t0, d0, t1, d1, mode) = match (left, right) {
+                (Some(a), Some(b)) => (minus[column], a, plus[column], b, "centered"),
+                (None, Some(b)) => (x[column], &base, plus[column], b, "inward_plus"),
+                (Some(a), None) => (minus[column], a, x[column], &base, "inward_minus"),
+                (None, None) => panic!("no lawful reference endpoint"),
+            };
+            assert_mask(&base, d0, &[column]);
+            assert_mask(&base, d1, &[column]);
+            let r0 = d0.normalized_residuals[column];
+            let r1 = d1.normalized_residuals[column];
+            let e0 = evaluation_allowance(t0, anchor, s, r0);
+            let e1 = evaluation_allowance(t1, anchor, s, r1);
+            assert_eq!(r0.to_bits(), ((t0 - anchor) / s).to_bits());
+            assert_eq!(r1.to_bits(), ((t1 - anchor) / s).to_bits());
+            let estimate = secant(t0, t1, r0, r1, e0, e1);
+            assert!(
+                (estimate.value - elementary.value).abs()
+                    <= estimate.uncertainty + elementary.uncertainty
+            );
+            if selected.is_none_or(|prior| estimate.uncertainty < prior.uncertainty) {
+                selected = Some(estimate);
+            }
+            samples.push(
+                serde_json::json!({"h_k":h,"mode":mode,"abscissae_k":[t0,t1],
+                "displacements_k":[t0-x[column],t1-x[column]],"estimate":estimate.value,
+                "uncertainty":estimate.uncertainty,"truncation":0.0,"inner_solve":0.0}),
+            );
+        }
+        let fd = selected.expect("UNRESOLVED: no lawful same-family affine corroboration");
+        assert!(fd.uncertainty <= allowed, "UNRESOLVED: FD resolution");
+        assert!(
+            elementary.uncertainty <= allowed,
+            "UNRESOLVED: elementary resolution"
+        );
+        references.push((column, elementary, fd));
+        let row_entries: Vec<_> = (0..x.len())
+            .map(|row| {
+                let own = row == column;
+                serde_json::json!({"row":row,"estimate":if own {elementary.value} else {0.0},
+                "uncertainty":if own {elementary.uncertainty} else {0.0},"units":"K^-1",
+                "route":if own {"elementary_reciprocal"} else {"structural_zero_and_probe_bits"},
+                "branch":"unchanged","allowed":allowed})
+            })
+            .collect();
+        records.push(
+            serde_json::json!({"column":column,"row":column,"units":"K^-1",
+            "route2":"exact_integer_reciprocal_rounded_once","estimate":elementary.value,
+            "uncertainty":elementary.uncertainty,"allowed":allowed,"route1":samples,"rows":row_entries,
+            "other_rows":"structural_zero_with_exact_probe_bit_invariance","branch":"unchanged"}),
+        );
+    }
+    let candidate =
+        capture::inactive_jacobian_columns(snapshot).expect("candidate canonical assembly");
+    assert_eq!(candidate.len(), x.len());
+    for (j, value) in candidate.iter().enumerate() {
+        assert_eq!(
+            value.is_some(),
+            columns.contains(&j),
+            "independent eligibility {j}"
+        );
+    }
+    for &(column, elementary, fd) in &references {
+        let actual = candidate[column].as_ref().unwrap();
+        assert_eq!(actual.len(), x.len());
+        let scale = snapshot
+            .v3
+            .as_ref()
+            .map_or(1.0, |v3| f64::from_bits(v3.coordinate_scale_bits[column]));
+        for (row, &value) in actual.iter().enumerate() {
+            let reference = if row == column {
+                elementary
+            } else {
+                Estimate {
+                    value: 0.0,
+                    uncertainty: 0.0,
+                }
+            };
+            assert!(
+                admits(
+                    value,
+                    Estimate {
+                        value: reference.value * scale,
+                        uncertainty: reference.uncertainty * scale
+                    },
+                    allowed * scale
+                ),
+                "candidate column {column} row {row}"
+            );
+            if row == column {
+                assert!(admits(
+                    value,
+                    Estimate {
+                        value: fd.value * scale,
+                        uncertainty: fd.uncertainty * scale
+                    },
+                    allowed * scale
+                ));
+            }
+        }
+    }
+    let mut directional_count = 0;
+    let mut directions = Vec::new();
+    for mode in 0..3 {
+        for h in STEPS_K {
+            let mut trial = x.clone();
+            for (position, &column) in columns.iter().enumerate() {
+                let sign = if mode == 1 || (mode == 2 && position % 2 == 1) {
+                    -1.0
+                } else {
+                    1.0
+                };
+                trial[column] += sign * h;
+            }
+            if !lawful(snapshot, &trial) {
+                directions
+                    .push(serde_json::json!({"mode":mode,"h_k":h,"status":"DOMAIN_INAPPLICABLE"}));
+                continue;
+            }
+            let probe = evaluate(snapshot, &trial).expect("lawful directional evaluator");
+            assert_mask(&base, &probe, &columns);
+            let mut row_checks = Vec::new();
+            for &(column, reference, _) in &references {
+                let displacement = trial[column] - x[column];
+                let observed =
+                    probe.normalized_residuals[column] - base.normalized_residuals[column];
+                let predicted = reference.value * displacement;
+                let bound = evaluation_allowance(
+                    trial[column],
+                    anchor,
+                    base.tolerances[column],
+                    probe.normalized_residuals[column],
+                ) + evaluation_allowance(
+                    x[column],
+                    anchor,
+                    base.tolerances[column],
+                    base.normalized_residuals[column],
+                ) + allowed * displacement.abs();
+                assert!(
+                    (observed - predicted).abs() <= bound,
+                    "direction {mode} row {column}"
+                );
+                // Check the actual complete candidate matrix-vector product,
+                // including every off-diagonal and actual coordinate scaling.
+                let candidate_prediction: f64 = columns
+                    .iter()
+                    .map(|&j| {
+                        let scale = snapshot
+                            .v3
+                            .as_ref()
+                            .map_or(1.0, |v3| f64::from_bits(v3.coordinate_scale_bits[j]));
+                        candidate[j].as_ref().unwrap()[column] * ((trial[j] - x[j]) / scale)
+                    })
+                    .sum();
+                let aggregate_allowance = allowed
+                    * columns
+                        .iter()
+                        .map(|&j| (trial[j] - x[j]).abs())
+                        .sum::<f64>();
+                let candidate_bound = bound - allowed * displacement.abs() + aggregate_allowance;
+                assert!((observed - candidate_prediction).abs() <= candidate_bound);
+                row_checks.push(serde_json::json!({"row":column,"displacement_k":displacement,
+                    "reference_remainder":(observed-predicted).abs(),"reference_bound":bound,
+                    "candidate_remainder":(observed-candidate_prediction).abs(),"candidate_bound":candidate_bound}));
+            }
+            directional_count += 1;
+            directions
+                .push(serde_json::json!({"mode":mode,"h_k":h,"status":"PASS","rows":row_checks}));
+        }
+    }
+    assert!(directional_count > 0);
+    serde_json::json!({"family":snapshot.family,"pass":snapshot.pass,"lifecycle":snapshot.lifecycle,
+        "dimension":x.len(),"supported":columns.len(),"entries":records,"directional_checks":directional_count,"directions":directions})
+}
+
