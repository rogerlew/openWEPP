+//! Untimed observation of existing accepted-operand validator invocations.
+//! Candidate construction is not final publication or full soil conservation.
+#![allow(clippy::missing_errors_doc)]
+
+use crate::{
+    CoveredColumnEnergyOperands, CoveredTileEnergyOperandSet, LandSurfaceEnergyError,
+    LitterPhaseReceipt, RuntimeTileIdentity, V3CoveredTileEnergyOperandSet,
+};
+use serde::Serialize;
+use serde_json::{Value, json};
+use std::{cell::RefCell, rc::Rc};
+
+#[derive(Clone, Copy, Debug, Serialize)]
+pub enum Family {
+    Covered,
+    #[serde(rename = "V3CanopyEnergyOnly")]
+    V3Energy,
+    Litter,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+enum Raw {
+    Covered(Box<CoveredTileEnergyOperandSet>),
+    V3(Box<V3CoveredTileEnergyOperandSet>),
+    Litter(Box<LitterPhaseReceipt>),
+}
+
+impl Raw {
+    fn family(&self) -> Family {
+        match self {
+            Self::Covered(_) => Family::Covered,
+            Self::V3(_) => Family::V3Energy,
+            Self::Litter(_) => Family::Litter,
+        }
+    }
+    fn validate(&self) -> Result<(), LandSurfaceEnergyError> {
+        self.finite_arithmetic()?;
+        match self {
+            Self::Covered(value) => {
+                value.validate()?;
+                canonical_shared_limits(
+                    &value.column.occupancies,
+                    value.column.canopy_air,
+                    matches!(
+                        &value.lower_boundary,
+                        crate::CoveredLowerBoundaryEnergyOperands::Stage3SnowCovered(_)
+                    ),
+                )
+            }
+            // Copy only the supplied canopy operands into the existing validator
+            // interface. No V1 ground payload replaces V3's litter ledger.
+            Self::V3(value) => {
+                CoveredColumnEnergyOperands {
+                    occupancies: value.occupancies.clone(),
+                    canopy_air: value.canopy_air,
+                    shortwave: value.shortwave.clone(),
+                    longwave: value.longwave.clone(),
+                    stage3_lower_boundary_energy_w_m2_tile: 0.0,
+                    optical_receipt_sha256: None,
+                    reciprocal_longwave_receipt_sha256: None,
+                    final_canopy_boundary_receipt_sha256: None,
+                }
+                .validate()?;
+                canonical_shared_limits(&value.occupancies, value.canopy_air, false)
+            }
+            Self::Litter(value) => crate::validate_litter_phase_receipt(value),
+        }
+    }
+    #[expect(
+        clippy::too_many_lines,
+        reason = "Keep the reviewed branch-specific overflow proof and its single aggregate bound together"
+    )]
+    fn finite_arithmetic(&self) -> Result<(), LandSurfaceEnergyError> {
+        // Arithmetic guard only, never a physical acceptance threshold. Include
+        // every serialized raw numeric operand in the absolute addition bound.
+        let mut bound = numeric_bound(&self.value());
+        let canopy = match self {
+            Self::Covered(v) => Some((&v.column.occupancies, v.column.canopy_air)),
+            Self::V3(v) => Some((&v.occupancies, v.canopy_air)),
+            Self::Litter(_) => None,
+        };
+        if let Some((occupancies, air)) = canopy {
+            let area: f64 = occupancies
+                .iter()
+                .flat_map(surfaces)
+                .map(|s| s.emissive_area_m2_m2_tile)
+                .sum();
+            finite(area)?;
+            for s in occupancies.iter().flat_map(surfaces) {
+                if s.emissive_area_m2_m2_tile > 0.0
+                    && !(0.0..=1.0).contains(&(s.emissive_area_m2_m2_tile / area))
+                {
+                    return Err(LandSurfaceEnergyError::ControlVolumeClosure(
+                        "audit emissive weight",
+                    ));
+                }
+                for v in [
+                    s.latent_heat_j_kg * s.signed_vapor_to_canopy_air_kg_m2_tile_s,
+                    air.rho_air_kg_m3
+                        * air.cp_air_j_kg_k
+                        * s.heat_conductance_m_s_tile
+                        * (s.surface_temperature_k - air.canopy_air_temperature_k),
+                    air.rho_air_kg_m3
+                        * s.vapor_conductance_m_s_tile
+                        * (s.surface_specific_humidity_kg_kg
+                            - air.canopy_air_specific_humidity_kg_kg),
+                    s.surface_temperature_k.powi(4),
+                ] {
+                    finite(v)?;
+                    bound += v.abs();
+                }
+            }
+        }
+        match self {
+            Self::Covered(v) => match &v.lower_boundary {
+                crate::CoveredLowerBoundaryEnergyOperands::SnowFree(g) => {
+                    let export = crate::physics::vapor_export_w_m2(
+                        g.latent.signed_vapor_kg_m2_s,
+                        g.latent.surface_temperature_k,
+                    )?;
+                    for value in [
+                        export,
+                        export * g.latent.interval_s,
+                        g.latent.signed_vapor_kg_m2_s * g.latent.interval_s,
+                        crate::physics::vapor_export_w_m2(
+                            g.surface.signed_vapor_kg_m2_s,
+                            g.surface.surface_temperature_k,
+                        )?,
+                    ] {
+                        finite(value)?;
+                        bound += value.abs();
+                    }
+                }
+                crate::CoveredLowerBoundaryEnergyOperands::Stage3SnowCovered(s) => {
+                    let latent = s.vapor_to_canopy_air_kg_m2_tile_s * s.latent_heat_j_kg;
+                    finite(latent)?;
+                    finite(latent * s.interval_s)?;
+                    bound += latent.abs() + (latent * s.interval_s).abs();
+                }
+            },
+            Self::Litter(v) => {
+                let dt = f64::from_bits(v.identity.support_duration_seconds_bits);
+                for value in [
+                    v.transfer.warm_energy_mass_bound_kg_m2,
+                    v.transfer.cold_energy_mass_bound_kg_m2,
+                    v.transfer.melt_kg_m2,
+                    v.transfer.freeze_kg_m2,
+                    v.transfer.signed_phase_kg_m2,
+                    v.transfer.fusion_energy_j_m2,
+                ] {
+                    finite(value)?;
+                }
+                for (liquid, ice, temperature) in [
+                    (
+                        v.beginning.liquid_kg_m2_tile,
+                        v.beginning.ice_kg_m2_tile,
+                        v.beginning.temperature_k,
+                    ),
+                    (
+                        v.post_vapor.liquid_kg_m2_tile,
+                        v.post_vapor.ice_kg_m2_tile,
+                        v.post_vapor.temperature_k,
+                    ),
+                    (
+                        v.ending.liquid_kg_m2_tile,
+                        v.ending.ice_kg_m2_tile,
+                        v.ending.temperature_k,
+                    ),
+                ] {
+                    let liquid_capacity = liquid * crate::WATER_HEAT_CAPACITY_J_KG_K;
+                    let ice_capacity = ice * crate::LITTER_ICE_HEAT_CAPACITY_J_KG_K;
+                    let capacity =
+                        v.configuration.dry_heat_capacity_j_m2_k + liquid_capacity + ice_capacity;
+                    for value in [
+                        liquid_capacity,
+                        ice_capacity,
+                        capacity,
+                        capacity * (temperature - crate::REFERENCE_TEMPERATURE_K),
+                        crate::LITTER_FUSION_ENTHALPY_J_KG * ice,
+                    ] {
+                        finite(value)?;
+                        bound += value.abs();
+                    }
+                }
+                for value in [
+                    crate::LITTER_FUSION_ENTHALPY_J_KG
+                        * (v.transfer.freeze_kg_m2 - v.transfer.melt_kg_m2),
+                    v.phase_free_surface_energy.liquid_vapor_energy_w_m2 * dt,
+                    v.phase_free_surface_energy.ice_vapor_energy_w_m2 * dt,
+                    v.vapor.liquid_signed_mass_kg_m2 * v.vapor.liquid_specific_enthalpy_j_kg,
+                    v.vapor.ice_signed_mass_kg_m2 * v.vapor.ice_specific_enthalpy_j_kg,
+                    v.vapor.finalized.liquid_signed_rate_kg_m2_s * dt,
+                    v.vapor.finalized.ice_signed_rate_kg_m2_s * dt,
+                    (v.post_vapor.sensible_energy_j_m2_tile
+                        - v.beginning.sensible_energy_j_m2_tile)
+                        / dt,
+                ] {
+                    finite(value)?;
+                    bound += value.abs();
+                }
+            }
+            Self::V3(_) => (),
+        }
+        finite(16.0 * bound)
+    }
+    fn poison(&self) -> Self {
+        let mut poisoned = self.clone();
+        match &mut poisoned {
+            Self::Covered(value) => {
+                value
+                    .column
+                    .canopy_air
+                    .ground_sensible_to_canopy_air_w_m2_tile += 1.0;
+            }
+            Self::V3(value) => value.canopy_air.ground_sensible_to_canopy_air_w_m2_tile += 1.0,
+            Self::Litter(value) => value.phase_free_surface_energy.absorbed_shortwave_w_m2 += 1.0,
+        }
+        poisoned
+    }
+    fn value(&self) -> Value {
+        match self {
+            Self::Covered(value) => {
+                let lower = match &value.lower_boundary {
+                    crate::CoveredLowerBoundaryEnergyOperands::SnowFree(ground) => {
+                        let crate::SurfaceEnergyOperands {
+                            absorbed_shortwave_w_m2,
+                            net_longwave_w_m2,
+                            sensible_w_m2,
+                            signed_vapor_kg_m2_s,
+                            surface_temperature_k,
+                            ground_heat_w_m2,
+                            storage_w_m2,
+                        } = ground.surface;
+                        let crate::LatentJoinOperands {
+                            signed_vapor_kg_m2_s: latent_vapor,
+                            interval_s,
+                            surface_temperature_k: latent_temperature,
+                            signed_water_amount_kg_m2,
+                            vapor_energy_j_m2,
+                        } = ground.latent;
+                        json!({"family":"snow_free", "surface": {
+                            "absorbed_shortwave_w_m2":absorbed_shortwave_w_m2,"net_longwave_w_m2":net_longwave_w_m2,
+                            "sensible_w_m2":sensible_w_m2,"signed_vapor_kg_m2_s":signed_vapor_kg_m2_s,
+                            "surface_temperature_k":surface_temperature_k,"ground_heat_w_m2":ground_heat_w_m2,"storage_w_m2":storage_w_m2},
+                            "latent":{"signed_vapor_kg_m2_s":latent_vapor,"interval_s":interval_s,
+                            "surface_temperature_k":latent_temperature,"signed_water_amount_kg_m2":signed_water_amount_kg_m2,"vapor_energy_j_m2":vapor_energy_j_m2},
+                            "ground_heat":ground.ground_heat.iter().map(|join| json!({"surface_debit_j_m2":join.surface_debit_j_m2,"soil_credit_j_m2":join.soil_credit_j_m2})).collect::<Vec<_>>()})
+                    }
+                    crate::CoveredLowerBoundaryEnergyOperands::Stage3SnowCovered(snow) => json!({
+                        "family":"stage3_snow", "optical":snow.optical,"snow_temperature_k":snow.snow_temperature_k,
+                        "vapor_to_canopy_air_kg_m2_tile_s":snow.vapor_to_canopy_air_kg_m2_tile_s,"interval_s":snow.interval_s,
+                        "latent_heat_j_kg":snow.latent_heat_j_kg,"latent_energy_to_canopy_air_j_m2_tile":snow.latent_energy_to_canopy_air_j_m2_tile,
+                        "sensible_to_canopy_air_w_m2_tile":snow.sensible_to_canopy_air_w_m2_tile,"net_longwave_w_m2_tile":snow.net_longwave_w_m2_tile,
+                        "precipitation_advection_w_m2_tile":snow.precipitation_advection_w_m2_tile,"boundary_energy_w_m2_tile":snow.boundary_energy_w_m2_tile,
+                        "carrier_receipt_id":snow.carrier_receipt_id,"optical_receipt_sha256":snow.optical_receipt_sha256,
+                        "reciprocal_longwave_receipt_sha256":snow.reciprocal_longwave_receipt_sha256,"final_canopy_boundary_receipt_sha256":snow.final_canopy_boundary_receipt_sha256}),
+                };
+                json!({"authority":value.authority,"column":value.column,"lower_boundary":lower})
+            }
+            Self::V3(value) => json!({"authority":value.authority,"occupancies":value.occupancies,
+                "canopy_air":value.canopy_air,"shortwave":value.shortwave,"longwave":value.longwave,
+                "litter_surface":value.litter_surface}),
+            Self::Litter(value) => json!(value),
+        }
+    }
+}
+
+fn finite(value: f64) -> Result<(), LandSurfaceEnergyError> {
+    if value.is_finite() {
+        Ok(())
+    } else {
+        Err(LandSurfaceEnergyError::NonFinite(
+            "accepted audit intermediate",
+        ))
+    }
+}
+fn numeric_bound(value: &Value) -> f64 {
+    match value {
+        Value::Number(n) => n.as_f64().map_or(f64::INFINITY, f64::abs),
+        Value::Array(v) => v.iter().map(numeric_bound).sum(),
+        Value::Object(v) => v.values().map(numeric_bound).sum(),
+        _ => 0.0,
+    }
+}
+
+// Audit-only threshold reconstruction. Snow carriers enter the residual but
+// canonical represented-snow normalization uses exact-zero ground scale terms.
+fn canonical_shared_limits(
+    occupancies: &[crate::CoveredOccupancyEnergyOperands],
+    air: crate::CoveredCanopyAirEnergyOperands,
+    represented_snow: bool,
+) -> Result<(), LandSurfaceEnergyError> {
+    let sensible: f64 = occupancies
+        .iter()
+        .map(|o| {
+            surfaces(o)
+                .iter()
+                .map(|s| s.sensible_to_canopy_air_w_m2_tile)
+                .sum::<f64>()
+        })
+        .sum();
+    let vapor: f64 = occupancies
+        .iter()
+        .map(|o| {
+            surfaces(o)
+                .iter()
+                .map(|s| s.signed_vapor_to_canopy_air_kg_m2_tile_s)
+                .sum::<f64>()
+        })
+        .sum();
+    let ground_heat_scale = if represented_snow {
+        0.0
+    } else {
+        air.ground_sensible_to_canopy_air_w_m2_tile
+    };
+    let ground_vapor_scale = if represented_snow {
+        0.0
+    } else {
+        air.ground_vapor_to_canopy_air_kg_m2_tile_s
+    };
+    let heat_scale =
+        (sensible.abs() + ground_heat_scale.abs() + air.sensible_to_reference_air_w_m2_tile.abs())
+            .max(1.0);
+    let vapor_scale = vapor
+        .abs()
+        .max(ground_vapor_scale.abs())
+        .max(air.vapor_to_reference_air_kg_m2_tile_s.abs());
+    let heat_limit = crate::energy_tolerance(heat_scale);
+    let vapor_limit = crate::water_tolerance(vapor_scale);
+    let heat_residual = sensible + air.ground_sensible_to_canopy_air_w_m2_tile
+        - air.sensible_to_reference_air_w_m2_tile;
+    let vapor_residual = vapor + air.ground_vapor_to_canopy_air_kg_m2_tile_s
+        - air.vapor_to_reference_air_kg_m2_tile_s;
+    if [
+        sensible,
+        vapor,
+        heat_scale,
+        vapor_scale,
+        heat_limit,
+        vapor_limit,
+        heat_residual,
+        vapor_residual,
+    ]
+    .iter()
+    .any(|v| !v.is_finite())
+        || heat_residual.abs() > heat_limit
+        || vapor_residual.abs() > vapor_limit
+        || air.shared_heat_tolerance_w_m2_tile.to_bits() != heat_limit.to_bits()
+        || air.shared_vapor_tolerance_kg_m2_tile_s.to_bits() != vapor_limit.to_bits()
+    {
+        return Err(LandSurfaceEnergyError::ControlVolumeClosure(
+            "audit canonical shared heat/vapor limits",
+        ));
+    }
+    Ok(())
+}
+
+fn surfaces(
+    occupancy: &crate::CoveredOccupancyEnergyOperands,
+) -> [crate::CoveredSurfaceEnergyOperands; 4] {
+    [
+        occupancy.sun_leaf,
+        occupancy.shade_leaf,
+        occupancy.wet_surface,
+        occupancy.dry_stem,
+    ]
+}
+
+fn exact_bits(value: &mut Value) {
+    match value {
+        Value::Number(number) if number.is_f64() => {
+            if let Some(float) = number.as_f64() {
+                *value = json!({"f64_bits":float.to_bits()});
+            }
+        }
+        Value::Array(values) => values.iter_mut().for_each(exact_bits),
+        Value::Object(values) => values.values_mut().for_each(exact_bits),
+        _ => (),
+    }
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct Record {
+    pub identity: Value,
+    pub primitive_bits: Value,
+    #[serde(skip)]
+    raw: Raw,
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct FamilyReport {
+    pub family: Family,
+    pub checked: u64,
+    pub failed: u64,
+    pub first: Option<Record>,
+    pub last: Option<Record>,
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct Report {
+    pub scope: &'static str,
+    pub families: [FamilyReport; 3],
+    pub first_error: Option<String>,
+    pub overflow: bool,
+}
+
+#[derive(Debug, thiserror::Error)]
+pub enum AuditError {
+    #[error("accepted operand observation already active")]
+    AlreadyActive,
+    #[error("accepted operand observation session missing")]
+    NotActive,
+    #[error("accepted operand evidence invalid: {0}")]
+    Invalid(String),
+}
+
+struct State {
+    generation: Rc<()>,
+    report: Report,
+}
+thread_local! { static ACTIVE: RefCell<Option<State>> = const { RefCell::new(None) }; }
+pub struct Session {
+    generation: Rc<()>,
+}
+
+pub fn begin() -> Result<Session, AuditError> {
+    ACTIVE.with(|active| {
+        let mut active = active.borrow_mut();
+        if active.is_some() { return Err(AuditError::AlreadyActive); }
+        let generation = Rc::new(());
+        *active = Some(State { generation: Rc::clone(&generation), report: Report {
+            scope:"existing validators on actual accepted physical candidate construction; not full scientific adjudication, final publication or soil-interior closure",
+            families: [Family::Covered,Family::V3Energy,Family::Litter].map(|family| FamilyReport {
+                family, checked:0,failed:0,first:None,last:None }), first_error:None,overflow:false,
+        }});
+        Ok(Session { generation })
+    })
+}
+
+impl Session {
+    pub fn finish(self) -> Result<Report, AuditError> {
+        ACTIVE.with(|active| {
+            let state = active.borrow_mut().take().ok_or(AuditError::NotActive)?;
+            let report = state.report;
+            if report.overflow
+                || report
+                    .families
+                    .iter()
+                    .any(|family| family.checked == 0 || family.failed != 0)
+            {
+                return Err(AuditError::Invalid(format!(
+                    "overflow={}, counts={:?}, first_error={:?}",
+                    report.overflow,
+                    report
+                        .families
+                        .iter()
+                        .map(|family| (family.checked, family.failed))
+                        .collect::<Vec<_>>(),
+                    report.first_error
+                )));
+            }
+            Ok(report)
+        })
+    }
+}
+impl Drop for Session {
+    fn drop(&mut self) {
+        ACTIVE.with(|active| {
+            let mut active = active.borrow_mut();
+            if active
+                .as_ref()
+                .is_some_and(|state| Rc::ptr_eq(&self.generation, &state.generation))
+            {
+                active.take();
+            }
+        });
+    }
+}
