+pub fn verify_inactive_provider_exclusions(
+    snapshot: &Snapshot,
+) -> Result<Vec<InactiveProviderExclusionEvidence>, crate::LandSurfaceEnergyError> {
+    use crate::LandSurfaceEnergyError;
+    let fail = |reason| LandSurfaceEnergyError::CoveredJacobianDerivativeIntegrity(reason);
+    let mut evidence = Vec::new();
+    for case in [
+        "positive_input_area",
+        "wet_only_inactivity",
+        "negative_zero_input_area",
+    ] {
+        eprintln!(
+            "provider_exclusion_begin family={:?} pass={:?} case={case}",
+            snapshot.family, snapshot.pass
+        );
+        let mut variant = snapshot.clone();
+        if case != "negative_zero_input_area" {
+            variant.inputs.top_rain_kg_m2_tile = 0.0;
+        }
+        for occupancy in &mut variant.inputs.occupancies {
+            occupancy.sun.leaf_area_m2_m2_tile = if case == "negative_zero_input_area" {
+                -0.0
+            } else {
+                0.25
+            };
+            if case != "negative_zero_input_area" {
+                // The captured physically absent leaf has zero respiration.
+                // Once its area is positive, the canonical exact-zero-PAR
+                // branch requires ca < ci < pressure. Supply explicit lawful
+                // test-local respiration and positive residual conductance;
+                // do not weaken that source guard for the variant.
+                occupancy.sun.rd25 = 1.0;
+                occupancy.g0_umol_m2_s = 25_000.0;
+                occupancy.lai = 0.25 + occupancy.shade.leaf_area_m2_m2_tile;
+                occupancy.beginning_canopy_liquid_kg_m2_tile = 0.0;
+                if case == "wet_only_inactivity" {
+                    occupancy.liquid_capacity_kg_m2_plant = 1.0;
+                    occupancy.beginning_canopy_liquid_kg_m2_tile = occupancy.lai + occupancy.sai;
+                }
+            }
+        }
+        let trial: Vec<_> = variant
+            .x_bits
+            .iter()
+            .map(|bits| f64::from_bits(*bits))
+            .collect();
+        // This entry performs ordinary fresh same-family validation. An invalid
+        // base cannot satisfy a structural-inapplicability assertion.
+        let columns = inactive_jacobian_columns(&variant)?;
+        if (0..variant.inputs.occupancies.len())
+            .any(|occupancy| columns[10 * occupancy + 6].is_some())
