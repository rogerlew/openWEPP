+        (0.0, valid_normalizer),
+        (-0.0, valid_normalizer),
+        (-1.0, valid_normalizer),
+        (f64::NAN, valid_normalizer),
+        (f64::INFINITY, valid_normalizer),
+        (1.0, 0.0),
+        (1.0, -0.0),
+        (1.0, -1.0),
+        (1.0, f64::NAN),
+        (1.0, f64::INFINITY),
+        (f64::MAX, f64::MIN_POSITIVE),
+    ] {
+        let mut matrix = vec![vec![19.0; 14]; 14];
+        let before = matrix.clone();
+        integrity(&assemble_affine_column(&mut matrix, 6, scale, normalizer));
+        assert_eq!(
+            matrix, before,
+            "invalid derivative must not partially write"
+        );
+    }
