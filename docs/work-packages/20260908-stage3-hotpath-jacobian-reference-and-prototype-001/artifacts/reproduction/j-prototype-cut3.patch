+impl Report {
+    /// Reuse actual edge records for side-channel success/error neutrality and
+    /// independent validator poisons. Does not claim rejected transaction replay.
+    #[expect(
+        clippy::too_many_lines,
+        reason = "Keep the bounded actual-edge poison and ordered observer-session protocol together for review"
+    )]
+    pub fn verify_observer_and_poison_vectors(&self) -> Result<(), AuditError> {
+        let records: Vec<_> = self
+            .families
+            .iter()
+            .flat_map(|family| family.first.iter().chain(&family.last))
+            .collect();
+        if is_active() {
+            return Err(AuditError::AlreadyActive);
+        }
+        for saved in &records {
+            for vapor_poison in [false, true] {
+                let mut laundered = saved.raw.clone();
+                let operands = match &mut laundered {
+                    Raw::Covered(v) => Some((&v.column.occupancies, &mut v.column.canopy_air)),
+                    Raw::V3(v) => Some((&v.occupancies, &mut v.canopy_air)),
+                    Raw::Litter(_) => None,
+                };
+                if let Some((occupancies, air)) = operands {
+                    let sensible: f64 = occupancies
+                        .iter()
+                        .map(|o| {
+                            surfaces(o)
+                                .iter()
+                                .map(|s| s.sensible_to_canopy_air_w_m2_tile)
+                                .sum::<f64>()
+                        })
+                        .sum();
+                    air.sensible_to_reference_air_w_m2_tile += 1.0;
+                    air.shared_heat_residual_w_m2_tile = sensible
+                        + air.ground_sensible_to_canopy_air_w_m2_tile
+                        - air.sensible_to_reference_air_w_m2_tile;
+                    air.shared_heat_tolerance_w_m2_tile =
+                        air.shared_heat_residual_w_m2_tile.abs() + 1.0;
+                    if vapor_poison {
+                        // Start this independent vapor poison from the unmodified air.
+                        *air = match &saved.raw {
+                            Raw::Covered(v) => v.column.canopy_air,
+                            Raw::V3(v) => v.canopy_air,
+                            Raw::Litter(_) => unreachable!(),
+                        };
+                        let vapor: f64 = occupancies
+                            .iter()
+                            .map(|o| {
+                                surfaces(o)
+                                    .iter()
+                                    .map(|s| s.signed_vapor_to_canopy_air_kg_m2_tile_s)
+                                    .sum::<f64>()
+                            })
+                            .sum();
+                        air.vapor_to_reference_air_kg_m2_tile_s += 1.0;
+                        air.shared_vapor_residual_kg_m2_tile_s = vapor
+                            + air.ground_vapor_to_canopy_air_kg_m2_tile_s
+                            - air.vapor_to_reference_air_kg_m2_tile_s;
+                        air.shared_vapor_tolerance_kg_m2_tile_s =
+                            air.shared_vapor_residual_kg_m2_tile_s.abs() + 1.0;
+                    }
+                    let old_result = match &laundered {
+                        Raw::Covered(v) => v.validate(),
+                        Raw::V3(v) => CoveredColumnEnergyOperands {
+                            occupancies: v.occupancies.clone(),
+                            canopy_air: v.canopy_air,
+                            shortwave: v.shortwave.clone(),
+                            longwave: v.longwave.clone(),
+                            stage3_lower_boundary_energy_w_m2_tile: 0.0,
+                            optical_receipt_sha256: None,
+                            reciprocal_longwave_receipt_sha256: None,
+                            final_canopy_boundary_receipt_sha256: None,
+                        }
+                        .validate(),
+                        Raw::Litter(_) => unreachable!(),
+                    };
+                    if old_result.is_err() || laundered.validate().is_ok() {
+                        return Err(AuditError::Invalid(
+                            "inflated canonical tolerance poison binding".into(),
+                        ));
+                    }
+                }
+            }
+            let mut overflow = saved.raw.clone();
+            match &mut overflow {
+                Raw::Covered(v) => {
+                    if let Some(o) = v.column.occupancies.first_mut() {
+                        o.sun_leaf.latent_heat_j_kg = 1e308;
+                        o.sun_leaf.signed_vapor_to_canopy_air_kg_m2_tile_s = 1e308;
+                    }
+                }
+                Raw::V3(v) => {
+                    if let Some(o) = v.occupancies.first_mut() {
+                        o.sun_leaf.latent_heat_j_kg = 1e308;
+                        o.sun_leaf.signed_vapor_to_canopy_air_kg_m2_tile_s = 1e308;
+                    }
+                }
+                Raw::Litter(v) => v.transfer.warm_energy_mass_bound_kg_m2 = f64::INFINITY,
+            }
+            if !matches!(
+                overflow.validate(),
+                Err(LandSurfaceEnergyError::NonFinite(
+                    "accepted audit intermediate"
+                ))
+            ) {
+                return Err(AuditError::Invalid(
+                    "actual raw overflow poison binding".into(),
+                ));
+            }
+            let before = saved.raw.clone();
+            let off = before.validate();
+            record(saved.identity.clone(), before.clone());
+            if off.is_err() || before != saved.raw {
+                return Err(AuditError::Invalid("valid observer-off vector".into()));
+            }
+            if let Raw::Litter(receipt) = &saved.raw {
+                let id = &receipt.identity;
+                let mut input = crate::LitterPhaseTransactionInput {
+                    identity: crate::LitterPhaseTransactionIdentity {
+                        lse_configuration_sha256: id.lse_configuration_sha256.clone(),
+                        transaction_id: id.transaction_id,
+                        ofe_id: id.ofe_id.clone(),
+                        tile_id: id.tile_id.clone(),
+                        surface_owner_id: id.surface_owner_id.clone(),
+                        beginning_surface_owner_sha256: id.beginning_surface_owner_sha256.clone(),
+                        candidate_surface_owner_sha256: id.candidate_surface_owner_sha256.clone(),
+                        support_start_ns: id.support_start_ns,
+                        support_end_ns: id.support_end_ns,
+                    },
+                    configuration: receipt.configuration,
+                    beginning: receipt.beginning,
+                    vapor_environment: receipt.vapor.raw.environment,
+                    finalized_vapor: receipt.vapor.finalized,
+                    phase_free_surface_energy: receipt.phase_free_surface_energy,
+                };
+                let dt = f64::from_bits(id.support_duration_seconds_bits);
+                input.finalized_vapor.liquid_signed_rate_kg_m2_s =
+                    (input.beginning.liquid_kg_m2_tile + 1.0) / dt;
+                let before = input.clone();
+                let off = crate::execute_litter_phase_v3(&input);
+                let session = begin()?;
+                let on = crate::execute_litter_phase_v3(&input);
+                let no_hooks = ACTIVE.with(|active| {
+                    active
+                        .borrow()
+                        .as_ref()
+                        .is_some_and(|state| state.report.families.iter().all(|f| f.checked == 0))
+                });
+                if !matches!(&off, Err(LandSurfaceEnergyError::FrozenLitterVapor(_)))
+                    || off != on
+                    || input != before
+                    || !no_hooks
+                {
+                    return Err(AuditError::Invalid(
+                        "real litter transaction pre-hook first-error neutrality".into(),
+                    ));
+                }
+                if session.finish().is_ok() {
+                    return Err(AuditError::Invalid(
+                        "failed transaction missing hooks admitted".into(),
+                    ));
+                }
+            }
+        }
+        let session = begin()?;
+        for saved in &records {
+            record(saved.identity.clone(), saved.raw.clone());
+        }
+        let repeated = session.finish()?;
+        for (original, observed) in self.families.iter().zip(&repeated.families) {
+            if original.first.as_ref().map(|record| &record.primitive_bits)
+                != observed.first.as_ref().map(|record| &record.primitive_bits)
+            {
+                return Err(AuditError::Invalid("observer-on input bit mutation".into()));
+            }
+        }
+        let session = begin()?;
+        for saved in &records {
+            let poisoned = saved.raw.poison();
+            let before = poisoned.clone();
+            let off_error = poisoned.validate();
+            record(saved.identity.clone(), poisoned.clone());
+            let on_error = poisoned.validate();
+            if off_error.is_ok() || off_error != on_error || poisoned != before {
+                return Err(AuditError::Invalid(
+                    "poison first-error or immutable operand mismatch".into(),
+                ));
+            }
+        }
+        if session.finish().is_ok() {
+            return Err(AuditError::Invalid("poison evidence accepted".into()));
+        }
+        Ok(())
+    }
+}
