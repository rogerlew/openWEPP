+        fd.iter()
+            .flatten()
+            .zip(candidate.iter().flatten())
+            .all(|(a, b)| a.to_bits() == b.to_bits()),
+        fd_rhs
+            .iter()
+            .zip(&candidate_rhs)
+            .all(|(a, b)| a.to_bits() == b.to_bits()),
+    ))
+}
