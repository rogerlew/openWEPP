+#[test]
+fn inactive_reference_implicit_branch_and_wrong_entry_tests() {
+    // z^2=x: finite root residual bounds z error by |F|/(2*z_lower).
+    let nodes = [4.0, 3.999, 4.001];
+    let roots = nodes.map(f64::sqrt);
+    let implicit_error = |residual: f64, evaluation_error: f64, denominator_lower: f64| {
+        (denominator_lower.is_finite() && denominator_lower > 0.0)
+            .then(|| (residual.abs() + evaluation_error) / denominator_lower)
+    };
+    let errors = std::array::from_fn(|i| {
+        implicit_error(
+            roots[i] * roots[i] - nodes[i],
+            8.0 * EPS * nodes[i],
+            2.0 * 1.99,
+        )
+        .unwrap()
+    });
+    let reference = three_point(nodes, roots, errors, 3.0 / (8.0 * 3.999_f64.powf(2.5)));
+    assert!(admits(0.25, reference, 1.0e-3));
+    // A singular implicit denominator is not replaced by a floor.
+    assert!(implicit_error(0.0, EPS, 0.0).is_none());
+    let same_branch = |x: [f64; 3]| x.iter().all(|v| *v > 0.0) || x.iter().all(|v| *v < 0.0);
+    assert!(!same_branch([0.0, -0.1, 0.1]), "kink/tie unsupported");
+    assert!(
+        !same_branch([0.01, -0.1, 0.1]),
+        "branch crossing unsupported"
+    );
+    let reference = reciprocal(1.0e-6 + 1.0e-10);
+    assert!(admits(reference.value, reference, 1.0e-3));
+    assert!(!admits(reference.value + 0.01, reference, 1.0e-3));
+    assert!(!admits(
+        0.01,
+        Estimate {
+            value: 0.0,
+            uncertainty: 0.0
+        },
+        1.0e-3
+    ));
+    assert!(!admits(
+        0.0,
+        Estimate {
+            value: 0.0,
+            uncertainty: 1.0
+        },
+        1.0e-3
