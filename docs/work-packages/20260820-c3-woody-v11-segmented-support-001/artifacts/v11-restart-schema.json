{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"OPENWEPP_C3_WOODY_V11_RESTART_V1",
  "type":"object","additionalProperties":false,
  "required":["schema","authority_sha256","configuration_sha256","checkpoint_phase","parent_transaction_id","parent_transaction_sequence","next_parent_transaction_sequence","accepted_until_ns","next_slab_ordinal","next_event_ordinal","active_participant_ids","coupled_time_v2_base64","coupled_time_v2_sha256","complete_owner_manifest","parent_beginning_owner_sha256","staged_owner_sha256","staged_v11_state","accepted_slab_receipts","accepted_event_receipts","accepted_resource_receipts","accepted_material_receipts","scheduled_once_receipts","staged_resource_bits","reduction_state","pending_publication_records","publication_outbox","parent_receipt_sha256"],
  "properties":{
    "schema":{"const":"OPENWEPP_C3_WOODY_V11_RESTART_V1"},"authority_sha256":{"$ref":"#/$defs/sha"},"configuration_sha256":{"$ref":"#/$defs/sha"},"checkpoint_phase":{"enum":["before_event","after_event","ActiveParent","CommittedParent"]},
    "parent_transaction_id":{"$ref":"#/$defs/sha"},"parent_transaction_sequence":{"$ref":"#/$defs/u128"},"next_parent_transaction_sequence":{"$ref":"#/$defs/u128"},"accepted_until_ns":{"$ref":"#/$defs/u128"},"next_slab_ordinal":{"type":"integer","minimum":0},"next_event_ordinal":{"type":"integer","minimum":0},
    "active_participant_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"coupled_time_v2_base64":{"$ref":"#/$defs/b64"},"coupled_time_v2_sha256":{"$ref":"#/$defs/sha"},
    "complete_owner_manifest":{"type":"array","minItems":7,"maxItems":7,"uniqueItems":true,"items":{"type":"string","minLength":1}},"parent_beginning_owner_sha256":{"type":"array","minItems":7,"maxItems":7,"items":{"$ref":"#/$defs/sha"}},"staged_owner_sha256":{"type":"array","minItems":7,"maxItems":7,"items":{"$ref":"#/$defs/sha"}},"staged_v11_state":{"$ref":"v11-state-schema.json"},
    "accepted_slab_receipts":{"type":"array","items":{"$ref":"#/$defs/receipt"}},"accepted_event_receipts":{"type":"array","items":{"$ref":"#/$defs/receipt"}},"accepted_resource_receipts":{"type":"array","items":{"$ref":"#/$defs/receipt"}},"accepted_material_receipts":{"type":"array","items":{"$ref":"#/$defs/receipt"}},"scheduled_once_receipts":{"type":"array","items":{"$ref":"#/$defs/receipt"}},
    "staged_resource_bits":{"type":"object","additionalProperties":false,"required":["water","nh4","no3"],"properties":{"water":{"$ref":"#/$defs/f64bits"},"nh4":{"$ref":"#/$defs/f64bits"},"no3":{"$ref":"#/$defs/f64bits"}}},"reduction_state":{"type":"object","additionalProperties":false,"required":["peak_bits","operand_count"],"properties":{"peak_bits":{"$ref":"#/$defs/f64bits"},"operand_count":{"type":"integer","minimum":0}}},
    "pending_publication_records":{"type":"array","items":{"$ref":"#/$defs/receipt"}},"publication_outbox":{"type":"array","items":{"$ref":"#/$defs/outbox"}},"parent_receipt_sha256":{"$ref":"#/$defs/sha"}
  },
  "$defs":{
    "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},"f64bits":{"type":"string","pattern":"^[0-9a-f]{16}$"},"u128":{"type":"string","pattern":"^(0|[1-9][0-9]{0,38})$"},"b64":{"type":"string","pattern":"^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
    "receipt":{"type":"object","additionalProperties":false,"required":["kind","ordinal","identity_sha256","payload","payload_sha256"],"properties":{"kind":{"enum":["slab","event","scheduled","resource","material","publication"]},"ordinal":{"type":"integer","minimum":0},"identity_sha256":{"$ref":"#/$defs/sha"},"payload":{"$ref":"#/$defs/b64"},"payload_sha256":{"$ref":"#/$defs/sha"}}},
    "outbox":{"type":"object","additionalProperties":false,"required":["outbox_id","state","delivery_count"],"properties":{"outbox_id":{"$ref":"#/$defs/sha"},"state":{"enum":["CommittedUndelivered","Delivered","Acknowledged"]},"delivery_count":{"type":"integer","minimum":0}}}
  }
}
