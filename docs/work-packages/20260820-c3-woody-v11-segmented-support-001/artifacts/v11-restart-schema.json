    "receipt":{"type":"object","additionalProperties":false,"required":["identity_sha256","parent_transaction_id","segment_id","accepted_slab_id","owner_id","payload_canonical_json","payload_sha256"],"properties":{"identity_sha256":{"$ref":"#/$defs/sha"},"parent_transaction_id":{"$ref":"#/$defs/nonempty"},"segment_id":{"$ref":"#/$defs/nonempty"},"accepted_slab_id":{"$ref":"#/$defs/nonempty"},"owner_id":{"$ref":"#/$defs/nonempty"},"payload_canonical_json":{"type":"object"},"payload_sha256":{"$ref":"#/$defs/sha"}}},
    "reduction":{"type":"object","additionalProperties":false,"required":["reduction_id","operator","operand_receipt_ids","operand_value_bits","value_bits"],"properties":{"reduction_id":{"$ref":"#/$defs/sha"},"operator":{"enum":["Maximum","Minimum","Sum"]},"operand_receipt_ids":{"type":"array","items":{"$ref":"#/$defs/sha"}},"operand_value_bits":{"type":"array","items":{"type":"string","pattern":"^[0-9a-f]{16}$"}},"value_bits":{"oneOf":[{"type":"null"},{"type":"string","pattern":"^[0-9a-f]{16}$"}]}}},
    "outbox":{"type":"object","additionalProperties":false,"required":["outbox_id","state","delivery_count","parent_receipt_id","publication_receipt_id"],"properties":{"outbox_id":{"$ref":"#/$defs/sha"},"state":{"enum":["CommittedUndelivered","Delivered","Acknowledged"]},"delivery_count":{"type":"integer","minimum":0},"parent_receipt_id":{"$ref":"#/$defs/sha"},"publication_receipt_id":{"$ref":"#/$defs/sha"}}}
