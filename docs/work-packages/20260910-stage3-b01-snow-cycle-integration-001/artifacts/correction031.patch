+#[test]
+#[ignore = "B01 immutable policy requires a fresh explicit process"]
+fn b01_cycle_endpoint_stabilization_real_maps() {
+    use CanonicalCoveredFinalConvergencePoisonV1 as Poison;
+    use openwepp_land_surface_energy::snow_accuracy_policy::Policy;
+    Policy::B01.install().expect("fresh B01 process");
+    for index in [1, 2, 3, 8] {
+        let (panicked, audit) = crate::v9_real_consumer_shadow::tests::adaptive_production_path_coverage::
+            run_equilibrium_with_canonical_covered_poison_audit(Some(Poison::DependentCoordinate(index)));
+        assert!(!panicked, "dependent coordinate {index}");
+        let first = audit.solves.first().expect("authentic solve");
+        assert!(first.completed);
+        assert_eq!(
+            first.charged_map_attempt_count, 4,
+            "fresh displaced map, fresh return and fresh stable witness"
+        );
+        assert_eq!(first.history_disposition_count, 2);
+        assert_eq!(first.final_constructor_attempt_count, 1);
+        assert_eq!(first.completed_final_envelope_count, 1);
+        assert_eq!(
+            first.charged_roles[2],
+            (CanonicalCoveredAuditRoleV1::EndpointStabilization(1), 2)
+        );
+        assert_eq!(
+            first.charged_roles[3],
+            (CanonicalCoveredAuditRoleV1::EndpointStabilization(2), 3)
+        );
+        assert_eq!(audit.map_local_publication_attempt_count, 0);
+        assert!(
+            audit
+                .solves
+                .iter()
+                .all(|s| s.charged_map_attempt_count <= 7)
+        );
+    }
+    for poison in [
+        Poison::DependentOscillation,
+        Poison::StabilizationOuterNonclosure,
+    ] {
+        let (audit, rejection) = crate::v9_real_consumer_shadow::tests::adaptive_production_path_coverage::
+        canonical_covered_convergence_poison_fixture_v1(CanonicalCoveredPhysicalParityCaseV1::Ordinary, poison);
+        let (class, _, rollback) = rejection.expect("typed cap rejection");
+        assert_eq!(class, CanonicalCoveredErrorClassV1::AdaptiveRefinement);
+        assert!(
+            rollback,
+            "all real accepted owners, clock and history retain exact bytes"
+        );
+        assert!(!audit.solves.is_empty());
+        for solve in &audit.solves {
+            assert_eq!(solve.charged_map_attempt_count, 7);
+            assert_eq!(solve.final_constructor_attempt_count, 0);
+            assert_eq!(solve.completed_final_envelope_count, 0);
+        }
+        assert_eq!(audit.accepted_parent_publication_count, 0);
+        if poison == Poison::StabilizationOuterNonclosure {
+            let first = audit.solves.first().expect("actual guarded solve");
+            assert_eq!(
+                first.charged_roles[2],
+                (CanonicalCoveredAuditRoleV1::EndpointStabilization(1), 2)
+            );
+            assert_eq!(
+                first.charged_roles[3],
+                (CanonicalCoveredAuditRoleV1::MultisecantAdjudication(2), 3)
+            );
+        }
+    }
+    let (panicked, audit) = crate::v9_real_consumer_shadow::tests::adaptive_production_path_coverage::run_equilibrium_with_canonical_covered_role_audit();
+    assert!(!panicked);
+    assert!(
+        audit
+            .solves
+            .iter()
+            .all(|s| s.charged_map_attempt_count == 2)
+    );
+}
