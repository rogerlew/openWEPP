+                &problem,
+                &probe,
+                context,
+                Some(tie.branches),
+            )
+            .unwrap();
+            assert!(
+                evaluation
+                    .normalized_residuals
+                    .iter()
+                    .all(|r| r.is_finite())
+            );
+            assert_eq!(vapor.rates, tie.rates);
+            assert!(vapor.receipt.is_none());
+            assert!(
