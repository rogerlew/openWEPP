+            || receipt.support_start_ns != id.support_start_ns || receipt.support_end_ns != id.support_end_ns
+            || receipt.receiver_ordinal != id.receiver_ordinal) {
+            return Err(DirectSnowStage3V11AttachmentError::Identity("native allocation event join"));
+        }
+        Ok(())
+    }
