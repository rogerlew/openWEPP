+fn b01_authentic_phase_trial_v1(
+    total_water: f64,
+    authentic_ice: f64,
+    authentic_liquid: f64,
+) -> Result<(f64, f64), DirectV11RealConsumerError> {
+    let authentic_total = authentic_ice + authentic_liquid;
+    if [
+        total_water,
+        authentic_ice,
+        authentic_liquid,
+        authentic_total,
+    ]
+    .iter()
+    .any(|v| !v.is_finite() || *v < 0.0)
+        || (authentic_total == 0.0 && total_water > 0.0)
+    {
+        return Err(DirectV11RealConsumerError::AdaptiveRefinement(
+            "B01 authentic phase trial domain",
+        ));
+    }
+    let ice = if authentic_total == 0.0 {
+        0.0
+    } else {
+        total_water * (authentic_ice / authentic_total)
+    };
+    let liquid = total_water - ice;
+    if !ice.is_finite() || !liquid.is_finite() || ice < 0.0 || liquid < 0.0 {
+        return Err(DirectV11RealConsumerError::AdaptiveRefinement(
+            "B01 authentic phase trial result domain",
+        ));
+    }
+    Ok((ice, liquid))
 }
 
