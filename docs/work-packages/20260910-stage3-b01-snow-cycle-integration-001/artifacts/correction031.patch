+            || event.parent_transaction_id().digest() != id.parent_transaction_sha256
+            || event.tick() != subslab.support.end_ns()
+            || event.ordinal() != id.receiver_ordinal
+            || event.beginning_owner_set_digest() != id.donor_ending_complete_owner_sha256
+            || event.event_context_digest() != id.receiver_context_sha256
+        { return Err(DirectSnowStage3V11AttachmentError::Identity("native support custody subslab/event join")); }
+        event.validate_ledger_entries(&[LedgerEntryV1::new(
+            "native-positive-support-snow-liquid-custody".into(), "kg-m-2-and-j-m-2-ofe-ground".into(),
+            record.publication_sha256, record.publication_sha256, record.receipt_sha256,
+        )?])?;
+        if record.allocation_receipts.iter().any(|receipt|
+            receipt.output_set_sha256 != *id.output_set_sha256.as_bytes()
