+impl Stage3NativeSupportLiquidCustodyV1 {
+    pub(crate) fn publication(&self) -> Result<crate::v9_real_consumer_shadow::native_snow_liquid_publication::NativeSnowLiquidPublicationV1, DirectSnowStage3V11AttachmentError> {
+        crate::v9_real_consumer_shadow::native_snow_liquid_publication::NativeSnowLiquidPublicationV1::from_transport_bytes(&self.publication_bytes)
+            .map_err(|_| DirectSnowStage3V11AttachmentError::Identity("native support custody transport"))
+    }
+    fn validate(&self, subslab: &Stage3CoupledSubslabReceiptV1) -> Result<(), DirectSnowStage3V11AttachmentError> {
+        let record = self.publication()?;
+        let id = &record.identity;
+        let event = &self.receiver_event;
+        let lse_beginning = record.lse_owner_bytes(false).map_err(|_| {
+            DirectSnowStage3V11AttachmentError::Identity("native support LSE owner bytes")
+        })?;
+        event.validate()?;
+        let beginning_digest = openwepp_coupled_time::complete_owner_digest_set_digest(&self.beginning_owner_digests)?;
+        let mut ending_digests = self.beginning_owner_digests.clone();
+        let lse_ending = record.lse_owner_bytes(true).map_err(|_| {
+            DirectSnowStage3V11AttachmentError::Identity("native ending LSE bytes")
+        })?;
+        for (name, beginning, ending) in [
+            ("surface_liquid", digest_bytes(&record.beginning_surface_bytes), digest_bytes(&record.ending_surface_bytes)),
+            ("land_surface_energy", digest_bytes(&lse_beginning), digest_bytes(&lse_ending)),
+        ] {
+            let (_, value) = ending_digests.iter_mut().find(|(key, _)| key == name).ok_or(
+                DirectSnowStage3V11AttachmentError::Identity("native packet missing physical owner"))?;
+            if *value != beginning { return Err(DirectSnowStage3V11AttachmentError::Identity("native packet beginning physical owner")); }
+            *value = ending;
+        }
+        if beginning_digest != event.beginning_owner_set_digest()
+            || openwepp_coupled_time::complete_owner_digest_set_digest(&ending_digests)? != event.ending_owner_set_digest() {
+            return Err(DirectSnowStage3V11AttachmentError::Identity("native packet complete owner transition"));
+        }
+        if subslab.post_support_liquid_receiver_event.is_some()
+            || subslab.post_support_liquid_custody_v2.is_some()
+            || id.parent_transaction_sha256 != subslab.owner_join.parent_transaction_sha256
+            || id.parent_start_ns != subslab.parent_support.start_ns().get()
+            || id.parent_end_ns != subslab.parent_support.end_ns().get()
+            || id.support_start_ns != subslab.support.start_ns().get()
+            || id.support_end_ns != subslab.support.end_ns().get()
+            || id.donor_ending_complete_owner_sha256 != subslab.owner_join.ending_complete_owner_set_sha256
+            || digest_bytes(&record.beginning_surface_bytes) != subslab.owner_join.surface_liquid_owner_sha256
