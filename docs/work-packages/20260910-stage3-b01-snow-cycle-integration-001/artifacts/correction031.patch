+fn native_drain_record_for_history_test(
+    physical:&FrozenLitterV3Resident,exact:&FrozenLitterV4Resident,start:u128,end:u128,finalize:bool,
+)->super::native_snow_liquid_publication::NativeSnowLiquidPublicationV1 {
+    use super::native_snow_liquid_publication::{NativeSnowLiquidPublicationV1,NativeSnowCustodyIdentityV1,NativeSnowCustodyKindV1};
+    use openwepp_coupled_time::{TimeSupport,ModelTimeNs,framed_sha256,FramedField};
+    let mut outputs=Vec::new();
+    if !finalize {
+        let config=physical.surface_configuration().parent();
+        let binding=&config.ofe_bindings[0];
+        let mut output=super::Stage3AcceptedSnowLiquidOutputV1 {
+            support:TimeSupport::new(ModelTimeNs::new(start),ModelTimeNs::new(end)).unwrap(),
+            lane_id:binding.production_lane_id,ofe_id:binding.ofe_id.clone(),
+            topology_sha256:Digest32::from_bytes([1;32]),beginning_snow_owner_sha256:Digest32::from_bytes([2;32]),
+            ending_snow_owner_sha256:Digest32::from_bytes([3;32]),
+            source_receipts_sha256:std::array::from_fn(|i|Digest32::from_bytes([u8::try_from(i+10).unwrap();32])),
+            mass_kg_m2_ofe_ground:0.25,sensible_enthalpy_j_m2_ofe_ground:0.0,
+            destinations:config.records.iter().map(|record|serde_json::from_value(serde_json::json!({
+                "ofe_id":record.key.ofe_id,"tile_id":record.key.tile_id,"tile_fraction":record.tile_fraction,
+                "mass_kg_m2_tile_ground":0.25,"sensible_enthalpy_j_m2_tile_ground":0.0})).unwrap()).collect(),
+            refreeze_kg_m2_ofe_ground:0.0,physical_ledger_receipt_sha256:Digest32::from_bytes([30;32]),
+            receipt_sha256:Digest32::zero(),
+        };
+        output.receipt_sha256=digest_bytes(&serde_json::to_vec(&output).unwrap());
+        output.validate().unwrap();outputs.push(output);
+    }
+    let output_set=if finalize {Digest32::zero()} else {
+        framed_sha256("stage3-v11-positive-support-liquid-output-set",&outputs.iter().map(|output|
+            FramedField{tag:"snow_liquid_output",value:output.receipt_sha256.as_bytes().as_slice()}).collect::<Vec<_>>()).unwrap()
+    };
+    let mut id=NativeSnowCustodyIdentityV1 {policy_id:14,
+        kind:if finalize {NativeSnowCustodyKindV1::ParentFinalization} else {NativeSnowCustodyKindV1::Drain},
+        parent_transaction_sha256:Digest32::from_bytes([40;32]),transaction_id:TransactionId(1),
+        predecessor_transaction_id:None,parent_start_ns:0,parent_end_ns:1_800_000_000_000,
+        support_start_ns:start,support_end_ns:end,receiver_ordinal:0,
+        donor_ending_complete_owner_sha256:Digest32::from_bytes([41;32]),receiver_context_sha256:Digest32::zero(),
+        output_set_sha256:output_set,predecessor_physical_receipt_chain_sha256:physical.predecessor_receipt_chain_sha256().into()};
+    id.receiver_context_sha256=id.expected_receiver_context(&outputs).unwrap();
+    NativeSnowLiquidPublicationV1::try_new(physical.surface_configuration(),physical.lse_configuration(),id, crate::land_surface_energy_shadow::endpoint_fixture().lse_state,
+        physical.lse_state().clone(),physical.surface_owner(),exact.exact_surface_owner().clone(),outputs).unwrap()
+}
