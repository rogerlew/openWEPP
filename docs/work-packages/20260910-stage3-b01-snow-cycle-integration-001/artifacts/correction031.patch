+    physical.accept_native_snow_publication(drain.clone(), &drain.outputs).unwrap();
+    exact.accept_native_snow_publication(&physical, &drain).unwrap();
+    assert!(physical.native_dirty_parent().is_some());
+    let second_phase = execute_runtime_v4_partial_candidate(&physical, &exact, TRANSACTION, 60_000_000_000, 120_000_000_000);
