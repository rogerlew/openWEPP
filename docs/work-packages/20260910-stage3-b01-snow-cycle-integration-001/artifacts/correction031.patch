+    let index = trial.len().checked_sub(soil_node_count + 1).ok_or(
+        LandSurfaceEnergyShadowError::Identity("V3 covered warm-start layout"),
+    )?;
+    let value = trial
+        .get_mut(index)
+        .ok_or(LandSurfaceEnergyShadowError::Identity(
+            "V3 covered ground warm start",
+        ))?;
+    *value = temperature_k;
+    Ok(trial)
+}
