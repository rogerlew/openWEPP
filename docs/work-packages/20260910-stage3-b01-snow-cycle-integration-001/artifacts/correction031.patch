+fn consume_native_positive_support_snow_liquid_v1(
+    context: &DirectSnowStage3V11StaticContext,
+    parent: &mut V11ParentTransaction,
+    consumer: &mut DirectV10RealConsumerShadow,
+    clock: &mut CoupledClockStateV1,
+    support: TimeSupport,
+    support_ending_owner: Digest32,
+    terminal_lanes: &BTreeSet<u32>,
+) -> Result<Option<Stage3NativeSupportLiquidCustodyV1>, DirectSnowStage3V11AttachmentError> {
+    if clock.accepted_until() != support.end_ns()
+        || complete_owner_set_digest(clock.owners())? != support_ending_owner {
+        return Err(support_liquid_transition_error("native receiver clock predecessor"));
+    }
+    let Some((mut candidate, record)) = consumer.prepare_native_support_liquid_receiver(
+        clock.parent_transaction_id().digest(), clock.parent_support(), support,
+        support_ending_owner, clock.event_ordinal(), terminal_lanes,
+    ).map_err(DirectSnowStage3V11AttachmentError::Owner)? else { return Ok(None); };
+    let beginning_lse_bytes = consumer.canonical_v11_lse_owner_bytes()
+        .map_err(|_| support_liquid_transition_error("native receiver LSE beginning"))?;
+    if clock.owners().iter().find(|owner| owner.owner_id() == "surface_liquid")
+        .is_none_or(|owner| owner.state_bytes() != record.beginning_surface_bytes)
+        || clock.owners().iter().find(|owner| owner.owner_id() == "land_surface_energy")
+        .is_none_or(|owner| owner.state_bytes() != beginning_lse_bytes) {
+        if crate::snow_accuracy_observer::physical_global_enabled() {
+            crate::snow_accuracy_observer::record(serde_json::json!({
+                "kind":"native_receiver_owner_join_rejection", "support":support,
+                "native_publication":record,
+                "expected_native_lse_bytes":String::from_utf8_lossy(&beginning_lse_bytes),
+                "clock_surface_bytes":clock.owners().iter().find(|owner| owner.owner_id()=="surface_liquid")
+                    .map(|owner| String::from_utf8_lossy(owner.state_bytes()).into_owned()),
+                "clock_lse_bytes":clock.owners().iter().find(|owner| owner.owner_id()=="land_surface_energy")
+                    .map(|owner| String::from_utf8_lossy(owner.state_bytes()).into_owned()),
+            }));
+        }
+        return Err(support_liquid_transition_error("native receiver actual owner bytes"));
+    }
+    let lse_bytes = candidate.canonical_v11_lse_owner_bytes()
+        .map_err(|_| support_liquid_transition_error("native receiver LSE ending"))?;
+    let ending_owners = clock.owners().iter().map(|owner| match owner.owner_id() {
+        "surface_liquid" => OwnerState::new("surface_liquid".into(), record.ending_surface_bytes.clone()),
+        "land_surface_energy" => OwnerState::new("land_surface_energy".into(), lse_bytes.clone()),
+        _ => Ok(owner.clone()),
+    }).collect::<Result<Vec<_>, _>>()?;
+    let mutations = clock.owners().iter().zip(&ending_owners).filter_map(|(before, after)|
+        (before != after).then(|| before.owner_id().to_owned())).collect::<Vec<_>>();
+    let event = EventProposalV1::new(EventClass::OwnershipTransfer, "snow".into(),
+        record.identity.receiver_context_sha256, ending_owners.clone(), mutations.clone(),
+        "snow-stage3-v11".into(), clock.active_participants().to_vec(), vec![LedgerEntryV1::new(
+            "native-positive-support-snow-liquid-custody".into(), "kg-m-2-and-j-m-2-ofe-ground".into(),
+            record.publication_sha256, record.publication_sha256, record.receipt_sha256,
+        )?])?;
+    let mut candidate_clock = clock.clone();
+    let mut queue = EventQueueV1::new(support.end_ns(), vec![event])?;
+    let accepted = queue.apply_next(&mut candidate_clock)?.ok_or(
+        support_liquid_transition_error("native receiver event application"))?;
+    if queue.apply_next(&mut candidate_clock)?.is_some()
+        || accepted.beginning_owner_set_digest() != support_ending_owner {
+        return Err(support_liquid_transition_error("native receiver event chronology"));
+    }
+    let mut candidate_parent = parent.clone();
+    let envelopes = owner_envelopes_from_states(&ending_owners)?;
+    if mutations.is_empty() {
+        candidate_parent.accept_zero_duration_custody_noop(&context.vegetation_configuration,
+            support.end_ns(), envelopes, record.receipt_sha256)?;
+    } else {
+        candidate_parent.accept_zero_duration_owner_transition(&context.vegetation_configuration,
+            support.end_ns(), envelopes, &mutations)?;
+    }
+    candidate.retain_accepted_publication_zero_duration_event(&accepted)?;
+    let physical = candidate.frozen_litter_v3_resident().ok_or(
+        support_liquid_transition_error("native receiver ending resident"))?;
+    let publication_bytes = record.canonical_bytes(physical.surface_configuration(), physical.lse_configuration())
+        .map_err(|_| support_liquid_transition_error("native receiver canonical publication"))?;
+    let beginning_owner_digests = clock.owners().iter().map(|owner|
+        (owner.owner_id().to_owned(), owner.state_digest())).collect();
+    *consumer = candidate; *parent = candidate_parent; *clock = candidate_clock;
+    Ok(Some(Stage3NativeSupportLiquidCustodyV1 { beginning_owner_digests, receiver_event: accepted, publication_bytes }))
+}
