+#[test]
+fn native_composite_owner_preserves_roles_and_refuses_component_poisons() {
+    use crate::v9_real_consumer_shadow::composite_lse_owner::{composite_lse_bytes, CompositeLseOwnerV1};
+    let fixture = exact_surface_topology_fixture(&["ofe-1".into()]);
+    let active = endpoint_fixture().lse_state;
+    let bytes = composite_lse_bytes(&active, &fixture.lse_state, &fixture.exact_owner).unwrap();
+    CompositeLseOwnerV1::from_canonical_bytes(&bytes).unwrap();
+    let value: serde_json::Value = serde_json::from_slice(&bytes).unwrap();
+    for key in ["active_covered_runtime_lse_v1", "native_litter_lse_v3", "native_exact_surface_enthalpy_v4"] {
+        let mut poison = value.clone();
+        poison.as_object_mut().unwrap().remove(key);
+        assert!(CompositeLseOwnerV1::from_canonical_bytes(&serde_json::to_vec(&poison).unwrap()).is_err());
+    }
+    for (key, bad) in [("policy_id", serde_json::json!(13)), ("schema", serde_json::json!("foreign")),
+        ("active_covered_sha256", serde_json::json!(vec![0; 32]))] {
+        let mut poison = value.clone(); poison[key] = bad;
+        assert!(CompositeLseOwnerV1::from_canonical_bytes(&serde_json::to_vec(&poison).unwrap()).is_err());
+    }
+    let mut poison = value.clone();
+    poison["active_covered_runtime_lse_v1"] = value["native_litter_lse_v3"].clone();
+    poison["native_litter_lse_v3"] = value["active_covered_runtime_lse_v1"].clone();
+    assert!(CompositeLseOwnerV1::from_canonical_bytes(&serde_json::to_vec(&poison).unwrap()).is_err());
+    assert!(CompositeLseOwnerV1::from_canonical_bytes(&serde_json::to_vec(&active).unwrap()).is_err());
+    let mut changed = active.clone();
+    changed.tiles[0].surface_enthalpy_j_m2_tile_ground += 1.0;
+    assert!(composite_lse_bytes(&changed, &fixture.lse_state, &fixture.exact_owner).is_err());
+    changed.state_sha256 = changed.canonical_sha256().unwrap();
+    let changed_bytes = composite_lse_bytes(&changed, &fixture.lse_state, &fixture.exact_owner).unwrap();
+    assert_ne!(bytes, changed_bytes);
+    let after: serde_json::Value = serde_json::from_slice(&changed_bytes).unwrap();
+    assert_eq!(value["native_litter_lse_v3"], after["native_litter_lse_v3"]);
+    assert_eq!(value["native_exact_surface_enthalpy_v4"], after["native_exact_surface_enthalpy_v4"]);
+}
