+#[test]
+fn native_donor_summary_keeps_vector_seal_and_receipt_sorted_arithmetic() {
+    use super::native_snow_liquid_publication::positive_support_output_summary_v1;
+    let (physical, exact) = v4_resident_fixture();
+    let template = native_drain_record_for_history_test(&physical, &exact, 0, 60_000_000_000, false).outputs[0].clone();
+    let mut outputs = Vec::new();
+    for (index, mass) in [1.0, 2.0_f64.powi(-53), 2.0_f64.powi(-53)].into_iter().enumerate() {
+        let mut output = template.clone();
+        output.lane_id = index as u32 + 1;
+        let (destinations, mass, energy) = super::v11_covered::physical_outcome_ledger::seal_destination_liquid_outcomes_v1(
+            &output.ofe_id, [(&output.destinations[0].tile_id, 1.0)], mass, mass * 4218.0).unwrap();
+        output.destinations = destinations;
+        output.mass_kg_m2_ofe_ground = mass;
+        output.sensible_enthalpy_j_m2_ofe_ground = energy;
+        output.receipt_sha256 = output.digest().unwrap();
+        output.validate().unwrap();
+        outputs.push(output);
+    }
+    let summarize = |values: &[super::Stage3AcceptedSnowLiquidOutputV1]| positive_support_output_summary_v1(values, 0, 60_000_000_000).unwrap();
+    let original = summarize(&outputs);
+    let mut sorted = outputs.clone();
+    sorted.sort_by_key(|output| *output.receipt_sha256.as_bytes());
+    let expected_mass = sorted.iter().fold(0.0_f64, |sum, output| sum + output.mass_kg_m2_ofe_ground);
+    let expected_energy = sorted.iter().fold(0.0_f64, |sum, output| sum + output.sensible_enthalpy_j_m2_ofe_ground);
+    assert_eq!(original.1.to_bits(), expected_mass.to_bits());
+    assert_eq!(original.2.to_bits(), expected_energy.to_bits());
+    outputs.reverse();
+    let reversed = summarize(&outputs);
+    assert_ne!(original.0, reversed.0);
+    assert_eq!(original.1.to_bits(), reversed.1.to_bits());
+    assert_eq!(original.2.to_bits(), reversed.2.to_bits());
+    assert_ne!(original.0, summarize(&outputs[..2]).0);
+    assert!(positive_support_output_summary_v1(&[outputs[0].clone(), outputs[0].clone()], 0, 60_000_000_000).is_err());
+    assert!(positive_support_output_summary_v1(&outputs, 60_000_000_000, 120_000_000_000).is_err());
+    // A different vector sum is deliberately present; shared summary order,
+    // not accidental equality for uniform lanes, establishes the context.
+    let large_first = [1.0_f64, 2.0_f64.powi(-53), 2.0_f64.powi(-53)].into_iter().fold(0.0, |a,b| a+b);
+    let large_last = [2.0_f64.powi(-53), 2.0_f64.powi(-53), 1.0_f64].into_iter().fold(0.0, |a,b| a+b);
+    assert_ne!(large_first.to_bits(), large_last.to_bits());
+}
