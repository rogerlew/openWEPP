+// INV-SNOWENERGY-083/087 and INV-SURFACELIQUID-035: a wholly
+// inactive native parent has no physical WB14 parent receipt to finalize.
+// Callers retain full subslab validation, including exact owner/slab joins.
+fn wb14_parent_finalization_custody_is_valid_v1(
+    parent_support: TimeSupport,
+    support: TimeSupport,
+    parent_replay_is_present: bool,
+    parent_digest_is_present: bool,
+    child_bytes: &[u8],
+    topology: &[OfeId],
+) -> Result<bool, DirectSnowStage3V11AttachmentError> {
