+            && binding.parent_support_end_ns == parent_support.end_ns().get()
+            && binding.child_support_start_ns >= support.start_ns().get()
+            && binding.child_support_end_ns == support.end_ns().get())
+    } else {
+        Ok(parent_replay_is_present == parent_digest_is_present
+            && wb14_parent_finalization_placement_is_valid_v1(parent_support, support, parent_replay_is_present))
+    }
