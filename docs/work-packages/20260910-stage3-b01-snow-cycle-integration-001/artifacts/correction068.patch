+
+/// Explicit admission selected by the enclosing native workflow, never by payload posture.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum ScientificAdmission { Ordinary, NativeB01 }
+impl ScientificAdmission {
+    pub(crate) fn validate(self) -> Result<(), RestartAdmissionFailureV1> {
+        if self == Self::NativeB01
+            && openwepp_land_surface_energy::snow_accuracy_policy::Policy::current().identity() != Some(14) {
+            return Err(RestartAdmissionFailureV1::Schema);
+        }
+        Ok(())
+    }
+}
+#[derive(Clone, Debug, Deserialize, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct NativeSoilResidentRestartV1 {
+    pub schema: String,
+    pub resident: DirectV10SoilThermalResidentV2,
+}
+impl ScientificOwnerStateSetV1 {
+    pub(crate) fn validate_soil_posture(&self, admission: ScientificAdmission) -> Result<(), RestartAdmissionFailureV1> {
+        admission.validate()?;
+        match (&self.soil_thermal, &self.native_soil) {
+            (Some(_), None) => Ok(()),
+            (None, Some(native)) if admission == ScientificAdmission::NativeB01
+                && native.schema == "OPENWEPP_B01_NATIVE_SOIL_RESIDENT_V1_POLICY14" =>
+                DirectSoilThermalResident::V2(native.resident.clone()).validate().map_err(|_| RestartAdmissionFailureV1::OwnerValidation),
+            _ => Err(RestartAdmissionFailureV1::OwnerOmission),
+        }
+    }
+    pub(crate) fn soil_layer_maps(&self, admission: ScientificAdmission) -> Result<Vec<(String, Vec<String>)>, RestartAdmissionFailureV1> {
+        self.validate_soil_posture(admission)?;
+        if let Some(v1) = &self.soil_thermal {
+            return Ok(v1.ofes.iter().map(|ofe| (ofe.ofe_id.clone(), ofe.ordered_layers.iter().map(|layer| layer.layer_id.clone()).collect())).collect());
+        }
+        let native = self.native_soil.as_ref().ok_or(RestartAdmissionFailureV1::OwnerOmission)?;
+        Ok(native.resident.owner().state.ofes.iter().map(|ofe| (ofe.ofe_id.as_str().to_owned(),
+            ofe.ordered_layers.iter().map(|layer| layer.layer_id.as_str().to_owned()).collect())).collect())
+    }
+}
