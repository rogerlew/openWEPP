+//! Isolated policy14 native custody disposition; never an ordinary phase checkpoint.
+use openwepp_hillslope_orchestrator::{LseSurfaceEnthalpyOwnerEnvelopeV1,
+    SurfaceLiquidConfigurationV2, SurfaceLiquidOwnerEnvelopeV2,
+    snow_stage3_v11_attachment::DirectSnowStage3V11ShadowAttachment,
+    v9_real_consumer_shadow::{DirectV10RealConsumerShadow, FrozenLitterV3Resident, FrozenLitterV4Resident}};
+use openwepp_land_surface_energy::{LandSurfaceEnergyConfiguration, LandSurfaceEnergyState,
+    LandSurfaceEnergyV3State, Sha256Digest};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest as _, Sha256};
+use crate::{DirectSnowStage3V11AttachmentRestartV3, ExpectedSnowStage3V11RestartContext,
+    ExpectedStage3CommittedDayArchiveV3, Sha256Hex, SnowStage3V11RestartError as Error,
+    from_canonical_bytes, to_canonical_bytes};
+use crate::snow_stage3_v11::{SnowStage3V11ExactResidentPositionV4 as Position,
+    SnowStage3V11ExactResidentRestorerV4};
+
+const SCHEMA: &str = "OPENWEPP_B01_NATIVE_CUSTODY_RESTART_V1_POLICY14";
+
+/// All anchors come from the authenticated run beginning, not checkpoint bytes.
+pub struct ExpectedNativeCustodyContextV1<'a> {
+    pub lse_configuration: &'a LandSurfaceEnergyConfiguration,
+    pub surface_configuration: &'a SurfaceLiquidConfigurationV2,
+    pub adoption_lse_sha256: &'a Sha256Digest,
+    pub adoption_exact: &'a LseSurfaceEnthalpyOwnerEnvelopeV1,
+    pub expected_laned_active: &'a Option<Box<openwepp_hillslope_orchestrator::DirectLanedActiveConfig>>,
+    pub adoption_surface_sha256: &'a str,
+}
+
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NativeCustodyResidentV1 {
+    laned_active: Option<Box<openwepp_hillslope_orchestrator::DirectLanedActiveConfig>>,
+    laned_active_summary: Option<Box<openwepp_hillslope_orchestrator::DirectLanedActiveRunSummary>>,
+    active_covered_lse: LandSurfaceEnergyState,
+    native_lse: LandSurfaceEnergyV3State,
+    native_surface_bytes: Vec<u8>,
+    native_exact: LseSurfaceEnthalpyOwnerEnvelopeV1,
+    physical_history: Vec<Vec<u8>>,
+    exact_history: Vec<Vec<u8>>,
+    wb14_parent_bytes: Option<Vec<u8>>,
+    physical_receipt_chain_sha256: String,
+    adoption_lse_sha256: Sha256Digest,
+}
+
+fn nested(error: impl std::fmt::Display) -> Error { Error::Nested(error.to_string()) }
+fn sha(bytes: &[u8]) -> Result<Sha256Hex, Error> {
+    Sha256Hex::try_new(format!("{:x}", Sha256::digest(bytes))).map_err(nested)
+}
+
+impl NativeCustodyResidentV1 {
+    fn project(consumer: &DirectV10RealConsumerShadow, context: &ExpectedNativeCustodyContextV1<'_>) -> Result<Self, Error> {
+        consumer.restart_authority_validate_native_composite().map_err(nested)?;
+        let physical = consumer.frozen_litter_v3_resident().ok_or(Error::Identity("native physical resident"))?;
+        let exact = consumer.frozen_litter_v4_resident().ok_or(Error::Identity("native exact resident"))?;
+        if physical.lse_configuration() != context.lse_configuration
+            || physical.surface_configuration() != context.surface_configuration
+            || exact.restart_authority_native_adoption_lse_sha256() != context.adoption_lse_sha256 {
+            return Err(Error::Identity("native external configuration/adoption"));
+        }
+        physical.restart_authority_validate_native_adoption(context.adoption_lse_sha256.as_str(), context.adoption_surface_sha256).map_err(nested)?;
+        exact.restart_authority_validate_native_exact_adoption(physical, context.adoption_exact).map_err(nested)?;
+        if &consumer.hydrology_frame().laned_active != context.expected_laned_active {
+            return Err(Error::Identity("native nested routing external configuration"));
+        }
+        Ok(Self {
+            laned_active: consumer.hydrology_frame().laned_active.clone(),
+            laned_active_summary: consumer.hydrology_frame().laned_active_summary.clone(),
+            active_covered_lse: consumer.restart_authority_active_covered_lse().clone(),
+            native_lse: physical.lse_state().clone(),
+            native_surface_bytes: physical.surface_owner().canonical_bytes(context.surface_configuration.parent(), Some(context.surface_configuration)).map_err(nested)?,
+            native_exact: exact.exact_surface_owner().clone(),
+            physical_history: physical.accepted_publication_supports_canonical_bytes().map_err(nested)?,
+            exact_history: exact.accepted_publication_supports_canonical_bytes().to_vec(),
+            wb14_parent_bytes: physical.restart_wb14_parent_working_state_bytes().map_err(nested)?,
+            physical_receipt_chain_sha256: physical.restart_authority_native_receipt_chain().into(),
+            adoption_lse_sha256: context.adoption_lse_sha256.clone(),
+        })
+    }
+
+    fn install(&self, consumer: &mut DirectV10RealConsumerShadow, context: &ExpectedNativeCustodyContextV1<'_>) -> Result<(), Error> {
+        if self.adoption_lse_sha256 != *context.adoption_lse_sha256
+            || consumer.restart_authority_active_covered_lse() != &self.active_covered_lse {
+            return Err(Error::Identity("native adoption/active base owner"));
+        }
+        let owner = SurfaceLiquidOwnerEnvelopeV2::from_canonical_bytes(context.surface_configuration.parent(),
+            Some(context.surface_configuration), &self.native_surface_bytes).map_err(nested)?;
+        if owner.v2_state().is_none() { return Err(Error::Identity("native restart surface downgrade")); }
+        let mut physical = FrozenLitterV3Resident::try_new(context.lse_configuration.clone(), self.native_lse.clone(),
+            context.surface_configuration.clone(), owner).map_err(nested)?;
+        physical.restore_restart_authority(&self.physical_history, self.wb14_parent_bytes.as_deref(),
+            &self.physical_receipt_chain_sha256).map_err(nested)?;
+        physical.restart_authority_validate_native_adoption(context.adoption_lse_sha256.as_str(), context.adoption_surface_sha256).map_err(nested)?;
+        let exact = FrozenLitterV4Resident::try_restore(&physical, self.native_exact.clone(), &self.exact_history,
+            context.adoption_lse_sha256).map_err(nested)?;
+        exact.restart_authority_validate_native_exact_adoption(&physical, context.adoption_exact).map_err(nested)?;
+        let mut candidate = consumer.clone();
+        candidate.install_restored_frozen_litter_v4_residents(physical, exact).map_err(nested)?;
+        candidate.restart_authority_install_native_routing(self.laned_active.clone(), self.laned_active_summary.clone(), context.expected_laned_active).map_err(nested)?;
+        candidate.restart_authority_validate_native_composite().map_err(nested)?;
+        if Self::project(&candidate, context)? != *self { return Err(Error::Identity("native resident reprojection")); }
+        *consumer = candidate;
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NativeCustodyResidentSetV1 {
+    committed: NativeCustodyResidentV1,
+    pending_candidate: Option<NativeCustodyResidentV1>,
+    in_progress_day_candidate: Option<NativeCustodyResidentV1>,
+    in_progress_support_current: Option<NativeCustodyResidentV1>,
+}
+impl NativeCustodyResidentSetV1 {
+    fn project(value: &DirectSnowStage3V11ShadowAttachment, context: &ExpectedNativeCustodyContextV1<'_>) -> Result<Self, Error> {
+        let progress = value.restart_authority_in_progress_execution_v2();
+        Ok(Self {
+            committed: NativeCustodyResidentV1::project(&value.committed.real_consumer, context)?,
+            pending_candidate: value.restart_authority_pending_candidate().map(|v| NativeCustodyResidentV1::project(&v.ending_state.real_consumer, context)).transpose()?,
+            in_progress_day_candidate: progress.map(|v| NativeCustodyResidentV1::project(&v.day_candidate().real_consumer, context)).transpose()?,
+            in_progress_support_current: progress.map(|v| NativeCustodyResidentV1::project(
+                &v.support_current().ok_or(Error::Identity("native in-progress current missing"))?.real_consumer, context)).transpose()?,
+        })
+    }
+    fn select(&self, position: Position) -> Result<&NativeCustodyResidentV1, Error> {
+        match position {
+            Position::Committed => Some(&self.committed),
+            Position::PendingCandidate => self.pending_candidate.as_ref(),
+            Position::InProgressDayCandidate => self.in_progress_day_candidate.as_ref(),
+            Position::InProgressSupportCurrent => self.in_progress_support_current.as_ref(),
+        }.ok_or(Error::Identity("native resident checkpoint posture"))
+    }
+}
+fn validate_native_snow_chronology(
+    values: &openwepp_hillslope_orchestrator::snow_stage3_v11_attachment::SnowStage3V11SnowEnthalpyMaterialResidentSetV1,
+) -> Result<(), Error> {
+    for value in std::iter::once(&values.committed)
+        .chain(values.pending_candidate.iter())
+        .chain(values.in_progress_day_candidate.iter())
+        .chain(values.in_progress_support_current.iter()) {
+        if value.current_owner.is_none() != value.accepted_owner_chronology.is_empty() {
+            return Err(Error::Identity("native snow compound owner/chronology posture"));
+        }
+        if let Some(first) = value.accepted_owner_chronology.first() {
+            first.validate().map_err(nested)?;
+            if first.receipt().predecessor_transaction_id().is_some()
+                || first.receipt().predecessor_receipt_chain_sha256() != openwepp_coupled_time::Digest32::zero() {
+                return Err(Error::Identity("native snow truncated initial chronology"));
+            }
+        }
+    }
+    Ok(())
+}
+
+struct Installer<'a, 'b> { values: &'a NativeCustodyResidentSetV1, context: &'a ExpectedNativeCustodyContextV1<'b> }
+impl SnowStage3V11ExactResidentRestorerV4 for Installer<'_, '_> {
+    fn scientific_admission(&self) -> crate::checkpoint::ScientificAdmission { crate::checkpoint::ScientificAdmission::NativeB01 }
+    fn validated_native_surface_bytes(&self, position: Position) -> Result<Option<Vec<u8>>, Error> {
+        let bytes = &self.values.select(position)?.native_surface_bytes;
+        let configuration = self.context.surface_configuration;
+        let owner = SurfaceLiquidOwnerEnvelopeV2::from_canonical_bytes(configuration.parent(),
+            Some(configuration), bytes).map_err(nested)?;
+        if owner.v2_state().is_none() { return Err(Error::Identity("native clock surface downgrade")); }
+        let canonical = owner.canonical_bytes(configuration.parent(), Some(configuration)).map_err(nested)?;
+        if canonical != *bytes { return Err(Error::Identity("native clock surface noncanonical")); }
+        Ok(Some(canonical))
+    }
+    fn restore_exact_resident(&self, position: Position, consumer: &mut DirectV10RealConsumerShadow) -> Result<(), Error> {
+        self.values.select(position)?.install(consumer, self.context)
+    }
+}
