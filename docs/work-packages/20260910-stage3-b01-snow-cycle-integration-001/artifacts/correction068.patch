+fn retained_snow_liquid_outputs_v1<'a>(
+    retained: impl IntoIterator<Item = (TimeSupport, &'a [Stage3AcceptedSnowLiquidOutputV1])>,
+    support: TimeSupport,
+) -> Result<Vec<Stage3AcceptedSnowLiquidOutputV1>, DirectV11RealConsumerError> {
+    let mut matching = retained.into_iter().filter(|(bounds, _)| *bounds == support);
+    let (_, outputs) = matching.next().ok_or(DirectV11RealConsumerError::Identity("native retained donor support missing"))?;
+    if matching.next().is_some() {
+        return Err(DirectV11RealConsumerError::Identity("native retained donor support duplicate"));
+    }
+    for output in outputs {
+        output.validate()?;
+        if output.support != support {
+            return Err(DirectV11RealConsumerError::Identity("native retained donor output support"));
+        }
+    }
+    Ok(outputs.iter().filter(|output| output.mass_kg_m2_ofe_ground() > 0.0).cloned().collect())
