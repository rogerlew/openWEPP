+
+fn refresh_native_snow_exchange(boundary: &mut Stage3SnowCoveredLowerBoundary) -> Result<(), DirectV11RealConsumerError> {
+    if boundary.native_snow_exchange.is_none() { return Ok(()); }
+    let mut candidate = boundary.clone();
+    if let Some(exchange) = candidate.native_snow_exchange.as_mut() {
+        let temperature = TemperatureCelsius::try_new(candidate.snow_temperature_k - 273.15)
+            .map_err(|_| DirectV11RealConsumerError::Identity("native snow saturation temperature"))?;
+        let pressure = openwepp_meteorology::surface_energy::saturation_vapor_pressure_snobal_pa(temperature)
+            .map_err(|_| DirectV11RealConsumerError::Identity("native snow saturation law"))?.as_pascals();
+        if !exchange.pressure_pa.is_finite() || exchange.pressure_pa <= 0.378 * pressure {
+            return Err(DirectV11RealConsumerError::Identity("native snow saturation pressure"));
+        }
+        exchange.snow_temperature_k = candidate.snow_temperature_k;
+        exchange.snow_saturation_specific_humidity = 0.622 * pressure / (exchange.pressure_pa - 0.378 * pressure);
+        exchange.payload_sha256 = exchange.reconstructed_sha256()
+            .map_err(|_| DirectV11RealConsumerError::Identity("native snow exchange seal"))?;
+    }
+    if candidate.snow_temperature_k < 200.0 && covered_boundary_only_cold_temperature_is_refinable_v1(&candidate) {
+        // Validation-only probe distinguishes a sole cold-domain failure. It
+        // is never installed, returned as an owner, or evaluated physically.
+        let mut probe = candidate.clone();
+        probe.snow_temperature_k = 200.0;
+        if let Some(exchange) = probe.native_snow_exchange.as_mut() {
+            exchange.snow_temperature_k = 200.0;
+            exchange.payload_sha256 = exchange.reconstructed_sha256()
+                .map_err(|_| DirectV11RealConsumerError::Identity("native cold classification seal"))?;
+        }
+        if probe.validate().is_ok() {
+            return Err(DirectV11RealConsumerError::AdaptiveRefinement("covered Stage-3 lower-boundary temperature below constitutive domain"));
+        }
+    }
+    candidate.validate().map_err(|_| DirectV11RealConsumerError::Identity("native snow exchange domain"))?;
+    *boundary = candidate;
+    Ok(())
+}
