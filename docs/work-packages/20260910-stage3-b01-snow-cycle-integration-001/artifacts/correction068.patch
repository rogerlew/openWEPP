+
+/// Explicit isolated native-custody state. Publication buffering and output prefixes
+/// remain the responsibility of the enclosing persisted workflow.
+#[derive(Clone, Debug, Deserialize, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct DirectHydrologyNativeCustodyRestartV1 {
+    schema: String,
+    policy_id: u8,
+    parent_v1_bytes: Vec<u8>,
+    parent_v1_sha256: Sha256Hex,
+    native_stage3: crate::DirectNativeCustodyStage3RestartV1,
+    laned_active: Option<Box<openwepp_hillslope_orchestrator::DirectLanedActiveConfig>>,
+    laned_active_summary: Option<Box<openwepp_hillslope_orchestrator::DirectLanedActiveRunSummary>>,
+    payload_sha256: Sha256Hex,
+}
+
+pub struct ExpectedDirectHydrologyNativeCustodyContextV1<'a> {
+    pub hydrology: &'a ExpectedDirectHydrologyRestartContext<'a>,
+    pub stage3: &'a crate::ExpectedSnowStage3V11RestartContext<'a>,
+    pub archive: &'a ExpectedStage3CommittedDayArchiveV3<'a>,
+    pub native: &'a crate::ExpectedNativeCustodyContextV1<'a>,
+    pub expected_laned_active: &'a Option<Box<openwepp_hillslope_orchestrator::DirectLanedActiveConfig>>,
+}
+
+impl DirectHydrologyNativeCustodyRestartV1 {
+    const SCHEMA: &'static str = "OPENWEPP_B01_HYDROLOGY_NATIVE_CUSTODY_RESTART_V1_POLICY14";
+    pub fn project(value: &DirectRunFrame, phase_plan_sha256: Sha256Hex, day_input_digests: &[Sha256Hex],
+        archive: &ExpectedStage3CommittedDayArchiveV3<'_>, native: &crate::ExpectedNativeCustodyContextV1<'_>,
+    ) -> Result<Self, HydrologyRestartError> {
+        let mut base = value.clone();
+        let laned_active = base.laned_active.take();
+        let laned_active_summary = base.laned_active_summary.take();
+        if let Some(attachment) = base.snow_stage3_v11_attachment.as_deref() {
+            base.snow_stage3_v11_attachment = Some(Box::new(attachment.restart_authority_native_without_routing().map_err(nested)?));
+        }
+        let parent = DirectHydrologyRestartV1::project_for_native_parent(&base, phase_plan_sha256.clone(), day_input_digests)?;
+        let attachment = value.snow_stage3_v11_attachment.as_deref().ok_or(HydrologyRestartError::Join("native checkpoint Stage3 missing"))?;
+        let native_stage3 = crate::DirectNativeCustodyStage3RestartV1::project(attachment, &phase_plan_sha256,
+            day_input_digests, archive, native).map_err(nested)?;
+        let bytes = crate::to_canonical_bytes(&parent).map_err(nested)?;
+        let mut result = Self {schema: Self::SCHEMA.into(), policy_id: 14, parent_v1_sha256: restart_sha(&bytes)?,
+            parent_v1_bytes: bytes, native_stage3, laned_active, laned_active_summary, payload_sha256: restart_zero_sha()?};
+        result.payload_sha256 = result.digest()?;
+        Ok(result)
+    }
+    fn digest(&self) -> Result<Sha256Hex, HydrologyRestartError> {
+        restart_sha(&crate::to_canonical_bytes(&(&self.schema, self.policy_id, &self.parent_v1_bytes,
+            &self.parent_v1_sha256, &self.native_stage3, &self.laned_active, &self.laned_active_summary)).map_err(nested)?)
+    }
+    pub fn restore(&self, context: &ExpectedDirectHydrologyNativeCustodyContextV1<'_>) -> Result<DirectRunFrame, HydrologyRestartError> {
+        if self.schema != Self::SCHEMA || self.policy_id != 14
+            || self.parent_v1_sha256 != restart_sha(&self.parent_v1_bytes)? || self.payload_sha256 != self.digest()? {
+            return Err(HydrologyRestartError::Join("native hydrology schema/policy/payload"));
+        }
+        validate_stage3_restart_contexts(context.hydrology, context.stage3)?;
+        let parent: DirectHydrologyRestartV1 = crate::from_canonical_bytes(&self.parent_v1_bytes).map_err(nested)?;
+        if crate::to_canonical_bytes(&parent).map_err(nested)? != self.parent_v1_bytes {
+            return Err(HydrologyRestartError::Join("native hydrology canonical parent"));
+        }
+        let active = parent.snow_stage3_v11_attachment.as_deref().ok_or(HydrologyRestartError::Join("native parent Stage3 posture"))?
+            .to_canonical_bytes().map_err(nested)?;
+        require_exact_parent_stage3_join(&active, &self.native_stage3.nested_active_v2_bytes().map_err(nested)?)?;
+        let mut frame = parent.restore_without_stage3(context.hydrology)?;
+        let attachment = self.native_stage3.restore(context.stage3, context.archive, context.native).map_err(nested)?;
+        if frame.lanes.iter().map(|lane| lane.lane_id).collect::<Vec<_>>() != attachment.static_context.lane_ids {
+            return Err(HydrologyRestartError::Join("native hydrology Stage3 topology"));
+        }
+        if frame.identity != attachment.committed.real_consumer.hydrology_frame().identity {
+            return Err(HydrologyRestartError::Join("native hydrology complete run identity"));
+        }
+        if &self.laned_active != context.expected_laned_active {
+            return Err(HydrologyRestartError::Join("native active routing external configuration"));
+        }
+        let next_day = attachment.committed.real_consumer.v11_next_day_index();
+        match (&self.laned_active, &self.laned_active_summary) {
+            (Some(config), summary) => {
+                config.validate(frame.identity.lane_count).map_err(nested)?;
+                if let Some(summary) = summary {
+                    if summary.mesh_policy != config.mesh_policy.summary() || summary.max_dt_s != config.max_dt_s
+                        || summary.days_seen != next_day as u64 || summary.days_routed > summary.days_seen {
+                        return Err(HydrologyRestartError::Join("native active routing summary/configuration/cursor"));
+                    }
+                } else if next_day != 0 { return Err(HydrologyRestartError::Join("native active routing summary missing")); }
+            }
+            (None, Some(_)) => return Err(HydrologyRestartError::Join("native inactive routing summary")),
+            (None, None) => {}
+        }
+        frame.laned_active = self.laned_active.clone();
+        frame.laned_active_summary = self.laned_active_summary.clone();
+        frame.snow_stage3_v11_attachment = Some(Box::new(attachment));
+        Ok(frame)
+    }
+    pub fn to_canonical_bytes(&self) -> Result<Vec<u8>, HydrologyRestartError> {
+        crate::to_canonical_bytes(self).map_err(nested)
+    }
+    pub fn from_canonical_bytes(bytes: &[u8], context: &ExpectedDirectHydrologyNativeCustodyContextV1<'_>) -> Result<Self, HydrologyRestartError> {
+        let value: Self = crate::from_canonical_bytes(bytes).map_err(nested)?;
+        if value.to_canonical_bytes()? != bytes { return Err(HydrologyRestartError::Join("native hydrology canonical bytes")); }
+        value.restore(context)?;
+        Ok(value)
+    }
+}
