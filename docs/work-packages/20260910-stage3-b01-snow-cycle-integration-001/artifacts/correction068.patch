+#[derive(Clone, Copy, PartialEq, Eq)]
+enum NativeSurfaceClockView { Complete, NativeV2 }
+fn native_surface_clock_view(bytes: &[u8]) -> Result<NativeSurfaceClockView, SnowStage3V11RestartError> {
+    let value: serde_json::Value = serde_json::from_slice(bytes).map_err(nested)?;
+    match (value.get("schema").and_then(serde_json::Value::as_str),
+           value.get("version").and_then(serde_json::Value::as_str)) {
+        (Some("OPENWEPP_SURFACE_LIQUID_COMPLETE_OWNER_PROJECTION_V2"), None) => Ok(NativeSurfaceClockView::Complete),
+        (None, Some("v2")) => Ok(NativeSurfaceClockView::NativeV2),
+        _ => Err(SnowStage3V11RestartError::Identity("native clock surface view schema")),
+    }
+}
+
+// Private admission proof compares both original components. Exact canonical
+// full-owner bytes are checked against the restored consumer before return.
+fn surface_clock_components_match(
+    clock_bytes: &[u8], surface_bytes: &[u8], wb14_bytes: Option<&[u8]>, admission: ScientificAdmission,
+    native_surface_bytes: Option<&[u8]>,
+) -> Result<bool, SnowStage3V11RestartError> {
+    if admission == ScientificAdmission::Ordinary { return Ok(clock_bytes == surface_bytes); }
+    if native_surface_clock_view(clock_bytes)? == NativeSurfaceClockView::NativeV2 {
+        return Ok(native_surface_bytes == Some(clock_bytes));
+    }
+    #[derive(serde::Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct CompleteSurface {
+        schema: String,
+        persistent_owner: serde_json::Value,
+        wb14_parent_working_state: serde_json::Value,
+    }
+    let clock: CompleteSurface = serde_json::from_slice(clock_bytes).map_err(nested)?;
+    let surface: serde_json::Value = serde_json::from_slice(surface_bytes).map_err(nested)?;
+    let wb14: serde_json::Value = wb14_bytes.map(serde_json::from_slice).transpose().map_err(nested)?.unwrap_or(serde_json::Value::Null);
+    Ok(clock.schema == "OPENWEPP_SURFACE_LIQUID_COMPLETE_OWNER_PROJECTION_V2"
+        && serde_json::to_vec(&clock.persistent_owner).map_err(nested)? == serde_json::to_vec(&surface).map_err(nested)?
+        && serde_json::to_vec(&clock.wb14_parent_working_state).map_err(nested)? == serde_json::to_vec(&wb14).map_err(nested)?)
+}
