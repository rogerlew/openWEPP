+    assert_eq!(serde_json::to_value(value).unwrap(), wire);
+    wire["mesh_policy"]["mode"] = serde_json::json!("foreign");
+    assert!(serde_json::from_value::<DirectLanedActiveRunSummary>(wire).is_err());
+}
