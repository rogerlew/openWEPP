+impl DirectV10RealConsumerShadow {
+    /// Physical observation only: enclosing projections are retained for joins,
+    /// and the independent inventory reader must count each physical store once.
+    pub(crate) fn accuracy_inventory_owners(&self) -> Result<serde_json::Value, DirectV11RealConsumerError> {
+        let owners = self.canonical_v11_parent_owner_state_bytes()?.into_iter()
+            .map(|(name,bytes)| Ok((name,serde_json::from_slice::<serde_json::Value>(&bytes)?)))
+            .collect::<Result<BTreeMap<_,_>,serde_json::Error>>()?;
+        let native_surface_owner = self.frozen_litter_v3_resident().map(|v| {
+            let c=v.surface_configuration();
+            let bytes=v.surface_owner().canonical_bytes(c.parent(),Some(c))
+                .map_err(|_|DirectV11RealConsumerError::Identity("inventory native surface canonical bytes"))?;
+            serde_json::from_slice::<serde_json::Value>(&bytes).map_err(DirectV11RealConsumerError::from)
+        }).transpose()?;
+        Ok(serde_json::json!({"owners":owners,"native_surface_owner":native_surface_owner}))
+    }
+}
