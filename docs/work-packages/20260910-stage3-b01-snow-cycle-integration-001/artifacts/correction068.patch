+impl NativeSnowLiquidPublicationV1 {
+    pub(crate) fn lse_owner_bytes(&self, ending: bool) -> Result<Vec<u8>, Error> {
+        let (lse, exact) = if ending { (&self.ending_lse, &self.ending_exact) }
+            else { (&self.beginning_lse, &self.beginning_exact) };
+        super::composite_lse_owner::composite_lse_bytes(&self.active_covered_lse, lse, exact)
+    }
+}
