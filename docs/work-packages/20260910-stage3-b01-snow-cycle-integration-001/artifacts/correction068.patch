+    #[test]
+    fn authenticated_digest_projection_matches_owner_bytes_and_rejects_reordering() {
+        let owners = vec![OwnerState::new("a".into(), vec![1, 2]).unwrap(),
+            OwnerState::new("b".into(), vec![3, 4]).unwrap()];
+        let mut records = owners.iter().map(|owner| (owner.owner_id().to_owned(), owner.state_digest())).collect::<Vec<_>>();
+        assert_eq!(complete_owner_set_digest(&owners).unwrap(), complete_owner_digest_set_digest(&records).unwrap());
