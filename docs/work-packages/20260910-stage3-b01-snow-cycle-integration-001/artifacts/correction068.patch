+fn apply_native_support_liquid_to_lane_day(
+    out: &mut AcceptedLaneDay,
+    subslab: &crate::snow_stage3_v11_attachment::Stage3CoupledSubslabReceiptV1,
+    binding: &DirectSurfaceLiquidOfeBinding,
+    surface_configuration: &DirectSurfaceLiquidConfiguration,
+    day_start_ns: u128,
+) -> Result<(), DirectRuntimeError> {
+    subslab.validate().map_err(|_| stage3_publication_guard("native accounting subslab"))?;
+    let packet = subslab.post_support_native_custody.as_ref()
+        .ok_or(stage3_publication_guard("native accounting missing packet"))?;
+    let record = packet.publication().map_err(|_| stage3_publication_guard("native accounting publication"))?;
+    let storage = |records: &[(crate::DirectSurfaceLiquidStoreKey, f64)]| -> Result<f64, DirectRuntimeError> {
+        if records.len() != surface_configuration.records.len()
+            || records.iter().zip(&surface_configuration.records).any(|((key, water), configured)|
+                key != &configured.key || !water.is_finite() || *water < 0.0) {
+            return Err(stage3_publication_guard("native accounting storage topology/domain"));
+        }
+        let mut total = 0.0;
+        for ((key, water), configured) in records.iter().zip(&surface_configuration.records) {
+            if key.ofe_id == binding.ofe_id {
+                add_nonnegative(&mut total, water * configured.tile_fraction / KG_M2_PER_M_WATER)?;
+            }
+        }
+        Ok(total)
+    };
+    let receipt_set = crate::zero_duration_snow_liquid_receipt_set_sha256(&record.allocation_receipts)
+        .map(Digest32::from_bytes).map_err(|_| stage3_publication_guard("native accounting receipt set"))?;
+    project_authenticated_snow_liquid_receipts_to_lane_day(out, &record.allocation_receipts, receipt_set,
+        binding, surface_configuration, storage(&record.beginning_liquid_records)?, storage(&record.ending_liquid_records)?,
+        day_start_ns, subslab.support, true, false)
+}
