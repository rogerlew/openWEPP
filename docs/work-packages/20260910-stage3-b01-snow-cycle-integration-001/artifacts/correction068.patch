+
+/// Resolve each signed phase independently; current ingress is unavailable.
+/// Negative raw transport is never limited by outbound authorization.
+pub(crate) fn bound_phase_vapor(
+    raw: RawLitterVapor,
+    context: V3LitterResidualContext,
+    interval_s: f64,
+) -> Result<FinalizedLitterVapor, LandSurfaceEnergyError> {
+    if !interval_s.is_finite()
+        || interval_s <= 0.0
+        || context.finalized_vapor.is_some_and(|v| {
+            [v.liquid_signed_rate_kg_m2_s, v.ice_signed_rate_kg_m2_s]
+                .iter()
+                .any(|rate| !rate.is_finite() || *rate < 0.0)
+        })
+    {
+        return Err(LandSurfaceEnergyError::FrozenLitterVapor(
+            "V3 authorization/support domain",
+        ));
+    }
+    let bound = |rate: f64, availability: f64, authorization: Option<f64>| {
+        if rate > 0.0 {
+            let local = rate.min(availability / interval_s);
+            authorization.map_or(local, |cap| local.min(cap))
+        } else {
+            rate
+        }
+    };
+    Ok(FinalizedLitterVapor {
+        liquid_signed_rate_kg_m2_s: bound(
+            raw.raw_liquid_signed_rate_kg_m2_s,
+            context.beginning.liquid_kg_m2_tile,
+            context
+                .finalized_vapor
+                .map(|v| v.liquid_signed_rate_kg_m2_s),
+        ),
+        ice_signed_rate_kg_m2_s: bound(
+            raw.raw_ice_signed_rate_kg_m2_s,
+            context.beginning.ice_kg_m2_tile,
+            context.finalized_vapor.map(|v| v.ice_signed_rate_kg_m2_s),
+        ),
+    })
 }
 
