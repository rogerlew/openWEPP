+#[test]
+fn native_snow_cold_refinement_excludes_other_defects_and_is_atomic() {
+    let d = Sha256Digest::try_new("a".repeat(64)).unwrap();
+    let mut boundary = Stage3SnowCoveredLowerBoundary {
+        native_snow_exchange: Some(openwepp_land_surface_energy::NativeSnowExchangeV1 {
+            policy_id: 14, ofe_id: OfeId::try_new("ofe-1").unwrap(), tile_id: TileId::try_new("forest").unwrap(),
+            start_ns: 0, end_ns: 60_000_000_000, snow_temperature_k: 199.0,
+            snow_saturation_specific_humidity: 0.001, pressure_pa: 101325.0,
+            heat_conductance_m_s: 0.02, vapor_conductance_m_s: 0.02,
+            forcing_sha256: d.clone(), exposure_sha256: d.clone(), payload_sha256: d.clone(),
+        }), snow_temperature_k: 199.0, latent_heat_j_kg: 2_834_000.0,
+        sensible_to_canopy_air_w_m2: 0.0, vapor_to_canopy_air_kg_m2_s: 0.0,
+        net_longwave_w_m2: 0.0, shortwave_absorbed_w_m2: 0.0, precipitation_advection_w_m2: 0.0,
+        carrier_receipt_id: d.clone(), snow_vis_albedo: 0.82, snow_nir_albedo: 0.82,
+        stage3_albedo_state_sha256: d.clone(), forcing_receipt_sha256: d,
+        optical_receipt_sha256: None, reciprocal_longwave_receipt_sha256: None, final_canopy_boundary_receipt_sha256: None,
+    };
+    let unchanged = serde_json::to_vec(&boundary).unwrap();
+    assert!(matches!(refresh_native_snow_exchange(&mut boundary), Err(DirectV11RealConsumerError::AdaptiveRefinement(_))));
+    assert_eq!(serde_json::to_vec(&boundary).unwrap(), unchanged);
+    for poison in 0..3 {
+        let mut bad = boundary.clone();
+        match poison {
+            0 => bad.latent_heat_j_kg = f64::NAN,
+            1 => bad.forcing_receipt_sha256 = Sha256Digest::try_new("b".repeat(64)).unwrap(),
+            _ => bad.native_snow_exchange.as_mut().unwrap().heat_conductance_m_s = -1.0,
+        }
+        let before = format!("{bad:?}");
+        assert!(matches!(refresh_native_snow_exchange(&mut bad), Err(DirectV11RealConsumerError::Identity(_))));
+        assert_eq!(format!("{bad:?}"), before);
+    }
