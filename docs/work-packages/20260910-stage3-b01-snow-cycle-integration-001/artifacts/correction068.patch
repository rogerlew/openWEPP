+pub(crate) fn native_supplement_active_v2_bytes(nested_bytes: &[u8]) -> Result<Vec<u8>, SnowStage3V11RestartError> {
+        let probe: Stage3V3WireProbe =
+            from_canonical_bytes(nested_bytes).map_err(nested)?;
+        validate_probe_shape(&probe)?;
+        decode_blob(
+            &probe.active_attachment_v2_canonical_base64,
+            &probe.active_attachment_v2_sha256,
+        )
+}
