+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct DirectNativeCustodyStage3RestartV1 {
+    schema: String,
+    policy_id: u8,
+    nested_stage3_v3_bytes: Vec<u8>,
+    nested_sha256: Sha256Hex,
+    residents: NativeCustodyResidentSetV1,
+    snow_material: openwepp_hillslope_orchestrator::snow_stage3_v11_attachment::SnowStage3V11SnowEnthalpyMaterialResidentSetV1,
+    payload_sha256: Sha256Hex,
+}
+impl DirectNativeCustodyStage3RestartV1 {
+    pub fn project(value: &DirectSnowStage3V11ShadowAttachment, phase_plan_sha256: &Sha256Hex,
+        day_input_digests: &[Sha256Hex], archive: &ExpectedStage3CommittedDayArchiveV3<'_>,
+        context: &ExpectedNativeCustodyContextV1<'_>) -> Result<Self, Error> {
+        let residents = NativeCustodyResidentSetV1::project(value, context)?;
+        let snow_material = value.restart_authority_snow_enthalpy_material_residents_v1().map_err(nested)?;
+        validate_native_snow_chronology(&snow_material)?;
+        let base = value.restart_authority_native_without_routing().map_err(nested)?;
+        let bytes = DirectSnowStage3V11AttachmentRestartV3::project_native(&base, phase_plan_sha256, day_input_digests, archive)?.to_canonical_bytes()?;
+        let mut result = Self {schema: SCHEMA.into(), policy_id: 14, nested_sha256: sha(&bytes)?,
+            nested_stage3_v3_bytes: bytes, residents, snow_material, payload_sha256: sha(&[])?};
+        result.payload_sha256 = result.digest()?;
+        Ok(result)
+    }
+    fn digest(&self) -> Result<Sha256Hex, Error> {
+        sha(&to_canonical_bytes(&(&self.schema, self.policy_id, &self.nested_stage3_v3_bytes, &self.nested_sha256, &self.residents, &self.snow_material)).map_err(nested)?)
+    }
+    pub fn restore(&self, stage3: &ExpectedSnowStage3V11RestartContext<'_>, archive: &ExpectedStage3CommittedDayArchiveV3<'_>,
+        context: &ExpectedNativeCustodyContextV1<'_>) -> Result<DirectSnowStage3V11ShadowAttachment, Error> {
+        if self.schema != SCHEMA || self.policy_id != 14
+            || openwepp_land_surface_energy::snow_accuracy_policy::Policy::current().identity() != Some(14)
+            || self.nested_sha256 != sha(&self.nested_stage3_v3_bytes)? || self.payload_sha256 != self.digest()? {
+            return Err(Error::Identity("native restart schema/policy/payload"));
+        }
+        validate_native_snow_chronology(&self.snow_material)?;
+        let installer = Installer {values: &self.residents, context};
+        let mut restored = crate::snow_stage3_v11_v4_exact_enthalpy::restore_native_supplement_base(
+            &self.nested_stage3_v3_bytes, stage3, archive, &installer, true)?;
+        restored.restart_authority_install_snow_enthalpy_material_residents_v1(self.snow_material.clone()).map_err(nested)?;
+        if restored.restart_authority_snow_enthalpy_material_residents_v1().map_err(nested)? != self.snow_material
+            || NativeCustodyResidentSetV1::project(&restored, context)? != self.residents {
+            return Err(Error::Identity("native restored posture/owners"));
+        }
+        Ok(restored)
+    }
+    pub(crate) fn nested_active_v2_bytes(&self) -> Result<Vec<u8>, Error> {
+        if self.schema != SCHEMA || self.policy_id != 14
+            || self.nested_sha256 != sha(&self.nested_stage3_v3_bytes)? || self.payload_sha256 != self.digest()? {
+            return Err(Error::Identity("native nested active envelope"));
+        }
+        crate::snow_stage3_v11_v4_exact_enthalpy::native_supplement_active_v2_bytes(&self.nested_stage3_v3_bytes)
+    }
+    pub fn to_canonical_bytes(&self) -> Result<Vec<u8>, Error> { to_canonical_bytes(self).map_err(nested) }
+    pub fn from_canonical_bytes(bytes: &[u8], stage3: &ExpectedSnowStage3V11RestartContext<'_>,
+        archive: &ExpectedStage3CommittedDayArchiveV3<'_>, context: &ExpectedNativeCustodyContextV1<'_>) -> Result<Self, Error> {
+        let value: Self = from_canonical_bytes(bytes).map_err(nested)?;
+        if value.to_canonical_bytes()? != bytes { return Err(Error::Identity("native canonical restart bytes")); }
+        value.restore(stage3, archive, context)?;
+        Ok(value)
+    }
+}
