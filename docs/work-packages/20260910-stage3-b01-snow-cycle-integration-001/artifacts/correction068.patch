+fn native_snow_liquid_candidate_preserves_ice_and_reprojects_zero_heat_credit() {
+    use crate::v9_real_consumer_shadow::native_snow_liquid_custody::prepare_native_snow_liquid_candidate_v1;
+    let mut fixture = exact_surface_topology_fixture(&["z-upstream".into(), "a-downstream".into()]);
+    let mut physical_records = fixture.surface_owner.v2_state().unwrap().records().to_vec();
+    for record in &mut physical_records {
+        if record.key.surface_class != SurfaceClass::ForestLitter { continue; }
+        record.litter_ice_kg_m2_tile = 0.1;
+        let capacity = 0.04 * 24.0 * 3370.5 + 0.1 * 2106.0;
+        record.surface_enthalpy_j_m2_tile = -5.0 * capacity;
+        let tile = fixture.lse_state.0.tiles.iter_mut().find(|tile|
+            tile.ofe_id == record.key.ofe_id && tile.tile_id == record.key.tile_id).unwrap();
+        tile.surface_enthalpy_j_m2_tile_ground = record.surface_enthalpy_j_m2_tile;
+        tile.surface_temperature_warm_start_k = 268.15;
+    }
+    fixture.surface_owner = SurfaceLiquidOwnerEnvelopeV2::wrap_v2(&fixture.surface_configuration,
+        SurfaceLiquidOwnedStateV2::try_new(&fixture.surface_configuration, physical_records,
+            fixture.surface_owner.v2_state().unwrap().continuations().to_vec()).unwrap()).unwrap();
+    fixture.lse_state.0.state_sha256 = fixture.lse_state.canonical_sha256().unwrap();
+    fixture.exact_owner = LseSurfaceEnthalpyOwnerEnvelopeV1::adopt_from_frozen_v2_v3(
+        fixture.exact_owner.owner_id.clone(), &fixture.lse_configuration, &fixture.lse_state,
+        &fixture.surface_configuration, &fixture.surface_owner).unwrap();
+    let inputs = fixture.surface_configuration.parent().records.iter()
+        .filter(|record| record.key.ofe_id.as_str() == "z-upstream")
+        .map(|record| crate::direct_runtime::DirectZeroDurationSnowLiquidInputV1 {
+            output_receipt_sha256: [1;32], output_set_sha256: [2;32],
+            predecessor_owner_set_sha256: [3;32], receiver_context_sha256: [4;32],
+            support_start_ns: 60_000_000_000, support_end_ns: 120_000_000_000,
+            receiver_ordinal: 0, ofe_id: record.key.ofe_id.clone(),
+            tile_id: record.key.tile_id.clone(), tile_fraction: record.tile_fraction,
+            mass_kg_m2_tile_ground: 0.25, sensible_enthalpy_j_m2_tile_ground: 0.0,
+        }).collect::<Vec<_>>();
+    let before = fixture.surface_owner.clone();
+    let exact_before = fixture.exact_owner.clone();
+    let candidate = prepare_native_snow_liquid_candidate_v1(
+        &fixture.surface_configuration, &fixture.lse_configuration, &fixture.lse_state,
+        &fixture.surface_owner, &fixture.exact_owner, &inputs, TransactionId(1), None
+    ).expect("native positive-origin allocation");
+    assert_eq!(fixture.surface_owner, before);
+    assert_eq!(fixture.exact_owner, exact_before);
+    for (begin, end) in before.v2_state().unwrap().records().iter()
+        .zip(candidate.surface_owner.v2_state().unwrap().records()) {
+        assert_eq!(begin.litter_ice_kg_m2_tile.to_bits(), end.litter_ice_kg_m2_tile.to_bits());
+        assert_eq!(begin.surface_enthalpy_j_m2_tile.to_bits(), end.surface_enthalpy_j_m2_tile.to_bits());
+    }
+    for (begin, end) in exact_before.records().iter().zip(candidate.exact_owner.records()) {
+        assert_eq!(begin.enthalpy_carry, end.enthalpy_carry);
+    }
+    let cold_litter = candidate.lse_state.0.tiles.iter().find(|tile|
+        tile.ofe_id.as_str() == "z-upstream" && tile.tile_id.as_str() == "forest-1").unwrap();
+    let expected_temperature = 273.15 - 5.0 * (0.04 * 24.0 * 3370.5 + 0.1 * 2106.0)
+        / (0.04 * 24.0 * 3370.5 + 0.1 * 2106.0 + 0.25 * 4218.0);
+    assert!((cold_litter.surface_temperature_warm_start_k - expected_temperature).abs() < 1e-12);
+    assert!(cold_litter.surface_temperature_warm_start_k > 268.15);
+    for record in &mut fixture.exact_owner.records {
+        record.enthalpy_carry = ExactDyadicEnthalpy::exact_product_binary64(&[2.0_f64.powi(-60)]).unwrap();
+    }
+    reseal_exact_surface_owner(&mut fixture.exact_owner);
+    let parcels = [1.0, 2.0_f64.powi(-54), 2.0_f64.powi(-54)].into_iter()
+        .enumerate().flat_map(|(ordinal, energy)| inputs.iter().cloned().map(move |mut input| {
+            input.output_receipt_sha256 = [u8::try_from(ordinal + 10).unwrap(); 32];
+            input.sensible_enthalpy_j_m2_tile_ground = energy; input
+        })).collect::<Vec<_>>();
+    let multiple = prepare_native_snow_liquid_candidate_v1(
+        &fixture.surface_configuration, &fixture.lse_configuration, &fixture.lse_state,
+        &fixture.surface_owner, &fixture.exact_owner, &parcels, TransactionId(1), None
