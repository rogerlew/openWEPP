+#[test]
+fn native_inactive_parent_placement_uses_validated_custody() {
+    let topology = vec![OfeId::try_new("ofe-1").unwrap()];
+    let parent =
+        TimeSupport::new(ModelTimeNs::new(0), ModelTimeNs::new(1_800_000_000_000)).unwrap();
+    for end in [60_000_000_000, 1_800_000_000_000] {
+        let support = TimeSupport::new(
+            ModelTimeNs::new(end - 60_000_000_000),
+            ModelTimeNs::new(end),
+        )
+        .unwrap();
+        let binding = crate::direct_runtime::DirectWb14CoupledChildBindingV1 {
+            proposed_upper_bound_s_bits: 60.0_f64.to_bits(),
+            coupled_parent_transaction_sha256: [1; 32],
+            accepted_slab_sha256: [2; 32],
+            parent_beginning_complete_owner_set_sha256: [3; 32],
+            parent_support_start_ns: 0,
+            parent_support_end_ns: parent.end_ns().get(),
+            child_support_start_ns: support.start_ns().get(),
+            child_support_end_ns: end,
+        };
+        let bytes = crate::direct_runtime::stage3_covered_native_inactive_child_custody_bytes(
+            binding, &topology,
+        )
+        .unwrap();
+        assert!(
+            wb14_parent_finalization_custody_is_valid_v1(
+                parent, support, false, false, &bytes, &topology
+            )
+            .unwrap()
+        );
+        for (replay, digest) in [(true, false), (false, true), (true, true)] {
+            assert!(
+                !wb14_parent_finalization_custody_is_valid_v1(
+                    parent, support, replay, digest, &bytes, &topology
+                )
+                .unwrap()
+            );
+        }
+        let foreign = vec![OfeId::try_new("ofe-2").unwrap()];
+        assert!(
+            wb14_parent_finalization_custody_is_valid_v1(
+                parent, support, false, false, &bytes, &foreign
+            )
+            .is_err()
+        );
+        assert!(
+            wb14_parent_finalization_custody_is_valid_v1(
+                parent, support, false, false, b"{", &topology
+            )
+            .is_err()
+        );
+        let wrong_support = TimeSupport::new(
+            ModelTimeNs::new(end),
+            ModelTimeNs::new(end + 60_000_000_000),
+        )
+        .unwrap();
+        assert!(
+            !wb14_parent_finalization_custody_is_valid_v1(
+                parent,
+                wrong_support,
+                false,
+                false,
+                &bytes,
+                &topology
+            )
+            .unwrap()
+        );
+    }
+    assert!(
+        !wb14_parent_finalization_custody_is_valid_v1(parent, parent, false, false, b"", &topology)
+            .unwrap()
+    );
+}
