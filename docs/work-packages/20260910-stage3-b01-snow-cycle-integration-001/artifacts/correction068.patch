+fn valid_subhourly_clock(hour: i32, bin: i32) -> bool {
+    (0..288).contains(&bin) && hour == bin / 12
+}
+#[test]
+fn native_workflow_subhourly_clock_uses_global_day_bins() {
+    for (hour, bin) in [(0,0),(0,11),(1,12),(23,287)] { assert!(valid_subhourly_clock(hour,bin)); }
+    for (hour, bin) in [(0,12),(1,11),(24,288),(0,-1),(-1,0),(23,276-1)] { assert!(!valid_subhourly_clock(hour,bin)); }
+}
