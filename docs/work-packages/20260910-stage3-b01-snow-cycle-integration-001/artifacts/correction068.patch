+        &configuration, &resource, &forcing, None, false, None).unwrap();
+    let parent = first.parent_working_state().unwrap();
+    let before = parent.clone();
+    let native_beginning = parent.candidate_owner();
+    let state = native_beginning.v2_state().unwrap();
+    let mut records = state.records().to_vec();
+    records[0].liquid_kg_m2_tile += 0.125;
+    let ending = SurfaceLiquidOwnerEnvelopeV2::wrap_v2(&configuration,
+        SurfaceLiquidOwnedStateV2::try_new(&configuration, records.clone(), state.continuations().to_vec()).unwrap()).unwrap();
+    let updated = parent.with_native_custody_candidate(&configuration, native_beginning, &ending).unwrap();
+    assert_eq!(parent, &before);
+    assert_eq!(updated.candidate_owner(), &ending);
+    assert_eq!(ending.v2_state().unwrap().continuations(), state.continuations());
+    for (old, new) in state.records().iter().zip(ending.v2_state().unwrap().records()) {
+        assert_eq!(old.last_accepted_transaction_id, new.last_accepted_transaction_id);
+        assert_eq!(old.litter_ice_kg_m2_tile, new.litter_ice_kg_m2_tile);
