+#[derive(Clone, Debug, PartialEq, serde::Serialize, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct NativeSnowExchangeV1 {
+    pub policy_id: u8,
+    pub ofe_id: OfeId,
+    pub tile_id: TileId,
+    pub start_ns: u128,
+    pub end_ns: u128,
+    pub snow_temperature_k: f64,
+    pub snow_saturation_specific_humidity: f64,
+    pub pressure_pa: f64,
+    pub heat_conductance_m_s: f64,
+    pub vapor_conductance_m_s: f64,
+    pub forcing_sha256: Sha256Digest,
+    pub exposure_sha256: Sha256Digest,
+    pub payload_sha256: Sha256Digest,
+}
+impl NativeSnowExchangeV1 {
+    pub fn reconstructed_sha256(&self) -> Result<Sha256Digest, LandSurfaceEnergyError> {
+        let bytes = serde_json::to_vec(&("OPENWEPP_NATIVE_SNOW_EXCHANGE_V1", self.policy_id,
+            &self.ofe_id, &self.tile_id, self.start_ns, self.end_ns,
+            self.snow_temperature_k, self.snow_saturation_specific_humidity, self.pressure_pa,
+            self.heat_conductance_m_s, self.vapor_conductance_m_s,
+            &self.forcing_sha256, &self.exposure_sha256))
+            .map_err(|_| LandSurfaceEnergyError::StateLineage("native snow exchange encoding"))?;
+        Sha256Digest::try_new(format!("{:x}", Sha256::digest(bytes)))
+    }
+    pub fn validate(&self) -> Result<(), LandSurfaceEnergyError> {
+        if self.policy_id != 14 || self.start_ns >= self.end_ns
+            || !(200.0..=350.0).contains(&self.snow_temperature_k)
+            || !(0.0..=1.0).contains(&self.snow_saturation_specific_humidity)
+            || !self.pressure_pa.is_finite() || self.pressure_pa <= 0.0
+            || !self.heat_conductance_m_s.is_finite() || self.heat_conductance_m_s <= 0.0
+            || !self.vapor_conductance_m_s.is_finite() || self.vapor_conductance_m_s <= 0.0
+            || self.payload_sha256 != self.reconstructed_sha256()? {
+            return Err(LandSurfaceEnergyError::StateLineage("native snow exchange domain/seal"));
+        }
+        Ok(())
+    }
+    /// Surface-to-node fluxes at the actual shared node; all participants use
+    /// the existing LSE density and heat-capacity convention.
+    pub fn outward_fluxes(&self, temperature_k: f64, humidity: f64) -> Result<(f64, f64), LandSurfaceEnergyError> {
+        if !(200.0..=350.0).contains(&temperature_k) || !(0.0..=1.0).contains(&humidity) {
+            return Err(LandSurfaceEnergyError::ConstitutiveDomain("native snow shared node"));
+        }
+        let rho = self.pressure_pa / (DRY_AIR_GAS_CONSTANT_J_KG_K * temperature_k);
+        Ok((rho * AIR_HEAT_CAPACITY_J_KG_K * self.heat_conductance_m_s * (self.snow_temperature_k - temperature_k),
+            rho * self.vapor_conductance_m_s * (self.snow_saturation_specific_humidity - humidity)))
+    }
+}
