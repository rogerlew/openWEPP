+#[test]
+fn native_drain_histories_retain_partial_state_finalize_dry_tail_and_reject_replay() {
+    let (mut physical,mut exact)=v4_resident_fixture();
+    let adoption=physical.lse_state().0.state_sha256.clone();
+    let record=native_drain_record_for_history_test(&physical,&exact,0,60_000_000_000,false);
+    let first=record.clone();
+    physical.accept_native_snow_publication(record.clone(),&record.outputs).unwrap();
+    exact.accept_native_snow_publication(&physical,&record).unwrap();
+    assert_eq!(physical.lse_state().0.last_accepted_transaction_id,None);
+    let previous=physical.clone();
+    assert!(physical.accept_native_snow_publication(first.clone(),&first.outputs).is_err());
+    assert_eq!(physical,previous);
+    let finalization=native_drain_record_for_history_test(&physical,&exact,1_740_000_000_000,1_800_000_000_000,true);
+    let physical_surface_before = physical.surface_owner().clone();
+    let physical_lse_before = physical.lse_state().clone();
+    let exact_before = exact.exact_surface_owner().clone();
+    let liquids=physical.surface_owner().v2_state().unwrap().records().iter()
+        .map(|record|(record.liquid_kg_m2_tile,record.litter_ice_kg_m2_tile,record.surface_enthalpy_j_m2_tile)).collect::<Vec<_>>();
+    physical.accept_native_snow_publication(finalization.clone(),&[]).unwrap();
+    exact.accept_native_snow_publication(&physical,&finalization).unwrap();
+    assert_eq!(physical.lse_state().0.last_accepted_transaction_id,None);
+    assert_eq!(liquids,physical.surface_owner().v2_state().unwrap().records().iter()
+        .map(|record|(record.liquid_kg_m2_tile,record.litter_ice_kg_m2_tile,record.surface_enthalpy_j_m2_tile)).collect::<Vec<_>>());
+    assert_eq!(physical.surface_owner(), &physical_surface_before);
+    assert_eq!(physical.lse_state(), &physical_lse_before);
+    let mut expected_exact = exact_before;
+    expected_exact.receipt_chain_sha256 = exact.exact_surface_owner().receipt_chain_sha256.clone();
+    assert_eq!(exact.exact_surface_owner(), &expected_exact);
+    let bytes=physical.accepted_publication_supports_canonical_bytes().unwrap();
+    let mut restored=FrozenLitterV3Resident::try_new(physical.lse_configuration().clone(),physical.lse_state().clone(),
+        physical.surface_configuration().clone(),physical.surface_owner().clone()).unwrap();
+    restored.restore_restart_authority(&bytes,None,physical.predecessor_receipt_chain_sha256()).unwrap();
+    assert_eq!(restored,physical);
+    let restored_exact=FrozenLitterV4Resident::try_restore(&restored,exact.exact_surface_owner().clone(),
+        exact.accepted_publication_supports_canonical_bytes(),&adoption).unwrap();
+    assert_eq!(restored_exact,exact);
+    let before=restored.clone();
+    assert!(restored.restore_restart_authority(&[bytes[1].clone()],None,
+        physical.predecessor_receipt_chain_sha256()).is_err());
+    assert_eq!(restored,before);
+    assert!(restored.restore_restart_authority(&[bytes[1].clone(),bytes[0].clone()],None,
+        physical.predecessor_receipt_chain_sha256()).is_err());
+    assert!(FrozenLitterV4Resident::try_restore(&restored,exact.exact_surface_owner().clone(),
+        &[bytes[0].clone()],&adoption).is_err());
+}
