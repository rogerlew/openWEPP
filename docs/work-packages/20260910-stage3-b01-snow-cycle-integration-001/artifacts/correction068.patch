+impl<'de> serde::Deserialize<'de> for DirectLanedActiveMeshPolicySummary {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        #[derive(serde::Deserialize)]
+        #[serde(deny_unknown_fields)]
+        struct Wire { mode: String, fixed_cells: Option<usize>, target_dx_m: Option<f64>, min_cells: usize, max_cells: usize }
+        let value = Wire::deserialize(deserializer)?;
+        let mode = match value.mode.as_str() {
+            "fixed_cells" => "fixed_cells",
+            "target_dx" => "target_dx",
+            _ => return Err(serde::de::Error::custom("unknown native mesh summary mode")),
+        };
+        Ok(Self { mode, fixed_cells: value.fixed_cells, target_dx_m: value.target_dx_m,
+            min_cells: value.min_cells, max_cells: value.max_cells })
+    }
+}
