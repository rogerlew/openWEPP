+        tx, &zero_closure(&ending)).unwrap();
+    let next = execute_surface_liquid_ingress_v2_with_parent_state_and_coupled_binding(
+        &configuration, &next_resource, &forcing, Some(&updated), true, None).unwrap();
+    assert!(next.parent_working_state().is_none());
+    assert_eq!(next.beginning_owner(), &ending);
+}
