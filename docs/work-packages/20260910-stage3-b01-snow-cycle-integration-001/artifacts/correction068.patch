+#[derive(Debug, thiserror::Error)]
+pub enum ObservationWriteError {
+    #[error("observation IO: {0}")]
+    Io(#[from] std::io::Error),
+    #[error("observation JSON: {0}")]
+    Json(#[from] serde_json::Error),
