+        let end = multiple.exact_owner.records().iter().find(|end| end.surface_key == begin.surface_key).unwrap();
+        let aggregate = multiple.allocation.retained_enthalpy_credits.iter().find(|credit|
+            credit.ofe_id == begin.surface_key.ofe_id && credit.tile_id == begin.surface_key.tile_id)
+            .map_or(0.0, |credit| credit.enthalpy_j_m2_tile_ground);
+        let rounded = ExactDyadicEnthalpy::exact_sum_binary64(begin.enthalpy_hi_j_m2_tile,
+            &begin.enthalpy_carry, &[aggregate]).unwrap().rounded_high_and_remainder().unwrap();
+        distinguishes_rounded_aggregate |= rounded != (end.enthalpy_hi_j_m2_tile, end.enthalpy_carry.clone());
