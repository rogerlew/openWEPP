+#[test]
+fn native_litter_phase_order_preserves_payloads_and_rejects_bad_key_sets() {
+    use super::v3_input_projection::order_native_litter_phase_inputs;
+    // Lexical OFE order deliberately differs from configured flow order.
+    let fixture = exact_surface_topology_fixture(&["z-upstream".into(), "a-downstream".into()]);
+    let records = fixture.surface_configuration.records().iter()
+        .filter(|record| record.litter_depth_m.is_some()).collect::<Vec<_>>();
+    assert_eq!(records.len(), 2);
+    // The ordering seam consumes accepted payloads independently of the open
+    // or covered evaluator that supplied them; distinct payloads detect swaps.
+    let mut open = runtime_fixture(275.0, false, 0.0).phase_inputs.remove(0);
+    open.ofe_id = records[0].key.ofe_id.clone();
+    open.tile_id = records[0].key.tile_id.clone();
+    let mut covered = runtime_fixture(270.0, true, 0.0).phase_inputs.remove(0);
+    covered.ofe_id = records[1].key.ofe_id.clone();
+    covered.tile_id = records[1].key.tile_id.clone();
+    let expected = vec![open.clone(), covered.clone()];
+    assert_eq!(order_native_litter_phase_inputs(&fixture.surface_configuration,
+        vec![covered.clone(), open.clone()]).expect("configuration order"), expected);
+    assert_eq!(order_native_litter_phase_inputs(&fixture.surface_configuration,
+        expected.clone()).expect("already ordered"), expected);
+    assert!(order_native_litter_phase_inputs(&fixture.surface_configuration,
+        vec![open.clone(), open.clone(), covered.clone()]).is_err());
+    assert!(order_native_litter_phase_inputs(&fixture.surface_configuration,
+        vec![open.clone()]).is_err());
+    let mut foreign = covered.clone();
+    foreign.ofe_id = OfeId::try_new("foreign").expect("test key");
+    assert!(order_native_litter_phase_inputs(&fixture.surface_configuration,
+        vec![open, covered, foreign]).is_err());
+}
