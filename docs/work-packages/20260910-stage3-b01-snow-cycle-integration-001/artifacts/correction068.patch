+//! Actual-process experimental checkpoint custody; no physical prefix replay.
+use super::*;
+use openwepp_coupled_time::{Digest32, digest_bytes};
+use openwepp_hillslope_orchestrator::{DirectPublicationFrame, Stage3CommittedDayArchiveManifestV1};
+use openwepp_persisted_restart_v1::{DirectHydrologyNativeCustodyRestartV1,
+    ExpectedStage3CommittedDayArchiveV3, Stage3CommittedDayArchiveReaderV3};
+use serde::{Deserialize, Serialize};
+
+fn fail(error: impl std::fmt::Display) -> HillslopeCliError {
+    HillslopeCliError::RuntimeSurfaceFailure {surface: "native_custody_restart_experiment", detail: error.to_string()}
+}
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct ArchiveRecords(pub Vec<Vec<u8>>);
+impl Stage3CommittedDayArchiveReaderV3 for ArchiveRecords {
+    fn read_canonical_uncompressed(&self, sha: Digest32) -> Option<Vec<u8>> {
+        let mut found = self.0.iter().filter(|bytes| digest_bytes(bytes) == sha);
+        let value = found.next()?.clone();
+        if found.next().is_some() { return None; }
+        Some(value)
+    }
+}
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Workflow {
+    schema: String,
+    pub next_day: usize,
+    metadata: DirectPublicationRunMetadata,
+    native_frame: Vec<u8>,
+    publication: DirectPublicationFrame,
+    pub rows: Vec<DirectPublicationDayRow>,
+    pub subhourly_rows: Vec<SavedSubhourlyRow>,
+    pub manifest: Stage3CommittedDayArchiveManifestV1,
+    pub records: ArchiveRecords,
+    payload: Digest32,
+}
+impl Workflow {
+    fn digest(&self) -> Result<Digest32, HillslopeCliError> {
+        let mut value = self.clone(); value.payload = Digest32::zero();
+        Ok(digest_bytes(&serde_json::to_vec(&value).map_err(fail)?))
+    }
+    fn validate_prefix(&self, frame: &DirectRunFrame, metadata: &DirectPublicationRunMetadata) -> Result<(), HillslopeCliError> {
+        if self.schema != "OPENWEPP_B01_NATIVE_WORKFLOW_V1_POLICY14" || self.payload != self.digest()?
+            || &self.metadata != metadata || self.next_day > frame.identity.day_count
+            || self.manifest.committed_day_count != self.next_day
+            || self.records.0.len() != self.next_day
+            || self.next_day.checked_mul(frame.identity.lane_count) != Some(self.rows.len()) {
+            return Err(fail("workflow schema/seal/metadata/prefix cardinality"));
+        }
+        self.manifest.validate().map_err(fail)?;
+        for (day, (entry, bytes)) in self.manifest.entries.iter().zip(&self.records.0).enumerate() {
+            if entry.day_index != day || entry.content_sha256 != digest_bytes(bytes)
+                || entry.canonical_uncompressed_len != bytes.len() as u64 {
+                return Err(fail("workflow archive chronology/content"));
+            }
+        }
+        for (index, row) in self.rows.iter().enumerate() {
+            let lane = &frame.lanes[index % frame.identity.lane_count];
+            if row.day_index != index / frame.identity.lane_count || row.lane_index != index % frame.identity.lane_count
+                || row.lane_id != lane.lane_id || row.run_id != frame.identity.run_id
+                || row.hillslope_id != frame.identity.hillslope_id {
+                return Err(fail("workflow row partition/identity"));
+            }
+        }
+        let mut previous = None;
+        for row in &self.subhourly_rows {
+            let index = self.rows.iter().position(|daily| daily.ofe_id == row.ofe_id as u32
+                && daily.calendar.year == row.year && daily.sim_day_index == row.sim_day_index
+                && i32::from(daily.calendar.julian_day) == row.julian)
+                .ok_or_else(|| fail("workflow subhourly parent row"))?;
+            let key = (index, row.hour_index, row.subinterval_index);
+            if previous.is_some_and(|old| old >= key) || row.wepp_id != DIRECT_WAT_WEPP_ID
+                || !valid_subhourly_clock(row.hour_index, row.subinterval_index) {
+                return Err(fail("workflow subhourly chronology/duplicate"));
+            }
+            previous = Some(key);
+        }
+        Ok(())
+    }
+    pub fn project(frame: &DirectRunFrame, fresh: &DirectRunFrame,
+        seed: &snow_stage3_v11_production_seed::DirectSnowStage3V11ProductionSeedV1,
+        metadata: &DirectPublicationRunMetadata, rows: &[DirectPublicationDayRow], subhourly_rows: &[SavedSubhourlyRow],
+        manifest: &Stage3CommittedDayArchiveManifestV1, records: &ArchiveRecords,
+    ) -> Result<Self, HillslopeCliError> {
+        let archive = ExpectedStage3CommittedDayArchiveV3 {manifest, reader: records};
+        let native_frame = seed.with_native_restart_context(fresh, &archive, |context| {
+            DirectHydrologyNativeCustodyRestartV1::project(frame,
+                context.hydrology.phase_plan_sha256.clone(), context.hydrology.day_input_digests,
+                &archive, context.native).map_err(fail)?.to_canonical_bytes().map_err(fail)
+        })?;
+        let mut value = Self {schema: "OPENWEPP_B01_NATIVE_WORKFLOW_V1_POLICY14".into(),
+            next_day: manifest.committed_day_count, metadata: metadata.clone(), native_frame,
+            publication: frame.publication.clone(), rows: rows.to_vec(), subhourly_rows: subhourly_rows.to_vec(), manifest: manifest.clone(),
+            records: records.clone(), payload: Digest32::zero()};
+        value.payload = value.digest()?;
+        value.validate_prefix(frame, metadata)?;
+        let restored = value.restore(fresh, seed, metadata)?;
+        if restored != *frame { return Err(fail("workflow full frame project/restore inequality")); }
+        Ok(value)
+    }
+    pub fn restore(&self, fresh: &DirectRunFrame,
+        seed: &snow_stage3_v11_production_seed::DirectSnowStage3V11ProductionSeedV1,
+        metadata: &DirectPublicationRunMetadata,
+    ) -> Result<DirectRunFrame, HillslopeCliError> {
+        self.validate_prefix(fresh, metadata)?;
+        let archive = ExpectedStage3CommittedDayArchiveV3 {manifest: &self.manifest, reader: &self.records};
+        let mut frame = seed.with_native_restart_context(fresh, &archive, |context| {
+            DirectHydrologyNativeCustodyRestartV1::from_canonical_bytes(&self.native_frame, context)
+                .map_err(fail)?.restore(context).map_err(fail)
+        })?;
+        if frame.identity != fresh.identity || frame.snow_stage3_v11_archived_receipt_prefix().map_err(fail)?.archived_day_count != self.next_day {
+            return Err(fail("workflow restored identity/cursor"));
+        }
+        let values = [&self.publication.runoff_m, &self.publication.infiltration_m,
+            &self.publication.evapotranspiration_m, &self.publication.drainage_m, &self.publication.lateral_flow_m];
+        if values.iter().any(|v| !v.is_finite()) { return Err(fail("workflow publication nonfinite")); }
+        frame.publication = self.publication.clone();
+        Ok(frame)
+    }
+    pub fn write(&self, path: &Path) -> Result<(), HillslopeCliError> {
+        use std::io::Write as _;
+        let bytes = serde_json::to_vec(self).map_err(fail)?;
+        let mut file = std::fs::OpenOptions::new().write(true).create_new(true).open(path).map_err(fail)?;
+        file.write_all(&bytes).map_err(fail)?; file.sync_all().map_err(fail)
+    }
+    pub fn read(path: &Path) -> Result<Self, HillslopeCliError> {
+        let bytes = std::fs::read(path).map_err(fail)?;
+        let value: Self = serde_json::from_slice(&bytes).map_err(fail)?;
+        if serde_json::to_vec(&value).map_err(fail)? != bytes { return Err(fail("workflow noncanonical bytes")); }
+        Ok(value)
+    }
+}
