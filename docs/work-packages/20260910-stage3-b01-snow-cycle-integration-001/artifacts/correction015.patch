+// Pure arithmetic shared by physical admission and private Jacobian probes.
+// No receipt, owner, phase operation or observer is created here.
+pub(crate) fn phase_vapor_energy_primitives(
+    rates: FinalizedLitterVapor,
+    temperature: f64,
+    interval: f64,
+) -> Result<[f64; 6], LandSurfaceEnergyError> {
+    let ml = rates.liquid_signed_rate_kg_m2_s * interval;
+    let mi = rates.ice_signed_rate_kg_m2_s * interval;
+    let hl = WATER_HEAT_CAPACITY_J_KG_K * (temperature - REFERENCE_TEMPERATURE_K)
+        + vaporization_enthalpy_j_kg(temperature);
+    let hi = LITTER_ICE_HEAT_CAPACITY_J_KG_K * (temperature - REFERENCE_TEMPERATURE_K)
+        + sublimation_enthalpy_j_kg(temperature);
+    let values = [ml, mi, hl, hi, ml * hl, mi * hi];
+    if values.iter().any(|v| !v.is_finite()) {
+        return Err(LandSurfaceEnergyError::FrozenLitterVapor(
+            "nonfinite vapor energy primitive",
+        ));
+    }
+    Ok(values)
+}
