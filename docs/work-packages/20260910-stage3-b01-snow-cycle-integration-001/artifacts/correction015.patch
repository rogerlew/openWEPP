+pub(crate) fn order_native_litter_phase_inputs(
+    configuration:&crate::SurfaceLiquidConfigurationV2,
+    inputs:impl IntoIterator<Item=FrozenLitterV3PhaseFreeInput>,
+)->Result<Vec<FrozenLitterV3PhaseFreeInput>,crate::DirectSurfaceLiquidError> {
+    let mut indexed=std::collections::BTreeMap::new();
+    for input in inputs {
+        let key=(input.ofe_id.clone(),input.tile_id.clone());
+        if indexed.insert(key,input).is_some() {
+            return Err(crate::DirectSurfaceLiquidError::Identity("duplicate native litter phase input"));
+        }
+    }
+    let mut ordered=Vec::new();
+    for record in configuration.records().iter().filter(|record|record.litter_depth_m.is_some()) {
+        ordered.push(indexed.remove(&(record.key.ofe_id.clone(),record.key.tile_id.clone()))
+            .ok_or(crate::DirectSurfaceLiquidError::Identity("missing native litter phase input"))?);
+    }
+    if !indexed.is_empty() {
+        return Err(crate::DirectSurfaceLiquidError::Identity("foreign native litter phase input"));
+    }
+    Ok(ordered)
 }
 
