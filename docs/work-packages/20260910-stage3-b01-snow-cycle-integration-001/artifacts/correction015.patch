+    let ice = if authentic_total == 0.0 {
+        0.0
+    } else {
+        total_water * (authentic_ice / authentic_total)
+    };
+    let liquid = total_water - ice;
+    if !ice.is_finite() || !liquid.is_finite() || ice < 0.0 || liquid < 0.0 {
+        return Err(DirectV11RealConsumerError::AdaptiveRefinement(
+            "B01 authentic phase trial result domain",
+        ));
+    }
+    Ok((ice, liquid))
