+#[derive(Debug, PartialEq)]
+enum RoutedPublicationLineageError {
+    Cardinality {
+        published: usize,
+        associated: usize,
+    },
+    WrongAreaAssociation {
+        ofe_index: usize,
+        published_area_m2_bits: u64,
+        associated_area_m2_bits: u64,
+    },
+}
