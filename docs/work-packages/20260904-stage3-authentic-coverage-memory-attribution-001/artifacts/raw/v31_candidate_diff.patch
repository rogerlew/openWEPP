+fn replay_covered_occupancy_energy_only(
+    context: &CoveredOccupancyTrialContext<'_>,
+    occupancy: &CoveredOccupancyInputs,
+    block: &[f64],
+    base: &CoveredOccupancyEvaluation,
+) -> Result<CoveredOccupancyEvaluation, LandSurfaceEnergyError> {
+    if block.len() != 10 || base.residuals.len() != 10 || base.tolerances.len() != 10 {
+        return Err(LandSurfaceEnergyError::ConstitutiveDomain(
+            "covered_component_dependency_replay_integrity",
+        ));
+    }
+    let geometry = covered_occupancy_component_geometry(context, occupancy, block)?;
+    let energy = evaluate_covered_occupancy_energy_tail(
+        context,
+        occupancy,
+        geometry,
+        base.gas_branches,
+        base.wet_branch,
+        [
+            base.signed_vapor_to_canopy_air_kg_m2_s[0],
+            base.signed_vapor_to_canopy_air_kg_m2_s[1],
+            base.wet_vapor_kg_m2_s,
+        ],
+    );
+    let mut result = base.clone();
+    result.residuals.truncate(6);
+    result.residuals.extend(energy.residuals);
+    result.tolerances.truncate(6);
+    result.tolerances.extend(energy.tolerances);
+    result.canopy_sensible_w_m2 = energy.sensible_to_canopy_air_w_m2.iter().sum();
+    result.component_temperatures_k = geometry.temperatures_k;
+    result.absorbed_shortwave_w_m2 = energy.absorbed_shortwave_w_m2;
+    result.net_longwave_w_m2 = context.component_longwave_w_m2;
+    result.sensible_to_canopy_air_w_m2 = energy.sensible_to_canopy_air_w_m2;
+    result.component_areas_m2_m2_tile = geometry.areas;
+    result.component_emissive_areas_m2_m2_tile = geometry.areas;
+    result.component_heat_conductance_m_s_tile = geometry.heat_conductance_m_s_tile;
+    Ok(result)
+}
