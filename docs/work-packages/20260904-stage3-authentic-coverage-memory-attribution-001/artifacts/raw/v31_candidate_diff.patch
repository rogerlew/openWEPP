+#[derive(Clone, Copy)]
+struct CoveredOccupancyComponentGeometry {
+    wet_fraction: f64,
+    areas: [f64; 4],
+    temperatures_k: [f64; 4],
+    heat_conductance_m_s_tile: [f64; 4],
