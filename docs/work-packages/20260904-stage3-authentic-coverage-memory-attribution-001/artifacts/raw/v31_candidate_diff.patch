+            for target in ["leaf.current", "leaf.maximum", "vapor"] {
+                requires(
+                    &two,
+                    format!("probe[{occupancy},{component}]"),
+                    format!("occ.{target}[{occupancy},{component}]"),
+                );
+            }
+            for target in ["vapor", "hydraulic"] {
+                requires(
+                    &two,
