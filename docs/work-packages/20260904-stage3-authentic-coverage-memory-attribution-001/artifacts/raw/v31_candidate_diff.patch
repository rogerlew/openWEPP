+struct ValidatedCoveredComponentReplaySweepBase<'a> {
+    jacobian: ValidatedCoveredJacobianBase<'a>,
+    graph: std::rc::Rc<CoveredComponentTemperatureDependencyGraph>,
+    graph_sha256: String,
+    solve_class: CoveredComponentReplaySolveClass,
+    map_identity: CoveredComponentReplayMapIdentity,
+    solve_ordinal: u64,
+    iteration_ordinal: u32,
+    sweep_ordinal: u32,
