+#[cfg(test)]
+pub(crate) fn arm_refusal_capture_for_test() {
+    REFUSAL_CAPTURE_ARMED.with(|armed| armed.set(true));
+    REFUSAL_CAPTURE_TRACE.with(|trace| *trace.borrow_mut() = None);
+}
