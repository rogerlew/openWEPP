+// One-support refusal capture entry.  It intentionally accepts only the three
+// frozen witnesses and takes exactly support zero: it is not the day IPC, does
+// not retry, and does not enable any mutation/poison seam.  The record is
+// emitted after the controller returns, so copying observer values cannot alter
+// the controller's decision, ordering, work counters, or state.
+#[cfg(feature = "m1-trust-region-physical-stage")]
+#[test]
+#[ignore = "sealed single-support refusal capture only"]
+fn m1_refusal_capture_support0_ipc() {
+    use std::io::{self, BufRead, Write};
+
+    const MAX_OUTPUT_BYTES: usize = 262_144;
+    let request_line = io::stdin()
+        .lock()
+        .lines()
+        .next()
+        .expect("RUN_INIT line")
+        .expect("RUN_INIT input");
+    let request: Value = serde_json::from_str(
+        request_line
+            .strip_prefix("RUN_INIT ")
+            .expect("RUN_INIT command"),
+    )
+    .expect("capture request JSON");
+    let witness = request["witness"].as_str().expect("witness");
+    let (case_id, representation, profile) = match witness {
+        "W1" => (
+            "A_cold_ice_day",
+            super::M1SeparateAccuracyRepresentation::Full,
+            super::M1SeparateAccuracyProfile::P0,
+        ),
+        "W2" => (
+            "C_freeze_then_melt_day",
+            super::M1SeparateAccuracyRepresentation::Full,
+            super::M1SeparateAccuracyProfile::P2,
+        ),
+        "W3" => (
+            "C_freeze_then_melt_day",
+            super::M1SeparateAccuracyRepresentation::Reduced {
+                zero_area_sun_anchors: true,
+            },
+            super::M1SeparateAccuracyProfile::P0,
+        ),
+        _ => panic!("only frozen W1/W2/W3 witnesses are admissible"),
+    };
+    assert_eq!(request["case"].as_str(), Some(case_id));
+    assert_eq!(request["support_id"].as_u64(), Some(0));
+    assert_eq!(request["cadence_seconds"].as_u64(), Some(60));
+    let support = separate_accuracy_case_supports(case_id, 60)
+        .into_iter()
+        .next()
+        .expect("frozen support zero");
+    assert_eq!(support.support_id, 0);
