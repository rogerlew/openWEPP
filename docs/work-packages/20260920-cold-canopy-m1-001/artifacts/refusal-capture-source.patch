+#[derive(Clone, Debug)]
+pub struct M1MhRefusalObservation {
+    pub mass_bits: u64,
+    pub enthalpy_bits: u64,
+    pub temperature_bits: Option<u64>,
+    pub predicate: &'static str,
+    pub context: Option<M1MhObservationContext>,
+    pub terminal_propagated: bool,
+}
+#[derive(Clone, Debug)]
+pub struct M1MhRefusalReport {
+    pub events: Vec<M1MhRefusalObservation>,
+    pub total_count: usize,
+    pub truncated: bool,
+    pub observer_error: bool,
+}
+#[derive(Clone, Debug)]
+pub struct M1MhObservationContext {
+    pub site: &'static str,
+    pub occupancy: usize,
+    pub mass_index: usize,
+    pub enthalpy_index: usize,
+    pub trial_coordinate_bits: [u64; 21],
+}
+static M1_MH_REFUSAL_ARMED: AtomicBool = AtomicBool::new(false);
+const M1_MH_REFUSAL_CAP: usize = 16;
+static M1_MH_REFUSAL_TOTAL: AtomicUsize = AtomicUsize::new(0);
+static M1_MH_REFUSAL_TRUNCATED: AtomicBool = AtomicBool::new(false);
+static M1_MH_REFUSAL_ERROR: AtomicBool = AtomicBool::new(false);
+static M1_MH_REFUSAL_RECORD: OnceLock<Mutex<Vec<M1MhRefusalObservation>>> = OnceLock::new();
+static M1_MH_REFUSAL_CONTEXT: OnceLock<Mutex<Option<M1MhObservationContext>>> = OnceLock::new();
+fn m1_mh_refusal_record() -> &'static Mutex<Vec<M1MhRefusalObservation>> {
+    M1_MH_REFUSAL_RECORD.get_or_init(|| Mutex::new(Vec::new()))
+}
+fn m1_mh_refusal_context() -> &'static Mutex<Option<M1MhObservationContext>> {
+    M1_MH_REFUSAL_CONTEXT.get_or_init(|| Mutex::new(None))
+}
+pub struct M1MhObservationContextScope(Option<M1MhObservationContext>);
+pub fn scoped_m1_mh_observation_context(
+    context: M1MhObservationContext,
+) -> M1MhObservationContextScope {
+    let prior = if M1_MH_REFUSAL_ARMED.load(Ordering::Acquire) {
+        match m1_mh_refusal_context().lock() {
+            Ok(mut slot) => slot.replace(context),
+            Err(_) => {
+                M1_MH_REFUSAL_ERROR.store(true, Ordering::Release);
+                None
+            }
+        }
+    } else {
+        None
+    };
+    M1MhObservationContextScope(prior)
+}
+impl Drop for M1MhObservationContextScope {
+    fn drop(&mut self) {
+        if M1_MH_REFUSAL_ARMED.load(Ordering::Acquire)
+            && let Ok(mut slot) = m1_mh_refusal_context().lock()
+        {
+            *slot = self.0.take();
+        } else if M1_MH_REFUSAL_ARMED.load(Ordering::Acquire) {
+            M1_MH_REFUSAL_ERROR.store(true, Ordering::Release);
+        }
+    }
+}
+pub fn mark_m1_mh_refusal_terminal() {
+    if M1_MH_REFUSAL_TOTAL.load(Ordering::Acquire) <= M1_MH_REFUSAL_CAP {
+        match m1_mh_refusal_record().lock() {
+            Ok(mut record) => {
+                if let Some(last) = record.last_mut() {
+                    last.terminal_propagated = true;
+                } else {
+                    M1_MH_REFUSAL_ERROR.store(true, Ordering::Release);
+                }
+            }
+            Err(_) => M1_MH_REFUSAL_ERROR.store(true, Ordering::Release),
+        }
+    }
+}
+pub fn arm_m1_mh_refusal_observation() {
+    if let Ok(mut record) = m1_mh_refusal_record().lock() {
+        record.clear();
+        if let Ok(mut context) = m1_mh_refusal_context().lock() {
+            *context = None;
+        }
+        M1_MH_REFUSAL_TOTAL.store(0, Ordering::Release);
+        M1_MH_REFUSAL_TRUNCATED.store(false, Ordering::Release);
+        M1_MH_REFUSAL_ERROR.store(false, Ordering::Release);
+        M1_MH_REFUSAL_ARMED.store(true, Ordering::Release);
+    }
+}
+pub fn take_m1_mh_refusal_observation() -> M1MhRefusalReport {
+    M1_MH_REFUSAL_ARMED.store(false, Ordering::Release);
+    let events = m1_mh_refusal_record().lock().map_or_else(
+        |_| {
+            M1_MH_REFUSAL_ERROR.store(true, Ordering::Release);
+            Vec::new()
+        },
+        |mut record| std::mem::take(&mut *record),
+    );
+    M1MhRefusalReport {
+        events,
+        total_count: M1_MH_REFUSAL_TOTAL.load(Ordering::Acquire),
+        truncated: M1_MH_REFUSAL_TRUNCATED.load(Ordering::Acquire),
+        observer_error: M1_MH_REFUSAL_ERROR.load(Ordering::Acquire),
+    }
+}
+fn record_m1_mh_refusal(
+    mass: f64,
+    enthalpy: f64,
+    temperature: Option<f64>,
+    predicate: &'static str,
+) {
+    if !M1_MH_REFUSAL_ARMED.load(Ordering::Acquire) {
+        return;
+    }
+    let ordinal = M1_MH_REFUSAL_TOTAL.fetch_add(1, Ordering::AcqRel);
+    if ordinal >= M1_MH_REFUSAL_CAP {
+        M1_MH_REFUSAL_TRUNCATED.store(true, Ordering::Release);
+        return;
+    }
+    if let Ok(mut record) = m1_mh_refusal_record().lock() {
+        record.push(M1MhRefusalObservation {
+            mass_bits: mass.to_bits(),
+            enthalpy_bits: enthalpy.to_bits(),
+            temperature_bits: temperature.map(f64::to_bits),
+            predicate,
+            context: match m1_mh_refusal_context().lock() {
+                Ok(slot) => slot.clone(),
+                Err(_) => {
+                    M1_MH_REFUSAL_ERROR.store(true, Ordering::Release);
+                    None
+                }
+            },
+            terminal_propagated: false,
+        });
+    } else {
+        M1_MH_REFUSAL_ERROR.store(true, Ordering::Release);
+    }
+}
