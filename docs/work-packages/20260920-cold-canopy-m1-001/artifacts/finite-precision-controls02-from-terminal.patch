+            raw_jacobian: jacobian,
+            normalizers: [1.0; 21],
+            scales,
+            lower,
+            upper,
+            initial_radius: 1.0,
+            base: [0.0; 21],
+            test_work: M1TrustRegionTestWorkState::default(),
