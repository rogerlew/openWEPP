+fn upward_mul(
+    left: f64,
+    right: f64,
+    coordinate: usize,
+    operations: &mut u16,
+) -> Result<f64, OptimalityFailure> {
+    if left < 0.0 || right < 0.0 {
+        return Err(optimality_failure(
+            "optimality_upward_enclosure",
+            coordinate,
+        ));
+    }
+    let left = upward_operand(left, coordinate)?;
+    let right = upward_operand(right, coordinate)?;
+    if left == 0.0 || right == 0.0 {
+        return Ok(0.0);
+    }
+    *operations += 1;
+    let product = left * right;
+    if !product.is_finite() {
+        return Err(optimality_failure(
+            "optimality_upward_enclosure",
+            coordinate,
+        ));
+    }
+    if product == 0.0 {
+        return Err(optimality_failure(
+            "optimality_underflow_to_zero",
+            coordinate,
+        ));
+    }
+    if !product.is_normal() {
+        return Err(optimality_failure(
+            "optimality_subnormal_intermediate",
+            coordinate,
+        ));
+    }
+    let upward = product.next_up();
+    if !upward.is_finite() || !upward.is_normal() {
+        return Err(optimality_failure(
+            "optimality_upward_enclosure",
+            coordinate,
+        ));
+    }
+    *operations += 1;
+    Ok(upward)
