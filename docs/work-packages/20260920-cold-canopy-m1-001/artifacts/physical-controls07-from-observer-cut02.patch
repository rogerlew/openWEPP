+fn m1_candidate_coordinate(
+    current: f64,
+    change: f64,
+    factor: f64,
+    eliminated_drainage: bool,
+) -> Result<f64, ()> {
+    if eliminated_drainage {
+        let candidate = (1.0 - factor) * current;
+        if !current.is_finite() || current < 0.0 || !candidate.is_finite() || candidate < 0.0 {
+            return Err(());
+        }
+        Ok(candidate)
+    } else {
+        Ok(current + factor * change)
+    }
+}
