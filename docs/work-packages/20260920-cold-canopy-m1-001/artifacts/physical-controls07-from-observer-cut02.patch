+            V11SharedResourceKind::Water => water_inventory
+                .get(&(key.ofe_id.clone(), key.layer_id.clone()))
+                .copied()
+                .ok_or(resource_construction_error(
+                    "water-beginning-ending-inventory",
+                    openwepp_vegetation::v11::V11Error::ResourceCustody,
+                ))?,
