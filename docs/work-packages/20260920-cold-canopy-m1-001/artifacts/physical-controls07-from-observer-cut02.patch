+            .iter()
+            .find(|value| value.owner_id == used.owner_id && value.key == used.key)
+            .ok_or(resource_construction_error(
+                "strict-nitrogen-authorization-identity",
+                openwepp_vegetation::v11::V11Error::ResourceDebit,
+            ))?;
