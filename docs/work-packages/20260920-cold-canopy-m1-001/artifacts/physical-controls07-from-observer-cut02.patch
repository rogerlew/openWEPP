+        assert!((actual.energy_j_m2_ofe_ground() - decimal(&frozen["ofe_energy"])).abs() <= 1e-8);
+        expected_ofe_mass += decimal(&frozen["ofe_mass"]);
+        expected_ofe_energy += decimal(&frozen["ofe_energy"]);
+    }
