+#[derive(Clone, Copy)]
+struct M1DrainageEliminationRow {
+    row: usize,
+    identity: usize,
+    support: f64,
+    duration: f64,
+    scale: f64,
+    current: f64,
+    raw_residual: f64,
+    raw_diagonal: f64,
+}
