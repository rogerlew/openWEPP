+        let Some(rows) = v["dependencies"].as_array() else {
+            return false;
+        };
+        v["schema_version"] == 1
+            && rows.len() == 10
+            && rows
+                .iter()
+                .filter_map(|row| row["path"].as_str())
+                .collect::<std::collections::BTreeSet<_>>()
+                .len()
+                == 10
+            && rows.iter().all(|row| {
+                row["path"]
+                    .as_str()
+                    .and_then(retained_bytes)
+                    .is_some_and(|bytes| row["sha256"].as_str() == Some(&sha(bytes)))
