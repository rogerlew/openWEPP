+                    .bgc_candidate
+                    .ending()
+                    .layers
+                    .get(&key.layer_id)
+                    .ok_or(resource_construction_error(
+                        "bgc-ending-inventory",
+                        openwepp_vegetation::v11::V11Error::ResourceCustody,
