+            .bgc_candidate
+            .beginning()
+            .layers
+            .get(layer)
+            .is_none()
+            || producer.bgc_candidate.ending().layers.get(layer).is_none()
+        {
+            return Err(resource_construction_error(
+                "bgc-beginning-ending-inventory",
+                openwepp_vegetation::v11::V11Error::ResourceDebit,
+            ));
+        }
