+/// Keep every approved locator alternative explicit in the detached inventory.
+/// This is a metadata-only guard: it neither drives nor invokes the evaluator.
+#[cfg(test)]
+#[test]
+fn m1_refinement_inventory_locator_alternatives_control() {
+    let inventory: serde_json::Value = serde_json::from_str(include_str!(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../../inventory-approved-discovery.json"
+    )))
+    .expect("approved inventory is valid JSON");
+    let entries = inventory["entries"]
+        .as_array()
+        .expect("approved inventory entries array");
+    let mut residual_term_zero = false;
+    let mut residual_interior = false;
+    let mut h0_matrix = false;
+    let mut h0_shift = false;
+    let mut h1_inner = false;
+    let mut h1_final_add = false;
+    let mut nonidentity_free_id = false;
+    let mut scratch_false = false;
+    let mut scratch_true = false;
+    for entry in entries.iter().filter(|entry| entry["stage"] != "not-applicable") {
+        let locator = &entry["locator"];
+        let alternatives = locator["variants"]
+            .as_array()
+            .or_else(|| locator["term_coordinate"].as_array());
+        for alternative in alternatives.into_iter().flatten() {
+            let operation = alternative["operation"].as_str();
+            h0_matrix |= operation == Some("matrix");
+            h0_shift |= operation == Some("shift");
+            let term = alternative["term"].as_u64();
+            residual_term_zero |= term == Some(0);
+            residual_interior |= term.is_some_and(|value| value > 0);
+            let coordinate = alternative["coordinate"].as_str();
+            nonidentity_free_id |= coordinate.is_some_and(|value| value.contains("free_ids"));
+        }
+        let term = locator["term"].as_str();
+        h1_inner |= term.is_some_and(|value| value.contains("inner"));
+        h1_final_add |= term.is_some_and(|value| value.contains("final-add"));
+        if let Some(values) = locator["scratch_box_feasible"].as_array() {
+            scratch_false |= values.iter().any(|value| value == false);
+            scratch_true |= values.iter().any(|value| value == true);
+        }
+    }
+    assert!(residual_term_zero && residual_interior);
+    assert!(h0_matrix && h0_shift);
+    assert!(h1_inner && h1_final_add);
+    assert!(nonidentity_free_id);
+    assert!(scratch_false && scratch_true);
