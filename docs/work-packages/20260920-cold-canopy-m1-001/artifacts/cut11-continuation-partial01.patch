+/// Factor-output terminals share a guard-stage name but have different copy
+/// boundaries.  The trace itself records each completed copy, so status must
+/// use that operation evidence instead of treating the entire stage as one
+/// boundary.
+#[cfg(test)]
+fn refinement_capture_factor_output_field_reached(
+    trace: &RefinementObservationTrace,
+    metadata: &super::M1TrustRegionRefinementFailureMetadata,
+    name: &str,
+) -> bool {
+    use super::M1TrustRegionCorrectionPosition as Position;
+    let ordinal = match metadata.correction_position {
+        Some(Position::First) => 1,
+        Some(Position::Second) => 2,
+        None => return refinement_capture_terminal_reaches_field(trace, metadata, name),
+    };
+    let snapshot = trace
+        .factor_application_snapshots
+        .get(usize::from(ordinal - 1));
+    let inverse_copy = snapshot.is_some_and(|entry| {
+        entry.inverse_t_bits.is_some()
+            && entry.inverse_denominator_bits.is_some()
+            && entry.inverse_z_bits.is_some()
+            && refinement_capture_legacy_inverse_matches(trace, entry)
+    });
+    let delta_copy = snapshot.is_some_and(|entry| {
+        let delta = if ordinal == 1 {
+            trace.delta0.as_ref()
+        } else {
+            trace.delta1.as_ref()
+        };
+        entry.delta_bits
+            == delta.map(|values| values.iter().map(|value| value.to_bits()).collect())
+    });
+    match name {
+        "inverse_t_bits" | "inverse_denominator_bits" | "inverse_z_bits" => inverse_copy,
+        "factor_application_snapshot_1_inverse_t_bits"
+        | "factor_application_snapshot_1_inverse_denominator_bits"
+        | "factor_application_snapshot_1_inverse_z_bits" => ordinal == 1 && inverse_copy,
+        "factor_application_snapshot_2_inverse_t_bits"
+        | "factor_application_snapshot_2_inverse_denominator_bits"
+        | "factor_application_snapshot_2_inverse_z_bits" => ordinal == 2 && inverse_copy,
+        "delta0_bits" => ordinal == 1 && delta_copy,
+        "delta1_bits" => ordinal == 2 && delta_copy,
+        "factor_application_snapshot_1_delta_bits" => ordinal == 1 && delta_copy,
+        "factor_application_snapshot_2_delta_bits" => ordinal == 2 && delta_copy,
+        "factor_application_snapshot_1_h_bits" => ordinal >= 1
+            && snapshot.is_some_and(|entry| entry.h_bits.is_some()),
+        "factor_application_snapshot_2_h_bits" => ordinal >= 2
+            && snapshot.is_some_and(|entry| entry.h_bits.is_some()),
+        _ => refinement_capture_terminal_reaches_field(trace, metadata, name),
+    }
+}
