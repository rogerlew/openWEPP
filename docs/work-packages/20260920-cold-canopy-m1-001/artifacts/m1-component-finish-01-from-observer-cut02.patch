+#[test]
+fn m1_restart_rejects_wrong_parent_day() {
+    let root: Value = serde_json::from_str(RESTARTS).expect("restart controls parse");
+    let context = restart_context(&root);
+    let mut record = root["positives"][0]["record"].clone();
+    record["day_index"] = Value::from(4);
+    let bytes = serde_json::to_string(&record).expect("day poison JSON");
+    let error =
+        M1RestartExtension::parse_and_validate(&bytes, &context).expect_err("parent day mismatch");
+    assert_eq!(error.code(), "VEG-E-144");
+    assert_eq!(error.stage().as_str(), "chronology");
+}
