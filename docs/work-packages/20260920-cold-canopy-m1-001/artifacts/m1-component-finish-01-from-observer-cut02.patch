+            (operand.wet_sensible_w_m2 - decimal(&expected["wet_sensible"][index])).abs() <= 1e-9
+        );
+        assert!(
+            (base.residuals()[6 * index + 3] - decimal(&expected["residual"][2 * index])).abs()
+                <= 1e-9
