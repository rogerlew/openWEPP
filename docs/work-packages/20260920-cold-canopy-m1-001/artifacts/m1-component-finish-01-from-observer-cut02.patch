+            "respiration_assimilation",
+        );
+        assert_gas_reference(
+            actual.shade.conductance_m_s,
+            &shade["gs_m_s"],
+            &gas,
+            "conductance_m_s",
+        );
+        assert_gas_reference(actual.shade.ci_pa, &shade["ci_pa"], &gas, "ci_pa");
+        assert_gas_reference(
+            actual.shade.vapor_kg_m2_tile_s,
