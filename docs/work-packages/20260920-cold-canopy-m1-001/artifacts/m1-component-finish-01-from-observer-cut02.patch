+        let plus_residual =
+            evaluate_m1_reservoir_residuals(beginning, plus, forcing, number(&control["d"]))
+                .expect("plus residual");
+        let minus_residual =
+            evaluate_m1_reservoir_residuals(beginning, minus, forcing, number(&control["d"]))
+                .expect("minus residual");
