+    assert_eq!(positives.len(), 3, "frozen positive restart membership");
+    for positive in positives {
+        let bytes = positive["canonical_utf8"].as_str().expect("positive bytes");
+        let extension =
+            M1RestartExtension::parse_and_validate(bytes, &context).expect("positive restart");
+        assert_eq!(extension.to_canonical_utf8().expect("roundtrip"), bytes);
+        assert_eq!(
+            extension.phase().as_str(),
+            positive["expected_phase"].as_str().expect("phase")
+        );
+    }
+    let poisons = root["poisons"].as_array().expect("23 poisons");
+    assert_eq!(poisons.len(), 23, "frozen poison restart membership");
+    for poison in poisons {
+        let error = M1RestartExtension::parse_and_validate(
+            poison["canonical_utf8"].as_str().expect("poison bytes"),
+            &context,
+        )
+        .expect_err("poison rejects");
+        assert_eq!(
+            error.code(),
+            poison["expected_error"].as_str().expect("error")
+        );
+        assert_eq!(
+            error.stage().as_str(),
+            poison["first_rejection_stage"].as_str().expect("stage")
+        );
+    }
+}
