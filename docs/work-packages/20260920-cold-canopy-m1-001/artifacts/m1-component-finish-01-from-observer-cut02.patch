+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Condition => "condition",
+            Self::Saturation => "saturation",
+            Self::MhConsistency => "mh_consistency",
+            Self::Capacity => "capacity",
+            Self::Parse => "parse",
+            Self::Version => "version",
+            Self::Identity => "identity",
+            Self::Chronology => "chronology",
+            Self::Ownership => "ownership",
+            Self::UnitsArea => "units_area",
+            Self::Domain => "domain",
+        }
+    }
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct M1Error {
+    code: &'static str,
+    stage: M1Stage,
+}
+impl M1Error {
+    const fn new(code: &'static str, stage: M1Stage) -> Self {
+        Self { code, stage }
+    }
+    #[must_use]
+    pub fn code(&self) -> &str {
+        self.code
+    }
+    #[must_use]
+    pub fn stage(&self) -> M1Stage {
+        self.stage
+    }
+    #[must_use]
+    pub const fn condition_error() -> Self {
+        Self::new("VEG-E-140", M1Stage::Condition)
+    }
+    #[must_use]
+    pub const fn saturation_error() -> Self {
+        Self::new("VEG-E-141", M1Stage::Saturation)
+    }
+}
+fn sat(
+    temperature_k: f64,
+    pressure_pa: f64,
+    phase: M1ExternalPhase,
+) -> Result<M1Saturation, M1Error> {
+    if !temperature_k.is_finite()
+        || !pressure_pa.is_finite()
+        || !(258.15..=373.15).contains(&temperature_k)
+        || !(80_000. ..=110_000.).contains(&pressure_pa)
+    {
+        return Err(M1Error::new("VEG-E-141", M1Stage::Saturation));
+    }
+    let (vapor_pressure_pa, vapor_pressure_derivative_pa_k) = if temperature_k >= TF {
+        warm_saturation_vapor_pressure_and_derivative_pa(temperature_k)
+            .map_err(|_| M1Error::new("VEG-E-141", M1Stage::Saturation))?
+    } else {
+        let (phase_heat_capacity, latent_heat_at_freezing) = match phase {
+            M1ExternalPhase::Liquid => (CW, LV),
+            M1ExternalPhase::Ice => (CI, 2_834_700.),
+        };
+        let heat_capacity_difference = phase_heat_capacity - CPV;
+        let latent_heat = latent_heat_at_freezing - heat_capacity_difference * (temperature_k - TF);
+        let vapor_pressure_pa = E0
+            * (TF / temperature_k).powf(heat_capacity_difference / RV)
+            * (latent_heat_at_freezing / (RV * TF) - latent_heat / (RV * temperature_k)).exp();
+        (
+            vapor_pressure_pa,
+            vapor_pressure_pa * latent_heat / (RV * temperature_k * temperature_k),
+        )
+    };
+    let humidity_denominator = pressure_pa - 0.378 * vapor_pressure_pa;
+    let specific_humidity_kg_kg = 0.622 * vapor_pressure_pa / humidity_denominator;
+    if !vapor_pressure_pa.is_finite()
+        || !vapor_pressure_derivative_pa_k.is_finite()
+        || vapor_pressure_pa <= 0.
+        || vapor_pressure_pa >= pressure_pa
+        || humidity_denominator.partial_cmp(&0.) != Some(std::cmp::Ordering::Greater)
+        || !(0. ..1.).contains(&specific_humidity_kg_kg)
+    {
+        return Err(M1Error::new("VEG-E-141", M1Stage::Saturation));
+    }
+    Ok(M1Saturation {
+        vapor_pressure_pa,
+        specific_humidity_kg_kg,
+        derivative_kg_kg_k: 0.622 * pressure_pa * vapor_pressure_derivative_pa_k
+            / humidity_denominator.powi(2),
+    })
+}
+pub fn m1_qsat_external(
+    temperature_k: f64,
+    pressure_pa: f64,
+    phase: M1ExternalPhase,
+) -> Result<M1Saturation, M1Error> {
+    sat(temperature_k, pressure_pa, phase)
+}
+pub fn m1_qsat_internal(temperature_k: f64, pressure_pa: f64) -> Result<M1Saturation, M1Error> {
+    sat(temperature_k, pressure_pa, M1ExternalPhase::Liquid)
+}
+#[derive(Clone, Copy, Debug)]
+pub struct M1PhaseReservoir {
+    m: f64,
+    h: f64,
+}
+impl M1PhaseReservoir {
+    pub fn from_mass_enthalpy(mass_kg_m2: f64, enthalpy_j_m2: f64) -> Result<Self, M1Error> {
+        if !mass_kg_m2.is_finite()
+            || !enthalpy_j_m2.is_finite()
+            || mass_kg_m2 < 0.
+            || (mass_kg_m2 == 0. && enthalpy_j_m2 != 0.)
+        {
+            Err(M1Error::new("VEG-E-142", M1Stage::MhConsistency))
+        } else {
+            let value = Self {
+                m: mass_kg_m2,
+                h: enthalpy_j_m2,
+            };
+            if let Some(temperature_k) = value.wet_temperature_k() {
+                if !temperature_k.is_finite() || !(258.15..=373.15).contains(&temperature_k) {
+                    return Err(M1Error::new("VEG-E-142", M1Stage::MhConsistency));
+                }
+            }
+            Ok(value)
+        }
+    }
+    #[must_use]
+    pub fn empty() -> Self {
+        Self { m: 0., h: 0. }
+    }
+    #[must_use]
+    pub fn phase(self) -> M1Phase {
+        if self.m == 0. {
+            M1Phase::Empty
+        } else if self.h >= 0. {
+            M1Phase::Liquid
+        } else if self.h >= -LF * self.m {
+            M1Phase::Mixed
+        } else {
+            M1Phase::Ice
+        }
+    }
+    #[must_use]
+    pub fn wet_temperature_k(self) -> Option<f64> {
+        if self.m == 0. {
+            None
+        } else {
+            Some(match self.phase() {
+                M1Phase::Empty => return None,
+                M1Phase::Liquid => TF + self.h / (self.m * CW),
+                M1Phase::Mixed => TF,
+                M1Phase::Ice => TF + (self.h + LF * self.m) / (self.m * CI),
+            })
+        }
+    }
+    /// Diagnosed total water mass on the plant-area basis.
+    #[must_use]
+    pub const fn mass_kg_m2(self) -> f64 {
+        self.m
+    }
+    /// Diagnosed enthalpy on the plant-area basis.
+    #[must_use]
+    pub const fn enthalpy_j_m2(self) -> f64 {
+        self.h
+    }
+    /// Phase-diagnosed liquid mass; ice and empty reservoirs contain none.
+    #[must_use]
+    pub fn liquid_mass_kg_m2(self) -> f64 {
+        self.ml()
+    }
+    pub fn temperature_jacobian(self) -> Result<M1TemperatureJacobian, M1Error> {
+        if self.m == 0. {
+            return Err(M1Error::new("VEG-E-142", M1Stage::MhConsistency));
+        }
+        let jacobian = match self.phase() {
+            M1Phase::Empty => return Err(M1Error::new("VEG-E-142", M1Stage::MhConsistency)),
+            M1Phase::Liquid => M1TemperatureJacobian {
+                d_t_d_m: -self.h / (self.m * self.m * CW),
+                d_t_d_h: 1.0 / (self.m * CW),
+            },
+            M1Phase::Mixed => M1TemperatureJacobian {
+                d_t_d_m: 0.,
+                d_t_d_h: 0.,
+            },
+            M1Phase::Ice => M1TemperatureJacobian {
+                d_t_d_m: -self.h / (self.m * self.m * CI),
+                d_t_d_h: 1.0 / (self.m * CI),
+            },
+        };
+        if !jacobian.d_t_d_m.is_finite() || !jacobian.d_t_d_h.is_finite() {
+            return Err(M1Error::new("VEG-E-142", M1Stage::MhConsistency));
+        }
+        Ok(jacobian)
+    }
+    fn ml(self) -> f64 {
+        match self.phase() {
+            M1Phase::Liquid => self.m,
+            M1Phase::Mixed => self.m + self.h / LF,
+            M1Phase::Empty | M1Phase::Ice => 0.,
+        }
+    }
+}
