+#[derive(Clone, Debug)]
+pub struct M1Error {
+    code: &'static str,
+    stage: M1Stage,
+}
+impl M1Error {
+    const fn new(code: &'static str, stage: M1Stage) -> Self {
+        Self { code, stage }
+    }
+    pub fn code(&self) -> &str {
+        self.code
+    }
+    pub fn stage(&self) -> M1Stage {
+        self.stage
+    }
+}
+fn sat(t: f64, p: f64, phase: M1ExternalPhase) -> Result<M1Saturation, M1Error> {
+    if !t.is_finite()
+        || !p.is_finite()
+        || !(258.15..=373.15).contains(&t)
+        || !(80000. ..=110000.).contains(&p)
+    {
+        return Err(M1Error::new("VEG-E-141", M1Stage::Saturation));
+    }
+    let (e, de) = if t >= TF {
+        let c = t - TF;
+        let (mut v, mut d) = (0., 0.);
+        for x in ES.iter().rev() {
+            d = d * c + v;
+            v = v * c + x;
+        }
+        (v * 100., d * 100.)
+    } else {
+        let (cp, l0) = match phase {
+            M1ExternalPhase::Liquid => (CW, LV),
+            M1ExternalPhase::Ice => (CI, 2834700.),
+        };
+        let a = cp - CPV;
+        let l = l0 - a * (t - TF);
+        let e = E0 * (TF / t).powf(a / RV) * (l0 / (RV * TF) - l / (RV * t)).exp();
+        (e, e * l / (RV * t * t))
+    };
+    let den = p - 0.378 * e;
+    let q = 0.622 * e / den;
+    if !e.is_finite()
+        || !de.is_finite()
+        || !(e > 0. && e < p)
+        || !(den > 0.)
+        || !(q >= 0. && q < 1.)
+    {
+        return Err(M1Error::new("VEG-E-141", M1Stage::Saturation));
+    };
+    Ok(M1Saturation {
+        vapor_pressure_pa: e,
+        specific_humidity_kg_kg: q,
+        derivative_kg_kg_k: 0.622 * p * de / den.powi(2),
+    })
+}
+pub fn m1_qsat_external(t: f64, p: f64, phase: M1ExternalPhase) -> Result<M1Saturation, M1Error> {
+    sat(t, p, phase)
+}
+pub fn m1_qsat_internal(t: f64, p: f64) -> Result<M1Saturation, M1Error> {
+    sat(t, p, M1ExternalPhase::Liquid)
+}
+#[derive(Clone, Copy, Debug)]
+pub struct M1PhaseReservoir {
+    m: f64,
+    h: f64,
+}
+impl M1PhaseReservoir {
+    pub fn from_mass_enthalpy(m: f64, h: f64) -> Result<Self, M1Error> {
+        if !m.is_finite() || !h.is_finite() || m < 0. || (m == 0. && h != 0.) {
+            Err(M1Error::new("VEG-E-142", M1Stage::MhConsistency))
+        } else {
+            Ok(Self { m, h })
+        }
+    }
+    pub fn empty() -> Self {
+        Self { m: 0., h: 0. }
+    }
+    pub fn phase(self) -> M1Phase {
+        if self.h >= 0. {
+            M1Phase::Liquid
+        } else if self.h >= -LF * self.m {
+            M1Phase::Mixed
+        } else {
+            M1Phase::Ice
+        }
+    }
+    pub fn wet_temperature_k(self) -> Option<f64> {
+        if self.m == 0. {
+            None
+        } else {
+            Some(match self.phase() {
+                M1Phase::Liquid => TF + self.h / (self.m * CW),
+                M1Phase::Mixed => TF,
+                M1Phase::Ice => TF + (self.h + LF * self.m) / (self.m * CI),
+            })
+        }
+    }
+    pub fn temperature_jacobian(self) -> M1TemperatureJacobian {
+        if self.m == 0. {
+            return M1TemperatureJacobian {
+                d_t_d_m: f64::NAN,
+                d_t_d_h: f64::NAN,
+            };
+        };
+        match self.phase() {
+            M1Phase::Liquid => M1TemperatureJacobian {
+                d_t_d_m: -self.h / (self.m * self.m * CW),
+                d_t_d_h: 1.0 / (self.m * CW),
+            },
+            M1Phase::Mixed => M1TemperatureJacobian {
+                d_t_d_m: 0.,
+                d_t_d_h: 0.,
+            },
+            M1Phase::Ice => M1TemperatureJacobian {
+                d_t_d_m: -self.h / (self.m * self.m * CI),
+                d_t_d_h: 1.0 / (self.m * CI),
+            },
+        }
+    }
+    fn ml(self) -> f64 {
+        match self.phase() {
+            M1Phase::Liquid => self.m,
+            M1Phase::Mixed => self.m + self.h / LF,
+            M1Phase::Ice => 0.,
+        }
+    }
+}
