+
+fn close(actual: f64, expected: f64, absolute: f64) {
+    assert!(
+        (actual - expected).abs() <= absolute,
+        "actual={actual:.17e}, expected={expected:.17e}"
+    );
+}
+
+fn close_relative(actual: f64, expected: f64, relative: f64) {
+    close(actual, expected, expected.abs().max(1.0) * relative);
+}
+
+fn number(value: &Value) -> f64 {
+    value
+        .as_str()
+        .expect("frozen decimal")
+        .parse()
+        .expect("valid frozen decimal")
+}
+
+fn restart_context(root: &Value) -> M1RestartValidationContext {
+    let bindings = &root["external_bindings"];
+    M1RestartValidationContext::from_external_bindings(
+        bindings["model_definition_digest_sha256"]["sha256"]
+            .as_str()
+            .expect("model"),
+        bindings["configuration_digest_sha256"]["sha256"]
+            .as_str()
+            .expect("configuration"),
+        bindings["topology_digest_sha256"]["sha256"]
+            .as_str()
+            .expect("topology"),
+        bindings["source_manifest_sha256"]["sha256"]
+            .as_str()
+            .expect("source"),
+        17,
+        3, // Expected parent checkpoint day; never derive it from the record.
+        "ofe-0",
+        "tile-0",
+        "upper",
+        120.0,
+        180.0,
+    )
+    .expect("reference context")
+}
