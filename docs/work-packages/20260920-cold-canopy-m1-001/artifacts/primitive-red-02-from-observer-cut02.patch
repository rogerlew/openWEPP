+//! M1 cold-canopy thermodynamic and restart primitives.
+use serde::{Deserialize, Serialize};
+const TF: f64 = 273.15;
+const CW: f64 = 4218.;
+const CI: f64 = 2106.;
+const LF: f64 = 333700.;
+const LV: f64 = 2501000.;
+const CPV: f64 = 1849.;
+const RV: f64 = 461.52;
+const E0: f64 = 611.213476;
+const RD: f64 = 287.04;
+const ES: [f64; 9] = [
+    6.11213476,
+    0.444007856,
+    0.0143064234,
+    0.000264461437,
+    0.00000305903558,
+    1.96237241e-8,
+    8.92344772e-11,
+    -3.73208410e-13,
+    2.09339997e-16,
+];
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum M1ExternalPhase {
