+    b: M1CapacityBranch,
+}
+impl M1CapacityResidual {
+    pub fn branch(self) -> M1CapacityBranch {
+        self.b
+    }
+}
+pub fn evaluate_m1_capacity_residual(x: M1CapacityTrial) -> Result<M1CapacityResidual, M1Error> {
+    if !x.ml.is_finite()
+        || !x.c.is_finite()
+        || !x.d.is_finite()
+        || !x.dt.is_finite()
+        || x.c < 0.
+        || x.d < 0.
+        || x.dt < 60.
+    {
+        return Err(M1Error::new("VEG-E-142", M1Stage::Capacity));
+    };
+    let a = x.dt * x.d;
+    let b = x.c - x.ml;
+    Ok(if a < b {
+        M1CapacityResidual {
+            residual_kg_m2: a,
+            b: M1CapacityBranch::Drainage,
+        }
+    } else {
+        M1CapacityResidual {
+            residual_kg_m2: b,
+            b: M1CapacityBranch::Capacity,
+        }
+    })
+}
+fn evap(e: M1PhaseReservoir, c: f64, v: VM) -> Result<f64, M1Error> {
+    match v {
+        VM::E(x) if x.is_finite() => Ok(x),
+        VM::E(_) => Err(M1Error::new("VEG-E-142", M1Stage::Domain)),
+        VM::B(b) => {
+            if !b.wet_conductance_m_s.is_finite()
+                || !b.plant_area_m2_m2.is_finite()
+                || !b.canopy_air_temperature_k.is_finite()
+                || !b.canopy_air_specific_humidity_kg_kg.is_finite()
+                || b.wet_conductance_m_s <= 0.
+                || b.plant_area_m2_m2 < 0.
+                || !(b.canopy_air_specific_humidity_kg_kg >= 0.
+                    && b.canopy_air_specific_humidity_kg_kg < 1.)
+                || c <= 0.
+            {
+                return Err(M1Error::new("VEG-E-141", M1Stage::Saturation));
+            };
+            let t = e
+                .wet_temperature_k()
+                .ok_or_else(|| M1Error::new("VEG-E-142", M1Stage::MhConsistency))?;
+            let ph = if e.phase() == M1Phase::Ice {
+                M1ExternalPhase::Ice
+            } else {
+                M1ExternalPhase::Liquid
+            };
+            Ok(b.pressure_pa / (RD * b.canopy_air_temperature_k)
+                * b.wet_conductance_m_s
+                * (e.m / c).powf(2.0 / 3.0).min(1.)
+                * b.plant_area_m2_m2
+                * (sat(t, b.pressure_pa, ph)?.specific_humidity_kg_kg
+                    - b.canopy_air_specific_humidity_kg_kg))
+        }
+    }
+}
+pub fn evaluate_m1_reservoir_residuals(
+    a: M1ReservoirState,
+    z: M1ReservoirState,
+    f: M1ReservoirForcing,
+    d: f64,
+) -> Result<M1Residuals, M1Error> {
+    let aa = a.p()?;
+    let zz = z.p()?;
+    if !f.dt.is_finite()
+        || f.dt < 60.
+        || ![f.i, f.hi, f.q, f.c, d].iter().all(|x| x.is_finite())
+        || f.c < 0.
+        || d < 0.
+    {
+        return Err(M1Error::new("VEG-E-142", M1Stage::Domain));
+    };
+    let e = evap(zz, f.c, f.v)?;
+    let t = zz.wet_temperature_k().unwrap_or(TF);
+    let cap =
+        evaluate_m1_capacity_residual(M1CapacityTrial::new(zz.ml(), f.c, d, f.dt))?.residual_kg_m2;
+    Ok(M1Residuals {
+        mass_kg_m2: z.mass_kg_m2 - a.mass_kg_m2 - f.dt * (f.i - e - d),
+        enthalpy_j_m2: z.enthalpy_j_m2
+            - a.enthalpy_j_m2
+            - f.dt * (f.q + f.i * f.hi - e * (LV + CPV * (t - TF)) - d * CW * (t - TF)),
+        capacity_kg_m2: cap,
+    })
+}
+#[derive(Clone, Copy, Debug)]
+pub struct M1EmptySurfaceInput {
+    pub surface: M1DrySurface,
+    pub area_m2_m2: f64,
+    pub temperature_k: f64,
+    pub pressure_pa: f64,
+    pub qcan_kg_kg: f64,
+    pub liquid_conducting_tissue: bool,
+}
+pub fn validate_m1_empty_surface(x: M1EmptySurfaceInput) -> Result<(), M1Error> {
+    if !x.liquid_conducting_tissue {
+        return Err(M1Error::new("VEG-E-140", M1Stage::Condition));
+    }
+    if !x.area_m2_m2.is_finite()
+        || x.area_m2_m2 < 0.
+        || !x.qcan_kg_kg.is_finite()
+        || !(x.qcan_kg_kg >= 0. && x.qcan_kg_kg < 1.)
+    {
+        return Err(M1Error::new("VEG-E-142", M1Stage::Domain));
+    }
+    if x.area_m2_m2 > 0.
+        && x.qcan_kg_kg
+            > sat(
+                x.temperature_k,
+                x.pressure_pa,
+                if x.temperature_k < TF {
+                    M1ExternalPhase::Ice
+                } else {
+                    M1ExternalPhase::Liquid
+                },
+            )?
+            .specific_humidity_kg_kg
+    {
+        return Err(M1Error::new("VEG-E-142", M1Stage::Domain));
+    }
+    Ok(())
+}
+fn digest(x: &str) -> bool {
+    x.len() == 64
+        && x.bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+#[derive(Clone, Debug)]
+pub struct M1RestartValidationContext {
+    d: [String; 4],
+    tx: u64,
+    day: u32,
+    ofe: String,
+    tile: String,
+    occ: String,
+    start: f64,
+    end: f64,
+}
+impl M1RestartValidationContext {
+    pub fn from_external_bindings(
+        a: &str,
+        b: &str,
+        c: &str,
+        d: &str,
+        tx: u64,
+        day: u32,
+        ofe: &str,
+        tile: &str,
+        occ: &str,
+        start: f64,
+        end: f64,
+    ) -> Result<Self, M1Error> {
+        if ![a, b, c, d].iter().all(|x| digest(x))
+            || tx == 0
+            || ofe.is_empty()
+            || tile.is_empty()
+            || occ.is_empty()
+            || !start.is_finite()
+            || !end.is_finite()
+            || end <= start
+        {
+            return Err(M1Error::new("VEG-E-144", M1Stage::Identity));
+        }
+        Ok(Self {
+            d: [a.into(), b.into(), c.into(), d.into()],
+            tx,
+            day,
+            ofe: ofe.into(),
+            tile: tile.into(),
+            occ: occ.into(),
+            start,
+            end,
+        })
+    }
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct M1RestartExtension {
+    area_basis: String,
+    configuration_digest_sha256: String,
+    consumed_transaction_cursor: u64,
+    day_index: u32,
+    enthalpy_unit: String,
+    h_j_m2: f64,
+    m_kg_h2o_m2: f64,
+    mass_unit: String,
+    model_definition_digest_sha256: String,
+    model_definition_id: String,
+    occupancy_id: String,
+    ofe_id: String,
+    schema_version: u32,
+    source_manifest_sha256: String,
+    support_end_s: f64,
+    support_start_s: f64,
+    tile_id: String,
+    topology_digest_sha256: String,
+    transaction_id: u64,
+}
+impl M1RestartExtension {
+    pub fn parse_and_validate(s: &str, x: &M1RestartValidationContext) -> Result<Self, M1Error> {
+        let r: Self =
+            serde_json::from_str(s).map_err(|_| M1Error::new("VEG-E-144", M1Stage::Parse))?;
+        if r.schema_version != 1 || r.model_definition_id != "OPENWEPP_C3_WOODY_COLD_M1_V1" {
+            return Err(M1Error::new("VEG-E-144", M1Stage::Version));
+        }
+        if ![
+            &r.model_definition_digest_sha256,
+            &r.configuration_digest_sha256,
+            &r.topology_digest_sha256,
+            &r.source_manifest_sha256,
+        ]
+        .iter()
+        .all(|z| digest(z))
+            || r.model_definition_digest_sha256 != x.d[0]
+            || r.configuration_digest_sha256 != x.d[1]
+            || r.topology_digest_sha256 != x.d[2]
+            || r.source_manifest_sha256 != x.d[3]
+        {
+            return Err(M1Error::new("VEG-E-144", M1Stage::Identity));
+        }
+        if r.transaction_id != x.tx
+            || r.consumed_transaction_cursor != r.transaction_id
+            || r.day_index != x.day
+            || r.support_start_s != x.start
+            || r.support_end_s != x.end
+            || !r.support_start_s.is_finite()
+            || !r.support_end_s.is_finite()
+            || r.support_end_s <= r.support_start_s
+        {
+            return Err(M1Error::new("VEG-E-144", M1Stage::Chronology));
+        }
+        if r.ofe_id != x.ofe || r.tile_id != x.tile || r.occupancy_id != x.occ {
+            return Err(M1Error::new("VEG-E-144", M1Stage::Ownership));
+        }
+        if r.area_basis != "tile_ground" || r.mass_unit != "kg_h2o_m2" || r.enthalpy_unit != "J_m2"
+        {
+            return Err(M1Error::new("VEG-E-144", M1Stage::UnitsArea));
+        }
+        let p = M1PhaseReservoir::from_mass_enthalpy(r.m_kg_h2o_m2, r.h_j_m2)
+            .map_err(|_| M1Error::new("VEG-E-144", M1Stage::MhConsistency))?;
+        if let Some(t) = p.wet_temperature_k() {
+            if !(258.15..=373.15).contains(&t) {
+                return Err(M1Error::new("VEG-E-144", M1Stage::Domain));
+            }
+        }
+        Ok(r)
+    }
+    pub fn to_canonical_utf8(&self) -> Result<String, M1Error> {
+        serde_json::to_string(self)
+            .map(|s| s + "\n")
+            .map_err(|_| M1Error::new("VEG-E-144", M1Stage::Parse))
+    }
+    pub fn phase(&self) -> M1Phase {
+        if self.h_j_m2 >= 0. {
+            M1Phase::Liquid
+        } else if self.h_j_m2 >= -LF * self.m_kg_h2o_m2 {
+            M1Phase::Mixed
+        } else {
+            M1Phase::Ice
+        }
+    }
+}
