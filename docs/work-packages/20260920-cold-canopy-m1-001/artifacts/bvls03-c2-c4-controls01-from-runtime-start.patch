+// C2--C4 are expected-red declarations for the next reviewed seam. They bind
+// the retained source operands and independent results directly, rather than a
+// second numerical implementation or manufactured refusal values.
+#[cfg(test)]
+mod bvls03_c2_c4_expected_red_controls {
+    use super::{
+        m1_trust_region_refinement_eligibility_for_test,
+        m1_trust_region_refinement_retained_face_for_test,
+        m1_trust_region_refinement_scratch_hooks_for_test,
+    };
+    use serde_json::Value;
+
+    const ORDINARY_CAPTURE: &str = include_str!(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../docs/work-packages/20260920-cold-canopy-m1-001/artifacts/finite-precision-observed-capture.json"
+    ));
+    const HISTORICAL_CAPTURE: &str = include_str!(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../docs/work-packages/20260920-cold-canopy-m1-001/artifacts/face-pivot-observed-capture.json"
+    ));
+    const RESULTS: &str = include_str!(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../docs/work-packages/20260920-cold-canopy-m1-001/artifacts/dot2-results.json"
+    ));
+
+    fn retained(case: usize) -> (Value, Value) {
+        let capture = serde_json::from_str(if case == 0 {
+            ORDINARY_CAPTURE
+        } else {
+            HISTORICAL_CAPTURE
+        })
+        .expect("retained capture");
+        let results: Value = serde_json::from_str(RESULTS).expect("independent Dot2 results");
+        (capture, results["cases"][case].clone())
+    }
+
+    #[test]
+    fn m1_trust_region_refinement_retained_face_reuses_factor_and_reproduces_all_bits() {
+        for case in 0..2 {
+            let (capture, expected) = retained(case);
+            let observed = m1_trust_region_refinement_retained_face_for_test(&capture, &expected)
+                .expect("retained face completes through unchanged BVLS02 decision");
+            assert_eq!(observed.p1_bits, expected["first_correction"]["p_bits"]);
+            assert_eq!(observed.dot2_residual_bits, expected["dot2_rows"].as_array().expect("rows").iter().map(|row| row["bits"].clone()).collect::<Vec<_>>());
+            assert_eq!(observed.p2_bits, expected["second_correction"]["p_bits"]);
+            assert_eq!(observed.factorizations_added, 0);
+            assert_eq!(observed.corrections, 2);
+            assert_eq!(observed.bvls02_decision, expected["second_correction"]["assessment"]);
+        }
+    }
+
+    #[test]
+    fn m1_trust_region_refinement_scratch_never_reaches_owner_or_physical_hooks() {
+        let (capture, expected) = retained(0);
+        let observed = m1_trust_region_refinement_scratch_hooks_for_test(&capture, &expected)
+            .expect("retained new-face scratch observation");
+        assert!(observed.p1_free_box_violation);
+        assert_eq!(observed.dot2_calls, 21);
+        assert_eq!(observed.physical_evaluator_calls, 0);
+        assert_eq!(observed.phase_calls, 0);
+        assert_eq!(observed.hydraulic_calls, 0);
+        assert_eq!(observed.merit_calls, 0);
+        assert_eq!(observed.materialization_calls, 0);
+        assert_eq!(observed.receipt_updates, 0);
+        assert_eq!(observed.owner_publications, 0);
+        assert!(observed.live_state_unchanged);
+    }
+
+    #[test]
+    fn m1_trust_region_refinement_eligibility_preserves_bvls02_for_ineligible_faces() {
+        let (capture, expected) = retained(0);
+        let observed = m1_trust_region_refinement_eligibility_for_test(&capture, &expected)
+            .expect("actual retained eligibility partition");
+        assert!(observed.lambda_zero_interior_refined);
+        assert!(observed.nonzero_lambda_uses_bvls02);
+        assert!(observed.radius_active_uses_bvls02);
+        assert!(observed.initial_box_infeasible_uses_bvls02);
+        assert!(observed.refinement_refusal_has_no_bvls02_fallback);
+        assert_eq!(observed.maximum_corrections, 2);
+        assert!(observed.denied_work_counted_before_entry);
+        assert!(observed.nested_budget_scope_restored);
+    }
