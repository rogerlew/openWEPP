+//! Contract-derived M1 expected-red tests.
+//!
+//! The reviewed API is intentionally absent before production implementation.
+//! This target must first fail at its public-module import. When it exists,
+//! every assertion below binds a frozen independent control.
+
+use openwepp_vegetation::cold_canopy_m1::{
+    M1CapacityTrial, M1DrySurface, M1EmptySurfaceInput, M1ExternalPhase, M1Phase, M1PhaseReservoir,
+    M1ReservoirForcing, M1ReservoirState, M1RestartExtension, M1RestartValidationContext,
+    M1VaporBoundary, evaluate_m1_capacity_residual, evaluate_m1_reservoir_residuals,
+    m1_qsat_external, m1_qsat_internal, validate_m1_empty_surface,
+};
+use serde_json::Value;
+
+const CONTROLS: &str = include_str!(concat!(
+    env!("CARGO_MANIFEST_DIR"),
+    "/../../docs/work-packages/20260920-cold-canopy-m1-001/artifacts/reference-controls-m1.json"
+));
+const RESTARTS: &str = include_str!(concat!(
+    env!("CARGO_MANIFEST_DIR"),
+    "/../../docs/work-packages/20260920-cold-canopy-m1-001/artifacts/restart-reference-m1.json"
+));
+
+fn close(actual: f64, expected: f64, absolute: f64) {
+    assert!(
+        (actual - expected).abs() <= absolute,
+        "actual={actual:.17e}, expected={expected:.17e}"
+    );
+}
+
+fn close_relative(actual: f64, expected: f64, relative: f64) {
+    close(actual, expected, expected.abs().max(1.0) * relative);
+}
+
+fn number(value: &Value) -> f64 {
+    value
+        .as_str()
+        .expect("frozen decimal")
+        .parse()
+        .expect("valid frozen decimal")
+}
+
+fn restart_context(root: &Value) -> M1RestartValidationContext {
+    let bindings = &root["external_bindings"];
+    M1RestartValidationContext::from_external_bindings(
+        bindings["model_definition_digest_sha256"]["sha256"]
+            .as_str()
+            .expect("model"),
+        bindings["configuration_digest_sha256"]["sha256"]
+            .as_str()
+            .expect("configuration"),
+        bindings["topology_digest_sha256"]["sha256"]
+            .as_str()
+            .expect("topology"),
+        bindings["source_manifest_sha256"]["sha256"]
+            .as_str()
+            .expect("source"),
+        17,
+        3, // Expected parent checkpoint day; never derive it from the record.
+        "ofe-0",
+        "tile-0",
+        "upper",
+        120.0,
+        180.0,
+    )
+    .expect("reference context")
+}
+
+#[test]
+fn m1_all_saturation_and_join_derivative_controls() {
+    let root: Value = serde_json::from_str(CONTROLS).expect("controls parse");
+    for control in root["saturation"]
+        .as_array()
+        .expect("ten saturation controls")
+    {
+        let phase = match control["phase_control"].as_str().expect("phase") {
+            "liquid" => M1ExternalPhase::Liquid,
+            "ice" => M1ExternalPhase::Ice,
+            other => panic!("unknown phase {other}"),
+        };
+        let actual = m1_qsat_external(
+            number(&control["temperature_k"]),
+            number(&control["pressure_pa"]),
+            phase,
+        )
+        .expect("saturation control");
+        close(actual.vapor_pressure_pa, number(&control["e_pa"]), 1.0e-9);
+        close(
+            actual.specific_humidity_kg_kg,
+            number(&control["q_kg_kg"]),
+            1.0e-15,
+        );
+        close(
+            actual.derivative_kg_kg_k,
+            number(&control["dq_kg_kg_k"]),
+            1.0e-15,
+        );
+    }
+    let liquid = m1_qsat_internal(263.15, 90_000.0).expect("liquid");
+    let ice = m1_qsat_external(263.15, 90_000.0, M1ExternalPhase::Ice).expect("ice");
+    assert!(liquid.specific_humidity_kg_kg > ice.specific_humidity_kg_kg);
+}
