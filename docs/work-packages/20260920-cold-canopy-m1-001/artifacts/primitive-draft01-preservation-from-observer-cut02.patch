+//! Default-off M1 cold-canopy thermodynamic primitives.
+use serde_json::Value;
+
+const TF: f64 = 273.15; const CW: f64 = 4218.0; const CI: f64 = 2106.0; const LF: f64 = 333700.0;
+const RV: f64 = 461.52; const CPV: f64 = 1849.0; const E0: f64 = 611.213476;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum M1ExternalPhase { Liquid, Ice }
+#[derive(Clone, Copy, Debug, PartialEq, Eq)] pub enum M1Phase { Liquid, Mixed, Ice }
+impl M1Phase { #[must_use] pub fn as_str(self)->&'static str { match self {Self::Liquid=>"liquid",Self::Mixed=>"mixed",Self::Ice=>"ice"} } }
+#[derive(Clone, Copy, Debug)] pub struct M1Saturation { pub vapor_pressure_pa:f64,pub specific_humidity_kg_kg:f64,pub derivative_kg_kg_k:f64 }
+#[derive(Clone, Copy, Debug)] pub struct M1TemperatureJacobian { pub d_t_d_m:f64,pub d_t_d_h:f64 }
+#[derive(Clone, Copy, Debug)] pub struct M1PhaseReservoir { m:f64,h:f64 }
+impl M1PhaseReservoir { pub fn from_mass_enthalpy(m:f64,h:f64)->Result<Self,M1Error>{if !m.is_finite()||!h.is_finite()||m<0.||m==0.&&h!=0.{return Err(M1Error::new("VEG-E-142","mh"));}Ok(Self{m,h})} #[must_use] pub fn empty()->Self{Self{m:0.,h:0.}} #[must_use] pub fn phase(self)->M1Phase{if self.h>=0.{M1Phase::Liquid}else if self.h>=-LF*self.m{M1Phase::Mixed}else{M1Phase::Ice}} #[must_use] pub fn wet_temperature_k(self)->Option<f64>{if self.m==0.{None}else{Some(match self.phase(){M1Phase::Liquid=>TF+self.h/(self.m*CW),M1Phase::Mixed=>TF,M1Phase::Ice=>TF+(self.h+LF*self.m)/(self.m*CI)})}} #[must_use] pub fn temperature_jacobian(self)->M1TemperatureJacobian{match self.phase(){M1Phase::Liquid=>M1TemperatureJacobian{d_t_d_m:-self.h/(self.m*self.m*CW),d_t_d_h:1./(self.m*CW)},M1Phase::Mixed=>M1TemperatureJacobian{d_t_d_m:0.,d_t_d_h:0.},M1Phase::Ice=>M1TemperatureJacobian{d_t_d_m:-self.h/(self.m*self.m*CI),d_t_d_h:1./(self.m*CI)}}} }
+#[derive(Clone,Debug)] pub struct M1Error{code:&'static str,stage:&'static str} impl M1Error{fn new(code:&'static str,stage:&'static str)->Self{Self{code,stage}} #[must_use]pub fn code(&self)->&str{self.code} #[must_use]pub fn stage(&self)->M1Stage{M1Stage(self.stage)}} #[derive(Clone,Copy,Debug)]pub struct M1Stage(&'static str);impl M1Stage{#[must_use]pub fn as_str(self)->&str{self.0}}
+fn sat(t:f64,p:f64,phase:M1ExternalPhase)->Result<M1Saturation,M1Error>{if !t.is_finite()||!p.is_finite()||p<=0.{return Err(M1Error::new("VEG-E-141","domain"));} let (e,de)=if t>=TF{let d=t-TF;let e=E0+44.4007856*d+0.002861284759375*d*d; (e,44.4007856+0.00572256951875*d)}else{let cp=match phase{M1ExternalPhase::Liquid=>CW,M1ExternalPhase::Ice=>CI};let l0=match phase{M1ExternalPhase::Liquid=>2501000.,M1ExternalPhase::Ice=>2834700.};let a=cp-CPV;let l=l0-a*(t-TF);let e=E0*(TF/t).powf(a/RV)*(l0/(RV*TF)-l/(RV*t)).exp();(e,e*l/(RV*t*t))};if !(e>0.&&e<p){return Err(M1Error::new("VEG-E-141","domain"));}let q=0.622*e/(p-0.378*e);if !(q>=0.&&q<1.){return Err(M1Error::new("VEG-E-141","domain"));}Ok(M1Saturation{vapor_pressure_pa:e,specific_humidity_kg_kg:q,derivative_kg_kg_k:0.622*p*de/(p-0.378*e).powi(2)})}
+pub fn m1_qsat_external(t:f64,p:f64,phase:M1ExternalPhase)->Result<M1Saturation,M1Error>{sat(t,p,phase)} pub fn m1_qsat_internal(t:f64,p:f64)->Result<M1Saturation,M1Error>{sat(t,p,M1ExternalPhase::Liquid)}
