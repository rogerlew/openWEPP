+#[test]
+fn m1_assembled_ice_residual_jacobian_columns() {
+    let root: Value = serde_json::from_str(CONTROLS).expect("controls parse");
+    let control = &root["assembled_reservoir_column_control"];
+    let base_m = number(&control["m"]);
+    let base_h = number(&control["h"]);
+    let beginning = M1ReservoirState::new(base_m, base_h);
+    let boundary = M1VaporBoundary {
+        wet_conductance_m_s: number(&control["gb"]),
+        plant_area_m2_m2: number(&control["plant_area"]),
+        canopy_air_temperature_k: number(&control["tcan"]),
+        canopy_air_specific_humidity_kg_kg: number(&control["qcan"]),
+        pressure_pa: number(&control["pressure"]),
+    };
+    let forcing = M1ReservoirForcing::with_vapor_boundary(
+        number(&control["dt"]),
+        number(&control["i"]),
+        0.0,
+        number(&control["q_nonvapor"]),
+        number(&control["capacity"]),
+        boundary,
+    );
+    for expected in control["columns"].as_array().expect("M/H columns") {
+        let step = number(&expected["step"]);
+        let coordinate = expected["coordinate"].as_str().expect("coordinate");
+        let plus = match coordinate {
+            "M" => M1ReservoirState::new(base_m + step, base_h),
+            "H" => M1ReservoirState::new(base_m, base_h + step),
+            other => panic!("unknown column {other}"),
+        };
+        let minus = match coordinate {
+            "M" => M1ReservoirState::new(base_m - step, base_h),
+            "H" => M1ReservoirState::new(base_m, base_h - step),
+            other => panic!("unknown column {other}"),
+        };
+        let plus_residual =
+            evaluate_m1_reservoir_residuals(beginning, plus, forcing, number(&control["d"]))
+                .expect("plus residual");
+        let minus_residual =
+            evaluate_m1_reservoir_residuals(beginning, minus, forcing, number(&control["d"]))
+                .expect("minus residual");
+        let values = expected["analytic"].as_array().expect("analytic column");
+        let relative = number(&control["relative_tolerance"]);
+        close_relative(
+            (plus_residual.mass_kg_m2 - minus_residual.mass_kg_m2) / (2.0 * step),
+            number(&values[0]),
+            relative,
+        );
+        close_relative(
+            (plus_residual.enthalpy_j_m2 - minus_residual.enthalpy_j_m2) / (2.0 * step),
+            number(&values[1]),
+            relative,
+        );
+    }
+}
