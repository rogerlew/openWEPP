+#[test]
+fn m1_all_inverse_and_ice_jacobian_controls() {
+    let root: Value = serde_json::from_str(CONTROLS).expect("controls parse");
+    for control in root["inverse"].as_array().expect("four inverse controls") {
+        let reservoir = M1PhaseReservoir::from_mass_enthalpy(
+            number(&control["mass_kg_m2"]),
+            number(&control["enthalpy_j_m2"]),
+        )
+        .expect("inverse control");
+        assert_eq!(
+            reservoir.phase().as_str(),
+            control["phase"].as_str().expect("phase")
+        );
+        close(
+            reservoir
+                .wet_temperature_k()
+                .expect("positive inverse control"),
+            number(&control["temperature_k"]),
+            1.0e-12,
+        );
+    }
+    let control = &root["ice_inverse_jacobian"];
+    let ice = M1PhaseReservoir::from_mass_enthalpy(number(&control["m"]), number(&control["h"]))
+        .expect("ice control");
+    assert_eq!(ice.phase(), M1Phase::Ice);
+    close(
+        ice.temperature_jacobian().d_t_d_m,
+        number(&control["expected_dt_dm"]),
+        1.0e-6,
+    );
+    close(
+        ice.temperature_jacobian().d_t_d_h,
+        number(&control["expected_dt_dh"]),
+        1.0e-12,
+    );
+}
