+#[test]
+fn m1_empty_surface_guards_enumerate_all_controls() {
+    let root: Value = serde_json::from_str(CONTROLS).expect("controls parse");
+    for control in root["empty_surface_controls"]
+        .as_array()
+        .expect("six empty controls")
+    {
+        let name = control["positive_area_surface"]
+            .as_str()
+            .or_else(|| control["tested_surface"].as_str())
+            .unwrap_or("shade");
+        let surface = match name {
+            "sun" => M1DrySurface::Sun,
+            "shade" => M1DrySurface::Shade,
+            "stem" => M1DrySurface::Stem,
+            other => panic!("surface {other}"),
+        };
+        let result = validate_m1_empty_surface(M1EmptySurfaceInput {
+            surface,
+            area_m2_m2: control["area_m2_m2"]
+                .as_str()
+                .map_or(1.0, |value| value.parse().expect("area decimal")),
+            temperature_k: number(&control["temperature_k"]),
+            pressure_pa: number(&control["pressure_pa"]),
+            qcan_kg_kg: number(&control["qcan"]),
+            liquid_conducting_tissue: control["liquid_conducting_tissue"]
+                .as_bool()
+                .unwrap_or(true),
+        });
+        if let Some(code) = control["expected_error"].as_str() {
+            assert_eq!(result.expect_err("poison").code(), code);
+        } else {
+            result.expect("admitted empty case");
+        }
+    }
+    let empty = M1PhaseReservoir::empty();
+    assert!(empty.wet_temperature_k().is_none());
+    assert!(m1_qsat_internal(f64::NAN, 90_000.0).is_err());
+    assert!(m1_qsat_external(373.15, 80_000.0, M1ExternalPhase::Liquid).is_err());
+}
