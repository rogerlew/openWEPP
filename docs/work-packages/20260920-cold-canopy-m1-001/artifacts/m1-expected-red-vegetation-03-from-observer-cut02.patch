+#[test]
+fn m1_signed_vapor_ledger_and_capacity_controls() {
+    let root: Value = serde_json::from_str(CONTROLS).expect("controls parse");
+    for control in root["constant_temperature_ice_vapor_controls"]
+        .as_array()
+        .expect("two signed vapor controls")
+    {
+        let forcing = M1ReservoirForcing::prescribed(
+            number(&control["dt_s"]),
+            0.0,
+            0.0,
+            number(&control["q_nonvapor_w_m2"]),
+            number(&control["e_kg_m2_s"]),
+            0.297,
+        );
+        let beginning = M1ReservoirState::new(number(&control["m0"]), number(&control["h0"]));
+        let ending = M1ReservoirState::new(number(&control["m1"]), number(&control["h1"]));
+        let residual = evaluate_m1_reservoir_residuals(beginning, ending, forcing, 0.0)
+            .expect("ledger residual");
+        close(
+            residual.mass_kg_m2,
+            number(&control["expected_mass_residual"]),
+            1.0e-9,
+        );
+        close(
+            residual.enthalpy_j_m2,
+            number(&control["expected_energy_residual"]),
+            1.0e-6,
+        );
+        let fusion_poison = M1ReservoirState::new(
+            number(&control["m1"]),
+            number(&control["h1"]) - number(&control["extra_fusion_debit_poison_j_m2"]),
+        );
+        assert!(
+            evaluate_m1_reservoir_residuals(beginning, fusion_poison, forcing, 0.0)
+                .expect("poison residual")
+                .enthalpy_j_m2
+                .abs()
+                > 1.0e-6
+        );
+    }
+    for control in root["capacity_controls"]
+        .as_array()
+        .expect("four capacity controls")
+    {
+        let trial = M1CapacityTrial::new(
+            number(&control["liquid_mass"]),
+            number(&control["capacity"]),
+            number(&control["d"]),
+            number(&control["dt"]),
+        );
+        let outcome = evaluate_m1_capacity_residual(trial);
+        match control["name"].as_str().expect("capacity name") {
+            "capacity_active_melting" => {
+                close(outcome.expect("active").residual_kg_m2, 0.0, 1.0e-9)
+            }
+            "capacity_tie" => assert_eq!(outcome.expect("tie").branch().as_str(), "capacity"),
+            "overcapacity_trial" => close(outcome.expect("trial").residual_kg_m2, -1.0e-8, 1.0e-12),
+            "negative_drainage" => assert!(outcome.is_err()),
+            other => panic!("unknown capacity control {other}"),
+        }
+        if control["name"].as_str() == Some("capacity_active_melting") {
+            let forcing = M1ReservoirForcing::prescribed(
+                number(&control["dt"]),
+                number(&control["i"]),
+                0.0,
+                number(&control["q"]),
+                number(&control["e"]),
+                number(&control["capacity"]),
+            );
+            let residual = evaluate_m1_reservoir_residuals(
+                M1ReservoirState::new(number(&control["m0"]), number(&control["h0"])),
+                M1ReservoirState::new(number(&control["m1"]), number(&control["h1"])),
+                forcing,
+                number(&control["d"]),
+            )
+            .expect("active prescribed residual");
+            close(residual.mass_kg_m2, number(&control["expected_rm"]), 1.0e-9);
+            close(
+                residual.enthalpy_j_m2,
+                number(&control["expected_rh"]),
+                1.0e-6,
+            );
+            close(
+                residual.capacity_kg_m2,
+                number(&control["expected_rcap"]),
+                1.0e-9,
+            );
+        }
+    }
+}
