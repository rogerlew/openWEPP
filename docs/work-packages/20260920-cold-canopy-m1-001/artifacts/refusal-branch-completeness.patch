 #[cfg(test)]
+fn refinement_capture_selected_terminal_kind(
+    metadata: &super::M1TrustRegionRefinementFailureMetadata,
+) -> bool {
+    use super::{
+        M1TrustRegionCorrectionPosition as Position, M1TrustRegionRefinementGuardStage as Stage,
+        M1TrustRegionRefinementReason as Reason,
+    };
+    let positive = metadata.lambda.is_finite() && metadata.lambda > 0.0;
+    let zero = metadata.lambda == 0.0;
+    let dot = matches!(
+        metadata.reason,
+        Reason::NonfiniteOperand | Reason::SubnormalIntermediate | Reason::UnderflowToZero
+    );
+    let row = metadata.row.is_some_and(|value| value < 21);
+    let coordinate = metadata.coordinate.is_some_and(|value| value < 21);
+    let no_locator =
+        metadata.row.is_none() && metadata.term.is_none() && metadata.coordinate.is_none();
+    let scratch = metadata.scratch_box_feasible;
+    match (metadata.correction_position, metadata.guard_stage) {
+        (None, Stage::ActiveFinite) => {
+            positive
+                && metadata.reason == Reason::SubnormalIntermediate
+                && coordinate
+                && metadata.row.is_none()
+                && metadata.term.is_none()
+                && scratch.is_none()
+        }
+        (None, Stage::P0FullRadius) => {
+            positive && no_locator && (metadata.reason == Reason::FinalRadius || dot)
+        }
+        (None, Stage::OrderedNorm) => {
+            zero && metadata.reason == Reason::NonfiniteOperand && no_locator
+        }
+        (
+            Some(Position::First),
+            Stage::ResidualSourceTerm | Stage::PrimaryProduct | Stage::Accumulation,
+        ) => dot && row && metadata.term.is_some() && coordinate && scratch.is_none(),
+        (Some(Position::First), Stage::FactorApplicationOutput) => {
+            metadata.reason == Reason::FactorOutput && no_locator && scratch.is_none()
+        }
+        (Some(Position::First), Stage::CoordinateUpdate) => {
+            metadata.reason == Reason::CoordinateUpdate
+                && coordinate
+                && metadata.row.is_none()
+                && metadata.term.is_none()
+                && scratch.is_none()
+        }
+        (Some(Position::First), Stage::ScratchBoxLower | Stage::ScratchBoxUpper) => {
+            positive
+                && metadata.reason == Reason::ScratchBox
+                && coordinate
+                && metadata.row.is_none()
+                && metadata.term.is_none()
+                && scratch == Some(false)
+        }
+        (Some(Position::First), Stage::ScratchFullRadius) => {
+            positive
+                && no_locator
+                && scratch == Some(true)
+                && (dot || metadata.reason == Reason::ScratchRadius)
+        }
+        (Some(Position::First), Stage::ScratchReducedRadius) => {
+            positive
+                && no_locator
+                && scratch == Some(true)
+                && metadata.reason == Reason::ScratchRadius
+        }
+        (Some(Position::First), Stage::OrderedNorm) => {
+            zero && metadata.reason == Reason::NonfiniteOperand && no_locator && scratch.is_some()
+        }
+        (Some(Position::First), Stage::RadiusComparison) => {
+            zero && metadata.reason == Reason::ScratchRadius && no_locator && scratch.is_some()
+        }
+        (Some(Position::Second), _) => refinement_capture_selected_second_terminal(metadata),
+        _ => false,
+    }
+}
