+#[cfg(test)]
+fn refinement_capture_selected_second_terminal(
+    metadata: &super::M1TrustRegionRefinementFailureMetadata,
+) -> bool {
+    use super::{
+        M1TrustRegionRefinementGuardStage as Stage, M1TrustRegionRefinementReason as Reason,
+    };
+    let positive = metadata.lambda.is_finite() && metadata.lambda > 0.0;
+    let zero = metadata.lambda == 0.0;
+    let dot = matches!(
+        metadata.reason,
+        Reason::NonfiniteOperand | Reason::SubnormalIntermediate | Reason::UnderflowToZero
+    );
+    let row = metadata.row.is_some_and(|value| value < 21);
+    let coordinate = metadata.coordinate.is_some_and(|value| value < 21);
+    let no_locator =
+        metadata.row.is_none() && metadata.term.is_none() && metadata.coordinate.is_none();
+    let scratch = metadata.scratch_box_feasible;
+    match metadata.guard_stage {
+        Stage::PrimaryProduct
+        | Stage::SplitterProduct
+        | Stage::SplitOutput
+        | Stage::EftRemainder
+        | Stage::TwoSumResult
+        | Stage::TwoSumRemainder
+        | Stage::Accumulation => {
+            dot && row && metadata.term.is_some() && coordinate && scratch.is_some()
+        }
+        Stage::FactorApplicationOutput => {
+            metadata.reason == Reason::FactorOutput && no_locator && scratch.is_some()
+        }
+        Stage::CoordinateUpdate => {
+            metadata.reason == Reason::CoordinateUpdate
+                && coordinate
+                && metadata.row.is_none()
+                && metadata.term.is_none()
+                && scratch.is_some()
+        }
+        Stage::FinalBoxLower | Stage::FinalBoxUpper => {
+            metadata.reason == Reason::FinalBox
+                && coordinate
+                && metadata.row.is_none()
+                && metadata.term.is_none()
+                && scratch.is_some()
+        }
+        Stage::FinalFullRadius => {
+            positive
+                && no_locator
+                && scratch == Some(true)
+                && (dot || metadata.reason == Reason::FinalRadius)
+        }
+        Stage::FinalReducedRadius | Stage::FinalRadiusCloseness => {
+            positive
+                && no_locator
+                && scratch == Some(true)
+                && metadata.reason == Reason::FinalRadius
+        }
+        Stage::OrderedNorm | Stage::RadiusComparison => {
+            zero && no_locator && scratch.is_some() && metadata.reason == Reason::FinalRadius
+        }
+        _ => false,
+    }
+}
