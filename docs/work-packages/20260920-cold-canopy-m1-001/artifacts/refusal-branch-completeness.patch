+#[cfg(test)]
+fn refinement_capture_final_radius_operands_join(
+    trace: &RefinementObservationTrace,
+    metadata: &super::M1TrustRegionRefinementFailureMetadata,
+    require_closeness: bool,
+) -> bool {
+    let Some(radius) = trace.remaining_radius else {
+        return false;
+    };
+    if radius.to_bits() != metadata.reduced_face_radius.to_bits() {
+        return false;
+    }
+    if !require_closeness {
+        return true;
+    }
+    let Some(free_norm) = trace.p2_reduced_norm else {
+        return false;
+    };
+    let Some(gap) = trace.radius_gap else {
+        return false;
+    };
+    let Some(tolerance) = trace.radius_tolerance else {
+        return false;
+    };
+    let expected_gap = radius - free_norm;
+    let a = 2_f64.powi(-40) * radius;
+    let b = 64.0 * f64::EPSILON * radius.max(1.0);
+    gap.to_bits() == expected_gap.to_bits() && tolerance.to_bits() == a.max(b).to_bits()
 }
 
