+            true,
+            false,
+            None,
+            "phase_join_selection",
+        ),
+        "fd_trial_is_admissible_screening_constructor" => m1_w3_full_context(
+            context,
+            "fd_admissibility_trial",
+            false,
+            false,
+            None,
+            "fd_admissibility",
