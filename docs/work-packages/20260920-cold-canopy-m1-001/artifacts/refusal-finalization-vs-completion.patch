+#[cfg(feature = "m1-trust-region-physical-stage")]
+fn m1_w3_primary_site_context(
+    context: &openwepp_vegetation::cold_canopy_m1::M1MhObservationContext,
+) -> bool {
+    match context.site {
+        "validate_with_q_guard_initial_reservoir" => m1_w3_full_context(
+            context,
+            "beginning_input_reservoir",
+            false,
+            false,
+            None,
+            "validate_with_q_guard",
+        ),
+        "jacobian_base_core" => m1_w3_full_context(
+            context,
+            "jacobian_base_trial",
+            false,
+            false,
+            None,
+            "jacobian_base_core",
+        ),
+        "adapter_base_core" => {
+            context.state_role == "adapter_base_trial"
+                && context.proposal_direction_bits.is_none()
+                && context.fd_column.is_none()
+                && context.fd_side.is_none()
+                && context.pass == "adapter_base_evaluation"
+                && matches!(
+                    (context.representation, context.map_identity),
+                    ("full", "full_logical_to_physical_identity")
+                        | ("reduced", "reduced_zero_sun_logical_to_physical_map")
+                )
+        }
+        "adapter_candidate_core" => {
+            context.state_role == "adapter_candidate_trial"
+                && context.proposal_direction_bits.is_none()
+                && context.fd_column.is_none()
+                && context.fd_side.is_none()
+                && context.pass == "adapter_candidate_evaluation"
+                && matches!(
+                    (context.representation, context.map_identity),
+                    ("full", "full_logical_to_physical_identity")
+                        | ("reduced", "reduced_zero_sun_logical_to_physical_map")
+                )
+        }
+        "selected_probe_core" => m1_w3_full_context(
+            context,
+            "selected_probe_candidate",
+            true,
+            false,
+            None,
+            "selected_probe_core",
+        ),
+        "jacobian_reservoir" => m1_w3_full_context(
+            context,
+            "jacobian_base_trial",
+            false,
+            true,
+            None,
+            "jacobian",
+        ),
+        _ => false,
+    }
