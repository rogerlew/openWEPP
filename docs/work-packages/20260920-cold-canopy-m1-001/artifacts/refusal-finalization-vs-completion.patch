+#[cfg(test)]
+fn refinement_capture_terminal_complete(
+    trace: &RefinementObservationTrace,
+    terminal: Option<&super::M1TrustRegionRefinementFailureMetadata>,
+) -> bool {
+    use super::{
+        M1TrustRegionCorrectionPosition as Position, M1TrustRegionRefinementGuardStage as Stage,
+    };
+    let Some(metadata) = terminal else {
+        return false;
+    };
+    // The metadata position identifies the executed correction.  The guard
+    // stage alone is intentionally insufficient: Dot2 guards recur in p0,
+    // the first residual/factor/update, and the second residual/factor/update.
+    let positive_lambda = metadata.lambda.is_finite() && metadata.lambda > 0.0;
+    let zero_lambda = metadata.lambda == 0.0;
+    if !positive_lambda && !zero_lambda {
+        return false;
+    }
+    let boundary =
+        trace.live_state_entry.is_some() && trace.live_state_exit.is_some() && trace.work.is_some();
+    let structural = refinement_capture_common_complete(trace);
+    // The p0 assembly guard is the one legitimate terminal before p0 exists.
+    if metadata.correction_position.is_none()
+        && matches!(metadata.guard_stage, Stage::P0AssemblyEquality)
+    {
+        return boundary && structural && trace.p0.is_none() && trace.factor_applications == 0;
+    }
+    let Some(p0_values) = trace.p0.as_ref() else {
+        return false;
+    };
+    let full: Vec<_> = (0..21).collect();
+    let Some(free_ids) = trace.face_free_ids.as_ref() else {
+        return false;
+    };
+    let p0 = trace.lower_mask_p0.is_some() && trace.upper_mask_p0.is_some();
+    let p0_norms = if positive_lambda {
+        refinement_capture_exact_norm(trace, "p0_full", p0_values, &full)
+            && refinement_capture_exact_norm(trace, "p0_free", p0_values, free_ids)
+    } else {
+        refinement_capture_exact_norm(trace, "p0_zero_lambda_eligibility", p0_values, &full)
+    };
+    let p1_present =
+        trace.p1.is_some() && trace.lower_mask_p1.is_some() && trace.upper_mask_p1.is_some();
+    let p1_norms = trace.p1.as_ref().is_some_and(|values| {
+        if positive_lambda {
+            refinement_capture_exact_norm(trace, "p1_full", values, &full)
+                && refinement_capture_exact_norm(trace, "p1_free", values, free_ids)
+        } else {
+            refinement_capture_exact_norm(trace, "p1_zero_lambda_scratch", values, &full)
+        }
+    });
+    let p2_present =
+        trace.p2.is_some() && trace.lower_mask_p2.is_some() && trace.upper_mask_p2.is_some();
+    let first_factor_shape = if positive_lambda {
+        trace.h0.is_some()
+            && trace.inverse_t.is_some()
+            && trace.inverse_denominator.is_some()
+            && trace.inverse_z.is_some()
+    } else {
+        trace.h0.is_none()
+    };
+    let second_factor_shape = if positive_lambda {
+        trace.h1.is_some()
+            && trace.inverse_t.is_some()
+            && trace.inverse_denominator.is_some()
+            && trace.inverse_z.is_some()
+    } else {
+        trace.h1.is_none()
+            && trace.inverse_t.is_none()
+            && trace.inverse_denominator.is_none()
+            && trace.inverse_z.is_none()
+    };
+    let lineage = refinement_capture_lineage_complete(trace, metadata);
+    let applications = |count| refinement_capture_applications_complete(trace, count);
+    let no_p1 = refinement_capture_no_p1(trace, p1_present);
+    let no_p2 = refinement_capture_no_p2(trace, p2_present);
+    let first_started = trace.residual0.is_some();
+    let first_delta = trace.delta0.is_some();
+    let first_complete = first_started && first_delta && p1_present && p1_norms;
+    let second_started = trace.residual1.is_some();
+    let second_delta = trace.delta1.is_some();
+    let common = boundary && structural && p0 && p0_norms && lineage;
+
+    refinement_capture_terminal_matrix!(
+        metadata,
+        common,
+        boundary,
+        structural,
+        p0,
+        lineage,
+        applications,
+        positive_lambda,
+        zero_lambda,
+        p0_values,
+        full,
+        trace,
+        first_started,
+        first_factor_shape,
+        no_p1,
+        first_delta,
+        p1_present,
+        no_p2,
+        p1_norms,
+        first_complete,
+        second_started,
+        second_factor_shape,
+        second_delta,
+        p2_present
+    )
+}
