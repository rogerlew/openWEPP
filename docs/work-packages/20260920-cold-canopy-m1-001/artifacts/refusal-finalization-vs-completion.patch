+#[cfg(feature = "m1-trust-region-physical-stage")]
+fn m1_w3_full_context(
+    context: &openwepp_vegetation::cold_canopy_m1::M1MhObservationContext,
+    role: &str,
+    direction: bool,
+    fd_column: bool,
+    fd_side: Option<&str>,
+    pass: &str,
+) -> bool {
+    context.state_role == role
+        && context.representation == "full"
+        && context.map_identity == "full_logical_to_physical_identity"
+        && (context.proposal_direction_bits.is_some() == direction)
+        && (if fd_column {
+            context.fd_column.is_some_and(|column| column < 21)
+        } else {
+            context.fd_column.is_none()
+        })
+        && context.fd_side == fd_side
+        && context.pass == pass
+}
