+#[cfg(test)]
+fn refinement_capture_exact_norm(
+    trace: &RefinementObservationTrace,
+    role: &str,
+    expected: &[f64],
+    coordinate_ids: &[usize],
+) -> bool {
+    let mut matches = trace.ordered_norms.iter().filter(|norm| norm.role == role);
+    let Some(norm) = matches.next() else {
+        return false;
+    };
+    if matches.next().is_some()
+        || norm.coordinate_ids != coordinate_ids
+        || norm.value_bits.len() != coordinate_ids.len()
+        || norm.square_bits.len() != coordinate_ids.len()
+        || norm.running_sum_bits.len() != coordinate_ids.len()
+    {
+        return false;
+    }
+    let mut sum = 0.0;
+    for (((&coordinate, &value_bits), &square_bits), &running_sum_bits) in coordinate_ids
+        .iter()
+        .zip(&norm.value_bits)
+        .zip(&norm.square_bits)
+        .zip(&norm.running_sum_bits)
+    {
+        let value = expected[coordinate];
+        if value.to_bits() != value_bits {
+            return false;
+        }
+        let square = value * value;
+        sum += square;
+        if square.to_bits() != square_bits || sum.to_bits() != running_sum_bits {
+            return false;
+        }
+    }
+    sum.to_bits() == norm.norm2_bits && sum.sqrt().to_bits() == norm.norm_bits
+}
