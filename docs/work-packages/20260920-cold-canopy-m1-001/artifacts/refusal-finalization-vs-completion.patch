+/// Select required copies from the typed terminal guard, never from a witness's
+/// historical outcome.  A stage whose copy boundary was not reached is reported
+/// incomplete; it is not relabelled as the expected refusal.
+#[cfg(test)]
+macro_rules! refinement_capture_terminal_matrix {
+    ($metadata:ident, $common:ident, $boundary:ident, $structural:ident, $p0:ident, $lineage:ident, $applications:ident, $positive_lambda:ident, $zero_lambda:ident, $p0_values:ident, $full:ident, $trace:ident, $first_started:ident, $first_factor_shape:ident, $no_p1:ident, $first_delta:ident, $p1_present:ident, $no_p2:ident, $p1_norms:ident, $first_complete:ident, $second_started:ident, $second_factor_shape:ident, $second_delta:ident, $p2_present:ident) => {
+        match ($metadata.correction_position, $metadata.guard_stage) {
+            // The $p0 assembly is before a copy exists.  Any other None-position
+            // terminal follows the $p0 copy and its lambda-specific norm route.
+            (None, Stage::ActiveFinite | Stage::ActiveEquality) => {
+                $boundary && $structural && $p0 && $lineage && $applications(0)
+            }
+            // $p0 $full/reduced norm failures occur inside the norm itself, before
+            // its scalar copy is recorded; a radius comparison follows a copy.
+            (None, Stage::P0FullRadius | Stage::P0ReducedRadius) => {
+                $positive_lambda
+                    && $boundary
+                    && $structural
+                    && $p0
+                    && $lineage
+                    && refinement_capture_exact_norm($trace, "p0_full", $p0_values, &$full)
+                    && $applications(0)
+            }
+            (None, Stage::OrderedNorm) => {
+                $zero_lambda && $boundary && $structural && $p0 && $lineage && $applications(0)
+            }
+            (None, Stage::RadiusComparison) => $zero_lambda && $common && $applications(0),
+
+            // First residual Dot2 guards happen before either factor application.
+            (
+                Some(Position::First),
+                Stage::ResidualSourceTerm
+                | Stage::ResidualSourceWeight
+                | Stage::PrimaryProduct
+                | Stage::SplitterProduct
+                | Stage::SplitOutput
+                | Stage::EftRemainder
+                | Stage::TwoSumResult
+                | Stage::TwoSumRemainder
+                | Stage::Accumulation,
+            ) => {
+                $common
+                    && $trace.h0.is_none()
+                    && $trace.delta0.is_none()
+                    && $no_p1
+                    && $applications(0)
+            }
+            // A factor may fail after the positive-lambda h0 product but before
+            // the application counter advances.  Zero lambda has no h0 route.
+            (Some(Position::First), Stage::FactorApplicationOutput) => {
+                $common
+                    && $first_started
+                    && $first_factor_shape
+                    && $trace.delta0.is_none()
+                    && $no_p1
+                    && $applications(1)
+            }
+            // Coordinate, first active, and scratch-box guards precede p1.
+            (
+                Some(Position::First),
+                Stage::CoordinateUpdate
+                | Stage::ActiveFinite
+                | Stage::ActiveEquality
+                | Stage::ScratchBoxLower
+                | Stage::ScratchBoxUpper,
+            ) => {
+                $common
+                    && $first_started
+                    && $first_factor_shape
+                    && $first_delta
+                    && $no_p1
+                    && $applications(1)
+            }
+            // Scratch radius and zero-lambda ordered/radius guards are after p1.
+            (
+                Some(Position::First),
+                Stage::ScratchFullRadius
+                | Stage::ScratchReducedRadius
+                | Stage::OrderedNorm
+                | Stage::RadiusComparison,
+            ) => {
+                $common
+                    && $first_started
+                    && $first_factor_shape
+                    && $first_delta
+                    && $p1_present
+                    && $no_p2
+                    && $applications(1)
+                    && match $metadata.guard_stage {
+                        Stage::ScratchFullRadius => {
+                            $positive_lambda
+                                && refinement_capture_exact_norm(
+                                    $trace,
+                                    "p1_full",
+                                    $trace.p1.as_ref().unwrap(),
+                                    &$full,
+                                )
+                        }
+                        Stage::ScratchReducedRadius => $positive_lambda && $p1_norms,
+                        Stage::OrderedNorm | Stage::RadiusComparison => $zero_lambda && $p1_norms,
+                        _ => false,
+                    }
+            }
+
+            // Second residual Dot2 guards occur after a completed first correction,
+            // but before the second factor application.
+            (
+                Some(Position::Second),
+                Stage::ResidualSourceTerm
+                | Stage::ResidualSourceWeight
+                | Stage::PrimaryProduct
+                | Stage::SplitterProduct
+                | Stage::SplitOutput
+                | Stage::EftRemainder
+                | Stage::TwoSumResult
+                | Stage::TwoSumRemainder
+                | Stage::Accumulation,
+            ) => {
+                $common
+                    && $first_complete
+                    && $trace.h1.is_none()
+                    && $trace.delta1.is_none()
+                    && $no_p2
+                    && $applications(1)
+            }
+            (Some(Position::Second), Stage::FactorApplicationOutput) => {
+                $common
+                    && $first_complete
+                    && $second_started
+                    && $second_factor_shape
+                    && $trace.delta1.is_none()
+                    && $no_p2
+                    && $applications(2)
+            }
+            (Some(Position::Second), Stage::CoordinateUpdate) => {
+                $common
+                    && $first_complete
+                    && $second_started
+                    && $second_factor_shape
+                    && $second_delta
+                    && $no_p2
+                    && $applications(2)
+            }
+            // Final active/box/radius/install guards are after the p2 observer
+            // seam.  Positive and zero lambda retain their distinct factor state.
+            (
+                Some(Position::Second),
+                Stage::ActiveFinite
+                | Stage::ActiveEquality
+                | Stage::FinalBoxLower
+                | Stage::FinalBoxUpper
+                | Stage::FinalFullRadius
+                | Stage::FinalReducedRadius
+                | Stage::FinalRadiusCloseness
+                | Stage::FinalInstallEquality
+                | Stage::OrderedNorm
+                | Stage::RadiusComparison,
+            ) => {
+                $common
+                    && $first_complete
+                    && $second_started
+                    && $second_factor_shape
+                    && $second_delta
+                    && $p2_present
+                    && $applications(2)
+                    && match $metadata.guard_stage {
+                        Stage::FinalFullRadius => {
+                            $positive_lambda
+                                && refinement_capture_exact_norm(
+                                    $trace,
+                                    "p2_full",
+                                    $trace.p2.as_ref().unwrap(),
+                                    &$full,
+                                )
+                        }
+                        Stage::ActiveFinite
+                        | Stage::ActiveEquality
+                        | Stage::FinalBoxLower
+                        | Stage::FinalBoxUpper => {
+                            $trace.p2_full_norm.is_none()
+                                && $trace.p2_full_norm2.is_none()
+                                && $trace.p2_reduced_norm.is_none()
+                                && $trace.p2_reduced_norm2.is_none()
+                                && !$trace
+                                    .ordered_norms
+                                    .iter()
+                                    .any(|norm| norm.role == "p2_full" || norm.role == "p2_free")
+                        }
+                        Stage::FinalReducedRadius => {
+                            $positive_lambda
+                                && refinement_capture_exact_norm(
+                                    $trace,
+                                    "p2_full",
+                                    $trace.p2.as_ref().unwrap(),
+                                    &$full,
+                                )
+                                && refinement_capture_exact_norm(
+                                    $trace,
+                                    "p2_free",
+                                    $trace.p2.as_ref().unwrap(),
+                                    $trace.face_free_ids.as_ref().unwrap(),
+                                )
+                        }
+                        Stage::FinalRadiusCloseness | Stage::FinalInstallEquality => {
+                            $positive_lambda
+                                && refinement_capture_exact_norm(
+                                    $trace,
+                                    "p2_full",
+                                    $trace.p2.as_ref().unwrap(),
+                                    &$full,
+                                )
+                                && refinement_capture_exact_norm(
+                                    $trace,
+                                    "p2_free",
+                                    $trace.p2.as_ref().unwrap(),
+                                    $trace.face_free_ids.as_ref().unwrap(),
+                                )
+                                && $trace.remaining_radius.is_some()
+                                && $trace.radius_gap.is_some()
+                                && $trace.radius_tolerance.is_some()
+                        }
+                        Stage::OrderedNorm | Stage::RadiusComparison => $zero_lambda,
+                        _ => false,
+                    }
+            }
+            _ => false,
+        }
+    };
+}
