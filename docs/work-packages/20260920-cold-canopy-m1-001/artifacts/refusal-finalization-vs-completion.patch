+#[cfg(feature = "m1-trust-region-physical-stage")]
+fn m1_refusal_capture_request_witness() -> String {
+    use std::io::{self, BufRead};
+
+    let request_line = io::stdin()
+        .lock()
+        .lines()
+        .next()
+        .expect("RUN_INIT line")
+        .expect("RUN_INIT input");
+    let request: Value = serde_json::from_str(
+        request_line
+            .strip_prefix("RUN_INIT ")
+            .expect("RUN_INIT command"),
+    )
+    .expect("capture request JSON");
+    let object = request.as_object().expect("capture request object");
+    assert_eq!(object.len(), 4, "capture request key count");
+    assert!(
+        object.keys().all(|key| matches!(
+            key.as_str(),
+            "witness" | "case" | "support_id" | "cadence_seconds"
+        )),
+        "capture request has an unknown key"
+    );
+    let witness = object
+        .get("witness")
+        .and_then(Value::as_str)
+        .expect("witness")
+        .to_owned();
+    let (case, support_id, cadence_seconds) = match witness.as_str() {
+        "W1" => ("A_cold_ice_day", 0, 60),
+        "W2" | "W3" => ("C_freeze_then_melt_day", 0, 60),
+        _ => panic!("only frozen W1/W2/W3 witnesses are admissible"),
+    };
+    assert_eq!(object.get("case").and_then(Value::as_str), Some(case));
+    assert_eq!(
+        object.get("support_id").and_then(Value::as_u64),
+        Some(support_id)
+    );
+    assert_eq!(
+        object.get("cadence_seconds").and_then(Value::as_u64),
+        Some(cadence_seconds)
+    );
+    witness
+}
