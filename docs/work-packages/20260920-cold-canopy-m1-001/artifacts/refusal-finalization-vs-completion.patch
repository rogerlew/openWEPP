+#[cfg(feature = "m1-trust-region-physical-stage")]
+fn m1_refusal_capture_w3_terminal_complete(
+    report: &openwepp_vegetation::cold_canopy_m1::M1MhRefusalReport,
+) -> bool {
+    let terminal: Vec<_> = report
+        .events
+        .iter()
+        .filter(|event| event.terminal_propagated)
+        .collect();
+    let Some(event) = terminal.first() else {
+        return false;
+    };
+    if terminal.len() != 1
+        || report.terminal_event_id != Some(event.event_id)
+        || event.call_id == usize::MAX
+    {
+        return false;
+    }
+    let Some(context) = event.context.as_ref() else {
+        return false;
+    };
+    context.call_id == event.call_id
+        && context.occupancy < 2
+        && context.mass_index == context.occupancy * 6 + 3
+        && context.enthalpy_index == context.occupancy * 6 + 4
+        && context.trial_coordinate_bits.is_some()
+        && report
+            .events
+            .iter()
+            .all(m1_refusal_capture_w3_context_complete)
+}
