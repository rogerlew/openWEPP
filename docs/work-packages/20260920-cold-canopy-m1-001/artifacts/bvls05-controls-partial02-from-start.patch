+        assert_eq!(result.work.bvls05_role_joins_attempted, 6);
+        assert_eq!(result.work.bvls05_column_entry_tests_attempted, 84);
+        assert_eq!(result.work.bvls05_held_base_copies_completed, 2);
+    }
+
+    #[test]
+    fn m1_trust_region_bvls05_default_empty_regression() {
+        let mut input = bvls05_diagonal_input();
+        input.test_work.bvls05_provenance = None;
+        input.raw_jacobian[1][1] = 1.0;
+        input.raw_jacobian[2][2] = 1.0;
+        let certificate = super::bvls05_certificate_for_test(
+            &[],
+            &input.raw_jacobian,
+            &bvls05_weighted(&input.raw_jacobian),
+        );
+        assert_eq!(certificate.held, [false; 21]);
+        assert_eq!(
+            certificate.work,
+            crate::M1TrustRegionWorkObservation::default()
+        );
+        let result =
+            super::solve_subproblem(&input).expect("default-empty old route remains solvable");
+        assert_eq!(result.scaled_step, [0.0; 21]);
+    }
+
+    #[test]
+    fn m1_trust_region_bvls05_accounting_caps() {
+        let input = bvls05_diagonal_input();
+        let certificate = super::bvls05_certificate_for_test(
+            &bvls05_roles(&input),
+            &input.raw_jacobian,
+            &bvls05_weighted(&input.raw_jacobian),
+        );
+        assert_eq!(certificate.work.bvls05_role_joins_attempted, 6);
+        assert_eq!(certificate.work.bvls05_column_entry_tests_attempted, 84);
+        assert!(certificate.work.bvls05_mask_joins_attempted <= 6);
+        let mut base = input.base;
+        base[1] = f64::from_bits(0x4009_21fb_5444_2d18);
+        base[2] = f64::from_bits(0xc005_bf0a_8b14_5769);
+        let mut work = certificate.work.clone();
+        let (step, candidate) =
+            super::bvls05_scatter_held_for_test(base, certificate.held, &mut work);
+        assert_eq!(step[1].to_bits(), 0.0f64.to_bits());
+        assert_eq!(step[2].to_bits(), 0.0f64.to_bits());
+        assert_eq!(candidate[1].to_bits(), base[1].to_bits());
+        assert_eq!(candidate[2].to_bits(), base[2].to_bits());
+        assert_eq!(work.bvls05_held_base_copies_completed, 2);
+    }
