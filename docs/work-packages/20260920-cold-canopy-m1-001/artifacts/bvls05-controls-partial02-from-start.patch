+    fn bvls05_full_h(raw: &[[f64; 21]; 21], f: [f64; 21], p: [f64; 21], lambda: f64) -> [f64; 21] {
+        let mut residual = f;
+        for row in 0..21 {
+            for column in 0..21 {
+                residual[row] += raw[row][column] * p[column];
+            }
+        }
+        let mut h = [0.0; 21];
+        for column in 0..21 {
+            for row in 0..21 {
+                h[column] += raw[row][column] * residual[row];
+            }
+            h[column] += lambda * p[column];
+        }
+        h
+    }
