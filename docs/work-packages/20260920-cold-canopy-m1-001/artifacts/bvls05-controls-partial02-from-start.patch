+            if raw[row][input.column] != 0.0 || *weighted_entry != 0.0 {
+                zero = false;
+            }
+            observed.work.bvls05_column_entry_tests_completed += 2;
+        }
+        observed.work.bvls05_mask_joins_attempted += 1;
+        if zero {
+            observed.held[input.column] = true;
+            observed.work.bvls05_mask_joins_completed += 1;
+        }
+    }
+    observed
