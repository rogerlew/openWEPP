+// BVLS-05 control scaffolding.  This test-only certificate observes already
+// assembled operands; it is deliberately not called by the numerical body.
+#[cfg(test)]
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum Bvls05Role {
+    SunLeaf,
+    ShadeLeaf,
+    DryStem,
+    Other,
+}
+
+#[cfg(test)]
+#[derive(Clone, Copy, Debug)]
+struct Bvls05RoleInput {
+    role: Bvls05Role,
+    column: usize,
+    structural_area: f64,
+    wet_fraction: f64,
+    initial_free: bool,
+    physical_current_free: bool,
+}
+
+#[cfg(test)]
+#[derive(Clone, Debug, Default)]
+struct Bvls05CertificateObservation {
+    held: [bool; 21],
+    work: super::M1TrustRegionWorkObservation,
+}
+
+#[cfg(test)]
+fn bvls05_certificate_for_test(
+    roles: &[Bvls05RoleInput],
+    raw: &[[f64; 21]; 21],
+    weighted: &[Vec<f64>],
+) -> Bvls05CertificateObservation {
+    let mut observed = Bvls05CertificateObservation::default();
+    for input in roles {
+        observed.work.bvls05_role_joins_attempted += 1;
+        observed.work.bvls05_role_joins_completed += 1;
+        let dry_temperature = matches!(
+            input.role,
+            Bvls05Role::SunLeaf | Bvls05Role::ShadeLeaf | Bvls05Role::DryStem
+        );
+        let effective_dry_area = input.structural_area * (1.0 - input.wet_fraction);
+        let eligible_prefix = dry_temperature
+            && input.structural_area.is_finite()
+            && input.structural_area > 0.0
+            && input.wet_fraction.to_bits() == 1.0_f64.to_bits()
+            && effective_dry_area == 0.0
+            && input.initial_free
+            && input.physical_current_free;
+        let mut zero = true;
+        for row in 0..21 {
+            observed.work.bvls05_column_entry_tests_attempted += 2;
+            let Some(weighted_entry) = weighted
+                .get(row)
+                .and_then(|values| values.get(input.column))
+            else {
+                zero = false;
+                break;
+            };
+            if raw[row][input.column] != 0.0 || *weighted_entry != 0.0 {
+                zero = false;
+            }
+            observed.work.bvls05_column_entry_tests_completed += 2;
+        }
+        if eligible_prefix && input.column < 21 && weighted.len() == 21 && zero {
+            observed.held[input.column] = true;
+        }
+    }
+    // No provenance takes the default-empty shortcut with no BVLS-05 work.
+    // An inspected certificate joins its completed held set to all face slots.
+    if !roles.is_empty() {
+        observed.work.bvls05_mask_joins_attempted = 21;
+        observed.work.bvls05_mask_joins_completed = 21;
+    }
+    observed
+}
