+                input.raw_residual[coordinate] = -1.0;
+            }
+        }
+        let mut expected_p = [0.0_f64; 21];
+        for coordinate in 0..21 {
+            if coordinate != 1 && coordinate != 2 {
+                expected_p[coordinate] = 1.0;
+            }
+        }
+        assert_eq!(expected_p[1].to_bits(), 0.0f64.to_bits());
+        assert_eq!(expected_p[2].to_bits(), 0.0f64.to_bits());
+        assert_eq!(expected_p.iter().filter(|value| **value == 1.0).count(), 19);
+        assert_eq!(
+            bvls05_full_h(&input.raw_jacobian, input.raw_residual, expected_p, 0.0),
+            [0.0; 21]
+        );
+        let result = super::solve_subproblem(&input)
+            .expect("expected-red: zero-lambda held refinement requires body consumption");
+        assert_eq!(result.scaled_step, expected_p);
+        assert_eq!(result.lambda.to_bits(), 0.0f64.to_bits());
+        assert_eq!(result.final_residual, [0.0; 21]);
+        assert_eq!(result.final_h, [0.0; 21]);
+        assert_eq!(
+            result
+                .optimality_observation
+                .expect("full KKT")
+                .coordinates
+                .len(),
+            21
+        );
+        assert_eq!(result.entered_svd_factorizations, 1);
+        assert_eq!(result.work.bvls05_role_joins_attempted, 6);
+        assert_eq!(result.work.bvls05_column_entry_tests_attempted, 252);
+        assert_eq!(result.work.bvls05_mask_joins_attempted, 21);
+        assert_eq!(result.work.bvls05_held_base_copies_completed, 21);
+    }
