+#[cfg(all(test, feature = "m1-trust-region-physical-stage"))]
+fn append_matrix_bits(output: &mut String, matrix: &[Vec<f64>]) {
+    output.push('[');
+    for (index, row) in matrix.iter().enumerate() {
+        if index != 0 {
+            output.push(',');
+        }
+        output.push('[');
+        append_slice_bits(output, row);
+        output.push(']');
+    }
+    output.push(']');
+}
+
+#[cfg(all(test, feature = "m1-trust-region-physical-stage"))]
+fn append_lambda_trace_json(output: &mut String, trace: Option<&M1FacePivotLambdaTraceCapture>) {
+    use std::fmt::Write;
+
+    let Some(trace) = trace else {
+        output.push_str("null");
+        return;
+    };
+    output.push_str("{\"initial_bracket\":");
+    append_bits(output, &trace.initial_bracket);
+    output.push_str(",\"bracket\":");
+    append_bits(output, &trace.bracket);
+    for (name, values) in [
+        ("bracket_evaluations", &trace.bracket_evaluations),
+        ("bisection_evaluations", &trace.bisection_evaluations),
+    ] {
+        let _ = write!(output, ",\"{name}\":[");
+        for (index, (lambda, norm)) in values.iter().enumerate() {
+            if index != 0 {
+                output.push(',');
+            }
+            let _ = write!(
+                output,
+                "[\"{:016x}\",\"{:016x}\"]",
+                lambda.to_bits(),
+                norm.to_bits()
+            );
+        }
+        output.push(']');
+    }
+    let _ = write!(
+        output,
+        ",\"lambda\":\"{:016x}\",\"natural_step\":[",
+        trace.lambda.to_bits()
+    );
+    append_slice_bits(output, &trace.natural_step);
+    output.push_str("],\"pre_hook_step\":[");
+    append_slice_bits(output, &trace.pre_hook_step);
+    output.push_str("],\"post_hook_step\":[");
+    append_slice_bits(output, &trace.post_hook_step);
+    let _ = write!(
+        output,
+        "] ,\"norm\":\"{:016x}\",\"gap\":\"{:016x}\",\"tolerance\":\"{:016x}\"}}",
+        trace.norm.to_bits(),
+        trace.gap.to_bits(),
+        trace.tolerance.to_bits()
+    );
+}
+
+#[cfg(all(test, feature = "m1-trust-region-physical-stage"))]
+fn append_factor_json(output: &mut String, factor: Option<&M1FacePivotFactorCapture>) {
+    use std::fmt::Write;
+
+    let Some(factor) = factor else {
+        output.push_str("null");
+        return;
+    };
+    let _ = write!(
+        output,
+        "{{\"same_invocation_identity\":{},\"a\":",
+        factor.same_invocation_identity
+    );
+    append_matrix_bits(output, &factor.a);
+    output.push_str(",\"b\":");
+    append_matrix_bits(output, &factor.b);
+    output.push_str(",\"v\":");
+    append_matrix_bits(output, &factor.v);
+    output.push_str(",\"sigma\":[");
+    append_slice_bits(output, &factor.sigma);
+    let _ = write!(output, "],\"order\":{:?},\"visits\":[", factor.order);
+    for (index, visit) in factor.visits.iter().enumerate() {
+        if index != 0 {
+            output.push(',');
+        }
+        let _ = write!(
+            output,
+            "{{\"left\":{},\"right\":{},\"rotated\":{},\"sweep\":{}}}",
+            visit.left, visit.right, visit.rotated, visit.sweep
+        );
+    }
+    let _ = write!(
+        output,
+        "],\"rotations\":{},\"sweeps\":{}}}",
+        factor.rotations, factor.sweeps
+    );
 }
 
