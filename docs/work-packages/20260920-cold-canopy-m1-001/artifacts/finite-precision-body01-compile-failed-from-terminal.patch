+fn cbar_and_tau(
+    weighted_matrix: &[Vec<f64>],
+    weighted_residual: &[f64],
+    step: &[f64; 21],
+    lambda: f64,
+    coordinate: usize,
+    operations: &mut u16,
+) -> Result<(f64, f64), OptimalityFailure> {
+    let mut cbar = 0.0;
+    for row in 0..21 {
+        let mut inner = 0.0;
+        for column in 0..21 {
+            let term = upward_mul(
+                upward_operand(weighted_matrix[row][column], coordinate)?,
+                upward_operand(step[column], coordinate)?,
+                coordinate,
+                operations,
+            )?;
+            inner = upward_add(inner, term, coordinate, operations)?;
+        }
+        let row_scale = upward_add(
+            upward_operand(weighted_residual[row], coordinate)?,
+            inner,
+            coordinate,
+            operations,
+        )?;
+        let row_term = upward_mul(
+            upward_operand(weighted_matrix[row][coordinate], coordinate)?,
+            row_scale,
+            coordinate,
+            operations,
+        )?;
+        cbar = upward_add(cbar, row_term, coordinate, operations)?;
+    }
+    let lambda_term = upward_mul(
+        upward_operand(lambda, coordinate)?,
+        upward_operand(step[coordinate], coordinate)?,
+        coordinate,
+        operations,
+    )?;
+    cbar = upward_add(cbar, lambda_term, coordinate, operations)?;
+    if cbar == 0.0 {
+        return Ok((0.0, 0.0));
+    }
+    const TWO_POW_53: f64 = 9_007_199_254_740_992.0;
+    let gamma = (87.0 / (TWO_POW_53 - 87.0)).next_up();
+    if !gamma.is_finite() || !gamma.is_normal() {
+        return Err(optimality_failure(
+            "optimality_upward_enclosure",
+            coordinate,
+        ));
+    }
+    let tau = upward_mul(gamma, cbar, coordinate, operations)?;
+    Ok((cbar, tau))
+}
