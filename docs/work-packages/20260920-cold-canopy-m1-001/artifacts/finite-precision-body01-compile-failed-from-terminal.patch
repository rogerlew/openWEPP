+fn upward_operand(value: f64, coordinate: usize) -> Result<f64, OptimalityFailure> {
+    checked_optimality_operand(value, coordinate)?;
+    let magnitude = value.abs();
+    if !magnitude.is_finite() || (magnitude != 0.0 && !magnitude.is_normal()) {
