+fn upward_add(
+    left: f64,
+    right: f64,
+    coordinate: usize,
+    operations: &mut u16,
+) -> Result<f64, OptimalityFailure> {
+    *operations = operations.saturating_add(1);
+    if left < 0.0 || right < 0.0 {
+        return Err(optimality_failure(
+            "optimality_upward_enclosure",
+            coordinate,
+        ));
+    }
+    let left = upward_operand(left, coordinate)?;
+    let right = upward_operand(right, coordinate)?;
+    if right == 0.0 {
+        return Ok(left);
+    }
+    let sum = left + right;
+    if !sum.is_finite() || sum == 0.0 || !sum.is_normal() {
+        return Err(optimality_failure(
+            "optimality_upward_enclosure",
+            coordinate,
+        ));
+    }
+    let upward = sum.next_up();
+    if !upward.is_finite() || !upward.is_normal() {
+        return Err(optimality_failure(
+            "optimality_upward_enclosure",
+            coordinate,
+        ));
+    }
+    Ok(upward)
+}
