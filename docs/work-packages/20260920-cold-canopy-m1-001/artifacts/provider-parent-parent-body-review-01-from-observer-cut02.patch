+/// Retained V10 liquid saturation polynomial and its analytic derivative.
+pub(crate) fn warm_saturation_vapor_pressure_and_derivative_pa(
+    temperature_k: f64,
+) -> Result<(f64, f64), VegetationError> {
+    if !temperature_k.is_finite() || !(273.15..=373.15).contains(&temperature_k) {
+        return Err(VegetationError::Domain("liquid saturation temperature"));
+    }
     let celsius = temperature_k - 273.15;
     let hpa = ESAT_HPA
         .iter()
         .rev()
         .fold(0.0, |sum, coefficient| sum * celsius + coefficient);
-    Ok(hpa * 100.0)
+    let derivative_hpa_per_k = ESAT_HPA
+        .iter()
+        .rev()
+        .fold((0.0, 0.0), |(value, derivative), coefficient| {
+            (value * celsius + coefficient, derivative * celsius + value)
+        })
+        .1;
+    Ok((hpa * 100.0, derivative_hpa_per_k * 100.0))
 }
 
