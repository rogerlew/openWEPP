+//! M1 cold-canopy thermodynamic and restart primitives.
+use crate::energy::warm_saturation_vapor_pressure_and_derivative_pa;
+use serde::{Deserialize, Serialize};
+const TF: f64 = 273.15;
+const CW: f64 = 4218.;
+const CI: f64 = 2106.;
+const LF: f64 = 333_700.;
+const LV: f64 = 2_501_000.;
+const CPV: f64 = 1849.;
+const RV: f64 = 461.52;
+const E0: f64 = 611.213_476;
+const RD: f64 = 287.05;
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum M1ExternalPhase {
+    Liquid,
+    Ice,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum M1Phase {
+    Empty,
+    Liquid,
+    Mixed,
+    Ice,
+}
+impl M1Phase {
+    #[must_use]
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Empty => "empty",
+            Self::Liquid => "liquid",
+            Self::Mixed => "mixed",
+            Self::Ice => "ice",
+        }
+    }
+}
+#[derive(Clone, Copy, Debug)]
+pub struct M1Saturation {
+    pub vapor_pressure_pa: f64,
+    pub specific_humidity_kg_kg: f64,
+    pub derivative_kg_kg_k: f64,
+}
+#[derive(Clone, Copy, Debug)]
+pub struct M1TemperatureJacobian {
+    pub d_t_d_m: f64,
+    pub d_t_d_h: f64,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum M1DrySurface {
+    Sun,
+    Shade,
