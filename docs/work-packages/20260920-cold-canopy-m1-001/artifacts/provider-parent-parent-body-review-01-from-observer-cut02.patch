+//! M1-owned persistent vegetation candidate construction.
+//!
+//! This is deliberately separate from the V8 owner. It receives an already
+//! accepted M1 result and a validated M1 beginning, then uses the shared
+//! E16--E22 implementation to build pools, mineral-N protocol, material
+//! proposals, and ledgers. It never manufactures a V8 digest or re-enters a
+//! warm coupled solve.
+
+use std::collections::{BTreeMap, BTreeSet};
+
+use openwepp_kernel_contract::{StratumId, TransactionId};
+use sha2::{Digest, Sha256};
+
+use crate::{
+    VegetationConfiguration,
+    carbon_nitrogen::MaterialTransfer,
+    carbon_phase::{ClassCarbonOperands, StratumCarbonOperands, integrate_class_carbon},
+    cold_canopy_m1::{M1Error, M1PhaseReservoir, M1Stage},
+    persistent_phase::{PersistentForcingInputs, execute_persistent_core_with_duration},
+    transaction::{NitrogenArbiter, StratumSharedState},
+    vegetation_candidate::{
+        VegetationLedgerStateView, bind_material_proposals_from_strata,
+        construct_ending_strata_from_preallocations, construct_ledgers_from_preallocations,
+    },
+    vegetation_ledger::{
+        VegetationCarbonLedger, VegetationDryMaterialLedger, VegetationNitrogenLedger,
+        validate_vegetation_ledgers,
+    },
+};
+
+const M1_MODEL_DEFINITION_SHA256: &str =
+    "60792c5fd1e5e3a09a9e4cfaa08673bd0c61ff3c86fa098155785606ff043328";
+
+/// Authenticated M1 mass/enthalpy state for one configured occupancy.
+#[derive(Clone, Debug, PartialEq, serde::Serialize)]
+pub struct M1OwnerReservoir {
+    occupancy_id: String,
+    mass_kg_m2: f64,
+    enthalpy_j_m2: f64,
+}
+
+impl M1OwnerReservoir {
+    #[must_use]
+    pub fn try_new(
+        occupancy_id: String,
+        mass_kg_m2: f64,
+        enthalpy_j_m2: f64,
+    ) -> Result<Self, M1Error> {
+        if occupancy_id.is_empty()
+            || M1PhaseReservoir::from_mass_enthalpy(mass_kg_m2, enthalpy_j_m2).is_err()
+        {
+            return Err(domain_error());
+        }
+        Ok(Self {
+            occupancy_id,
+            mass_kg_m2,
+            enthalpy_j_m2,
+        })
+    }
+    #[must_use]
+    pub fn occupancy_id(&self) -> &str {
+        &self.occupancy_id
+    }
+    #[must_use]
+    pub const fn mass_kg_m2(&self) -> f64 {
+        self.mass_kg_m2
+    }
+    #[must_use]
+    pub const fn enthalpy_j_m2(&self) -> f64 {
+        self.enthalpy_j_m2
+    }
+}
+
+/// M1-owned persistent C/N state. The state includes actual tissue pools and
+/// M/H; neither is recoverable from a V8 state or a caller-provided revision.
+#[derive(Clone, Debug, PartialEq, serde::Serialize)]
+pub struct M1OwnerState {
+    model_definition_id: String,
+    model_definition_sha256: String,
+    configuration_sha256: String,
+    revision: u64,
+    state_sha256: String,
+    reservoirs: BTreeMap<String, M1OwnerReservoir>,
+    strata: BTreeMap<StratumId, StratumSharedState>,
+}
+
+impl M1OwnerState {
+    /// Bind a beginning supplied by the M1 checkpoint reader. The M1 model
+    /// identity must be the configuration identity and V8 is refused here.
+    pub fn try_new(
+        configuration: &VegetationConfiguration,
+        model_definition_id: String,
+        model_definition_sha256: String,
+        revision: u64,
+        reservoirs: Vec<M1OwnerReservoir>,
+        strata: BTreeMap<StratumId, StratumSharedState>,
+    ) -> Result<Self, M1Error> {
+        // The configuration DTO is shared with historical coupled models.
+        // Authenticate every canonical configuration invariant under the M1
+        // definition before accepting its generic physical strata.
+        configuration
+            .validate_historical(M1_MODEL_DEFINITION_SHA256)
+            .map_err(|_| identity_error())?;
+        if model_definition_id != "OPENWEPP_C3_WOODY_COLD_M1_V1"
+            || model_definition_sha256 != M1_MODEL_DEFINITION_SHA256
+            || configuration.model_definition_sha256 != M1_MODEL_DEFINITION_SHA256
+            || configuration.configuration_sha256
+                != configuration
+                    .canonical_sha256()
+                    .map_err(|_| identity_error())?
+            || revision == 0
+        {
+            return Err(identity_error());
+        }
+        let configured = configuration
+            .strata
+            .iter()
+            .map(|row| row.stratum_id.clone())
+            .collect::<BTreeSet<_>>();
+        if configured != strata.keys().cloned().collect::<BTreeSet<_>>() {
+            return Err(identity_error());
+        }
+        // M1 projects the generic physical bootstrap into a distinct owner,
+        // but it does not weaken the canonical shared stratum admission.
+        crate::v8_state::validate_shared_states(&strata, configuration, u128::from(revision))
+            .map_err(|_| identity_error())?;
+        let mut by_occupancy = BTreeMap::new();
+        for reservoir in reservoirs {
+            if by_occupancy
+                .insert(reservoir.occupancy_id.clone(), reservoir)
+                .is_some()
+            {
+                return Err(identity_error());
+            }
+        }
+        let expected_reservoirs = configuration
+            .expected_occupancies()
+            .iter()
+            .map(|occupancy| {
+                format!(
+                    "{}::{}",
+                    occupancy.stratum_id.as_str(),
+                    occupancy.tile_id.as_str()
+                )
+            })
+            .collect::<BTreeSet<_>>();
+        if by_occupancy.keys().cloned().collect::<BTreeSet<_>>() != expected_reservoirs
+            || strata
+                .values()
+                .any(|state| state.last_transaction_id != u128::from(revision))
+        {
+            return Err(identity_error());
+        }
+        let mut state = Self {
+            model_definition_id,
+            model_definition_sha256,
+            configuration_sha256: configuration.configuration_sha256.clone(),
+            revision,
+            state_sha256: String::new(),
+            reservoirs: by_occupancy,
+            strata,
+        };
+        state.state_sha256 = state.recompute_sha256()?;
+        Ok(state)
+    }
+
+    #[must_use]
+    pub fn model_definition_id(&self) -> &str {
+        &self.model_definition_id
+    }
+    #[must_use]
+    pub fn model_definition_sha256(&self) -> &str {
+        &self.model_definition_sha256
+    }
+    #[must_use]
+    pub fn configuration_sha256(&self) -> &str {
+        &self.configuration_sha256
+    }
+    #[must_use]
+    pub const fn revision(&self) -> u64 {
+        self.revision
+    }
+    #[must_use]
+    pub fn state_sha256(&self) -> &str {
+        &self.state_sha256
+    }
+    #[must_use]
+    pub fn reservoirs(&self) -> &BTreeMap<String, M1OwnerReservoir> {
+        &self.reservoirs
+    }
+    #[must_use]
+    pub fn strata(&self) -> &BTreeMap<StratumId, StratumSharedState> {
+        &self.strata
+    }
+
+    /// Apply the zero-duration parent-lineage transition after all support
+    /// candidates have been validated.  This deliberately changes no M1
+    /// physical reservoir, pool, forcing cache, model, or configuration.
+    pub fn finalize_parent_lineage(&self) -> Result<Self, M1Error> {
+        if self.state_sha256 != self.recompute_sha256()? {
+            return Err(identity_error());
+        }
+        let revision = self.revision.checked_add(1).ok_or_else(identity_error)?;
+        let mut finalized = self.clone();
+        finalized.revision = revision;
+        for stratum in finalized.strata.values_mut() {
+            stratum.last_transaction_id = u128::from(revision);
+        }
+        finalized.state_sha256 = finalized.recompute_sha256()?;
+        if finalized.model_definition_id != self.model_definition_id
+            || finalized.model_definition_sha256 != self.model_definition_sha256
+            || finalized.configuration_sha256 != self.configuration_sha256
+            || finalized.reservoirs != self.reservoirs
+        {
+            return Err(identity_error());
+        }
+        Ok(finalized)
+    }
+
+    fn recompute_sha256(&self) -> Result<String, M1Error> {
+        let bytes = serde_json::to_vec(&(
+            "OPENWEPP_COLD_CANOPY_M1_OWNER_V1",
+            &self.model_definition_id,
+            &self.model_definition_sha256,
+            &self.configuration_sha256,
+            self.revision,
+            &self.reservoirs,
+            &self.strata,
+        ))
+        .map_err(|_| identity_error())?;
+        Ok(format!("{:x}", Sha256::digest(bytes)))
+    }
+}
+
+/// One class-resolved accepted M1 carbon/hydraulic result. Net assimilation is
+/// retained as an audited operand, while gross and dark respiration feed the
+/// canonical carbon integration exactly once.
+#[derive(Clone, Debug, PartialEq)]
+pub struct M1AcceptedStratumResult {
