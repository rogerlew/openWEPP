+
+/// One support-local M1 evaluation retained inside an admitted parent.
+///
+/// Persistent owner lineage remains at the parent beginning revision until the
+/// caller consumes the parent finalization.  The support transaction is still
+/// carried by every material proposal so native/resource joins cannot reuse a
+/// persistent revision as a per-support identity.
+#[derive(Clone, Debug, PartialEq)]
+pub struct M1ParentSegmentCandidate {
+    support_transaction_id: TransactionId,
+    beginning: M1OwnerState,
+    ending: M1OwnerState,
+    material_proposals: Vec<MaterialTransfer>,
+    requests: Vec<crate::transaction::NitrogenRequest>,
+    authorizations: Vec<crate::transaction::NitrogenAuthorization>,
+    finalized_uses: Vec<crate::transaction::NitrogenUse>,
+    carbon_ledgers: Vec<VegetationCarbonLedger>,
+    nitrogen_ledgers: Vec<VegetationNitrogenLedger>,
+    dry_material_ledgers: Vec<VegetationDryMaterialLedger>,
+}
+impl M1ParentSegmentCandidate {
+    #[must_use]
+    pub const fn support_transaction_id(&self) -> TransactionId {
+        self.support_transaction_id
+    }
+    #[must_use]
+    pub fn beginning(&self) -> &M1OwnerState {
+        &self.beginning
+    }
+    #[must_use]
+    pub fn ending(&self) -> &M1OwnerState {
+        &self.ending
+    }
+    #[must_use]
+    pub fn material_proposals(&self) -> &[MaterialTransfer] {
+        &self.material_proposals
+    }
+    #[must_use]
+    pub fn nitrogen_protocol(
+        &self,
+    ) -> (
+        &[crate::transaction::NitrogenRequest],
+        &[crate::transaction::NitrogenAuthorization],
+        &[crate::transaction::NitrogenUse],
+    ) {
+        (&self.requests, &self.authorizations, &self.finalized_uses)
+    }
+}
