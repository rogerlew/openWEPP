+fn m1_consume_first_domain_valid_halved_trial(
+    exponent: u32,
+    first_domain_valid_seen: &mut bool,
+) -> bool {
+    if exponent == 0 || *first_domain_valid_seen {
+        return false;
+    }
+    *first_domain_valid_seen = true;
+    true
