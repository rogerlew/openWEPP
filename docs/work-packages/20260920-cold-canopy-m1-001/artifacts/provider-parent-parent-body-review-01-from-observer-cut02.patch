+/// Sealed M1 candidate. It is intentionally uncommitted: the caller owns
+/// joining it with hydrology, thermal, LSE, and BGC candidates at its parent.
+#[derive(Clone, Debug, PartialEq)]
+pub struct M1OwnerCandidate {
