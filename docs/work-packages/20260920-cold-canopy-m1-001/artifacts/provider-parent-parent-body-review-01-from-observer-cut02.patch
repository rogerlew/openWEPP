+pub fn m1_phase_join_primal_normalizers(
+    input: &M1CoupledColumnInput,
+    trial: &M1CoupledColumnTrial,
+) -> Result<Vec<f64>, M1CoupledError> {
+    let base = core(input, trial)?;
+    Ok(m1_tolerances(input, &base).to_vec())
+}
