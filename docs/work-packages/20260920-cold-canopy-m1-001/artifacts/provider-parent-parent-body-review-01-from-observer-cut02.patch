+/// Build the complete C/N/material candidate from accepted M1 results without
+/// replaying the canopy solve or replacing the nitrogen arbiter.
+fn construct_m1_candidate_with_lineage(
+    configuration: &VegetationConfiguration,
+    beginning: &M1OwnerState,
+    transaction_id: TransactionId,
+    ending_revision: u64,
+    validate_single_support_lineage: bool,
+    ending_reservoirs: Vec<M1OwnerReservoir>,
+    accepted: Vec<M1AcceptedStratumResult>,
+    forcing: &M1PersistentForcing,
+    nitrogen: &dyn NitrogenArbiter,
+) -> Result<M1OwnerCandidate, M1Error> {
+    if configuration.configuration_sha256 != beginning.configuration_sha256
+        || beginning.model_definition_sha256 != M1_MODEL_DEFINITION_SHA256
+        || accepted.len() != configuration.strata.len()
+    {
+        return Err(identity_error());
+    }
+    let mut rows = BTreeMap::new();
+    for row in &accepted {
+        let values = [
+            row.plant_area_m2_m2_tile,
+            row.occupancy_fraction,
+            row.sun_leaf_area_m2_m2_tile,
+            row.shade_leaf_area_m2_m2_tile,
+            row.sun_gross_umol_m2_leaf_s,
+            row.shade_gross_umol_m2_leaf_s,
+            row.sun_dark_respiration_umol_m2_leaf_s,
+            row.shade_dark_respiration_umol_m2_leaf_s,
+            row.root_use_kg_m2_tile,
+            row.captured_incident_liquid_kg_m2_tile,
+        ];
+        if row.occupancy_id.is_empty()
+            || values
+                .iter()
+                .any(|value| !value.is_finite() || *value < 0.0)
+            || !(0.0..=1.0).contains(&row.occupancy_fraction)
+            || !row.sun_net_umol_m2_leaf_s.is_finite()
+            || !row.shade_net_umol_m2_leaf_s.is_finite()
+            || row.sun_net_umol_m2_leaf_s.to_bits()
+                != (row.sun_gross_umol_m2_leaf_s - row.sun_dark_respiration_umol_m2_leaf_s)
+                    .to_bits()
+            || row.shade_net_umol_m2_leaf_s.to_bits()
+                != (row.shade_gross_umol_m2_leaf_s - row.shade_dark_respiration_umol_m2_leaf_s)
+                    .to_bits()
+            || rows.insert(row.stratum_id.clone(), row).is_some()
+        {
+            return Err(domain_error());
+        }
+    }
+    let expected = configuration
+        .strata
+        .iter()
+        .map(|row| row.stratum_id.clone())
+        .collect::<BTreeSet<_>>();
+    if rows.keys().cloned().collect::<BTreeSet<_>>() != expected {
+        return Err(identity_error());
+    }
+    let carbon = rows
+        .iter()
+        .map(|(id, row)| {
+            let (gross, rd) = integrate_class_carbon(
+                ClassCarbonOperands {
+                    sun_leaf_area_m2_m2_tile_ground: row.sun_leaf_area_m2_m2_tile,
+                    shade_leaf_area_m2_m2_tile_ground: row.shade_leaf_area_m2_m2_tile,
+                    sun_gross_assimilation_umol_co2_m2_leaf_s: row.sun_gross_umol_m2_leaf_s,
+                    shade_gross_assimilation_umol_co2_m2_leaf_s: row.shade_gross_umol_m2_leaf_s,
+                    sun_dark_respiration_umol_co2_m2_leaf_s: row
+                        .sun_dark_respiration_umol_m2_leaf_s,
+                    shade_dark_respiration_umol_co2_m2_leaf_s: row
+                        .shade_dark_respiration_umol_m2_leaf_s,
+                },
+                forcing.duration_s,
+                row.occupancy_fraction,
+            )
+            .map_err(|_| domain_error())?;
+            let beginning_t10 = beginning.strata.get(id).ok_or_else(identity_error)?.t10_k;
+            let advanced_t10_k = crate::carbon_nitrogen::update_t10(
+                beginning_t10,
+                forcing.air_temperature_k,
+                forcing.duration_s,
+            )
+            .map_err(|_| domain_error())?;
+            Ok((
+                id.clone(),
+                StratumCarbonOperands {
+                    gross_primary_production_kg_c_m2: gross,
+                    accepted_leaf_respiration_kg_c_m2: rd,
+                    advanced_t10_k,
+                },
+            ))
+        })
+        .collect::<Result<BTreeMap<_, _>, M1Error>>()?;
+    let core = execute_persistent_core_with_duration(
+        configuration,
+        &beginning.strata,
+        transaction_id,
+        &PersistentForcingInputs {
+            air_temperature_k: forcing.air_temperature_k,
+            gsi: forcing.gsi,
+            soil_temperature_k_by_layer: forcing.soil_temperature_k_by_layer.clone(),
+        },
+        &carbon,
+        &carbon,
+        nitrogen,
+        forcing.duration_s,
+    )
+    .map_err(|_| domain_error())?;
+    let ending_strata =
+        construct_ending_strata_from_preallocations(configuration, transaction_id, &core.strata)
+            .map_err(|_| domain_error())?;
+    let material_proposals = bind_material_proposals_from_strata(transaction_id, &core.strata)
+        .map_err(|_| domain_error())?;
+    let ending_reservoirs = ending_reservoirs
+        .into_iter()
+        .map(|row| (row.occupancy_id.clone(), row))
+        .collect::<BTreeMap<_, _>>();
+    if ending_reservoirs.len() != beginning.reservoirs.len()
+        || ending_reservoirs.keys().collect::<Vec<_>>()
+            != beginning.reservoirs.keys().collect::<Vec<_>>()
+    {
+        return Err(identity_error());
+    }
+    let mut ending = M1OwnerState {
+        model_definition_id: beginning.model_definition_id.clone(),
+        model_definition_sha256: beginning.model_definition_sha256.clone(),
+        configuration_sha256: beginning.configuration_sha256.clone(),
+        revision: ending_revision,
+        state_sha256: String::new(),
+        reservoirs: ending_reservoirs,
+        strata: ending_strata,
+    };
+    for stratum in ending.strata.values_mut() {
+        stratum.last_transaction_id = u128::from(ending_revision);
+    }
+    ending.state_sha256 = ending.recompute_sha256()?;
+    let (carbon_ledgers, nitrogen_ledgers, dry_material_ledgers) =
+        construct_ledgers_from_preallocations(
+            configuration,
+            VegetationLedgerStateView {
+                strata: &beginning.strata,
+                state_sha256: &beginning.state_sha256,
+            },
+            VegetationLedgerStateView {
+                strata: &ending.strata,
+                state_sha256: &ending.state_sha256,
+            },
+            transaction_id,
+            &core.strata,
+            &material_proposals,
+        )
+        .map_err(|_| domain_error())?;
+    let candidate = M1OwnerCandidate {
+        transaction_id,
+        beginning: beginning.clone(),
+        ending,
+        accepted,
+        material_proposals,
+        requests: core.requests,
+        authorizations: core.authorizations,
+        finalized_uses: core.finalized_uses,
+        carbon_ledgers,
+        nitrogen_ledgers,
+        dry_material_ledgers,
+    };
+    if validate_single_support_lineage {
+        candidate.validate_sealed()?;
+    } else {
+        validate_vegetation_ledgers(
+            &candidate.ending.strata.keys().cloned().collect(),
+            candidate.transaction_id,
+            &candidate.beginning.state_sha256,
+            &candidate.ending.state_sha256,
+            &candidate.carbon_ledgers,
+            &candidate.nitrogen_ledgers,
+            &candidate.dry_material_ledgers,
+        )
+        .map_err(|_| domain_error())?;
+    }
+    Ok(candidate)
+}
+
+pub fn construct_uncommitted_m1_owner_candidate(
+    configuration: &VegetationConfiguration,
+    beginning: &M1OwnerState,
+    transaction_id: TransactionId,
+    ending_reservoirs: Vec<M1OwnerReservoir>,
+    accepted: Vec<M1AcceptedStratumResult>,
+    forcing: &M1PersistentForcing,
+    nitrogen: &dyn NitrogenArbiter,
+) -> Result<M1OwnerCandidate, M1Error> {
+    if transaction_id.0 != u128::from(beginning.revision) + 1 {
+        return Err(identity_error());
+    }
+    let ending_revision = beginning
+        .revision
+        .checked_add(1)
+        .ok_or_else(identity_error)?;
+    construct_m1_candidate_with_lineage(
+        configuration,
+        beginning,
+        transaction_id,
+        ending_revision,
+        true,
+        ending_reservoirs,
+        accepted,
+        forcing,
+        nitrogen,
+    )
+}
+
+/// Construct a support-local candidate with canonical M1 persistent physics,
+/// while retaining the admitted parent's persistent lineage.  A parent
+/// finalizer advances that lineage once after all accepted supports.
+pub fn construct_parent_segment_candidate(
+    configuration: &VegetationConfiguration,
+    beginning: &M1OwnerState,
+    support_transaction_id: TransactionId,
+    ending_reservoirs: Vec<M1OwnerReservoir>,
+    accepted: Vec<M1AcceptedStratumResult>,
+    forcing: &M1PersistentForcing,
+    nitrogen: &dyn NitrogenArbiter,
+) -> Result<M1ParentSegmentCandidate, M1Error> {
+    let canonical = construct_m1_candidate_with_lineage(
+        configuration,
+        beginning,
+        support_transaction_id,
+        beginning.revision,
+        false,
+        ending_reservoirs,
+        accepted,
+        forcing,
+        nitrogen,
+    )?;
+    Ok(M1ParentSegmentCandidate {
+        support_transaction_id,
+        beginning: beginning.clone(),
+        ending: canonical.ending,
+        material_proposals: canonical.material_proposals,
+        requests: canonical.requests,
+        authorizations: canonical.authorizations,
+        finalized_uses: canonical.finalized_uses,
+        carbon_ledgers: canonical.carbon_ledgers,
+        nitrogen_ledgers: canonical.nitrogen_ledgers,
+        dry_material_ledgers: canonical.dry_material_ledgers,
+    })
+}
+
+fn identity_error() -> M1Error {
+    M1Error::new("VEG-E-143", M1Stage::Identity)
+}
+fn domain_error() -> M1Error {
+    M1Error::new("VEG-E-143", M1Stage::Ownership)
