+#[test]
+fn m1_primitive_domains_reject_nonfinite_and_invalid_forcing() {
+    assert_eq!(M1PhaseReservoir::empty().phase(), M1Phase::Empty);
+    let error = M1PhaseReservoir::from_mass_enthalpy(f64::from_bits(1), -1.0)
+        .expect_err("raw invalid mass-enthalpy state rejects");
+    assert_error(&error, "VEG-E-142", "mh_consistency");
+    let tiny_liquid_jacobian = M1PhaseReservoir::from_mass_enthalpy(1.0e-200, 0.0)
+        .expect("finite tiny liquid")
+        .temperature_jacobian()
+        .expect_err("nonfinite tiny-liquid Jacobian rejects");
+    assert_error(&tiny_liquid_jacobian, "VEG-E-142", "mh_consistency");
+    let error = M1PhaseReservoir::from_mass_enthalpy(f64::INFINITY, 0.0)
+        .expect_err("nonfinite mass-enthalpy state rejects");
+    assert_error(&error, "VEG-E-142", "mh_consistency");
+    let error = evaluate_m1_capacity_residual(M1CapacityTrial::new(0.0, f64::INFINITY, 0.0, 60.0))
+        .expect_err("nonfinite capacity rejects");
+    assert_error(&error, "VEG-E-142", "capacity");
+    let error = evaluate_m1_capacity_residual(M1CapacityTrial::new(0.0, 0.297, 2.0, f64::MAX))
+        .expect_err("overflowing capacity product rejects");
+    assert_error(&error, "VEG-E-142", "capacity");
+    let error = evaluate_m1_capacity_residual(M1CapacityTrial::new(-1.0, 0.297, 0.0, 60.0))
+        .expect_err("negative liquid mass rejects");
+    assert_error(&error, "VEG-E-142", "capacity");
+    let state = M1ReservoirState::new(0.018, -6385.68);
+    let error = evaluate_m1_reservoir_residuals(
+        state,
+        state,
+        M1ReservoirForcing::prescribed(60.0, -1.0e-8, 0.0, 0.0, 0.0, 0.297),
+        0.0,
+    )
+    .expect_err("negative incident liquid rejects");
+    assert_error(&error, "VEG-E-142", "domain");
+    let error = evaluate_m1_reservoir_residuals(
+        state,
+        state,
+        M1ReservoirForcing::prescribed(60.0, 1.0e-8, -1.0e9, 0.0, 0.0, 0.297),
+        0.0,
+    )
+    .expect_err("subfreezing positive liquid input rejects");
+    assert_error(&error, "VEG-E-142", "domain");
+    let error = evaluate_m1_reservoir_residuals(
+        state,
+        state,
+        M1ReservoirForcing::prescribed(60.0, 1.0e-8, 4218.0 * (272.15 - 273.15), 0.0, 0.0, 0.297),
+        0.0,
+    )
+    .expect_err("subfreezing liquid input rejects");
+    assert_error(&error, "VEG-E-142", "domain");
+}
