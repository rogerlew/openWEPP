+fn raw32(hex: &str) -> [u8; 32] {
+    let mut bytes = [0_u8; 32];
+    for (index, chunk) in hex.as_bytes().chunks_exact(2).enumerate() {
+        bytes[index] = u8::from_str_radix(std::str::from_utf8(chunk).expect("hex"), 16)
+            .expect("lowercase SHA-256");
+    }
+    bytes
+}
