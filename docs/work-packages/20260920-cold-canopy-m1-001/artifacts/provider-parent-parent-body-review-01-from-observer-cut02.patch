+}
+#[derive(Clone, Copy, Debug)]
+pub struct M1Residuals {
+    pub mass_kg_m2: f64,
+    pub enthalpy_j_m2: f64,
+    pub capacity_kg_m2: f64,
+}
+#[derive(Clone, Copy, Debug)]
+pub struct M1CapacityTrial {
+    ml: f64,
+    c: f64,
+    d: f64,
+    dt: f64,
+}
+impl M1CapacityTrial {
+    #[must_use]
+    pub fn new(ml: f64, c: f64, d: f64, dt: f64) -> Self {
+        Self { ml, c, d, dt }
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum M1CapacityBranch {
+    Drainage,
+    Capacity,
+}
+impl M1CapacityBranch {
+    #[must_use]
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Drainage => "drainage",
+            Self::Capacity => "capacity",
+        }
+    }
+}
+#[derive(Clone, Copy, Debug)]
+pub struct M1CapacityResidual {
+    pub residual_kg_m2: f64,
+    b: M1CapacityBranch,
+}
+impl M1CapacityResidual {
+    #[must_use]
+    pub fn branch(self) -> M1CapacityBranch {
+        self.b
+    }
+}
+pub fn evaluate_m1_capacity_residual(x: M1CapacityTrial) -> Result<M1CapacityResidual, M1Error> {
+    if !x.ml.is_finite()
+        || !x.c.is_finite()
+        || !x.d.is_finite()
+        || !x.dt.is_finite()
+        || x.ml < 0.
+        || x.c < 0.
+        || x.d < 0.
+        || x.dt < 60.
+        || !(x.dt * x.d).is_finite()
+        || !(x.c - x.ml).is_finite()
+    {
+        return Err(M1Error::new("VEG-E-142", M1Stage::Capacity));
+    }
+    let a = x.dt * x.d;
+    let b = x.c - x.ml;
+    Ok(if a < b {
+        M1CapacityResidual {
+            residual_kg_m2: a,
+            b: M1CapacityBranch::Drainage,
+        }
+    } else {
+        M1CapacityResidual {
+            residual_kg_m2: b,
+            b: M1CapacityBranch::Capacity,
+        }
+    })
+}
+fn evap(reservoir: M1PhaseReservoir, capacity_kg_m2: f64, vapor_model: VM) -> Result<f64, M1Error> {
+    match vapor_model {
+        VM::E(flux_kg_m2_s) if flux_kg_m2_s.is_finite() => Ok(flux_kg_m2_s),
+        VM::E(_) => Err(M1Error::new("VEG-E-142", M1Stage::Domain)),
+        VM::B(boundary) => {
+            if !boundary.wet_conductance_m_s.is_finite()
+                || !boundary.plant_area_m2_m2.is_finite()
+                || !boundary.canopy_air_temperature_k.is_finite()
+                || !boundary.canopy_air_specific_humidity_kg_kg.is_finite()
+                || boundary.wet_conductance_m_s <= 0.
+                || boundary.plant_area_m2_m2 <= 0.
+                || !(258.15..=373.15).contains(&boundary.canopy_air_temperature_k)
+                || !(0. ..1.).contains(&boundary.canopy_air_specific_humidity_kg_kg)
+                || capacity_kg_m2 <= 0.
+            {
+                return Err(M1Error::new("VEG-E-140", M1Stage::Domain));
+            }
+            let temperature_k = reservoir
+                .wet_temperature_k()
+                .ok_or_else(|| M1Error::new("VEG-E-142", M1Stage::MhConsistency))?;
+            let phase = if reservoir.phase() == M1Phase::Ice {
+                M1ExternalPhase::Ice
+            } else {
+                M1ExternalPhase::Liquid
+            };
+            let air_density_kg_m3 = boundary.pressure_pa / (RD * boundary.canopy_air_temperature_k);
+            let wet_fraction = (reservoir.m / capacity_kg_m2).powf(2.0 / 3.0).min(1.);
+            let flux_kg_m2_s = air_density_kg_m3
+                * boundary.wet_conductance_m_s
+                * wet_fraction
+                * boundary.plant_area_m2_m2
+                * (sat(temperature_k, boundary.pressure_pa, phase)?.specific_humidity_kg_kg
+                    - boundary.canopy_air_specific_humidity_kg_kg);
+            if !air_density_kg_m3.is_finite()
+                || !wet_fraction.is_finite()
+                || !flux_kg_m2_s.is_finite()
+            {
+                return Err(M1Error::new("VEG-E-141", M1Stage::Saturation));
+            }
+            Ok(flux_kg_m2_s)
+        }
+    }
+}
+pub fn evaluate_m1_reservoir_residuals(
+    beginning: M1ReservoirState,
+    ending: M1ReservoirState,
+    forcing: M1ReservoirForcing,
+    drainage_kg_m2_s: f64,
+) -> Result<M1Residuals, M1Error> {
+    beginning.p()?;
+    let ending_reservoir = ending.p()?;
+    if !forcing.dt.is_finite()
+        || forcing.dt < 60.
+        || ![
+            forcing.i,
+            forcing.hi,
+            forcing.q,
+            forcing.c,
+            drainage_kg_m2_s,
+        ]
+        .iter()
+        .all(|value| value.is_finite())
+        || forcing.c < 0.
+        || forcing.i < 0.
+        || drainage_kg_m2_s < 0.
+    {
+        return Err(M1Error::new("VEG-E-142", M1Stage::Domain));
+    }
+    if forcing.i > 0.0 {
+        let incident_temperature_k = TF + forcing.hi / CW;
+        if !incident_temperature_k.is_finite()
+            || !(273.15..=373.15).contains(&incident_temperature_k)
+        {
+            return Err(M1Error::new("VEG-E-142", M1Stage::Domain));
+        }
+    }
+    let vapor_flux_kg_m2_s = evap(ending_reservoir, forcing.c, forcing.v)?;
+    let ending_temperature_k = ending_reservoir
+        .wet_temperature_k()
+        .ok_or_else(|| M1Error::new("VEG-E-142", M1Stage::MhConsistency))?;
+    let cap = evaluate_m1_capacity_residual(M1CapacityTrial::new(
+        ending_reservoir.ml(),
+        forcing.c,
+        drainage_kg_m2_s,
+        forcing.dt,
+    ))?
+    .residual_kg_m2;
+    let residuals = M1Residuals {
+        mass_kg_m2: ending.mass_kg_m2
+            - beginning.mass_kg_m2
+            - forcing.dt * (forcing.i - vapor_flux_kg_m2_s - drainage_kg_m2_s),
+        enthalpy_j_m2: ending.enthalpy_j_m2
+            - beginning.enthalpy_j_m2
+            - forcing.dt
+                * (forcing.q + forcing.i * forcing.hi
+                    - vapor_flux_kg_m2_s * (LV + CPV * (ending_temperature_k - TF))
+                    - drainage_kg_m2_s * CW * (ending_temperature_k - TF)),
+        capacity_kg_m2: cap,
+    };
+    if !residuals.mass_kg_m2.is_finite()
+        || !residuals.enthalpy_j_m2.is_finite()
+        || !residuals.capacity_kg_m2.is_finite()
+    {
+        return Err(M1Error::new("VEG-E-142", M1Stage::Domain));
+    }
+    Ok(residuals)
+}
+#[derive(Clone, Copy, Debug)]
+pub struct M1EmptySurfaceInput {
+    pub surface: M1DrySurface,
+    pub area_m2_m2: f64,
+    pub temperature_k: f64,
+    pub pressure_pa: f64,
+    pub qcan_kg_kg: f64,
+    pub liquid_conducting_tissue: bool,
+}
+pub fn validate_m1_empty_surface(x: M1EmptySurfaceInput) -> Result<(), M1Error> {
+    if !x.liquid_conducting_tissue {
+        return Err(M1Error::new("VEG-E-140", M1Stage::Condition));
+    }
+    if !(x.area_m2_m2.is_finite()
+        && x.area_m2_m2 >= 0.
+        && x.qcan_kg_kg.is_finite()
+        && x.qcan_kg_kg >= 0.
+        && x.qcan_kg_kg < 1.)
+    {
+        return Err(M1Error::new("VEG-E-142", M1Stage::Domain));
+    }
+    if x.area_m2_m2 > 0.
+        && x.qcan_kg_kg
+            > sat(
+                x.temperature_k,
+                x.pressure_pa,
+                if x.temperature_k < TF {
+                    M1ExternalPhase::Ice
+                } else {
+                    M1ExternalPhase::Liquid
+                },
+            )?
+            .specific_humidity_kg_kg
+    {
+        return Err(M1Error::new("VEG-E-142", M1Stage::Domain));
+    }
+    Ok(())
+}
+fn is_sha256_digest(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+#[derive(Clone, Debug)]
+pub struct M1RestartValidationContext {
+    d: [String; 4],
+    tx: u64,
+    day: u32,
+    ofe: String,
+    tile: String,
+    occ: String,
+    start: f64,
+    end: f64,
+}
+#[derive(Clone, Copy, Debug)]
+pub struct M1RestartExternalBindings<'a> {
+    pub definition_digests_sha256: [&'a str; 4],
+    pub transaction_id: u64,
+    pub day_index: u32,
+    pub ofe_id: &'a str,
+    pub tile_id: &'a str,
+    pub occupancy_id: &'a str,
+    pub support_start_s: f64,
+    pub support_end_s: f64,
+}
+impl M1RestartValidationContext {
+    pub fn from_external_bindings(
+        bindings: M1RestartExternalBindings<'_>,
+    ) -> Result<Self, M1Error> {
+        if !bindings
+            .definition_digests_sha256
+            .iter()
+            .all(|value| is_sha256_digest(value))
+            || bindings.transaction_id == 0
+            || bindings.ofe_id.is_empty()
+            || bindings.tile_id.is_empty()
+            || bindings.occupancy_id.is_empty()
+            || !bindings.support_start_s.is_finite()
+            || !bindings.support_end_s.is_finite()
+            || bindings.support_end_s <= bindings.support_start_s
+        {
+            return Err(M1Error::new("VEG-E-144", M1Stage::Identity));
+        }
+        Ok(Self {
+            d: bindings.definition_digests_sha256.map(str::to_owned),
+            tx: bindings.transaction_id,
+            day: bindings.day_index,
+            ofe: bindings.ofe_id.into(),
+            tile: bindings.tile_id.into(),
+            occ: bindings.occupancy_id.into(),
+            start: bindings.support_start_s,
+            end: bindings.support_end_s,
+        })
+    }
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct M1RestartExtension {
+    area_basis: String,
+    configuration_digest_sha256: String,
+    consumed_transaction_cursor: u64,
+    day_index: u32,
+    enthalpy_unit: String,
+    h_j_m2: f64,
+    m_kg_h2o_m2: f64,
+    mass_unit: String,
+    model_definition_digest_sha256: String,
+    model_definition_id: String,
+    occupancy_id: String,
+    ofe_id: String,
+    schema_version: u32,
+    source_manifest_sha256: String,
+    support_end_s: f64,
+    support_start_s: f64,
+    tile_id: String,
+    topology_digest_sha256: String,
+    transaction_id: u64,
+}
+impl M1RestartExtension {
+    #[allow(
+        clippy::float_cmp,
+        reason = "Restart support bounds are externally bound identity coordinates and must match exactly."
+    )]
+    pub fn parse_and_validate(
+        serialized: &str,
+        context: &M1RestartValidationContext,
+    ) -> Result<Self, M1Error> {
+        let record: Self = serde_json::from_str(serialized)
+            .map_err(|_| M1Error::new("VEG-E-144", M1Stage::Parse))?;
+        if record.schema_version != 1
+            || record.model_definition_id != "OPENWEPP_C3_WOODY_COLD_M1_V1"
+        {
+            return Err(M1Error::new("VEG-E-144", M1Stage::Version));
+        }
+        if ![
+            &record.model_definition_digest_sha256,
+            &record.configuration_digest_sha256,
+            &record.topology_digest_sha256,
+            &record.source_manifest_sha256,
+        ]
+        .iter()
+        .all(|value| is_sha256_digest(value))
+            || record.model_definition_digest_sha256 != context.d[0]
+            || record.configuration_digest_sha256 != context.d[1]
+            || record.topology_digest_sha256 != context.d[2]
+            || record.source_manifest_sha256 != context.d[3]
+        {
+            return Err(M1Error::new("VEG-E-144", M1Stage::Identity));
+        }
+        if record.transaction_id != context.tx
+            || record.consumed_transaction_cursor != record.transaction_id
+            || record.day_index != context.day
+            || record.support_start_s != context.start
+            || record.support_end_s != context.end
+            || !record.support_start_s.is_finite()
+            || !record.support_end_s.is_finite()
+            || record.support_end_s <= record.support_start_s
+        {
+            return Err(M1Error::new("VEG-E-144", M1Stage::Chronology));
+        }
+        if record.ofe_id != context.ofe
+            || record.tile_id != context.tile
+            || record.occupancy_id != context.occ
+        {
+            return Err(M1Error::new("VEG-E-144", M1Stage::Ownership));
+        }
+        if record.area_basis != "tile_ground"
+            || record.mass_unit != "kg_h2o_m2"
+            || record.enthalpy_unit != "J_m2"
+        {
+            return Err(M1Error::new("VEG-E-144", M1Stage::UnitsArea));
+        }
+        if !record.m_kg_h2o_m2.is_finite()
+            || !record.h_j_m2.is_finite()
+            || record.m_kg_h2o_m2 < 0.0
+            || (record.m_kg_h2o_m2 == 0.0 && record.h_j_m2 != 0.0)
+        {
+            return Err(M1Error::new("VEG-E-144", M1Stage::MhConsistency));
+        }
+        let reservoir = M1PhaseReservoir::from_mass_enthalpy(record.m_kg_h2o_m2, record.h_j_m2)
+            .map_err(|_| M1Error::new("VEG-E-144", M1Stage::Domain))?;
+        if let Some(temperature_k) = reservoir.wet_temperature_k() {
+            if !(258.15..=373.15).contains(&temperature_k) {
+                return Err(M1Error::new("VEG-E-144", M1Stage::Domain));
+            }
+        }
+        Ok(record)
+    }
+    pub fn to_canonical_utf8(&self) -> Result<String, M1Error> {
+        serde_json::to_string(self)
+            .map(|s| s + "\n")
+            .map_err(|_| M1Error::new("VEG-E-144", M1Stage::Parse))
+    }
+    #[must_use]
+    pub fn phase(&self) -> M1Phase {
+        M1PhaseReservoir {
+            m: self.m_kg_h2o_m2,
+            h: self.h_j_m2,
+        }
+        .phase()
+    }
+}
