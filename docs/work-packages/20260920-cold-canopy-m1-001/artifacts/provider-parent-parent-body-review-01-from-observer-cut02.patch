+        Self { coordinates }
+    }
+    pub fn with_coordinate_offset(
+        &self,
+        index: usize,
+        offset: f64,
+    ) -> Result<Self, M1CoupledError> {
+        if index >= 21 || !offset.is_finite() {
+            return Err(saturation_error());
+        }
+        let mut trial = self.clone();
+        trial.coordinates[index] += offset;
+        Ok(trial)
+    }
