+            &leaves[1]["rd"],
+            &gas["comparisons"]["respiration_assimilation"],
+        );
+        close(
+            shade.net_assimilation_umol_co2_m2_leaf_s,
+            &leaves[1]["an"],
+            &gas["comparisons"]["respiration_assimilation"],
+        );
+        close(
