+impl M1OwnerCandidate {
+    #[must_use]
+    pub fn transaction_id(&self) -> TransactionId {
+        self.transaction_id
+    }
+    #[must_use]
+    pub fn beginning(&self) -> &M1OwnerState {
+        &self.beginning
+    }
+    #[must_use]
+    pub fn ending(&self) -> &M1OwnerState {
+        &self.ending
+    }
+    #[must_use]
+    pub fn accepted(&self) -> &[M1AcceptedStratumResult] {
+        &self.accepted
+    }
+    #[must_use]
+    pub fn material_proposals(&self) -> &[MaterialTransfer] {
+        &self.material_proposals
+    }
+    #[must_use]
+    pub fn nitrogen_protocol(
+        &self,
+    ) -> (
+        &[crate::transaction::NitrogenRequest],
+        &[crate::transaction::NitrogenAuthorization],
+        &[crate::transaction::NitrogenUse],
+    ) {
+        (&self.requests, &self.authorizations, &self.finalized_uses)
+    }
+
+    pub fn validate_sealed(&self) -> Result<(), M1Error> {
+        if self.transaction_id.0 != u128::from(self.beginning.revision) + 1
+            || self.ending.revision != self.beginning.revision + 1
+            || self.beginning.model_definition_id != self.ending.model_definition_id
+            || self.beginning.model_definition_sha256 != self.ending.model_definition_sha256
+            || self.beginning.configuration_sha256 != self.ending.configuration_sha256
+            || self.ending.state_sha256 != self.ending.recompute_sha256()?
+        {
+            return Err(identity_error());
+        }
+        validate_vegetation_ledgers(
+            &self.ending.strata.keys().cloned().collect(),
+            self.transaction_id,
+            &self.beginning.state_sha256,
+            &self.ending.state_sha256,
+            &self.carbon_ledgers,
+            &self.nitrogen_ledgers,
+            &self.dry_material_ledgers,
+        )
+        .map_err(|_| domain_error())
+    }
+}
