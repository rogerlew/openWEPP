+    pub(crate) selected_phase: Phase,
+    pub(crate) natural: super::m1_trust_region_stage1::M1TrustRegionBvls05AssemblyInspection,
+    pub(crate) selected: super::m1_trust_region_stage1::M1TrustRegionBvls05AssemblyInspection,
+    pub(crate) retry: super::m1_trust_region_stage1::M1TrustRegionBvls05AssemblyInspection,
