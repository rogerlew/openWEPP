+#[cfg(feature = "m1-trust-region-physical-stage")]
+fn bvls05_assert_trial_recomputation(
+    observation: &super::M1TrustRegionBvls05TrialRecomputationObservation,
+    expected_upper_wet: bool,
+) {
+    assert_eq!(observation.current_evaluations, 2);
+    assert_eq!(observation.trial_domain_checks, 1);
+    assert!(observation.input_unchanged);
+    assert!(observation.trial_unchanged);
+    assert!(
+        observation
+            .candidate_residual
+            .iter()
+            .all(|value| value.is_finite())
+    );
+    assert!(observation.candidate_normalizers.iter().all(|value| {
+        value.is_finite() && matches!(value.partial_cmp(&0.0), Some(std::cmp::Ordering::Greater))
+    }));
+    assert!(!observation.candidate_full_residual_root);
+    assert_ne!(
+        observation.base_residual.map(f64::to_bits),
+        observation.candidate_residual.map(f64::to_bits)
+    );
+    let upper_wet = observation.candidate_wet_fractions[0];
+    if expected_upper_wet {
+        assert_eq!(upper_wet.to_bits(), 1.0_f64.to_bits());
+    } else {
+        assert!(matches!(
+            upper_wet.partial_cmp(&0.0),
+            Some(std::cmp::Ordering::Greater)
+        ));
+        assert!(matches!(
+            upper_wet.partial_cmp(&1.0),
+            Some(std::cmp::Ordering::Less)
+        ));
+    }
+}
