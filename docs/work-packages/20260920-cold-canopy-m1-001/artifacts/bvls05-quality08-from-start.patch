+#[cfg(feature = "m1-trust-region-physical-stage")]
+fn bvls05_role_is_certified(
+    inspection: &super::m1_trust_region_stage1::M1TrustRegionBvls05AssemblyInspection,
+    slot: usize,
+) -> bool {
+    let provenance = inspection.provenance.expect("actual physical provenance");
+    let column = provenance.role_columns[slot];
+    let area = provenance.structural_areas[slot];
+    let wet = provenance.wet_fractions[slot];
+    let dry_bits = (area * (1.0 - wet)).to_bits() & 0x7fff_ffff_ffff_ffff;
+    let raw_zero = inspection
+        .input
+        .raw_jacobian
+        .iter()
+        .all(|row| row[column].to_bits().trailing_zeros() >= 63);
+    let weighted_zero = inspection
+        .weighted_matrix
+        .iter()
+        .all(|row| row[column].to_bits().trailing_zeros() >= 63);
+    area.is_finite()
+        && matches!(area.partial_cmp(&0.0), Some(std::cmp::Ordering::Greater))
+        && wet.to_bits() == 1.0_f64.to_bits()
+        && dry_bits == 0
+        && provenance.initial_free[slot]
+        && provenance.physical_current_free[slot]
+        && raw_zero
+        && weighted_zero
+}
