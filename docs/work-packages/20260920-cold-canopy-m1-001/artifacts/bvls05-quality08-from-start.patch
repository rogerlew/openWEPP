+        for row in 0..21 {
+            for column in 0..21 {
+                residual[row] += raw[row][column] * p[column];
+            }
+        }
+        let mut h = [0.0; 21];
+        for column in 0..21 {
+            for row in 0..21 {
+                h[column] += raw[row][column] * residual[row];
+            }
+            h[column] += lambda * p[column];
+        }
+        h
+    }
