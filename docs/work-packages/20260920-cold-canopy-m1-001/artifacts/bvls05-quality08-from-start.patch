+#[cfg(all(test, feature = "m1-trust-region-physical-stage"))]
+fn bvls05_inspection_error<E>(
+    error: M1TrustRegionControllerError<core::convert::Infallible>,
+) -> M1TrustRegionControllerError<E> {
+    match error {
+        M1TrustRegionControllerError::Subproblem(refusal) => {
+            M1TrustRegionControllerError::Subproblem(refusal)
+        }
+        M1TrustRegionControllerError::CoreWorkCap => M1TrustRegionControllerError::CoreWorkCap,
+        M1TrustRegionControllerError::Numerical(message) => {
+            M1TrustRegionControllerError::Numerical(message)
+        }
+        M1TrustRegionControllerError::IncompleteScope => {
+            M1TrustRegionControllerError::IncompleteScope
+        }
+        M1TrustRegionControllerError::Own(never) => match never {},
+    }
+}
+
+#[cfg(all(test, feature = "m1-trust-region-physical-stage"))]
+pub(crate) fn m1_trust_region_bvls05_selected_retry_lifecycle_for_test<E, P, Phase, V>(
+    evaluator: &mut V,
+    selected_direction: [f64; 21],
+    new_base: [f64; 21],
+) -> Result<M1TrustRegionBvls05SelectedRetryObservation<Phase>, M1TrustRegionControllerError<E>>
+where
+    P: Clone,
+    Phase: Clone + PartialEq,
+    V: M1TrustRegionControllerEvaluator<Error = E, Payload = P, Phase = Phase>,
+{
+    let mut state = FoundationState::initialize(evaluator)?;
+    let natural = state
+        .inspect_bvls05_assembly_for_test()
+        .map_err(bvls05_inspection_error)?;
+    let selected_phase = evaluator
+        .select_phase(&state.current, selected_direction)
+        .map_err(M1TrustRegionControllerError::Own)?;
+    let raw_jacobian = evaluator
+        .raw_jacobian(&state.current, Some(&selected_phase), selected_direction)
+        .map_err(M1TrustRegionControllerError::Own)?;
+    state.replace_assembly_for_bvls05::<E, V>(evaluator, &raw_jacobian);
+    state.selected_phase = selected_phase.clone();
+    let selected = state
+        .inspect_bvls05_assembly_for_test()
+        .map_err(bvls05_inspection_error)?;
+    state.radius *= 0.25;
+    let retry = state
+        .inspect_bvls05_assembly_for_test()
+        .map_err(bvls05_inspection_error)?;
+    state.current = state.budget.enter(evaluator, new_base)?;
+    state.reassemble_current(evaluator)?;
+    let new_base = state
+        .inspect_bvls05_assembly_for_test()
+        .map_err(bvls05_inspection_error)?;
+    Ok(M1TrustRegionBvls05SelectedRetryObservation {
+        selected_phase,
+        natural,
+        selected,
+        retry,
+        new_base,
+    })
+}
