+#[cfg(all(test, feature = "m1-trust-region-physical-stage"))]
+pub(crate) fn m1_trust_region_physical_adapter_bvls05_trial_recomputation_for_test(
+    adapter: &mut M1PhysicalTrustRegionAdapter,
