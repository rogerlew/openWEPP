+#[cfg(feature = "m1-trust-region-physical-stage")]
+fn bvls05_trial_with_upper_operands(mass: f64) -> M1CoupledColumnTrial {
+    let mut coordinates = super::m1_trial_coordinates_for_test(&trial());
+    coordinates[3] = mass;
