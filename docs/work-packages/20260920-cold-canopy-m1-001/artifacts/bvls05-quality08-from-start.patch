+#[cfg(feature = "m1-trust-region-physical-stage")]
+fn bvls05_held_objective_identity(
+    inspection: &super::m1_trust_region_stage1::M1TrustRegionBvls05AssemblyInspection,
+) {
+    let step: [f64; 21] = std::array::from_fn(|column| {
+        if inspection.held[column] {
+            0.0
+        } else {
+            f64::from(u32::try_from(column + 1).expect("21-coordinate test vector"))
+        }
+    });
+    let full = inspection
+        .weighted_matrix
+        .iter()
+        .zip(&inspection.weighted_residual)
+        .map(|(row, residual)| {
+            residual
+                + row
+                    .iter()
+                    .zip(&step)
+                    .map(|(entry, value)| entry * value)
+                    .sum::<f64>()
+        })
+        .collect::<Vec<_>>();
+    let reduced = inspection
+        .weighted_matrix
+        .iter()
+        .zip(&inspection.weighted_residual)
+        .map(|(row, residual)| {
+            residual
+                + inspection
+                    .retained_free_ids
+                    .iter()
+                    .map(|&column| row[column] * step[column])
+                    .sum::<f64>()
+        })
+        .collect::<Vec<_>>();
+    for (full_value, reduced_value) in full.iter().zip(&reduced) {
+        assert_eq!(full_value.to_bits(), reduced_value.to_bits());
+    }
+    let full_norm = step.iter().map(|value| value * value).sum::<f64>();
+    let reduced_norm = inspection
+        .retained_free_ids
+        .iter()
+        .map(|&column| step[column] * step[column])
+        .sum::<f64>();
+    assert_eq!(full_norm.to_bits(), reduced_norm.to_bits());
+}
