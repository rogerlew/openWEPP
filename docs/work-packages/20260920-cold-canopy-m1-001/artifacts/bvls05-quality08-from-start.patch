+#[cfg(feature = "m1-trust-region-physical-stage")]
+#[test]
+fn m1_trust_region_bvls05_g4_full_wet_actual_assembly() {
+    let input = retained_phase_control_input();
+    let inspection = bvls05_natural_assembly(
+        input.clone(),
+        bvls05_trial_with_upper_operands(bvls05_upper_capacity(&input)),
+    );
+    assert_eq!(inspection.input.raw_jacobian.len(), 21);
+    assert_eq!(inspection.weighted_matrix.len(), 21);
+    assert_eq!(
+        inspection.held,
+        std::array::from_fn(|column| matches!(column, 1 | 2))
+    );
+    assert_eq!(
+        inspection.retained_free_ids,
+        (0..21)
+            .filter(|&column| !matches!(column, 1 | 2))
+            .collect::<Vec<_>>()
+    );
+    for &column in &[5_usize, 11] {
+        assert!(inspection.retained_free_ids.contains(&column));
+        assert!(
+            inspection
+                .input
+                .raw_jacobian
+                .iter()
+                .any(|row| { row[column].to_bits() & 0x7fff_ffff_ffff_ffff != 0 })
+        );
+    }
+    for (row, raw_row) in inspection.input.raw_jacobian.iter().enumerate() {
+        let weight = 1.0 / inspection.input.normalizers[row];
+        for (column, raw) in raw_row.iter().enumerate() {
+            assert_eq!(
+                inspection.weighted_matrix[row][column].to_bits(),
+                (weight * raw * inspection.input.scales[column]).to_bits()
+            );
+        }
+    }
+    bvls05_held_objective_identity(&inspection);
+}
