+    Ok(M1TrustRegionBvls05TrialRecomputationObservation {
+        base_residual: base.raw_residual,
+        candidate_residual: candidate.raw_residual,
+        candidate_normalizers: candidate.dynamic_normalizers,
+        candidate_wet_fractions: [
+            candidate.payload.core.occupancies[0].wet_fraction,
+            candidate.payload.core.occupancies[1].wet_fraction,
