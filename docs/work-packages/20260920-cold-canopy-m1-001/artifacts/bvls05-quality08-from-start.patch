+fn bvls05_scatter_held(
+    base: [f64; 21],
+    held: [bool; 21],
+    mut step: [f64; 21],
+    mut candidate: [f64; 21],
+    work: &mut super::M1TrustRegionWorkObservation,
+) -> ([f64; 21], [f64; 21]) {
+    for coordinate in 0..21 {
+        if held[coordinate] {
+            work.bvls05_held_base_copies_attempted += 1;
+            step[coordinate] = 0.0;
+            candidate[coordinate] = base[coordinate];
