+    let certificate = bvls05_admit_for_input(input, prepared, state);
+    state.held = certificate.held;
+    state.bvls05_work = certificate.work;
+    state.bvls05_inspected = true;
+    // Certificate admission does not itself enter a face; each actual face
+    // charges its own full-coordinate mask join in solve_face.
+    state.bvls05_work.bvls05_mask_joins_attempted = 0;
+    state.bvls05_work.bvls05_mask_joins_completed = 0;
+    *certificate_cache = Some(M1TrustRegionBvls05Certificate {
+        held: certificate.held,
+    });
+}
