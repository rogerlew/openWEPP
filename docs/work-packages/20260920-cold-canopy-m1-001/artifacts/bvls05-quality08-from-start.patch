+    #[test]
+    fn m1_trust_region_bvls05_fixed_bound_active_precedence_red() {
+        let input = bvls05_diagonal_input();
+        let certificate = bvls05_fixed_active_certificate_and_partition(&input);
+
+        // Exercise the actual KKT owner with a fixed coordinate, two
+        // certificate-held free coordinates, and independent lower/upper
+        // physical active coordinates.  The certificate is only metadata at
+        // this pre-body seam; it does not mutate physical masks.
+        let mut kkt_input = bvls05_diagonal_input();
+        kkt_input.lower[0] = 0.0;
+        kkt_input.upper[0] = 0.0;
+        // Physical bounds do not make a coordinate fixed when they are only
+        // attained by the base: both certified coordinates remain free.
+        kkt_input.lower[1] = -2.0;
+        kkt_input.base[1] = -2.0;
+        kkt_input.upper[2] = 2.0;
+        kkt_input.base[2] = 2.0;
+        kkt_input.raw_residual[3] = -1.0;
+        kkt_input.raw_residual[4] = -2.0;
+        let prepared = super::prepare_subproblem(&kkt_input).expect("KKT preparation");
+        let mut kkt_state = super::SubproblemState::new(&kkt_input);
+        kkt_state.p[3] = -2.0;
+        kkt_state.p[4] = 2.0;
+        kkt_state.lower_active[3] = true;
+        kkt_state.upper_active[4] = true;
+        kkt_state.free[3] = false;
+        kkt_state.free[4] = false;
+        let held = certificate.held;
+        assert!(held[1] && held[2]);
+        assert!(kkt_state.initial_free[1] && kkt_state.initial_free[2]);
+        assert!(kkt_state.free[1] && kkt_state.free[2]);
+        let solution = super::FaceSolution {
+            free_ids: (0..21)
+                .filter(|coordinate| kkt_state.free[*coordinate])
+                .collect(),
+            trace: super::LambdaTrace {
+                lambda: 0.0,
+                ..Default::default()
+            },
+            refined: false,
+            factor: None,
+            radius: 8.0,
+        };
+        let transition = super::kkt_transition(&prepared, &mut kkt_state, &solution)
+            .expect("actual KKT transition");
+        assert!(transition.values.is_none());
+        assert_eq!(transition.observation.coordinates.len(), 21);
+        for held_coordinate in [1, 2] {
+            let observed = &transition.observation.coordinates[held_coordinate];
+            assert_eq!(observed.coordinate, held_coordinate);
+            assert_eq!(observed.h.to_bits(), 0.0f64.to_bits());
+            assert_eq!(observed.cbar.to_bits(), 0.0f64.to_bits());
+            assert_eq!(observed.tau.to_bits(), 0.0f64.to_bits());
+            assert_eq!(
+                observed.class,
+                crate::M1TrustRegionOptimalityClass::FreePass
+            );
+        }
+        assert_eq!(
+            transition.observation.coordinates[0].class,
+            crate::M1TrustRegionOptimalityClass::Fixed
+        );
+        assert!(
+            kkt_state.free[3],
+            "actual owner releases lower-active coordinate 3"
+        );
+        assert!(
+            kkt_state.upper_active[4],
+            "upper-active coordinate remains retained"
+        );
+        assert!(kkt_state.initial_free[1] && kkt_state.initial_free[2]);
+        let observation = kkt_state
+            .events
+            .last()
+            .and_then(|event| event.g)
+            .expect("KKT event");
+        assert_eq!(observation[1].to_bits(), 0.0f64.to_bits());
+        assert_eq!(observation[2].to_bits(), 0.0f64.to_bits());
+    }
