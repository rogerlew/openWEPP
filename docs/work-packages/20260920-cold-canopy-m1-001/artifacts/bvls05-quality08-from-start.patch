+    fn bvls05_fixed_active_certificate_and_partition(
+        input: &M1TrustRegionSubproblemInput,
+    ) -> super::Bvls05CertificateObservation {
+        let weighted = bvls05_weighted(&input.raw_jacobian);
+        let mut roles = bvls05_roles(input);
+        roles[1].initial_free = false;
+        roles[2].physical_current_free = false;
+        let rejected = super::bvls05_certificate_for_test(&roles, &input.raw_jacobian, &weighted);
+        assert!(!rejected.held[1]);
+        assert!(!rejected.held[2]);
+        let mut bound_free = bvls05_roles(input);
+        bound_free[1].initial_free = true;
+        bound_free[1].physical_current_free = true;
+        let certificate =
+            super::bvls05_certificate_for_test(&bound_free, &input.raw_jacobian, &weighted);
+        assert!(certificate.held[1]);
+        // Drive the real state partition: coordinate 0 is fixed, 3 is at a
+        // lower active bound, 4 at an upper active bound, and 5 is ordinary
+        // free/releasable.  The admitted certificate is external to physical
+        // bounds and never changes this partition.
+        let mut state_input = input.clone();
+        state_input.lower[0] = 0.0;
+        state_input.upper[0] = 0.0;
+        let mut state = super::SubproblemState::new(&state_input);
+        state.lower_active[3] = true;
+        state.free[3] = false;
+        state.upper_active[4] = true;
+        state.free[4] = false;
+        assert!(!state.initial_free[0]);
+        assert!(state.initial_free[1]);
+        assert!(state.lower_active[3] && !state.free[3]);
+        assert!(state.upper_active[4] && !state.free[4]);
+        assert!(state.free[5]);
+        state.lower_active[3] = false;
+        state.free[3] = true;
+        assert!(
+            state.free[3],
+            "ordinary non-held active coordinates release"
+        );
+        let mut held_step = [1.0_f64; 21];
+        held_step[1] = 0.0;
+        held_step[2] = 0.0;
+        let (scattered, _) = super::bvls05_scatter_held(
+            state_input.base,
+            certificate.held,
+            [0.0; 21],
+            state_input.base,
+            &mut crate::M1TrustRegionWorkObservation::default(),
+        );
+        assert_eq!(scattered[1].to_bits(), held_step[1].to_bits());
+        assert_eq!(scattered[2].to_bits(), held_step[2].to_bits());
+        certificate
+    }
