+fn exhausted_witness_residual(coordinates: [f64; N], base: [f64; N], scale: [f64; N]) -> f64 {
+    let z = (coordinates[3] - base[3]) / scale[3];
+    -0.5 + z / 4.0 - z * z / 4.0
