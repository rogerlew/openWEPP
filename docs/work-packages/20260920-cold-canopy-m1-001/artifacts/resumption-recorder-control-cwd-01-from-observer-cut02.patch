-pub(crate) fn sweep() -> Observation {
-    let identity = ACTIVE.with(|active| {
-        active.borrow().as_ref().and_then(|state| {
-            state
-                .current
-                .as_ref()
-                .map(|(family, pass, _, _)| (*family, *pass))
-        })
-    });
-    identity.map_or(
-        Observation {
-            index: None,
-            clear_sweep: false,
-            generation: None,
-            dimension: 0,
-        },
-        |(family, pass)| start(family, pass, "sweep", "not_applicable", "lifecycle"),
-    )
