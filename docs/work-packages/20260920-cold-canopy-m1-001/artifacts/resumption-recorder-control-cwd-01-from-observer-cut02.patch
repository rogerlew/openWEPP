-        ACTIVE.with(|active| {
-            let state = active.borrow_mut().take().ok_or(CaptureError::NotActive)?;
-            if state.live != 0 {
-                return Err(CaptureError::LiveScopes);
-            }
-            if state.overflow {
-                return Err(CaptureError::Overflow);
