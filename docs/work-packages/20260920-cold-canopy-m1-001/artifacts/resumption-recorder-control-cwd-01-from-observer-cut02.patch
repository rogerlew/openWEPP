-    }
-    let lse_bytes: Vec<u8> =
-        serde_json::from_value(get("lse_configuration_canonical_json")?.clone())
-            .map_err(|e| e.to_string())?;
-    let lse = serde_json::from_slice(&lse_bytes).map_err(|e| e.to_string())?;
