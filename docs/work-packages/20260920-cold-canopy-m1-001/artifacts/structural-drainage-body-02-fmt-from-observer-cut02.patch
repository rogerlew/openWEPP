+fn phase_join_selections(
+    input: &M1CoupledColumnInput,
+    trial: &M1CoupledColumnTrial,
+    direction: &[f64; 21],
+) -> Result<[M1PhaseJoinSelection; 2], M1PhaseJoinFailure> {
+    let reservoir = |base| M1PhaseReservoir::from_mass_enthalpy(
+        trial.coordinates[base + 3], trial.coordinates[base + 4],
+    ).map_err(|error| M1PhaseJoinFailure::Source { error: Box::new(error.into()), activity: M1PhaseJoinActivity::default() });
+    let selection = |base: usize| {
+        let occupancy = &input.column.occupancies[base / 6];
+        classify_m1_phase_join_active_set(
+            reservoir(base)?,
+            occupancy.liquid_capacity_kg_m2_plant * (occupancy.lai + occupancy.sai),
+            trial.coordinates[base + 5], input.column.interval_s,
+            direction[base + 3], direction[base + 4], direction[base + 5],
+        )
+    };
+    Ok([selection(0)?, selection(6)?])
+}
+
+/// Solve the selected affine drainage rows by substitution before the existing
+/// LU factorization.  The selected capacity equation is `dt * D = 0`, so its
+/// Newton correction is exactly `-D`; retained rows receive that contribution
+/// in ascending eliminated-coordinate order.
+fn solve_selected_drainage_system(
+    matrix: &[Vec<f64>], rhs: &[f64], raw: &[Vec<f64>], base: &Core,
+    input: &M1CoupledColumnInput, trial: &M1CoupledColumnTrial,
+    selections: &[M1PhaseJoinSelection; 2], iteration: u32, backtracking_count: u32,
+) -> Result<([f64; 21], f64, f64, [bool; 2], usize), M1CoupledError> {
+    use openwepp_vegetation::cold_canopy_m1::M1CapacityBranch;
+    let selected = [
+        selections[0].capacity == M1CapacityBranch::Drainage,
+        selections[1].capacity == M1CapacityBranch::Drainage,
+    ];
+    let integrity = || m1_failure(
+        crate::numerics::NumericalFailureKind::DrainageEliminationIntegrity,
+        iteration, input, base, trial, backtracking_count,
+        StepNorms { temperature_k: None, humidity_kg_kg: None, ci_pa: None, hydraulic_mm: None, beta: Some(0.0) },
+        None, None,
+    );
+    let singular = |pivot, norm| m1_failure(
+        crate::numerics::NumericalFailureKind::SingularPivot,
+        iteration, input, base, trial, backtracking_count,
+        StepNorms { temperature_k: None, humidity_kg_kg: None, ci_pa: None, hydraulic_mm: None, beta: Some(0.0) },
+        Some(pivot), Some(norm),
+    );
+    if matrix.len() != 21 || raw.len() != 21 || rhs.len() != 21
+        || matrix.iter().any(|row| row.len() != 21)
+        || raw.iter().any(|row| row.len() != 21)
+        || matrix.iter().flatten().any(|value| !value.is_finite())
+        || raw.iter().flatten().any(|value| !value.is_finite())
+        || rhs.iter().any(|value| !value.is_finite())
+    { return Err(integrity()); }
+    if !selected.iter().any(|value| *value) {
+        let (solution, pivot, norm) = crate::numerics::solve_linear(matrix, rhs)
+            .map_err(|error| singular(error.pivot, error.matrix_norm))?;
+        if solution.iter().any(|value| !value.is_finite()) {
+            return Err(LandSurfaceEnergyError::NonFinite("m1_reduced_linear_result").into());
+        }
+        let mut direction = [0.0; 21]; direction.copy_from_slice(&solution);
+        return Ok((direction, pivot, norm, selected, 21));
+    }
+    let tolerances = m1_tolerances(input, base);
+    let full_norm = matrix.iter().map(|row| row.iter().map(|value| value.abs()).sum::<f64>()).fold(0.0, f64::max);
+    if !full_norm.is_finite() { return Err(integrity()); }
+    let mut eliminated = Vec::with_capacity(2);
+    for (slot, active) in selected.iter().enumerate() {
+        if !active { continue; }
+        let row = slot * 6 + 5;
+        let duration = input.column.interval_s;
+        let drainage = trial.coordinates[row];
+        let tolerance = tolerances[row];
+        let raw_residual = duration * drainage;
+        if !duration.is_finite() || duration <= 0.0 || !drainage.is_finite() || drainage < 0.0
+            || !tolerance.is_finite() || tolerance <= 0.0
+            || raw[row][row] != duration || base.residuals[row] != raw_residual
+            || raw[row].iter().enumerate().any(|(column, value)| column != row && *value != 0.0)
+            || matrix[row][row] != duration / tolerance
+            || matrix[row].iter().enumerate().any(|(column, value)| column != row && *value != 0.0)
+            || rhs[row] != -(raw_residual / tolerance)
+            || matrix[row][row].abs() < 64.0 * f64::EPSILON * full_norm
+        { return Err(integrity()); }
+        eliminated.push(row);
+    }
+    let retained: Vec<_> = (0..21).filter(|index| !eliminated.contains(index)).collect();
+    let mut reduced = vec![vec![0.0; retained.len()]; retained.len()];
+    let mut reduced_rhs = vec![0.0; retained.len()];
+    for (reduced_row, &row) in retained.iter().enumerate() {
+        reduced_rhs[reduced_row] = rhs[row];
+        for &column in &eliminated {
+            reduced_rhs[reduced_row] -= matrix[row][column] * -trial.coordinates[column];
+        }
+        for (reduced_column, &column) in retained.iter().enumerate() {
+            reduced[reduced_row][reduced_column] = matrix[row][column];
+        }
+    }
+    if reduced_rhs.iter().any(|value| !value.is_finite()) || reduced.iter().flatten().any(|value| !value.is_finite()) {
+        return Err(LandSurfaceEnergyError::NonFinite("m1_reduced_linear_result").into());
+    }
+    let (solution, pivot, norm) = crate::numerics::solve_linear(&reduced, &reduced_rhs)
+        .map_err(|error| singular(error.pivot, error.matrix_norm))?;
+    if solution.iter().any(|value| !value.is_finite()) { return Err(LandSurfaceEnergyError::NonFinite("m1_reduced_linear_result").into()); }
+    let mut direction = [0.0; 21];
+    for (index, value) in retained.into_iter().zip(solution) { direction[index] = value; }
+    for index in eliminated { direction[index] = -trial.coordinates[index]; }
+    if direction.iter().any(|value| !value.is_finite()) { return Err(LandSurfaceEnergyError::NonFinite("m1_reduced_linear_result").into()); }
+    Ok((direction, pivot, norm, selected, 21 - selected.iter().filter(|value| **value).count()))
+}
