+#[derive(Clone, Debug, PartialEq)]
+pub enum M1CoupledError {
+    LandSurfaceEnergy(LandSurfaceEnergyError),
+    Vegetation(openwepp_vegetation::cold_canopy_m1::M1Error),
+    /// Detached M1 retains its complete numerical evidence until the owning
+    /// caller can attach runtime identities to it.
+    Numerical(crate::numerics::NumericalFailure),
+}
+impl M1CoupledError {
+    #[must_use]
+    pub fn code(&self) -> &str {
+        match self {
+            Self::Numerical(_) => "LSEB-E-034",
+            Self::Vegetation(error) => error.code(),
+            Self::LandSurfaceEnergy(error) => match error {
+                LandSurfaceEnergyError::UnsupportedDomain(_) => "LSEB-E-030",
+                LandSurfaceEnergyError::SupportBelowMinimum { .. } => "LSEB-E-041",
+                LandSurfaceEnergyError::MalformedSerialization(_)
+                | LandSurfaceEnergyError::Identity { .. }
+                | LandSurfaceEnergyError::Topology { .. }
+                | LandSurfaceEnergyError::StateLineage(_)
+                | LandSurfaceEnergyError::OwnerEnvelope(_)
+                | LandSurfaceEnergyError::FrozenLitterV3Identity(_)
+                | LandSurfaceEnergyError::FrozenLitterTransaction(_) => "LSEB-E-031",
+                LandSurfaceEnergyError::NonFinite(_)
+                | LandSurfaceEnergyError::ConstitutiveDomain(_) => "LSEB-E-032",
+                LandSurfaceEnergyError::WaterIdentityOrBound { .. } => "LSEB-E-033",
+                LandSurfaceEnergyError::NumericalSingular { .. }
+                | LandSurfaceEnergyError::NumericalBacktrackingLimit { .. }
+                | LandSurfaceEnergyError::NumericalPhaseActiveSetInconsistent { .. }
+                | LandSurfaceEnergyError::NumericalPhaseActiveSetUnrepresentable { .. }
+                | LandSurfaceEnergyError::NumericalDrainageEliminationIntegrity { .. }
+                | LandSurfaceEnergyError::NumericalIterationLimit { .. }
+                | LandSurfaceEnergyError::NumericalAcceptedResidual => "LSEB-E-034",
+                LandSurfaceEnergyError::ComponentClosure(_)
+                | LandSurfaceEnergyError::ControlVolumeClosure(_) => "LSEB-E-035",
+                LandSurfaceEnergyError::LatentJoin(_)
+                | LandSurfaceEnergyError::FrozenLitterVapor(_)
+                | LandSurfaceEnergyError::FrozenLitterPhaseClosure(_) => "LSEB-E-036",
+                LandSurfaceEnergyError::GroundHeatJoin(_) => "LSEB-E-037",
+                LandSurfaceEnergyError::SupportReceipt(_) => "LSEB-E-038",
+            },
+        }
+    }
+}
