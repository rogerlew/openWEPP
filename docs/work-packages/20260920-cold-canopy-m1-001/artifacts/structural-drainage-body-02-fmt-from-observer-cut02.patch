+/// Solves the bounded M1 diagnostic column from the canonical cold-column seed.
+pub fn solve_m1_coupled_column(
+    input: &M1CoupledColumnInput,
+) -> Result<M1CoupledEvaluation, M1CoupledError> {
+    // Structural preflight precedes all topology-indexed seed reads.
+    if input.column.occupancies.len() != 2
+        || input.column.ground.soil_nodes.len() != 6
+        || input
+            .topology
+            .occupancy_ids
+            .iter()
+            .collect::<BTreeSet<_>>()
+            .len()
+            != 2
+        || input
+            .topology
+            .soil_layer_ids
+            .iter()
+            .collect::<BTreeSet<_>>()
+            .len()
+            != 6
+    {
+        return Err(LandSurfaceEnergyError::UnsupportedDomain("m1_diagnostic_envelope").into());
+    }
+    let boundary = input
+        .column
+        .stage3_lower_boundary
+        .as_ref()
+        .ok_or_else(|| LandSurfaceEnergyError::UnsupportedDomain("m1_diagnostic_envelope"))?;
+    let mut coordinates = [input.column.air_temperature_k; 21];
+    coordinates[3] = input.reservoirs[0].mass_kg_m2;
+    coordinates[4] = input.reservoirs[0].enthalpy_j_m2;
+    coordinates[5] = 0.0;
+    coordinates[9] = input.reservoirs[1].mass_kg_m2;
+    coordinates[10] = input.reservoirs[1].enthalpy_j_m2;
+    coordinates[11] = 0.0;
+    coordinates[12] = input.column.air_temperature_k;
+    coordinates[13] = input.column.air_specific_humidity_kg_kg;
+    coordinates[14] = boundary.snow_temperature_k;
+    for soil in 0..6 {
+        coordinates[15 + soil] = input.column.ground.soil_nodes[soil].beginning_temperature_k;
+    }
+    let mut trial = M1CoupledColumnTrial::from_coordinates(coordinates);
+    validate(input, &trial)?;
+    let mut backtracking_count = 0;
+    let mut last_installed_steps: Option<StepNorms> = None;
+    for iteration in 0..=crate::numerics::MAX_NEWTON_ITERATIONS {
+        if let Some(steps) = &last_installed_steps {
+            let current = core(input, &trial)?;
+            let current_norm = normalized(&current, input)
+                .iter()
+                .map(|value| value.abs())
+                .fold(0.0_f64, f64::max);
+            if current_norm <= 1.0
+                && steps.temperature_k.is_some_and(|value| value <= 1.0e-8)
+                && steps.humidity_kg_kg.is_some_and(|value| value <= 1.0e-12)
+                && steps.hydraulic_mm.is_some_and(|value| value <= 1.0e-7)
+            {
+                return evaluate_m1_coupled_column(input, &trial);
+            }
+        }
+        if iteration == crate::numerics::MAX_NEWTON_ITERATIONS {
+            let terminal = core(input, &trial)?;
+            if normalized(&terminal, input)
+                .iter()
+                .all(|value| value.is_finite())
+                && normalized(&terminal, input)
+                    .iter()
+                    .map(|value| value.abs())
+                    .fold(0.0_f64, f64::max)
+                    <= 1.0
+                && last_installed_steps.as_ref().is_some_and(|steps| {
+                    steps.temperature_k.is_some_and(|value| value <= 1.0e-8)
+                        && steps.humidity_kg_kg.is_some_and(|value| value <= 1.0e-12)
+                        && steps.hydraulic_mm.is_some_and(|value| value <= 1.0e-7)
+                })
+            {
+                return evaluate_m1_coupled_column(input, &trial);
+            }
+            return Err(m1_failure(
+                crate::numerics::NumericalFailureKind::IterationLimit,
+                iteration,
+                input,
+                &terminal,
+                &trial,
+                backtracking_count,
+                StepNorms {
+                    temperature_k: None,
+                    humidity_kg_kg: None,
+                    ci_pa: None,
+                    hydraulic_mm: None,
+                    beta: Some(0.0),
+                },
+                None,
+                None,
+            ));
+        }
+        // The controller owns the only predictor and optional corrected solve
+        // for this Newton base.  It is deliberately called before candidate
+        // construction so a frozen-set failure cannot enter backtracking.
+        let phase_report = m1_phase_join_controller(
+            input,
+            &trial,
+            iteration,
+            backtracking_count,
+            None,
+            None,
+            #[cfg(test)]
+            None,
+        ).map_err(M1PhaseJoinControllerError::into_source)?;
+        let base = phase_report.base.clone();
+        let residuals = normalized(&base, input);
+        if residuals.iter().any(|x| !x.is_finite())
+            || phase_report.raw_jacobian.iter().flatten().any(|x| !x.is_finite())
+        {
+            return Err(domain_error());
+        }
+        let norm = residuals.iter().map(|x| x.abs()).fold(0.0_f64, f64::max);
+        let delta = phase_report.direction().to_vec();
+        #[cfg(test)]
+        if iteration == 0 || iteration == 3 {
+            let mut rhs: Vec<f64> = residuals.iter().map(|value| -value).collect();
+            for (index, occupancy) in input.column.occupancies.iter().enumerate() {
+                for (offset, area) in [occupancy.sun.leaf_area_m2_m2_tile, occupancy.shade.leaf_area_m2_m2_tile, occupancy.stem_area_m2_m2_tile].into_iter().enumerate() {
+                    if area == 0.0 { rhs[index * 6 + offset] = -base.residuals[index * 6 + offset]; }
+                }
+            }
+            eprintln!(
+                "m1-linear-witness {}",
+                serde_json::json!({
+                    "iteration": iteration,
+                    "normalized_jacobian": phase_report.normalized_jacobian,
+                    "normalized_residuals": residuals,
+                    "convergence_residuals": residuals,
+                    "rhs": rhs,
+                    "coordinates": trial.coordinates,
+                    "delta": delta,
+                })
+            );
+            eprintln!(
+                "m1-newton iteration={iteration} current={:?} delta={delta:?}",
+                trial.coordinates
+            );
+        }
+        let base_hydraulics = hydraulic_potentials(input, &base)?;
+        let mut accepted = None;
+        let mut first_halved_witness_seen = false;
+        for exponent in 0..=crate::numerics::MAX_BACKTRACKING_HALVINGS {
+            let factor = 0.5_f64.powi(exponent as i32);
+            let mut candidate = trial.clone();
+            for (index, change) in delta.iter().enumerate() {
+                let drainage_slot = match index { 5 => Some(0), 11 => Some(1), _ => None };
+                if drainage_slot.is_some_and(|slot| phase_report.eliminated_coordinates[slot]) {
+                    candidate.coordinates[index] = (1.0 - factor) * trial.coordinates[index];
+                } else {
+                    candidate.coordinates[index] += factor * change;
+                }
+            }
+            if !fd_trial_is_admissible(&candidate) {
+                #[cfg(test)]
+                eprintln!(
+                    "m1-newton iteration={iteration} b={exponent} factor={factor:.17e} trial_d=[{:.17e}, {:.17e}] candidate=fd-domain reason={:?}",
+                    candidate.coordinates[5],
+                    candidate.coordinates[11],
+                    fd_trial_rejection_reason(&candidate),
+                );
+                continue;
+            }
+            let Ok(candidate_core) = core(input, &candidate) else {
+                #[cfg(test)]
+                eprintln!("m1-newton iteration={iteration} b={exponent} candidate=core-domain");
+                continue;
+            };
+            let candidate_residuals = normalized(&candidate_core, input);
+            if candidate_residuals.iter().any(|x| !x.is_finite()) {
+                #[cfg(test)]
+                eprintln!("m1-newton iteration={iteration} b={exponent} candidate=nonfinite");
+                continue;
+            }
+            let candidate_norm = candidate_residuals
+                .iter()
+                .map(|x| x.abs())
+                .fold(0.0_f64, f64::max);
+            #[cfg(test)]
+            {
+                let controlling = candidate_residuals
+                    .iter()
+                    .enumerate()
+                    .max_by(|(_, left), (_, right)| left.abs().total_cmp(&right.abs()))
+                    .map(|(row, value)| format!("row={row} value={value:.17e}"));
+                eprintln!(
+                    "m1-newton iteration={iteration} b={exponent} norm={candidate_norm:.17e} current={norm:.17e} controlling={controlling:?}"
+                );
+            }
+            let Ok(potentials) = hydraulic_potentials(input, &candidate_core) else {
+                #[cfg(test)]
+                eprintln!(
+                    "m1-newton iteration={iteration} b={exponent} candidate=hydraulic-domain"
+                );
+                continue;
+            };
+            let dry_temperature = [0, 1, 2, 6, 7, 8, 12, 14, 15, 16, 17, 18, 19, 20]
+                .iter()
+                .map(|&i| (factor * delta[i]).abs())
+                .fold(0.0, f64::max);
+            let wet_temperature = candidate_core
+                .occupancies
+                .iter()
+                .zip(&base.occupancies)
+                .filter_map(|(next, current)| {
+                    next.wet_temperature_k
+                        .zip(current.wet_temperature_k)
+                        .map(|(a, b)| (a - b).abs())
+                })
+                .fold(0.0, f64::max);
+            let temperature = dry_temperature.max(wet_temperature);
+            let humidity = (factor * delta[13]).abs();
+            let hydraulic = potentials
+                .iter()
+                .zip(&base_hydraulics)
+                .map(|(a, b)| (a - b).abs())
+                .fold(0.0, f64::max);
+            let steps_pass = temperature <= 1.0e-8 && humidity <= 1.0e-12 && hydraulic <= 1.0e-7;
+            let is_first_halved_witness = exponent > 0 && !first_halved_witness_seen;
+            if exponent > 0 && !first_halved_witness_seen {
+                first_halved_witness_seen = true;
+            }
+            if norm <= 1.0 && steps_pass && (exponent == 0 || is_first_halved_witness) {
+                return evaluate_m1_coupled_column(input, &trial);
+            }
+            if candidate_norm < norm {
+                accepted = Some((
+                    candidate,
+                    exponent,
+                    StepNorms {
+                        temperature_k: Some(temperature),
+                        humidity_kg_kg: Some(humidity),
+                        ci_pa: None,
+                        hydraulic_mm: Some(hydraulic),
+                        beta: Some(0.0),
+                    },
+                ));
+                break;
+            }
+        }
+        let Some((candidate, exponent, installed_steps)) = accepted else {
+            return Err(m1_failure(
+                crate::numerics::NumericalFailureKind::BacktrackingLimit,
+                iteration,
+                input,
+                &base,
+                &trial,
+                backtracking_count,
+                StepNorms {
+                    temperature_k: None,
+                    humidity_kg_kg: None,
+                    ci_pa: None,
+                    hydraulic_mm: None,
+                    beta: Some(0.0),
+                },
+                Some(phase_report.pivot),
+                Some(phase_report.matrix_norm),
+            ));
+        };
+        backtracking_count += exponent;
+        last_installed_steps = Some(installed_steps);
+        trial = candidate;
+    }
+    Err(domain_error())
+}
