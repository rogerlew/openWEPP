+#[cfg(test)]
+fn phase_test_result(result: Result<M1PhaseJoinControllerReport, M1PhaseJoinControllerError>) -> Result<M1PhaseJoinControllerReport, M1PhaseJoinFailure> {
+    result.map_err(|failure| {
+        match &failure.error {
+            M1CoupledError::Numerical(numerical) if numerical.kind == crate::numerics::NumericalFailureKind::PhaseActiveSetInconsistent =>
+                M1PhaseJoinFailure::InconsistentFinalSet { activity: failure.activity },
+            M1CoupledError::Numerical(numerical) if numerical.kind == crate::numerics::NumericalFailureKind::PhaseActiveSetUnrepresentable =>
+                M1PhaseJoinFailure::UnrepresentableProbe { activity: failure.activity },
+            _ => M1PhaseJoinFailure::Source { error: Box::new(failure.error), activity: failure.activity },
+        }
+    })
+}
