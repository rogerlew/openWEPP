+/// M1's liquid-internal-saturation version of the existing V10 exact-zero-PAR
+/// leaf calculation.  It retains the existing peaked respiration and diffusion
+/// arithmetic, while the M1 primitive owns the below-freezing saturation law.
+#[allow(clippy::too_many_arguments)]
+pub fn m1_zero_par_leaf_state(
+    inputs: LeafBiochemicalInputs,
+    p: BiochemicalConstants,
+    temperature_k: f64,
+    canopy_temperature_k: f64,
+    canopy_q: f64,
+    pressure_pa: f64,
+    ca_pa: f64,
+    gb_leaf_m_s: f64,
+    g0_umol_m2_s: f64,
+    wet_fraction: f64,
+) -> Result<M1ZeroParLeafState, M1CoupledError> {
+    if [
+        temperature_k,
+        canopy_temperature_k,
+        canopy_q,
+        pressure_pa,
+        ca_pa,
+        gb_leaf_m_s,
+        g0_umol_m2_s,
+        wet_fraction,
+        inputs.leaf_area_m2_m2_tile,
+        inputs.absorbed_par_w_m2_leaf,
+        inputs.rd25,
+    ]
+    .iter()
+    .any(|x| !x.is_finite())
+        || !(80_000.0..=110_000.0).contains(&pressure_pa)
+    {
+        return Err(openwepp_vegetation::cold_canopy_m1::M1Error::saturation_error().into());
+    }
+    if !(263.15..=373.15).contains(&temperature_k)
+        || !(258.15..=373.15).contains(&canopy_temperature_k)
+        || !(0.0..=0.1).contains(&canopy_q)
+        || !(0.0..=1.0).contains(&wet_fraction)
+        || !gb_leaf_m_s.is_finite()
+        || gb_leaf_m_s <= 0.0
+        || inputs.leaf_area_m2_m2_tile < 0.0
+        || (inputs.leaf_area_m2_m2_tile > 0.0
+            && (g0_umol_m2_s <= 0.0 || inputs.rd25 <= 0.0 || ca_pa <= 0.0))
+    {
+        return Err(openwepp_vegetation::cold_canopy_m1::M1Error::condition_error().into());
+    }
+    let qsurface =
+        openwepp_vegetation::cold_canopy_m1::m1_qsat_internal(temperature_k, pressure_pa)?
+            .specific_humidity_kg_kg;
+    if inputs.leaf_area_m2_m2_tile > 0.0 && qsurface <= canopy_q {
+        return Err(openwepp_vegetation::cold_canopy_m1::M1Error::condition_error().into());
+    }
+    if inputs.absorbed_par_w_m2_leaf != 0.0 {
+        return Err(openwepp_vegetation::cold_canopy_m1::M1Error::condition_error().into());
+    }
+    let environment = LeafGasEnvironment {
+        authority: CoveredColumnAuthority::V11SnowCovered,
+        pressure_pa,
+        ca_pa,
+    };
+    let state = leaf_trial_state_with_surface_q(
+        inputs,
+        p,
+        temperature_k,
+        canopy_q,
+        1.0,
+        environment,
+        gb_leaf_m_s,
+        g0_umol_m2_s,
+        0.0,
+        || Ok(qsurface),
+    )?;
+    let gs = 1.0 / state.rs_s_m;
+    let rb = 1.0 / gb_leaf_m_s;
+    let rho = pressure_pa / (287.05 * canopy_temperature_k);
+    let vapor = rho / (rb + state.rs_s_m)
+        * (1.0 - wet_fraction)
+        * inputs.leaf_area_m2_m2_tile
+        * (qsurface - canopy_q);
+    if !vapor.is_finite() {
+        return Err(openwepp_vegetation::cold_canopy_m1::M1Error::saturation_error().into());
+    }
+    Ok(M1ZeroParLeafState {
+        beta: 1.0,
+        internal_specific_humidity_kg_kg: qsurface,
+        conductance_m_s: gs,
+        ci_pa: state.ci_pa,
+        gross_assimilation_umol_co2_m2_leaf_s: state.gross_assimilation_umol_co2_m2_leaf_s,
+        net_assimilation_umol_co2_m2_leaf_s: state.net_assimilation_umol_co2_m2_leaf_s,
+        dark_respiration_umol_co2_m2_leaf_s: state.dark_respiration_umol_co2_m2_leaf_s,
+        vapor_kg_m2_tile_s: vapor,
+        gas_branch: state.gas_branch,
+    })
+}
