+        return false;
+    };
+    if partials.next().is_some()
+        || partial.value_bits.len() > coordinate_ids.len()
+        || partial.coordinate_ids.len() != partial.value_bits.len()
+        || partial.square_bits.len() > partial.value_bits.len()
+        || partial.running_sum_bits.len() > partial.square_bits.len()
+        || partial.coordinate_ids != coordinate_ids[..partial.value_bits.len()]
+    {
+        return false;
+    }
+    let mut sum = 0.0;
+    for index in 0..partial.value_bits.len() {
+        let value = expected[coordinate_ids[index]];
+        if partial.value_bits[index] != value.to_bits() {
+            return false;
+        }
+        let square = value * value;
+        if index < partial.square_bits.len() && partial.square_bits[index] != square.to_bits() {
+            return false;
+        }
+        sum += square;
+        if index < partial.running_sum_bits.len()
+            && partial.running_sum_bits[index] != sum.to_bits()
+        {
+            return false;
+        }
+    }
+    let zero_role = matches!(
+        role,
+        "p0_zero_lambda_eligibility" | "p1_zero_lambda_scratch" | "p2_zero_lambda_final"
+    );
+    match partial.terminal_operation {
+        "coordinate" => !zero_role && partial.value_bits.is_empty() && partial.sqrt_bits.is_none(),
+        "value_guard" => {
+            !zero_role
+                && partial.square_bits.len() + 1 == partial.value_bits.len()
+                && partial.running_sum_bits.len() == partial.square_bits.len()
+                && partial.sqrt_bits.is_none()
+        }
+        "square_guard" => {
+            partial.square_bits.len() == partial.value_bits.len()
+                && partial.running_sum_bits.len() + 1 == partial.square_bits.len()
+                && partial.sqrt_bits.is_none()
+        }
+        "running_sum_guard" => {
+            partial.running_sum_bits.len() == partial.square_bits.len()
+                && partial.square_bits.len() == partial.value_bits.len()
