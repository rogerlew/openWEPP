+        .any(|role| matches!(*role, "p0_free" | "p1_free" | "p2_free"));
+    if present && phase < required_phase {
+        "contradictory_stray_presence"
+    } else if present {
+        "captured"
+    } else if terminal.is_some_and(|metadata| metadata.lambda == 0.0) && positive_only {
+        "inapplicable_zero_lambda"
+    } else if trace
+        .partial_ordered_norms
+        .iter()
+        .any(|entry| roles.contains(&entry.role))
+    {
+        "interrupted"
+    } else if terminal.is_none() {
+        "missing_terminal_metadata"
+    } else if stops_before_free || phase < required_phase {
+        "naturally_unreached"
+    } else {
+        "missing_instrumentation"
+    }
+}
