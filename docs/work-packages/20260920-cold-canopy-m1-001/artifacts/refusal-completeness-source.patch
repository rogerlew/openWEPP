+                && partial.square_bits.len() == coordinate_ids.len()
+                && partial.running_sum_bits.len() == coordinate_ids.len()
+                && partial.sqrt_bits == Some(sum.sqrt().to_bits())
+        }
+        _ => false,
+    }
