+        (None, false, Stage::P0FullRadius) => &["p0_full"],
+        (None, false, Stage::P0ReducedRadius) => &["p0_full", "p0_free"],
+        (None, _, _) => &[],
+        (Some(Position::First), true, Stage::OrderedNorm | Stage::RadiusComparison) => {
+            &["p0_zero_lambda_eligibility", "p1_zero_lambda_scratch"]
+        }
+        (Some(Position::First), true, _) => &["p0_zero_lambda_eligibility"],
+        (Some(Position::First), false, Stage::ScratchFullRadius) => {
+            &["p0_full", "p0_free", "p1_full"]
+        }
+        (Some(Position::First), false, Stage::ScratchReducedRadius) => {
+            &["p0_full", "p0_free", "p1_full", "p1_free"]
+        }
+        (Some(Position::First), false, _) => &["p0_full", "p0_free"],
+        (
+            Some(Position::Second),
+            true,
+            Stage::OrderedNorm | Stage::RadiusComparison | Stage::FinalInstallEquality,
+        ) => &[
+            "p0_zero_lambda_eligibility",
+            "p1_zero_lambda_scratch",
+            "p2_zero_lambda_final",
+        ],
+        (Some(Position::Second), true, _) => {
+            &["p0_zero_lambda_eligibility", "p1_zero_lambda_scratch"]
+        }
+        (Some(Position::Second), false, Stage::FinalFullRadius) => {
+            &["p0_full", "p0_free", "p1_full", "p1_free", "p2_full"]
+        }
+        (
+            Some(Position::Second),
+            false,
+            Stage::FinalReducedRadius | Stage::FinalRadiusCloseness | Stage::FinalInstallEquality,
+        ) => &[
+            "p0_full", "p0_free", "p1_full", "p1_free", "p2_full", "p2_free",
+        ],
+        (Some(Position::Second), false, _) => &["p0_full", "p0_free", "p1_full", "p1_free"],
+    };
+    let exact_once = |role: &str| {
+        trace
+            .ordered_norms
+            .iter()
+            .filter(|entry| entry.role == role)
+            .count()
+            + trace
+                .partial_ordered_norms
+                .iter()
+                .filter(|entry| entry.role == role)
+                .count()
+            <= 1
+    };
+    trace
+        .ordered_norms
+        .iter()
+        .all(|entry| allowed.contains(&entry.role))
+        && trace
+            .partial_ordered_norms
+            .iter()
+            .all(|entry| allowed.contains(&entry.role))
+        && allowed.iter().all(|role| exact_once(role))
+}
