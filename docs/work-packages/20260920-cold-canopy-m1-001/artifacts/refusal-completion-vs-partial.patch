+#[cfg(test)]
+fn refusal_capture_completeness_json(
+    trace: &RefinementObservationTrace,
+    witness: &str,
+) -> serde_json::Value {
+    let refinement_complete = match witness {
+        "W1" => {
+            trace.face_free_ids.is_some()
+                && trace.factor_order.is_some()
+                && trace.weighted_residual.is_some()
+                && trace.weighted_matrix.is_some()
+                && trace.scaled_lower_bits.is_some()
+                && trace.scaled_upper_bits.is_some()
+                && trace.free_mask.is_some()
+                && trace.held_mask.is_some()
+                && trace.p0.is_some()
+                && trace.residual0.is_some()
+                && trace.h0.is_some()
+                && trace.delta0.is_some()
+                && trace.p1.is_some()
+                && trace.p1_full_norm2.is_some()
+                && trace.p1_full_norm.is_some()
+                && trace
+                    .ordered_norms
+                    .iter()
+                    .any(|norm| norm.role == "p1_full" && norm.coordinate_ids.len() == 21)
+                && trace.terminal_refusal.is_some()
+        }
+        "W2" => {
+            trace.face_free_ids.is_some()
+                && trace.factor_order.is_some()
+                && trace.weighted_residual.is_some()
+                && trace.weighted_matrix.is_some()
+                && trace.scaled_lower_bits.is_some()
+                && trace.scaled_upper_bits.is_some()
+                && trace.free_mask.is_some()
+                && trace.held_mask.is_some()
+                && trace.p0.is_some()
+                && trace.residual0.is_some()
+                && trace.delta0.is_some()
+                && trace.p1.is_some()
+                && trace.residual1.is_some()
+                && trace.delta1.is_some()
+                && trace.p2.is_some()
+                && trace.lower_mask_p2.is_some()
+                && trace.ordered_norms.iter().any(|norm| {
+                    norm.role == "p0_zero_lambda_eligibility" && norm.coordinate_ids.len() == 21
+                })
+                && trace.ordered_norms.iter().any(|norm| {
+                    norm.role == "p1_zero_lambda_scratch" && norm.coordinate_ids.len() == 21
+                })
+                && trace.terminal_refusal.is_some()
+        }
+        _ => false,
+    };
+    let expected_terminal_match = trace
+        .terminal_refusal
+        .as_ref()
+        .and_then(|refusal| refusal.refinement.as_ref())
+        .is_some_and(|metadata| match witness {
+            "W1" => {
+                matches!(
+                    metadata.correction_position,
+                    Some(super::M1TrustRegionCorrectionPosition::First)
+                ) && matches!(
+                    metadata.guard_stage,
+                    super::M1TrustRegionRefinementGuardStage::ScratchFullRadius
+                )
+            }
+            "W2" => {
+                matches!(
+                    metadata.correction_position,
+                    Some(super::M1TrustRegionCorrectionPosition::Second)
+                ) && matches!(
+                    metadata.guard_stage,
+                    super::M1TrustRegionRefinementGuardStage::FinalBoxLower
+                ) && metadata.coordinate == Some(5)
+            }
+            _ => false,
+        });
+    let reached_fields_present = trace.face_free_ids.is_some()
+        && trace.factor_order.is_some()
+        && trace.scaled_lower_bits.is_some()
+        && trace.scaled_upper_bits.is_some()
+        && trace.p0.is_some()
+        && (witness == "W2" || trace.p0_full_norm.is_some())
+        && trace.live_state_entry.is_some()
+        && trace.work.is_some();
+    let reached_prefix_complete =
+        refinement_complete && reached_fields_present && trace.terminal_refusal.is_some();
+    serde_json::json!({
+        "reached_prefix_complete": reached_prefix_complete, "witness": witness,
+        "witness_complete": refinement_complete, "expected_terminal_match": expected_terminal_match,
+        "unreached_is_natural_only": true, "missing_capture_is_incomplete": !reached_prefix_complete,
+    })
+}
