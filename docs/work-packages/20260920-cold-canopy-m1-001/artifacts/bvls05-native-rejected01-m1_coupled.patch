+#[cfg(feature = "m1-trust-region-native-harness")]
+thread_local! {
+    static M1_NATIVE_HARNESS_ORDINAL: Cell<Option<u32>> = const { Cell::new(None) };
+    static M1_NATIVE_HARNESS_CAPTURE: RefCell<Option<M1NativeHarnessCanonicalSeed>> = const { RefCell::new(None) };
+}
+
+/// Private, opt-in native caller custody record.  It is captured at the sole
+/// canonical seed construction point and does not select a numerical policy.
+#[cfg(feature = "m1-trust-region-native-harness")]
+#[doc(hidden)]
+#[derive(Clone, Debug, PartialEq)]
+pub struct M1NativeHarnessCanonicalSeed {
+    pub ordinal: u32,
+    pub input: M1CoupledColumnInput,
+    pub seed_coordinates: [f64; 21],
+}
+
+#[cfg(feature = "m1-trust-region-native-harness")]
+#[doc(hidden)]
+pub fn m1_native_harness_arm_for_ordinal(ordinal: u32) {
+    M1_NATIVE_HARNESS_ORDINAL.with(|armed| armed.set(Some(ordinal)));
+    M1_NATIVE_HARNESS_CAPTURE.with(|capture| *capture.borrow_mut() = None);
+}
+
+#[cfg(feature = "m1-trust-region-native-harness")]
+#[doc(hidden)]
+pub fn m1_native_harness_take_canonical_seed() -> Option<M1NativeHarnessCanonicalSeed> {
+    M1_NATIVE_HARNESS_CAPTURE.with(|capture| capture.borrow_mut().take())
+}
+
+#[cfg(feature = "m1-trust-region-native-harness")]
+fn m1_native_harness_capture_canonical_seed(
+    input: &M1CoupledColumnInput,
+    seed_coordinates: [f64; 21],
+) {
+    let ordinal = M1_NATIVE_HARNESS_ORDINAL.with(|armed| armed.replace(None));
+    if let Some(ordinal) = ordinal {
+        M1_NATIVE_HARNESS_CAPTURE.with(|capture| {
+            *capture.borrow_mut() = Some(M1NativeHarnessCanonicalSeed {
+                ordinal,
+                input: input.clone(),
+                seed_coordinates,
+            });
+        });
+    }
+}
