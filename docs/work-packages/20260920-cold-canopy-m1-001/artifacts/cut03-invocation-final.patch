+/// Concrete metadata controls for the locator alternatives that share a
+/// guard-stage name but select distinct operation sites.
+#[cfg(test)]
+#[test]
+fn m1_refinement_inventory_locator_semantics_control() {
+    use super::{
+        M1TrustRegionCorrectionPosition as Position, M1TrustRegionRefinementGuardStage as Stage,
+        M1TrustRegionRefinementReason as Reason,
+    };
+    let trace = RefinementObservationTrace {
+        face_free_ids: Some(vec![2, 5, 9]),
+        ..Default::default()
+    };
+    let metadata = |position, stage, reason, row, term, coordinate, lambda, scratch| {
+        super::M1TrustRegionRefinementFailureMetadata {
+            reason,
+            correction_position: position,
+            guard_stage: stage,
+            row,
+            term,
+            coordinate,
+            lower_active: [false; 21],
+            upper_active: [false; 21],
+            free: [true; 21],
+            lambda,
+            original_trust_radius: 1.0,
+            reduced_face_radius: 1.0,
+            scratch_box_feasible: scratch,
+        }
+    };
+    for (term, coordinate) in [(0, None), (1, Some(0))] {
+        let residual = metadata(
+            Some(Position::First),
+            Stage::ResidualSourceTerm,
+            Reason::SubnormalIntermediate,
+            Some(0),
+            Some(term),
+            coordinate,
+            1.0,
+            None,
+        );
+        assert!(refinement_capture_selected_terminal_kind(&residual, &trace));
+    }
+    let impossible_residual = metadata(
+        Some(Position::First),
+        Stage::ResidualSourceTerm,
+        Reason::SubnormalIntermediate,
+        Some(0),
+        Some(0),
+        Some(1),
+        1.0,
+        None,
+    );
+    assert!(!refinement_capture_selected_terminal_kind(
+        &impossible_residual,
+        &trace
+    ));
+    for row in [Some(0), None] {
+        let h0 = metadata(
+            Some(Position::First),
+            Stage::PrimaryProduct,
+            Reason::NonfiniteOperand,
+            row,
+            Some(0),
+            Some(2),
+            1.0,
+            None,
+        );
+        assert!(refinement_capture_selected_terminal_kind(&h0, &trace));
+    }
+    let impossible_h0_slot = metadata(
+        Some(Position::First),
+        Stage::PrimaryProduct,
+        Reason::NonfiniteOperand,
+        Some(0),
+        Some(0),
+        Some(5),
+        1.0,
+        None,
+    );
+    assert!(!refinement_capture_selected_terminal_kind(
+        &impossible_h0_slot,
+        &trace
+    ));
+    for (stage, term) in [
+        (Stage::PrimaryProduct, Some(0)),
+        (Stage::Accumulation, None),
+    ] {
+        let h1 = metadata(
+            Some(Position::Second),
+            stage,
+            Reason::NonfiniteOperand,
+            None,
+            term,
+            Some(2),
+            1.0,
+            Some(true),
+        );
+        assert!(refinement_capture_selected_terminal_kind(&h1, &trace));
+    }
+    let impossible_scratch = metadata(
+        Some(Position::First),
+        Stage::OrderedNorm,
+        Reason::NonfiniteOperand,
+        None,
+        None,
+        None,
+        1.0,
+        Some(false),
+    );
+    assert!(!refinement_capture_selected_terminal_kind(
+        &impossible_scratch,
+        &trace
+    ));
+}
