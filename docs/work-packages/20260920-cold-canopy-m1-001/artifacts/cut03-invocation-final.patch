+    )))
+    .expect("approved inventory is valid JSON");
+    let entries = inventory["entries"]
+        .as_array()
+        .expect("approved inventory entries array");
+    let mut refinement_rows = 0_usize;
+    let mut work_cap_rows = 0_usize;
+    let mut locator_alternatives = 0_usize;
+    let mut scratch_alternatives = 0_usize;
+    for entry in entries {
+        let locator = &entry["locator"];
+        if entry["stage"] == "not-applicable" {
+            work_cap_rows += 1;
+            assert_eq!(entry["position"], "not-refinement");
+            assert_eq!(entry["reason"], "not-applicable");
+            continue;
+        }
+        refinement_rows += 1;
+        let alternatives = locator["variants"]
+            .as_array()
+            .or_else(|| locator["term_coordinate"].as_array());
+        if let Some(alternatives) = alternatives {
+            assert!(!alternatives.is_empty(), "empty locator alternative set");
+            for alternative in alternatives {
+                assert!(
+                    alternative.is_object(),
+                    "locator alternative is not an object"
+                );
+                locator_alternatives += 1;
+            }
+        } else {
+            locator_alternatives += 1;
+        }
+        match locator["scratch_box_feasible"].as_array() {
+            Some(values) => {
+                assert!(!values.is_empty(), "empty scratch alternative set");
+                for value in values {
+                    assert!(value.is_boolean(), "scratch alternative is not boolean");
+                    scratch_alternatives += 1;
+                }
+            }
+            None => scratch_alternatives += 1,
+        }
+    }
+    assert_eq!((refinement_rows, work_cap_rows), (107, 2));
+    assert!(locator_alternatives > refinement_rows);
+    assert!(scratch_alternatives > refinement_rows);
+}
