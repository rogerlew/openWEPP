+#[test]
+fn m1_vapor_boundary_domain_and_overflow_guards_are_typed() {
+    let state = M1ReservoirState::new(0.018, -6385.68);
+    let bad_temperature = M1VaporBoundary {
+        wet_conductance_m_s: 0.0186,
+        plant_area_m2_m2: 1.35,
+        canopy_air_temperature_k: 258.14,
+        canopy_air_specific_humidity_kg_kg: 0.00135,
+        pressure_pa: 90_000.0,
+    };
+    let error = evaluate_m1_reservoir_residuals(
+        state,
+        state,
+        M1ReservoirForcing::with_vapor_boundary(60.0, 0.0, 0.0, 0.0, 0.297, bad_temperature),
+        0.0,
+    )
+    .expect_err("out-of-domain canopy-air temperature rejects");
+    assert_error(&error, "VEG-E-140", "domain");
+    let zero_area = M1VaporBoundary {
+        wet_conductance_m_s: 0.0186,
+        plant_area_m2_m2: 0.0,
+        canopy_air_temperature_k: 266.85,
+        canopy_air_specific_humidity_kg_kg: 0.00135,
+        pressure_pa: 90_000.0,
+    };
+    let error = evaluate_m1_reservoir_residuals(
+        state,
+        state,
+        M1ReservoirForcing::with_vapor_boundary(60.0, 0.0, 0.0, 0.0, 0.297, zero_area),
+        0.0,
+    )
+    .expect_err("zero plant area rejects");
+    assert_error(&error, "VEG-E-140", "domain");
+    let overflow = M1VaporBoundary {
+        wet_conductance_m_s: f64::MAX,
+        plant_area_m2_m2: f64::MAX,
+        canopy_air_temperature_k: 266.85,
+        canopy_air_specific_humidity_kg_kg: 0.00135,
+        pressure_pa: 90_000.0,
+    };
+    let error = evaluate_m1_reservoir_residuals(
+        state,
+        state,
+        M1ReservoirForcing::with_vapor_boundary(60.0, 0.0, 0.0, 0.0, 0.297, overflow),
+        0.0,
+    )
+    .expect_err("overflow vapor flux rejects");
+    assert_eq!(error.code(), "VEG-E-141");
+    assert_eq!(error.stage().as_str(), "saturation");
+    let bad_area_pressure = M1VaporBoundary {
+        wet_conductance_m_s: 0.0186,
+        plant_area_m2_m2: 0.0,
+        canopy_air_temperature_k: 266.85,
+        canopy_air_specific_humidity_kg_kg: 0.00135,
+        pressure_pa: 1.0,
+    };
+    let error = evaluate_m1_reservoir_residuals(
+        state,
+        state,
+        M1ReservoirForcing::with_vapor_boundary(60.0, 0.0, 0.0, 0.0, 0.297, bad_area_pressure),
+        0.0,
+    )
+    .expect_err("role-area guard precedes pressure");
+    assert_eq!(error.code(), "VEG-E-140");
+    assert_eq!(error.stage().as_str(), "domain");
+}
