+pub fn evaluate_m1_capacity_residual(x: M1CapacityTrial) -> Result<M1CapacityResidual, M1Error> {
+    if !x.ml.is_finite()
+        || !x.c.is_finite()
+        || !x.d.is_finite()
+        || !x.dt.is_finite()
+        || x.ml < 0.
+        || x.c < 0.
+        || x.d < 0.
+        || x.dt < 60.
+        || !(x.dt * x.d).is_finite()
+        || !(x.c - x.ml).is_finite()
+    {
+        return Err(M1Error::new("VEG-E-142", M1Stage::Capacity));
+    }
+    let a = x.dt * x.d;
+    let b = x.c - x.ml;
+    Ok(if a < b {
+        M1CapacityResidual {
+            residual_kg_m2: a,
+            b: M1CapacityBranch::Drainage,
+        }
+    } else {
+        M1CapacityResidual {
+            residual_kg_m2: b,
+            b: M1CapacityBranch::Capacity,
+        }
+    })
+}
+fn evap(reservoir: M1PhaseReservoir, capacity_kg_m2: f64, vapor_model: VM) -> Result<f64, M1Error> {
+    match vapor_model {
+        VM::E(flux_kg_m2_s) if flux_kg_m2_s.is_finite() => Ok(flux_kg_m2_s),
+        VM::E(_) => Err(M1Error::new("VEG-E-142", M1Stage::Domain)),
+        VM::B(boundary) => {
+            if !boundary.wet_conductance_m_s.is_finite()
+                || !boundary.plant_area_m2_m2.is_finite()
+                || !boundary.canopy_air_temperature_k.is_finite()
+                || !boundary.canopy_air_specific_humidity_kg_kg.is_finite()
+                || boundary.wet_conductance_m_s <= 0.
+                || boundary.plant_area_m2_m2 <= 0.
+                || !(258.15..=373.15).contains(&boundary.canopy_air_temperature_k)
+                || !(0. ..1.).contains(&boundary.canopy_air_specific_humidity_kg_kg)
+                || capacity_kg_m2 <= 0.
+            {
+                return Err(M1Error::new("VEG-E-140", M1Stage::Domain));
+            }
+            let temperature_k = reservoir
+                .wet_temperature_k()
+                .ok_or_else(|| M1Error::new("VEG-E-142", M1Stage::MhConsistency))?;
+            let phase = if reservoir.phase() == M1Phase::Ice {
+                M1ExternalPhase::Ice
+            } else {
+                M1ExternalPhase::Liquid
+            };
+            let air_density_kg_m3 = boundary.pressure_pa / (RD * boundary.canopy_air_temperature_k);
+            let wet_fraction = (reservoir.m / capacity_kg_m2).powf(2.0 / 3.0).min(1.);
+            let flux_kg_m2_s = air_density_kg_m3
+                * boundary.wet_conductance_m_s
+                * wet_fraction
+                * boundary.plant_area_m2_m2
+                * (sat(temperature_k, boundary.pressure_pa, phase)?.specific_humidity_kg_kg
+                    - boundary.canopy_air_specific_humidity_kg_kg);
+            if !air_density_kg_m3.is_finite()
+                || !wet_fraction.is_finite()
+                || !flux_kg_m2_s.is_finite()
+            {
+                return Err(M1Error::new("VEG-E-141", M1Stage::Saturation));
+            }
+            Ok(flux_kg_m2_s)
+        }
+    }
+}
+pub fn evaluate_m1_reservoir_residuals(
+    beginning: M1ReservoirState,
+    ending: M1ReservoirState,
+    forcing: M1ReservoirForcing,
+    drainage_kg_m2_s: f64,
+) -> Result<M1Residuals, M1Error> {
+    beginning.p()?;
+    let ending_reservoir = ending.p()?;
+    if !forcing.dt.is_finite()
+        || forcing.dt < 60.
+        || ![
+            forcing.i,
+            forcing.hi,
+            forcing.q,
+            forcing.c,
+            drainage_kg_m2_s,
+        ]
+        .iter()
+        .all(|value| value.is_finite())
+        || forcing.c < 0.
+        || forcing.i < 0.
+        || drainage_kg_m2_s < 0.
+    {
+        return Err(M1Error::new("VEG-E-142", M1Stage::Domain));
+    }
+    if forcing.i > 0.0 {
+        let incident_temperature_k = TF + forcing.hi / CW;
+        if !incident_temperature_k.is_finite()
+            || !(273.15..=373.15).contains(&incident_temperature_k)
+        {
+            return Err(M1Error::new("VEG-E-142", M1Stage::Domain));
+        }
+    }
+    let vapor_flux_kg_m2_s = evap(ending_reservoir, forcing.c, forcing.v)?;
+    let ending_temperature_k = ending_reservoir
+        .wet_temperature_k()
+        .ok_or_else(|| M1Error::new("VEG-E-142", M1Stage::MhConsistency))?;
+    let cap = evaluate_m1_capacity_residual(M1CapacityTrial::new(
+        ending_reservoir.ml(),
+        forcing.c,
+        drainage_kg_m2_s,
+        forcing.dt,
+    ))?
+    .residual_kg_m2;
+    let residuals = M1Residuals {
+        mass_kg_m2: ending.mass_kg_m2
+            - beginning.mass_kg_m2
+            - forcing.dt * (forcing.i - vapor_flux_kg_m2_s - drainage_kg_m2_s),
+        enthalpy_j_m2: ending.enthalpy_j_m2
+            - beginning.enthalpy_j_m2
+            - forcing.dt
+                * (forcing.q + forcing.i * forcing.hi
+                    - vapor_flux_kg_m2_s * (LV + CPV * (ending_temperature_k - TF))
+                    - drainage_kg_m2_s * CW * (ending_temperature_k - TF)),
+        capacity_kg_m2: cap,
+    };
+    if !residuals.mass_kg_m2.is_finite()
+        || !residuals.enthalpy_j_m2.is_finite()
+        || !residuals.capacity_kg_m2.is_finite()
+    {
+        return Err(M1Error::new("VEG-E-142", M1Stage::Domain));
+    }
+    Ok(residuals)
+}
+#[derive(Clone, Copy, Debug)]
+pub struct M1EmptySurfaceInput {
+    pub surface: M1DrySurface,
+    pub area_m2_m2: f64,
+    pub temperature_k: f64,
+    pub pressure_pa: f64,
+    pub qcan_kg_kg: f64,
+    pub liquid_conducting_tissue: bool,
+}
+pub fn validate_m1_empty_surface(x: M1EmptySurfaceInput) -> Result<(), M1Error> {
+    if !x.liquid_conducting_tissue {
+        return Err(M1Error::new("VEG-E-140", M1Stage::Condition));
+    }
+    if !(x.area_m2_m2.is_finite()
+        && x.area_m2_m2 >= 0.
+        && x.qcan_kg_kg.is_finite()
+        && x.qcan_kg_kg >= 0.
+        && x.qcan_kg_kg < 1.)
+    {
+        return Err(M1Error::new("VEG-E-142", M1Stage::Domain));
+    }
+    if x.area_m2_m2 > 0.
+        && x.qcan_kg_kg
+            > sat(
+                x.temperature_k,
+                x.pressure_pa,
+                if x.temperature_k < TF {
+                    M1ExternalPhase::Ice
+                } else {
+                    M1ExternalPhase::Liquid
+                },
+            )?
+            .specific_humidity_kg_kg
+    {
+        return Err(M1Error::new("VEG-E-142", M1Stage::Domain));
+    }
+    Ok(())
+}
+fn is_sha256_digest(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
