+impl M1RestartExtension {
+    #[allow(
+        clippy::float_cmp,
+        reason = "Restart support bounds are externally bound identity coordinates and must match exactly."
+    )]
+    pub fn parse_and_validate(
+        serialized: &str,
+        context: &M1RestartValidationContext,
+    ) -> Result<Self, M1Error> {
+        let record: Self = serde_json::from_str(serialized)
+            .map_err(|_| M1Error::new("VEG-E-144", M1Stage::Parse))?;
+        if record.schema_version != 1
+            || record.model_definition_id != "OPENWEPP_C3_WOODY_COLD_M1_V1"
+        {
+            return Err(M1Error::new("VEG-E-144", M1Stage::Version));
+        }
+        if ![
+            &record.model_definition_digest_sha256,
+            &record.configuration_digest_sha256,
+            &record.topology_digest_sha256,
+            &record.source_manifest_sha256,
+        ]
+        .iter()
+        .all(|value| is_sha256_digest(value))
+            || record.model_definition_digest_sha256 != context.d[0]
+            || record.configuration_digest_sha256 != context.d[1]
+            || record.topology_digest_sha256 != context.d[2]
+            || record.source_manifest_sha256 != context.d[3]
+        {
+            return Err(M1Error::new("VEG-E-144", M1Stage::Identity));
+        }
+        if record.transaction_id != context.tx
+            || record.consumed_transaction_cursor != record.transaction_id
+            || record.day_index != context.day
+            || record.support_start_s != context.start
+            || record.support_end_s != context.end
+            || !record.support_start_s.is_finite()
+            || !record.support_end_s.is_finite()
+            || record.support_end_s <= record.support_start_s
+        {
+            return Err(M1Error::new("VEG-E-144", M1Stage::Chronology));
+        }
+        if record.ofe_id != context.ofe
+            || record.tile_id != context.tile
+            || record.occupancy_id != context.occ
+        {
+            return Err(M1Error::new("VEG-E-144", M1Stage::Ownership));
+        }
+        if record.area_basis != "tile_ground"
+            || record.mass_unit != "kg_h2o_m2"
+            || record.enthalpy_unit != "J_m2"
+        {
+            return Err(M1Error::new("VEG-E-144", M1Stage::UnitsArea));
+        }
+        if !record.m_kg_h2o_m2.is_finite()
+            || !record.h_j_m2.is_finite()
+            || record.m_kg_h2o_m2 < 0.0
+            || (record.m_kg_h2o_m2 == 0.0 && record.h_j_m2 != 0.0)
+        {
+            return Err(M1Error::new("VEG-E-144", M1Stage::MhConsistency));
+        }
+        let reservoir = M1PhaseReservoir::from_mass_enthalpy(record.m_kg_h2o_m2, record.h_j_m2)
+            .map_err(|_| M1Error::new("VEG-E-144", M1Stage::Domain))?;
+        if let Some(temperature_k) = reservoir.wet_temperature_k() {
+            if !(258.15..=373.15).contains(&temperature_k) {
+                return Err(M1Error::new("VEG-E-144", M1Stage::Domain));
+            }
+        }
+        Ok(record)
+    }
+    pub fn to_canonical_utf8(&self) -> Result<String, M1Error> {
+        serde_json::to_string(self)
+            .map(|s| s + "\n")
+            .map_err(|_| M1Error::new("VEG-E-144", M1Stage::Parse))
+    }
+    #[must_use]
+    pub fn phase(&self) -> M1Phase {
+        M1PhaseReservoir {
+            m: self.m_kg_h2o_m2,
+            h: self.h_j_m2,
+        }
+        .phase()
+    }
