+    let error = evaluate_m1_capacity_residual(M1CapacityTrial::new(0.0, 0.297, 2.0, f64::MAX))
+        .expect_err("overflowing capacity product rejects");
+    assert_error(&error, "VEG-E-142", "capacity");
+    let error = evaluate_m1_capacity_residual(M1CapacityTrial::new(-1.0, 0.297, 0.0, 60.0))
+        .expect_err("negative liquid mass rejects");
+    assert_error(&error, "VEG-E-142", "capacity");
+    let state = M1ReservoirState::new(0.018, -6385.68);
+    let error = evaluate_m1_reservoir_residuals(
+        state,
+        state,
+        M1ReservoirForcing::prescribed(60.0, -1.0e-8, 0.0, 0.0, 0.0, 0.297),
+        0.0,
+    )
+    .expect_err("negative incident liquid rejects");
+    assert_error(&error, "VEG-E-142", "domain");
+    let error = evaluate_m1_reservoir_residuals(
+        state,
+        state,
+        M1ReservoirForcing::prescribed(60.0, 1.0e-8, -1.0e9, 0.0, 0.0, 0.297),
+        0.0,
+    )
+    .expect_err("subfreezing positive liquid input rejects");
+    assert_error(&error, "VEG-E-142", "domain");
+    let error = evaluate_m1_reservoir_residuals(
+        state,
+        state,
+        M1ReservoirForcing::prescribed(60.0, 1.0e-8, 4218.0 * (272.15 - 273.15), 0.0, 0.0, 0.297),
+        0.0,
+    )
+    .expect_err("subfreezing liquid input rejects");
+    assert_error(&error, "VEG-E-142", "domain");
+}
