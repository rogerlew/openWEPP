{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwepp:assurance:v2:catalog:3",
  "title": "openWEPP assurance v2 source catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "source_state",
    "trust_domain",
    "principal_registry",
    "schemas",
    "reports"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "contract_version": { "const": 3 },
    "source_state": { "const": "internal_assurance_sources" },
    "trust_domain": { "$ref": "#/$defs/trustDomain" },
    "principal_registry": { "$ref": "#/$defs/contentIdentity" },
    "schemas": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/schemaSource" }
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reportSource" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "text": { "type": "string", "pattern": "\\S" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/]",
      "not": { "pattern": "(^|/)\\.{1,2}(/|$)" }
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "trustDomain": { "enum": ["production", "test_only"] },
    "contentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "schemaSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {
          "enum": [
            "openwepp:assurance:v2:catalog:3",
            "openwepp:assurance:v2:report:3",
            "openwepp:assurance:v2:result:1",
            "openwepp:assurance:v2:principals:1"
          ]
        },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "reportSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "title",
        "owner",
        "trust_domain",
        "fixture_only",
        "manifest_path",
        "manifest_sha256"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "title": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "trust_domain": { "$ref": "#/$defs/trustDomain" },
        "fixture_only": { "type": "boolean" },
        "manifest_path": { "$ref": "#/$defs/path" },
        "manifest_sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
