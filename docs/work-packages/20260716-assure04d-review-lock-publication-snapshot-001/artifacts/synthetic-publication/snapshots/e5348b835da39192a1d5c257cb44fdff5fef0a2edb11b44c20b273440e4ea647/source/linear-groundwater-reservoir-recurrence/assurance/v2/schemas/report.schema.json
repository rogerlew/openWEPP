{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwepp:assurance:v2:report:3",
  "title": "openWEPP assurance v2 report source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "id",
    "version",
    "title",
    "owner",
    "lifecycle",
    "trust_domain",
    "fixture_only",
    "reader_metadata",
    "authorship",
    "agent_assistance",
    "manuscript",
    "supplement",
    "dependencies",
    "units",
    "claims",
    "methods",
    "results",
    "value_bindings",
    "tables",
    "figures",
    "references",
    "research_objects",
    "review",
    "publication"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "contract_version": { "const": 3 },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "title": { "$ref": "#/$defs/text" },
    "owner": { "$ref": "#/$defs/text" },
    "lifecycle": { "enum": ["DRAFT", "IN_REVIEW", "APPROVED"] },
    "trust_domain": { "enum": ["production", "test_only"] },
    "fixture_only": { "type": "boolean" },
    "reader_metadata": { "$ref": "#/$defs/readerMetadata" },
    "authorship": { "$ref": "#/$defs/authorship" },
    "agent_assistance": { "$ref": "#/$defs/agentAssistance" },
    "manuscript": { "$ref": "#/$defs/contentSource" },
    "supplement": { "$ref": "#/$defs/contentSource" },
    "dependencies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/dependency" } },
    "units": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/unit" } },
    "claims": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/claim" } },
    "methods": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/method" } },
    "results": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/result" } },
    "value_bindings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/valueBinding" } },
    "tables": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/table" } },
    "figures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/figure" } },
    "references": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } },
    "research_objects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/researchObject" } },
    "review": { "$ref": "#/$defs/review" },
    "publication": { "$ref": "#/$defs/publication" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "text": { "type": "string", "pattern": "\\S" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/]",
      "not": { "pattern": "(^|/)\\.{1,2}(/|$)" }
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "idList": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "nonEmptyIdList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "nullableText": {
      "anyOf": [
        { "$ref": "#/$defs/text" },
        { "type": "null" }
      ]
    },
    "nullablePath": {
      "anyOf": [
        { "$ref": "#/$defs/path" },
        { "type": "null" }
      ]
    },
    "nullableDigest": {
      "anyOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "readerMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scientific_question", "assessed_process", "assessed_quantity",
        "realization", "related_model_narrative", "manuscript_date"
      ],
      "properties": {
        "scientific_question": { "$ref": "#/$defs/text" },
        "assessed_process": { "$ref": "#/$defs/text" },
        "assessed_quantity": { "$ref": "#/$defs/text" },
        "realization": { "$ref": "#/$defs/text" },
        "related_model_narrative": { "$ref": "#/$defs/path" },
        "manuscript_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "authorship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "owner", "draft_authors", "human_report_lead",
        "scientific_approver", "accountability_state",
        "external_peer_review_claimed"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "draft_authors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "human_report_lead": { "$ref": "#/$defs/nullableText" },
        "scientific_approver": { "$ref": "#/$defs/nullableText" },
        "accountability_state": { "enum": ["unassigned_blocks_review", "assigned"] },
        "external_peer_review_claimed": { "type": "boolean" }
      }
    },
    "agentAssistance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "owner", "procedure_version", "objective",
        "tool_model_identity", "input_dependency_ids",
        "exact_output_dependency_id", "human_disposition",
        "known_nondeterminism", "limitations", "independent_review",
        "provenance_complete", "review_entry_authorized"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "procedure_version": { "$ref": "#/$defs/id" },
        "objective": { "$ref": "#/$defs/text" },
        "tool_model_identity": { "$ref": "#/$defs/text" },
        "input_dependency_ids": { "$ref": "#/$defs/nonEmptyIdList" },
        "exact_output_dependency_id": { "$ref": "#/$defs/id" },
        "human_disposition": { "$ref": "#/$defs/text" },
        "known_nondeterminism": { "$ref": "#/$defs/text" },
        "limitations": { "$ref": "#/$defs/text" },
        "independent_review": { "$ref": "#/$defs/text" },
        "provenance_complete": { "type": "boolean" },
        "review_entry_authorized": { "type": "boolean" }
      }
    },
    "contentSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "owner", "path", "sha256", "media_type",
        "provenance", "creation_procedure", "claim_ids", "method_ids",
        "result_ids", "value_binding_ids", "table_ids", "figure_ids",
        "reference_ids", "research_object_ids"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/digest" },
        "media_type": { "const": "text/markdown" },
        "provenance": { "$ref": "#/$defs/text" },
        "creation_procedure": { "$ref": "#/$defs/text" },
        "claim_ids": { "$ref": "#/$defs/nonEmptyIdList" },
        "method_ids": { "$ref": "#/$defs/nonEmptyIdList" },
        "result_ids": { "$ref": "#/$defs/nonEmptyIdList" },
        "value_binding_ids": { "$ref": "#/$defs/nonEmptyIdList" },
        "table_ids": { "$ref": "#/$defs/idList" },
        "figure_ids": { "$ref": "#/$defs/nonEmptyIdList" },
        "reference_ids": { "$ref": "#/$defs/nonEmptyIdList" },
        "research_object_ids": { "$ref": "#/$defs/nonEmptyIdList" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "owner", "kind", "provenance", "creation_procedure",
        "access", "license", "path", "sha256", "immutable_identity",
        "restriction_reason", "review_role"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["local_content", "external_immutable", "restricted"] },
        "provenance": { "$ref": "#/$defs/text" },
        "creation_procedure": { "$ref": "#/$defs/text" },
        "access": { "$ref": "#/$defs/text" },
        "license": { "$ref": "#/$defs/text" },
        "path": { "$ref": "#/$defs/nullablePath" },
        "sha256": { "$ref": "#/$defs/nullableDigest" },
        "immutable_identity": { "$ref": "#/$defs/nullableText" },
        "restriction_reason": { "$ref": "#/$defs/nullableText" },
        "review_role": { "$ref": "#/$defs/nullableText" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "local_content" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "sha256": { "$ref": "#/$defs/digest" },
              "immutable_identity": { "type": "null" },
              "restriction_reason": { "type": "null" },
              "review_role": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "external_immutable" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "path": { "type": "null" },
              "sha256": { "type": "null" },
              "immutable_identity": { "$ref": "#/$defs/text" },
              "restriction_reason": { "type": "null" },
              "review_role": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "restricted" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "access": { "const": "restricted" },
              "path": { "type": "null" },
              "sha256": { "type": "null" },
              "immutable_identity": { "$ref": "#/$defs/text" },
              "restriction_reason": { "$ref": "#/$defs/text" },
              "review_role": { "$ref": "#/$defs/text" }
            }
          }
        }
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "symbol", "quantity", "definition"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "symbol": { "$ref": "#/$defs/text" },
        "quantity": { "$ref": "#/$defs/text" },
        "definition": { "$ref": "#/$defs/text" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "owner", "statement", "claim_type", "scope_limit",
        "method_ids", "result_ids", "dependency_ids", "unit_ids", "reference_ids"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "statement": { "$ref": "#/$defs/text" },
        "claim_type": { "$ref": "#/$defs/text" },
        "scope_limit": { "$ref": "#/$defs/text" },
        "method_ids": { "$ref": "#/$defs/nonEmptyIdList" },
        "result_ids": { "$ref": "#/$defs/idList" },
        "dependency_ids": { "$ref": "#/$defs/nonEmptyIdList" },
        "unit_ids": { "$ref": "#/$defs/idList" },
        "reference_ids": { "$ref": "#/$defs/nonEmptyIdList" }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "owner", "description", "procedure",
        "dependency_ids", "unit_ids"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "procedure": { "$ref": "#/$defs/text" },
        "dependency_ids": { "$ref": "#/$defs/nonEmptyIdList" },
        "unit_ids": { "$ref": "#/$defs/idList" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "owner", "path", "sha256", "media_type",
        "method_id", "dependency_ids", "unit_ids", "quantity_semantics",
        "precision_policy", "software_realization", "provenance",
        "creation_procedure"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/digest" },
        "media_type": { "const": "application/json" },
        "method_id": { "$ref": "#/$defs/id" },
        "dependency_ids": { "$ref": "#/$defs/nonEmptyIdList" },
        "unit_ids": { "$ref": "#/$defs/nonEmptyIdList" },
        "quantity_semantics": { "$ref": "#/$defs/text" },
        "precision_policy": { "$ref": "#/$defs/text" },
        "software_realization": { "$ref": "#/$defs/id" },
        "provenance": { "$ref": "#/$defs/text" },
        "creation_procedure": { "$ref": "#/$defs/text" }
      }
    },
    "valueBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "owner", "result_id", "value_id", "unit_id",
        "transform", "display"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "result_id": { "$ref": "#/$defs/id" },
        "value_id": { "$ref": "#/$defs/id" },
        "unit_id": { "$ref": "#/$defs/id" },
        "transform": { "enum": ["identity", "absolute"] },
        "display": {
          "anyOf": [
            { "const": "integer" },
            { "type": "string", "pattern": "^(fixed|scientific):(0|[1-9]|1[0-5])$" }
          ]
        }
      }
    },
    "tableColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "unit_id"],
      "properties": {
        "label": { "$ref": "#/$defs/text" },
        "unit_id": {
          "anyOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        }
      }
    },
    "tableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value_binding_ids"],
      "properties": {
        "label": { "$ref": "#/$defs/text" },
        "value_binding_ids": { "$ref": "#/$defs/nonEmptyIdList" }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "owner", "caption", "alternative_text",
        "row_header", "columns", "rows"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "caption": { "$ref": "#/$defs/text" },
        "alternative_text": { "$ref": "#/$defs/text" },
        "row_header": { "$ref": "#/$defs/text" },
        "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tableColumn" } },
        "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tableRow" } }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "owner", "kind", "result_ids",
        "value_binding_ids", "visualization",
        "generation_procedure", "alternative_text", "caption"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "kind": { "const": "result_bearing" },
        "result_ids": { "$ref": "#/$defs/nonEmptyIdList" },
        "value_binding_ids": { "$ref": "#/$defs/nonEmptyIdList" },
        "visualization": { "const": "linear_magnitude_bars" },
        "generation_procedure": { "$ref": "#/$defs/text" },
        "alternative_text": { "$ref": "#/$defs/text" },
        "caption": { "$ref": "#/$defs/text" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "owner", "citation", "immutable_identity",
        "access", "license", "dependency_id"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "citation": { "$ref": "#/$defs/text" },
        "immutable_identity": { "$ref": "#/$defs/text" },
        "access": { "$ref": "#/$defs/text" },
        "license": { "$ref": "#/$defs/text" },
        "dependency_id": { "$ref": "#/$defs/id" }
      }
    },
    "researchObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "owner", "access", "license", "path", "sha256",
        "restriction_reason", "review_role", "result_ids", "method_ids",
        "dependency_ids", "reproduction_instructions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "access": { "enum": ["public_safe", "restricted"] },
        "license": { "$ref": "#/$defs/text" },
        "path": { "$ref": "#/$defs/nullablePath" },
        "sha256": { "$ref": "#/$defs/nullableDigest" },
        "restriction_reason": { "$ref": "#/$defs/nullableText" },
        "review_role": { "$ref": "#/$defs/nullableText" },
        "result_ids": { "$ref": "#/$defs/idList" },
        "method_ids": { "$ref": "#/$defs/nonEmptyIdList" },
        "dependency_ids": { "$ref": "#/$defs/nonEmptyIdList" },
        "reproduction_instructions": { "$ref": "#/$defs/text" }
      },
      "allOf": [
        {
          "if": { "properties": { "access": { "const": "public_safe" } }, "required": ["access"] },
          "then": {
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "sha256": { "$ref": "#/$defs/digest" },
              "restriction_reason": { "type": "null" },
              "review_role": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "access": { "const": "restricted" } }, "required": ["access"] },
          "then": {
            "properties": {
              "path": { "type": "null" },
              "sha256": { "type": "null" },
              "restriction_reason": { "$ref": "#/$defs/text" },
              "review_role": { "$ref": "#/$defs/text" }
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "owner", "state", "decision", "subject_root",
        "review_charge", "build_maintainer_id", "material_producer_ids",
        "findings", "finding_ledger_root", "approvals",
        "approval_lock_root", "independence_assessment"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "state": { "enum": ["DRAFT", "IN_REVIEW", "APPROVED"] },
        "decision": { "enum": ["not_started", "pending", "approved"] },
        "subject_root": { "$ref": "#/$defs/nullableDigest" },
        "review_charge": { "$ref": "#/$defs/nullableText" },
        "build_maintainer_id": { "$ref": "#/$defs/nullableText" },
        "material_producer_ids": { "$ref": "#/$defs/idList" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "finding_ledger_root": { "$ref": "#/$defs/nullableDigest" },
        "approvals": { "type": "array", "items": { "$ref": "#/$defs/approval" } },
        "approval_lock_root": { "$ref": "#/$defs/nullableDigest" },
        "independence_assessment": { "$ref": "#/$defs/text" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "summary", "severity", "disposition", "rationale",
        "resolution", "verification", "verifier_id"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "summary": { "$ref": "#/$defs/text" },
        "severity": { "enum": ["blocking", "major", "minor", "editorial"] },
        "disposition": { "enum": ["open", "resolved_and_verified", "rejected"] },
        "rationale": { "$ref": "#/$defs/nullableText" },
        "resolution": { "$ref": "#/$defs/nullableText" },
        "verification": { "$ref": "#/$defs/nullableText" },
        "verifier_id": { "$ref": "#/$defs/nullableText" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role", "principal_id", "finding_ledger_root", "decision",
        "competence_basis", "independence_attestation", "approved_on"
      ],
      "properties": {
        "role": { "enum": ["scientific", "reproduction_publication", "assurance_steward"] },
        "principal_id": { "$ref": "#/$defs/id" },
        "finding_ledger_root": { "$ref": "#/$defs/digest" },
        "decision": { "const": "approved" },
        "competence_basis": { "$ref": "#/$defs/text" },
        "independence_attestation": { "$ref": "#/$defs/text" },
        "approved_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "owner", "state", "approval_lock_root",
        "target_release_commit", "target_release_configuration",
        "prior_realization", "candidate_realization", "impact_assessment",
        "reproduction_disposition", "semantic_differences",
        "release_owner_id", "assurance_steward_id", "publication_date",
        "public_path", "release_transfer_root", "export_authorized",
        "vendoring_authorized", "supersedes", "withdrawn"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "owner": { "$ref": "#/$defs/text" },
        "state": { "enum": ["DRAFT", "APPROVED"] },
        "approval_lock_root": { "$ref": "#/$defs/nullableDigest" },
        "target_release_commit": { "$ref": "#/$defs/nullableText" },
        "target_release_configuration": { "$ref": "#/$defs/nullableText" },
