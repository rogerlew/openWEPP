{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "OPENWEPP_SHARED_CANOPY_AIR_CARRIER_RECEIPT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["parent_transaction_id", "segment_id", "segment_phase", "active_participant_set", "support_receipts", "exposure_receipt", "shared_air_state", "turbulent_fluxes", "longwave_ledger", "mass_ledger", "energy_ledger", "owner_map", "begin_owner_digest", "ending_owner_digest", "ledger_digest", "receipt_id"],
  "properties": {
    "parent_transaction_id": {"type": "string"}, "segment_id": {"type": "string"}, "segment_phase": {"enum": ["snow_covered", "snow_free"]},
    "active_participant_set": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "support_receipts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["participant_id", "receipt_id", "minimum_support_ns"], "properties": {"participant_id": {"type": "string", "minLength": 1}, "receipt_id": {"type": "string", "minLength": 1}, "minimum_support_ns": {"$ref": "#/$defs/tick"}}}},
    "exposure_receipt": {"type": "object", "additionalProperties": false, "required": ["receipt_id", "provider", "provider_digest", "source", "wind_m_s", "transfer_height_m", "roughness_m"], "properties": {"receipt_id": {"type": "string"}, "provider": {"const": "sealed-stage3-exposure"}, "provider_digest": {"type": "string"}, "source": {"const": "sealed-exposure-v1"}, "wind_m_s": {"type": "number", "exclusiveMinimum": 0}, "transfer_height_m": {"type": "number", "exclusiveMinimum": 0}, "roughness_m": {"type": "number", "exclusiveMinimum": 0}}},
    "shared_air_state": {"type": "object", "additionalProperties": false, "required": ["temperature_k", "specific_humidity", "state_digest"], "properties": {"temperature_k": {"type": "number", "exclusiveMinimum": 0}, "specific_humidity": {"type": "number", "minimum": 0, "maximum": 1}, "state_digest": {"type": "string"}}},
    "turbulent_fluxes": {"type": "array", "minItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["flux_id", "owner", "kind", "value", "units", "duration_s", "integrated_amount", "lineage_digest"], "properties": {"flux_id": {"type": "string"}, "owner": {"type": "string"}, "kind": {"enum": ["sensible", "vapor"]}, "value": {"type": "number"}, "units": {"type": "string"}, "duration_s": {"type": "number", "exclusiveMinimum": 0}, "integrated_amount": {"type": "number"}, "lineage_digest": {"type": "string"}}}},
    "longwave_ledger": {"type": "object", "additionalProperties": false, "required": ["canopy_components", "snow_down_w_m2", "snow_up_w_m2", "snow_canopy_exchange_w_m2", "canopy_snow_exchange_w_m2", "reciprocal_closure_w_m2", "ledger_digest"], "properties": {"canopy_components": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["surface_id", "temperature_k", "emissive_area_weight", "lineage_digest"], "properties": {"surface_id": {"type": "string"}, "temperature_k": {"type": "number", "exclusiveMinimum": 0}, "emissive_area_weight": {"type": "number", "exclusiveMinimum": 0}, "lineage_digest": {"type": "string"}}}}, "snow_down_w_m2": {"type": "number"}, "snow_up_w_m2": {"type": "number"}, "snow_canopy_exchange_w_m2": {"type": "number"}, "canopy_snow_exchange_w_m2": {"type": "number"}, "reciprocal_closure_w_m2": {"type": "number"}, "ledger_digest": {"type": "string"}}},
    "mass_ledger": {"type": "object", "additionalProperties": false, "required": ["snow_ice_start_kg_m2", "solid_precipitation_kg_m2", "melt_kg_m2", "sublimation_kg_m2", "deposition_kg_m2", "snow_ice_end_kg_m2", "liquid_start_kg_m2", "liquid_end_kg_m2", "vapor_net_kg_m2", "closure_kg_m2", "ledger_digest"], "properties": {"snow_ice_start_kg_m2": {"type": "number", "minimum": 0}, "solid_precipitation_kg_m2": {"type": "number", "minimum": 0}, "melt_kg_m2": {"type": "number", "minimum": 0}, "sublimation_kg_m2": {"type": "number", "minimum": 0}, "deposition_kg_m2": {"type": "number", "minimum": 0}, "snow_ice_end_kg_m2": {"type": "number", "minimum": 0}, "liquid_start_kg_m2": {"type": "number", "minimum": 0}, "liquid_end_kg_m2": {"type": "number", "minimum": 0}, "vapor_net_kg_m2": {"type": "number"}, "closure_kg_m2": {"type": "number"}, "ledger_digest": {"type": "string"}}},
    "energy_ledger": {"type": "object", "additionalProperties": false, "required": ["energy_start_j_m2", "external_energy_j_m2", "canopy_energy_j_m2", "snow_energy_j_m2", "energy_end_j_m2", "closure_j_m2", "ledger_digest"], "properties": {"energy_start_j_m2": {"type": "number"}, "external_energy_j_m2": {"type": "number"}, "canopy_energy_j_m2": {"type": "number"}, "snow_energy_j_m2": {"type": "number"}, "energy_end_j_m2": {"type": "number"}, "closure_j_m2": {"type": "number"}, "ledger_digest": {"type": "string"}}},
    "owner_map": {"type": "object", "additionalProperties": false, "required": ["reference_forcing", "v11_canopy", "stage3_snow", "shared_carrier", "parent_commit"], "properties": {"reference_forcing": {"const": "sealed-half-hour-forcing"}, "v11_canopy": {"const": "v11-configuration-state"}, "stage3_snow": {"const": "stage3-configuration-state"}, "shared_carrier": {"const": "carrier-transaction"}, "parent_commit": {"const": "coupled-time-complete-owner-transaction"}}},
    "accepted_event_receipt_id": {"type": "string"}, "begin_owner_digest": {"type": "string"}, "ending_owner_digest": {"type": "string"}, "ledger_digest": {"type": "string"}, "receipt_id": {"type": "string"}
  },
  "allOf": [{"if": {"properties": {"segment_phase": {"const": "snow_free"}}}, "then": {"required": ["accepted_event_receipt_id"]}}],
  "$defs": {"tick": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}}
}
