+/// Package-local compact wall-cost observation. No operand/event allocation.
+pub mod compact_cost {
+    use super::{AuditError, PhantomData, Rc, RefCell};
+    use serde::Serialize;
+    use std::time::Instant;
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+    #[repr(usize)]
+    pub enum Bucket {
+        RunnerUnassigned,
+        OtherPhysical,
+        Orchestration,
+        Custody,
+        Routing,
+        Diagnostics,
+        PreparationBase,
+        InactiveLeafProbe,
+        OtherProbe,
+        Assembly,
+        Linear,
+        Trial,
+        SolverRemaining,
+    }
+    const BUCKETS: usize = 13;
+    #[cfg(any(test, feature = "test-support"))]
+    const LABELS: [Bucket; BUCKETS] = [
+        Bucket::RunnerUnassigned,
+        Bucket::OtherPhysical,
+        Bucket::Orchestration,
+        Bucket::Custody,
+        Bucket::Routing,
+        Bucket::Diagnostics,
+        Bucket::PreparationBase,
+        Bucket::InactiveLeafProbe,
+        Bucket::OtherProbe,
+        Bucket::Assembly,
+        Bucket::Linear,
+        Bucket::Trial,
+        Bucket::SolverRemaining,
+    ];
+    #[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+    #[repr(usize)]
+    pub enum Family {
+        CoveredPotential,
+        CoveredFixedFinal,
+        V3Potential,
+        V3FixedFinal,
+    }
+    #[derive(Clone, Copy, Debug, Default, Serialize)]
+    pub struct Population {
+        pub family: Option<Family>,
+        pub dimension: usize,
+        pub inactive_input_leaf_coordinates: usize,
+        pub solves: u64,
+        pub sweeps: u64,
+        pub fd_columns: u64,
+        pub identity_columns: u64,
+        pub inactive_input_leaf_fd_columns: u64,
+    }
+    #[derive(Clone, Debug, Serialize)]
+    pub struct Report {
+        pub bucket_order: [Bucket; BUCKETS],
+        pub exclusive_ns: [u64; BUCKETS],
+        pub entries: [u64; BUCKETS],
+        pub family_exclusive_ns: [[u64; BUCKETS]; 4],
+        pub populations: [Population; 32],
+        pub runner_ns: u64,
+        pub accounting_difference_ns: i128,
+    }
+    struct State {
+        report: Report,
+        generation: u64,
+        last: Option<Instant>,
+        start: Option<Instant>,
+        bucket: Bucket,
+        depth: u64,
+        invalid: bool,
+        family: Option<Family>,
+        population: Option<usize>,
+        inactive: [bool; 256],
+    }
+    impl State {
+        fn charge(&mut self, now: Instant) {
+            if let Some(last) = self.last {
+                if let Some(dt) = now
+                    .checked_duration_since(last)
+                    .and_then(|d| u64::try_from(d.as_nanos()).ok())
+                {
+                    add(
+                        &mut self.report.exclusive_ns[self.bucket as usize],
+                        dt,
+                        &mut self.invalid,
+                    );
+                    if let Some(f) = self.family {
+                        add(
+                            &mut self.report.family_exclusive_ns[f as usize][self.bucket as usize],
+                            dt,
+                            &mut self.invalid,
+                        );
+                    }
+                } else {
+                    self.invalid = true;
+                }
+            }
+            self.last = Some(now);
+        }
+    }
+    fn add(value: &mut u64, amount: u64, invalid: &mut bool) {
+        if let Some(next) = value.checked_add(amount) {
+            *value = next;
+        } else {
+            *invalid = true;
+        }
+    }
+    thread_local! { static COST:RefCell<Option<State>>=const {RefCell::new(None)}; }
+    #[cfg(any(test, feature = "test-support"))]
+    static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+    pub struct Session {
+        generation: u64,
+        _thread: PhantomData<Rc<()>>,
+    }
+    #[cfg(any(test, feature = "test-support"))]
+    pub fn begin() -> Result<Session, AuditError> {
+        COST.with(|cell| {
+            let mut cell = cell.borrow_mut();
+            if cell.is_some() {
+                return Err(AuditError::AlreadyActive);
+            }
+            let generation = NEXT
+                .fetch_update(
+                    std::sync::atomic::Ordering::Relaxed,
+                    std::sync::atomic::Ordering::Relaxed,
+                    |n| n.checked_add(1),
+                )
+                .map_err(|_| AuditError::Overflow)?;
+            *cell = Some(State {
+                report: Report {
+                    bucket_order: LABELS,
+                    exclusive_ns: [0; BUCKETS],
+                    entries: [0; BUCKETS],
+                    family_exclusive_ns: [[0; BUCKETS]; 4],
+                    populations: [Population::default(); 32],
+                    runner_ns: 0,
+                    accounting_difference_ns: 0,
+                },
+                generation,
+                last: None,
+                start: None,
+                bucket: Bucket::RunnerUnassigned,
+                depth: 0,
+                invalid: false,
+                family: None,
+                population: None,
+                inactive: [false; 256],
+            });
+            Ok(Session {
+                generation,
+                _thread: PhantomData,
+            })
+        })
+    }
+    impl Session {
+        pub fn start_at(&self, start: Instant) -> Result<(), AuditError> {
+            COST.with(|cell| {
+                let mut cell = cell.borrow_mut();
+                let s = cell.as_mut().ok_or(AuditError::NotActive)?;
+                if s.generation != self.generation || s.start.is_some() || s.depth != 0 {
+                    return Err(AuditError::LiveScopes);
+                }
+                s.start = Some(start);
+                s.last = Some(start);
+                Ok(())
+            })
+        }
+        pub fn finish_at(self, end: Instant) -> Result<Report, AuditError> {
+            COST.with(|cell| {
+                let mut cell = cell.borrow_mut();
+                if cell
+                    .as_ref()
+                    .is_none_or(|s| s.generation != self.generation)
+                {
+                    return Err(AuditError::NotActive);
+                }
+                let mut s = cell.take().ok_or(AuditError::NotActive)?;
+                if s.depth != 0 || s.family.is_some() {
+                    return Err(AuditError::LiveScopes);
+                }
+                s.charge(end);
+                s.report.runner_ns = end
+                    .checked_duration_since(s.start.ok_or(AuditError::NotActive)?)
+                    .and_then(|d| u64::try_from(d.as_nanos()).ok())
+                    .ok_or(AuditError::Overflow)?;
+                let sum = s
+                    .report
+                    .exclusive_ns
+                    .iter()
+                    .map(|n| i128::from(*n))
+                    .sum::<i128>();
+                s.report.accounting_difference_ns = i128::from(s.report.runner_ns) - sum;
+                if s.invalid || s.report.accounting_difference_ns != 0 {
+                    return Err(AuditError::Overflow);
+                }
+                Ok(s.report)
+            })
+        }
+    }
+    impl Drop for Session {
+        fn drop(&mut self) {
+            COST.with(|cell| {
+                let mut c = cell.borrow_mut();
+                if c.as_ref().is_some_and(|s| s.generation == self.generation) {
+                    c.take();
+                }
+            });
+        }
+    }
+    pub struct Guard {
+        generation: Option<u64>,
+        previous: Bucket,
+        previous_family: Option<Family>,
+        depth: u64,
+        solve: bool,
+        _thread: PhantomData<Rc<()>>,
+    }
+    #[must_use]
+    pub fn scope(bucket: Bucket) -> Guard {
+        let mut guard = Guard {
+            generation: None,
+            previous: Bucket::RunnerUnassigned,
+            previous_family: None,
+            depth: 0,
+            solve: false,
+            _thread: PhantomData,
+        };
+        COST.with(|cell| {
+            if let Some(s) = cell.borrow_mut().as_mut().filter(|s| s.start.is_some()) {
+                s.charge(Instant::now());
+                guard.generation = Some(s.generation);
+                guard.previous = s.bucket;
+                guard.previous_family = s.family;
+                if (bucket as usize) < (Bucket::PreparationBase as usize) {
+                    s.family = None;
+                }
+                add(&mut s.depth, 1, &mut s.invalid);
+                guard.depth = s.depth;
+                s.bucket = bucket;
+                add(&mut s.report.entries[bucket as usize], 1, &mut s.invalid);
+            }
+        });
+        guard
+    }
+    impl Drop for Guard {
+        fn drop(&mut self) {
+            let Some(generation) = self.generation else {
+                return;
+            };
+            COST.with(|cell| {
+                if let Some(s) = cell
+                    .borrow_mut()
+                    .as_mut()
+                    .filter(|s| s.generation == generation)
+                {
+                    s.charge(Instant::now());
+                    if s.depth != self.depth || s.depth == 0 {
+                        s.invalid = true;
+                    } else {
+                        s.depth -= 1;
+                    }
+                    s.bucket = self.previous;
+                    s.family = self.previous_family;
+                    if self.solve {
+                        s.family = None;
+                        s.population = None;
+                        s.inactive.fill(false);
+                    }
+                }
+            });
+        }
+    }
+    pub(crate) fn solve(
+        family: Family,
+        dimension: usize,
+        column: &crate::CoveredColumnInputs,
+    ) -> Guard {
+        let mut guard = scope(Bucket::PreparationBase);
+        if guard.generation.is_none() {
+            return guard;
+        }
+        COST.with(|cell| {
+            if let Some(s) = cell.borrow_mut().as_mut() {
+                if s.family.is_some() || dimension > 256 {
+                    s.invalid = true;
+                    return;
+                }
+                let mut inactive = 0;
+                for (i, o) in column.occupancies.iter().enumerate() {
+                    for (offset, area) in [
+                        (6, o.sun.leaf_area_m2_m2_tile),
+                        (7, o.shade.leaf_area_m2_m2_tile),
+                    ] {
+                        let Some(slot) = s.inactive.get_mut(10 * i + offset) else {
+                            s.invalid = true;
+                            return;
+                        };
+                        *slot = area.to_bits() == 0.0_f64.to_bits();
+                        inactive += usize::from(*slot);
+                    }
+                }
+                let row = s
+                    .report
+                    .populations
+                    .iter()
+                    .position(|p| {
+                        p.family == Some(family)
+                            && p.dimension == dimension
+                            && p.inactive_input_leaf_coordinates == inactive
+                    })
+                    .or_else(|| s.report.populations.iter().position(|p| p.family.is_none()));
+                if let Some(row) = row {
+                    let p = &mut s.report.populations[row];
+                    p.family = Some(family);
+                    p.dimension = dimension;
+                    p.inactive_input_leaf_coordinates = inactive;
+                    add(&mut p.solves, 1, &mut s.invalid);
+                    s.population = Some(row);
+                    s.family = Some(family);
+                    guard.solve = true;
+                } else {
+                    s.invalid = true;
+                }
+            }
+        });
+        guard
+    }
+    pub(crate) fn sweep() {
+        COST.with(|cell| {
+            if let Some(s) = cell.borrow_mut().as_mut() {
+                if let Some(row) = s.population {
+                    add(&mut s.report.populations[row].sweeps, 1, &mut s.invalid);
+                }
+            }
+        });
+    }
+    pub(crate) fn column(index: usize, identity: bool) {
+        COST.with(|cell| {
+            if let Some(s) = cell.borrow_mut().as_mut() {
+                if let Some(row) = s.population {
+                    let p = &mut s.report.populations[row];
+                    if identity {
+                        add(&mut p.identity_columns, 1, &mut s.invalid);
+                    } else {
+                        add(&mut p.fd_columns, 1, &mut s.invalid);
+                        if s.inactive.get(index) == Some(&true) {
+                            add(&mut p.inactive_input_leaf_fd_columns, 1, &mut s.invalid);
+                        }
+                    }
+                }
+            }
+        });
+    }
+    pub(crate) fn probe(index: usize) -> Guard {
+        let bucket = COST.with(|cell| {
+            cell.borrow()
+                .as_ref()
+                .filter(|s| s.inactive.get(index) == Some(&true))
+                .map_or(Bucket::OtherProbe, |_| Bucket::InactiveLeafProbe)
+        });
+        scope(bucket)
+    }
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+        #[test]
+        fn compact_cost_accounting_and_off_neutrality() {
+            drop(scope(Bucket::Linear));
+            let session = begin().unwrap();
+            let start = Instant::now();
+            session.start_at(start).unwrap();
+            {
+                let _outer = scope(Bucket::OtherPhysical);
+                {
+                    let _inner = scope(Bucket::Linear);
+                }
+            }
+            let report = session.finish_at(Instant::now()).unwrap();
+            assert_eq!(report.runner_ns, report.exclusive_ns.iter().sum::<u64>());
+            assert_eq!(report.accounting_difference_ns, 0);
+            assert_eq!(report.entries[Bucket::Linear as usize], 1);
+        }
+        #[test]
+        fn compact_cost_live_stale_order_and_overflow() {
+            let s = begin().unwrap();
+            s.start_at(Instant::now()).unwrap();
+            let old = scope(Bucket::Linear);
+            assert!(matches!(
+                s.finish_at(Instant::now()),
+                Err(AuditError::LiveScopes)
+            ));
+            let s = begin().unwrap();
+            s.start_at(Instant::now()).unwrap();
+            drop(old);
+            let a = scope(Bucket::Linear);
+            let b = scope(Bucket::Trial);
+            drop(a);
+            drop(b);
+            assert!(s.finish_at(Instant::now()).is_err());
+            let s = begin().unwrap();
+            s.start_at(Instant::now()).unwrap();
+            COST.with(|c| c.borrow_mut().as_mut().unwrap().report.exclusive_ns[0] = u64::MAX);
+            assert!(s.finish_at(Instant::now()).is_err());
+        }
+        #[test]
+        fn compact_cost_rejects_clock_reversal_and_preserves_errors() {
+            let off = Err::<(), _>("first typed error");
+            let session = begin().unwrap();
+            let start = Instant::now();
+            session.start_at(start).unwrap();
+            let on = {
+                let _scope = scope(Bucket::PreparationBase);
+                Err::<(), _>("first typed error")
+            };
+            assert_eq!(off, on);
+            COST.with(|cell| {
+                cell.borrow_mut().as_mut().unwrap().last =
+                    Some(start + std::time::Duration::from_secs(1))
+            });
+            assert!(session.finish_at(start).is_err());
+        }
+    }
+}
