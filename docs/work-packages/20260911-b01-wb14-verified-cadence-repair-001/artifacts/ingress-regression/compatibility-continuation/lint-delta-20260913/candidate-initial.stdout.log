ariant\":\"open\",\"identity\":identity(&v.identity),\"evaluation\":v.final_solver_candidate.evaluation}),\n                super::multi_tile_runtime::FinalizedRuntimeTile::Stage3OpenSnow {identity:v,..} => serde_json::json!({\n                    \"variant\":\"open_snow_owned_by_stage3\",\"identity\":identity(v)}),\n            }\n        }\n        let tiles: Vec<_> = match &self.physical {\n            CoveredV8PhysicalOwner::Legacy(v) => vec![covered(v.final_tile())],\n            CoveredV8PhysicalOwner::MultiTile(v) => v.finalized_tiles().iter().map(tile).collect(),\n            CoveredV8PhysicalOwner::FrozenLitterV3 {fixed,..} => {\n                let mut rows: Vec<_> = fixed.legacy_tiles.iter().map(tile).collect();\n                for v in &fixed.frozen_litter_tiles {\n                    let c = &v.fixed_final.complete_physical_candidate;\n                    rows.push(serde_json::json!({\"variant\":\"native_covered_litter\",\"identity\":identity(&c.identity),\n                        \"evaluation\":v.fixed_final.accepted_fixed_final.evaluation,\n                        \"occupancies\":c.energy_operands.occupancies,\"canopy_air\":c.energy_operands.canopy_air,\n                        \"shortwave\":c.energy_operands.shortwave,\"longwave\":c.energy_operands.longwave,\n                        \"litter_surface\":c.energy_operands.litter_surface,\"vegetation_operands\":c.vegetation_operands}));\n                }\n                for v in &fixed.open_litter_tiles {\n                    rows.push(serde_json::json!({\"variant\":\"native_open_litter\",\"identity\":identity(&v.fixed_final.identity),\n                        \"evaluation\":v.fixed_final.accepted_fixed_final}));\n                }\n                rows\n            }\n        };\n        let problem_row = |id: &openwepp_land_surface_energy::RuntimeTileIdentity, problem: &openwepp_land_surface_energy::OpenSurfaceProblem| serde_json::json!({\n            \"ofe_id\":id.ofe_id,\"tile_id\":id.tile_id,\"transaction_id\":id.transaction_id,\"soil_transaction_id\":id.soil_thermal_transaction_id,\n            \"interval_s\":id.interval_s,\"beginning_soil_thermal_state_sha256\":id.beginning_soil_thermal_state_sha256,\"ground_problem\":problem});\n        let problem_inputs: Vec<_> = match &self.physical {\n            CoveredV8PhysicalOwner::Legacy(v) => vec![problem_row(v.potential().identity(), &v.potential().accuracy_observation_beginning().ground)],\n            CoveredV8PhysicalOwner::MultiTile(v) => v.potential_tiles().iter().filter_map(|v| {\n                match v {\n                    super::multi_tile_runtime::PotentialTilePhase::Open {phase,..} => Some(problem_row(&phase.identity,phase.accuracy_observation_beginning())),\n                    super::multi_tile_runtime::PotentialTilePhase::Covered {phase,..} => Some(problem_row(phase.identity(),&phase.accuracy_observation_beginning().ground)),\n                    super::multi_tile_runtime::PotentialTilePhase::Stage3OpenSnow {..} => None,\n                }\n            }).collect(),\n            CoveredV8PhysicalOwner::FrozenLitterV3 {fixed,..} => fixed.accuracy_problem_inputs.clone(),\n        };\n        let soil_children: Vec<_> = self.hydrology().pre_ingress_soil_thermal_candidates().iter().map(|v| serde_json::json!({\n            \"ofe_id\":v.ofe_id,\"tile_id\":v.tile_id,\"beginning_state_sha256\":v.beginning_state_sha256,\"beginning_identity\":v.beginning_identity})).collect();\n        serde_json::json!({\"tiles\":tiles,\"problem_inputs\":problem_inputs,\"soil_children\":soil_children})\n    }\n}","suggestion_applicability":"MachineApplicable","text":[{"highlight_end":2,"highlight_start":2,"text":"}"}]},{"byte_end":110869,"byte_start":105641,"column_end":2,"column_start":2,"expansion":null,"file_name":"crates/openwepp-hillslope-orchestrator/src/land_surface_energy_shadow/covered_v8_owner.rs","is_primary":true,"label":null,"line_end":2707,"line_start":2640,"suggested_replacement":"","suggestion_applicabi