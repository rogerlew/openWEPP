+    // Test-local adaptation of the a3100159 nonzero archive fixture in
+    // openwepp-persisted-restart-v1/src/snow_stage3_v11_v3_tests.rs. The
+    // profile and subsurface operands come from this lane's actual initial
+    // layers; the zero constructor supplies only the controlled test baseline.
+    fn native_archive_day_input(
+        lane: &crate::DirectLaneFrame,
+        forcing: &HillslopeDirectClimateDayForcing,
+    ) -> crate::DirectDayConstructorInputs {
+        let profile_depth_m = lane
+            .subsurface_layers
+            .iter()
+            .map(|layer| layer.depth_m)
+            .sum::<f64>();
+        let mut day = crate::DirectDayConstructorInputs::zero();
+        day.forcing.precipitation_m = forcing.prcp_m;
+        day.forcing.effective_temperature_c = f64::midpoint(forcing.tmax_c, forcing.tmin_c);
+        day.hydrology_projection_inputs = crate::DirectHydrologyProjectionInputs {
+            aggregate_storage_tolerance_m: 1.0e-9,
+            profile_depth_m: Some(profile_depth_m),
+            profile_porosity_cap_m: Some(
+                lane.subsurface_layers
+                    .iter()
+                    .map(|layer| layer.porosity * layer.depth_m)
+                    .sum(),
+            ),
+            profile_field_capacity_m: Some(
+                lane.subsurface_layers
+                    .iter()
+                    .map(|layer| layer.field_capacity_m)
+                    .sum(),
+            ),
+            profile_wilting_point_m: Some(
+                lane.subsurface_layers
+                    .iter()
+                    .map(|layer| layer.residual_theta * layer.depth_m)
+                    .sum(),
+            ),
+            ..crate::DirectHydrologyProjectionInputs::zero()
+        };
+        day.subsurface_compute_inputs = crate::DirectSubsurfaceComputeInputs {
+            soil_depth_m: profile_depth_m,
+            layers: lane
+                .subsurface_layers
+                .iter()
+                .cloned()
+                .map(Into::into)
+                .collect(),
+            ..crate::DirectSubsurfaceComputeInputs::neutral()
+        };
+        day
+    }
+
+    fn validated_native_archive_publication_input(
+        day_index: usize,
+        constructor: &crate::DirectDayConstructorInputs,
+        forcing: &HillslopeDirectClimateDayForcing,
+        initial_soil_water_m: f64,
+    ) -> DirectPublicationDayInput {
+        let mut input = publication_input_from_constructor(day_index, constructor);
+        input.initial_soil_water_m = Some(initial_soil_water_m);
+        assert_eq!(input.calendar.year, forcing.year);
+        assert_eq!(i32::from(input.calendar.month), forcing.month);
+        assert_eq!(i32::from(input.calendar.day_of_month), forcing.day);
+        assert_eq!(input.precipitation_m, forcing.prcp_m);
+        assert_eq!(
+            input.effective_temperature_c,
+            f64::midpoint(forcing.tmax_c, forcing.tmin_c)
+        );
+        assert_eq!(
+            input.hydrology_projection_inputs,
+            Some(constructor.hydrology_projection_inputs)
+        );
+        assert_eq!(
+            input.subsurface_compute_inputs.as_ref(),
+            Some(&constructor.subsurface_compute_inputs)
+        );
+        assert!(initial_soil_water_m.is_finite());
+        assert!(initial_soil_water_m >= 0.0);
+        assert!(
+            initial_soil_water_m
+                <= constructor
+                    .hydrology_projection_inputs
+                    .profile_porosity_cap_m
+                    .expect("configured profile porosity cap")
+        );
         input
     }
 
