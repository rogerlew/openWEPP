+fn native_mixed_phase_fixture_reaches_deferred_v4_promotion_boundary() {
+    let (value, promotion_audit) = std::thread::Builder::new()
+        .name("native-mixed-phase-integrated-promotion".to_owned())
+        .stack_size(64 * 1024 * 1024)
+        .spawn(|| {
+            use crate::v9_real_consumer_shadow::v11_covered::CanonicalCoveredPhysicalParityCaseV1 as Case;
+
+            CANONICAL_PARITY_CASE.with(|slot| slot.set(Some(Case::NativeMixedPhase)));
+            crate::v9_real_consumer_shadow::begin_integrated_promotion_boundary_audit_v1();
+            match std::panic::catch_unwind(std::panic::AssertUnwindSafe(
+                run_native_mixed_phase_terminal_on_large_stack,
+            )) {
+                Ok(value) => {
+                    let promotion_audit = crate::v9_real_consumer_shadow::
+                        take_integrated_promotion_boundary_audit_v1();
+                    println!(
+                        "B01_INTEGRATED_PROMOTION outcome=success promotion={promotion_audit:?} native_physical={:?} carrier_live={:?}",
+                        value.native_physical_audit,
+                        value.carrier_live_audit,
+                    );
+                    (value, promotion_audit)
+                }
+                Err(panic) => {
+                    let promotion_audit = crate::v9_real_consumer_shadow::
+                        take_integrated_promotion_boundary_audit_v1();
+                    let native_physical = crate::v9_real_consumer_shadow::
+                        take_covered_native_physical_path_audit_v1();
+                    let carrier_live = crate::v9_real_consumer_shadow::v11_covered::
+                        take_covered_carrier_live_consumption_audit();
+                    println!(
+                        "B01_INTEGRATED_PROMOTION outcome=unwind promotion={promotion_audit:?} native_physical={native_physical:?} carrier_live={carrier_live:?}"
+                    );
+                    std::panic::resume_unwind(panic);
+                }
+            }
+        })
+        .expect("spawn native mixed-phase integrated promotion")
+        .join()
+        .expect("join native mixed-phase integrated promotion");
+
+    assert_eq!(
+        value.fixture.fixture_inputs["parity_profile"],
+        "native-mixed-phase"
+    );
+    assert_eq!(
+        value.fixture.fixture_inputs["hard_boundary_ns"],
+        serde_json::json!(60_000_000_000_u128)
+    );
+    assert_eq!(
+        value.production.0.parent_support,
+        openwepp_coupled_time::TimeSupport::new(
+            openwepp_coupled_time::ModelTimeNs::new(0),
+            openwepp_coupled_time::ModelTimeNs::new(1_800_000_000_000)
+        )
+        .expect("native parent support")
+    );
+    assert!(value.fixture.beginning_native_v3_resident_present);
+    assert!(value.fixture.beginning_native_v4_resident_present);
+    assert_eq!(promotion_audit.deferred_completion_count, 1);
+    assert_eq!(promotion_audit.v4_runtime_entry_count, 2);
+    assert_eq!(promotion_audit.v4_runtime_success_count, 2);
+    assert_eq!(promotion_audit.final_replay_entry_count, 1);
+    assert_eq!(promotion_audit.final_replay_success_count, 1);
+    assert_eq!(promotion_audit.promotion_attempt_count, 1);
+    assert_eq!(promotion_audit.promotion_entry_count, 1);
+    assert_eq!(promotion_audit.promotion_success_count, 1);
+    assert_eq!(promotion_audit.projection_promotion_entry_count, 1);
+    assert_eq!(promotion_audit.projection_promotion_success_count, 1);
+    assert_eq!(
+        promotion_audit.promotion_entry_count, promotion_audit.candidate_only_promotion_entry_count,
+        "only candidate-only V4 custody may enter deferred promotion"
+    );
+    assert_eq!(
+        value
+            .native_physical_audit
+            .snow_free_litter_physics_call_count,
+        0
+    );
+    assert_eq!(
+        value
+            .native_physical_audit
+            .snow_free_surface_physics_call_count,
+        0
+    );
+    assert_eq!(
+        value
+            .native_physical_audit
+            .snow_free_wb14_physics_call_count,
+        0
+    );
+    assert_eq!(promotion_audit.snow_free_litter_low_level_count, 2);
+    assert_eq!(promotion_audit.snow_free_surface_low_level_count, 2);
+    assert_eq!(promotion_audit.snow_free_wb14_low_level_count, 3);
+    assert!(!value.carrier_live_audit.carrier_rows.is_empty());
+    assert_native_mixed_phase_transition(&value.fixture);
+    println!(
+        "B01_INTEGRATED_PARENT {}",
