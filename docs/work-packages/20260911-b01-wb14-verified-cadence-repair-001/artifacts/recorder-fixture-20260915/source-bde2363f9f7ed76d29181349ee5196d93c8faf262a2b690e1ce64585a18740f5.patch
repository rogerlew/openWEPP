+fn run_native_mixed_phase_terminal_on_large_stack() -> NativeMixedPhaseFixtureOutcomeV1 {
+    SHORT_SUPPORT_REQUESTED.with(|value| value.set(false));
+    SHORT_SUPPORT_DURATION_NS.with(|value| value.set(1_800_000_000_000));
+    begin_adaptive_controller_test_audit(AdaptiveControllerTestPolicyV1::default());
+    begin_adaptive_performance_test_audit();
+    begin_adaptive_comparison_test_audit();
+    crate::v9_real_consumer_shadow::v11_covered::begin_covered_carrier_support_audit();
+    crate::v9_real_consumer_shadow::v11_covered::
+        begin_covered_carrier_live_consumption_audit();
+    begin_terminal_batch_production_audit();
+    crate::snow_stage3_v11_attachment::begin_snow_free_successor_fixture_audit_v1();
+
+    let fixture = super::execute_complete_wb14_cadence_fixture(
+        0.000_6,
+        0.0,
+        false,
+        Some(60_000_000_000),
+        false,
+        None,
+        true,
+        false,
+        false,
+        true,
+    )
+    .expect("native mixed-phase terminal fixture result");
+
+    let receipts = take_adaptive_controller_test_audit();
+    let carrier_supports =
+        crate::v9_real_consumer_shadow::v11_covered::take_covered_carrier_support_audit();
+    let batches = take_terminal_batch_production_audit();
+    let publication_captures = take_accepted_publication_capture_audit();
+    let performance_spans = take_adaptive_performance_test_audit();
+    let comparison_audits = take_adaptive_comparison_test_audit();
+    let _live_carrier_audit =
+        crate::v9_real_consumer_shadow::v11_covered::take_covered_carrier_live_consumption_audit();
+    let receipt = receipts
+        .last()
+        .cloned()
+        .expect("native mixed-phase adaptive production receipt");
+    let production = (
+        receipt,
+        carrier_supports,
+        batches,
+        publication_captures,
+        take_final_physical_comparison(),
+        performance_spans,
+        comparison_audits,
+    );
+    assert_native_mixed_phase_terminal_fixture(&production, &fixture);
+    NativeMixedPhaseFixtureOutcomeV1 {
+        production,
+        fixture,
+    }
+}
+
+fn assert_native_mixed_phase_terminal_fixture(
+    production: &AdaptiveProductionOutcomeV1,
+    fixture: &super::CompleteWb14CadenceFixtureResultV1,
+) {
+    assert_eq!(fixture.fixture_inputs["parity_profile"], "native-mixed-phase");
+    assert_eq!(
+        fixture.fixture_inputs["runtime_swe_m_bits"],
+        serde_json::json!(0.000_6_f64.to_bits())
+    );
+    assert_eq!(
+        fixture.fixture_inputs["hard_boundary_ns"],
+        serde_json::json!(60_000_000_000_u128)
+    );
+    assert_eq!(fixture.beginning_stage3_lane_count, 1);
+    assert!(fixture.beginning_native_v3_resident_present);
+    assert!(fixture.beginning_native_v4_resident_present);
+    assert!(
+        fixture
+            .beginning_complete_owner_canonical_bytes
+            .contains_key("soil_thermal")
+    );
+    assert!(
+        fixture
+            .beginning_complete_owner_canonical_bytes
+            .contains_key("land_surface_energy")
+    );
+    assert_native_mixed_phase_transition(fixture);
+    assert_eq!(
+        production.0.parent_support,
+        openwepp_coupled_time::TimeSupport::new(
+            ModelTimeNs::new(0),
+            ModelTimeNs::new(1_800_000_000_000)
+        )
+        .expect("native parent support")
+    );
+    assert!(!production.0.accepted_microsteps.is_empty());
+    assert!(!production.2.is_empty());
+    assert!(production
+        .2
+        .iter()
+        .all(|batch| batch.lane_ids == vec![1]));
+    assert_eq!(
+        fixture.ending_clock_accepted_until,
+        ModelTimeNs::new(1_800_000_000_000)
+    );
+}
+
+fn assert_native_mixed_phase_transition(
+    fixture: &super::CompleteWb14CadenceFixtureResultV1,
+) {
+    assert_eq!(fixture.event_groups.len(), 1);
+    let group = &fixture.event_groups[0];
+    let accepted_event = group
+        .accepted_event_receipt
+        .as_ref()
+        .expect("native terminal event receipt");
+    assert_eq!(accepted_event.tick(), group.tick);
+    assert_eq!(fixture.terminal_parcels.len(), 1);
+    let parcel = &fixture.terminal_parcels[0];
+    assert_eq!(
+        parcel.posture,
+        crate::snow_stage3_v11_attachment::
+            DirectSnowStage3V11TerminalParcelPosture::Consumed
+    );
+    assert!(
+        group
+            .produced_unconsumed_parcel_digests
+            .contains(&parcel.parcel_digest)
+    );
+    assert!(!fixture.subslabs.is_empty());
+    assert_eq!(
+        fixture.subslabs[0].support.start_ns(),
+        ModelTimeNs::new(0)
+    );
+    assert!(fixture.subslabs.iter().all(|receipt| {
+        receipt.lane_receipts.len() == 1 && receipt.lane_receipts.contains_key(&1)
+    }));
+    assert!(fixture
+        .subslabs
+        .windows(2)
+        .all(|pair| pair[0].support.end_ns() == pair[1].support.start_ns()));
+    assert_eq!(
+        fixture
+            .subslabs
+            .last()
+            .expect("terminal native subslab")
+            .support
+            .end_ns(),
+        group.tick
+    );
+    let first_successor = fixture
+        .snow_free_successor_receipts
+        .first()
+        .expect("first snow-free successor receipt");
+    assert_eq!(first_successor.successor_ordinal, 0);
+    assert_eq!(first_successor.support.start_ns(), group.tick);
+    assert_eq!(
+        first_successor.beginning_complete_owner_set_sha256,
+        accepted_event.ending_owner_set_digest()
+    );
+    assert!(first_successor.receiver_pending);
+    assert_ne!(
+        first_successor.beginning_pending_terminal_parcel_set_sha256,
+        first_successor.ending_pending_terminal_parcel_set_sha256
+    );
+    assert!(fixture
+        .snow_free_successor_receipts
+        .windows(2)
+        .all(|pair| {
+            pair[0].successor_ordinal + 1 == pair[1].successor_ordinal
+                && pair[0].support.end_ns() == pair[1].support.start_ns()
+                && pair[0].ending_complete_owner_set_sha256
+                    == pair[1].beginning_complete_owner_set_sha256
+                && pair[0].ending_snow_owner_sha256
+                    == pair[1].beginning_snow_owner_sha256
+                && pair[0].ending_pending_terminal_parcel_set_sha256
+                    == pair[1].beginning_pending_terminal_parcel_set_sha256
+        }));
+    assert_eq!(
+        fixture
+            .snow_free_successor_receipts
+            .last()
+            .expect("ending snow-free successor receipt")
+            .support
+            .end_ns(),
+        ModelTimeNs::new(1_800_000_000_000)
+    );
+}
