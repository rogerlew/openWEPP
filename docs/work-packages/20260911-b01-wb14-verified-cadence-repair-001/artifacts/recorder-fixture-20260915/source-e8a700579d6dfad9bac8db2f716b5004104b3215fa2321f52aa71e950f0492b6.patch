+fn adaptive_complete_owner_comparison_payload(
+    comparison: &crate::v9_real_consumer_shadow::AdaptiveCompleteOwnerComparisonV1,
+) -> serde_json::Value {
+    serde_json::json!({
+        "scalars": comparison.scalars.iter().map(|scalar| serde_json::json!({
+            "owner_id": scalar.owner_id,
+            "path": scalar.path,
+            "value_bits": scalar.value.to_bits(),
+            "contract_id": scalar.tolerance_authority.contract_id,
+            "tolerance_id": scalar.tolerance_authority.tolerance_id,
+            "absolute_tolerance_bits": scalar.absolute_tolerance.to_bits(),
+            "relative_tolerance_bits": scalar.relative_tolerance.to_bits(),
+        })).collect::<Vec<_>>(),
+        "exact_discrete_surfaces": comparison.exact_discrete_surfaces.iter().map(|surface| serde_json::json!({
+            "owner_id": surface.owner_id,
+            "path": surface.path,
+            "kind": adaptive_discrete_surface_kind_tag(surface.kind),
+            "exact_value": surface.exact_value,
+        })).collect::<Vec<_>>(),
+        "exact_discrete_sha256": comparison.exact_discrete_sha256,
+    })
