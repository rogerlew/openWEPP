+    pub(crate) ending_owner_set_sha256: Digest32,
+    pub(crate) ordered_support_receipt_set_sha256: Digest32,
+}
+
+/// Restores the source publication-day wire carried inside a committed-day
+/// archive.  This is deliberately stronger than accepting the outer content
+/// digest: every support is restored through its canonical admission adapter,
+/// and the support/event chronology is replayed through the publication
+/// history owner before its source-defined endpoints are returned.
+#[cfg(any(
+    feature = "restart-authority-evidence",
+    feature = "persisted-restart-v1"
+))]
+pub(crate) fn restart_authority_restore_archived_publication_day_v1(
+    bytes: &[u8],
+) -> Result<RestoredStage3PublicationDayEvidenceV1, DirectV11RealConsumerError> {
+    let wire: Stage3AcceptedPublicationDayEvidenceWireV1 =
+        serde_json::from_slice(bytes)?;
+    if wire.schema_version != 1
+        || serde_json::to_vec(&wire)? != bytes
+        || wire.supports.is_empty()
+        || wire.prefix_support_count.checked_add(wire.supports.len())
+            != Some(wire.cumulative_support_count)
+        || wire
+            .prefix_event_count
+            .checked_add(wire.event_handoffs.len())
+            != Some(wire.cumulative_event_count)
+        || wire
+            .supports
+            .iter()
+            .any(|support| support.day_index != wire.day_index)
+    {
+        return Err(DirectV11RealConsumerError::Identity(
+            "archived publication day wire",
+        ));
+    }
+    let supports = wire
+        .supports
+        .iter()
+        .cloned()
+        .map(Stage3AcceptedPublicationSupportV1::try_from_wire)
+        .collect::<Result<Vec<_>, _>>()?;
+    let first = supports.first().ok_or(DirectV11RealConsumerError::Identity(
+        "archived publication day beginning",
+    ))?;
+    let last = supports.last().ok_or(DirectV11RealConsumerError::Identity(
+        "archived publication day ending",
+    ))?;
+    let beginning_owner_set_sha256 = wire
+        .event_handoffs
+        .first()
+        .filter(|event| {
+            event.tick() == first.support.start_ns()
+                && event.parent_transaction_id() == first.parent_transaction_id
+        })
+        .map_or(
+            first.beginning_complete_owner_set_sha256,
+            AcceptedEventReceiptV1::beginning_owner_set_digest,
+        );
+    let mut restored = AcceptedPublicationHistoryV1::default();
+    restored.replace(supports.clone(), &wire.event_handoffs)?;
+    if restored.validate_cached_tail_against_full_scan()? != Some(wire.ending_owner_set_sha256)
+        || beginning_owner_set_sha256 == Digest32::zero()
+        || last.ending_complete_owner_set_sha256 != wire.ending_owner_set_sha256
+    {
+        return Err(DirectV11RealConsumerError::Identity(
+            "archived publication day chronology",
+        ));
+    }
+    let mut ordered = Vec::with_capacity((supports.len() + wire.event_handoffs.len()) * 33 + 64);
+    ordered.extend_from_slice(b"OPENWEPP_STAGE3_ACCEPTED_PUBLICATION_SUPPORT_SET_V1\0");
+    for support in &supports {
+        ordered.push(b'S');
+        ordered.extend_from_slice(support.receipt_sha256().as_bytes());
+    }
+    for event in &wire.event_handoffs {
+        ordered.push(b'E');
+        ordered.extend_from_slice(event.id().digest().as_bytes());
+    }
+    Ok(RestoredStage3PublicationDayEvidenceV1 {
+        canonical_bytes: bytes.to_vec(),
+        day_index: wire.day_index,
+        prefix_support_count: wire.prefix_support_count,
+        prefix_event_count: wire.prefix_event_count,
+        prefix_authority_sha256: wire.prefix_authority_sha256,
+        prefix_ending_owner_set_sha256: wire.prefix_ending_owner_set_sha256,
+        support_count: supports.len(),
+        event_count: wire.event_handoffs.len(),
+        cumulative_support_count: wire.cumulative_support_count,
+        cumulative_event_count: wire.cumulative_event_count,
+        cumulative_authority_sha256: wire.cumulative_authority_sha256,
+        beginning_owner_set_sha256,
+        ending_owner_set_sha256: wire.ending_owner_set_sha256,
+        ordered_support_receipt_set_sha256: digest_bytes(&ordered),
+    })
 }
 
