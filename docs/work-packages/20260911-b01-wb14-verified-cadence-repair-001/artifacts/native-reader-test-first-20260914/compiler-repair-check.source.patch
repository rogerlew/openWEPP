+    pub(crate) fn diagnostic_restore_native_lane_maps_v1(
+        maps: Vec<DiagnosticNativeLaneMapV1>,
+    ) -> Result<Vec<RealHydrologyLaneLayerMap>, DirectV10RealConsumerError> {
+        let mut restored = Vec::with_capacity(maps.len());
