+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct RestoredStage3PublicationDayEvidenceV1 {
+    pub(crate) canonical_bytes: Vec<u8>,
+    pub(crate) day_index: usize,
+    pub(crate) prefix_support_count: usize,
+    pub(crate) prefix_event_count: usize,
