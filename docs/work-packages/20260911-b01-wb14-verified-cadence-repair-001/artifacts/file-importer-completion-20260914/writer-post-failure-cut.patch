+fn is_target(day: usize, interval: usize, support: openwepp_coupled_time::TimeSupport) -> bool {
+    day == B01_DAY_INDEX
+        && interval == B01_INTERVAL_INDEX
+        && support.start_ns().get() == B01_CHILD_START_NS
+        && support.end_ns().get() == B01_CHILD_END_NS
+}
