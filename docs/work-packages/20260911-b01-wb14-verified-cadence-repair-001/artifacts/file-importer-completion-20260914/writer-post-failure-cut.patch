+pub(crate) fn restore_coupled_clock(
+    bytes: &[u8],
+    model: openwepp_coupled_time::Digest32,
+    authority: openwepp_coupled_time::Digest32,
+    policy: openwepp_coupled_time::Digest32,
+) -> Result<CoupledTimeRestartV2, String> {
