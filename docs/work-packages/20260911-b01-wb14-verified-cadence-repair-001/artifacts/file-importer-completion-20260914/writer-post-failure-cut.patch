+    Ok(crate::hydrology::DirectSnowStage3SupportInput { forcing: crate::hydrology::DirectSnowHourlyForcing { active_precipitation_m:value.hourly.values[0],rain_m:value.hourly.values[1],snowfall_m:value.hourly.values[2],radiation_mj_m2:value.hourly.values[3],air_temperature_c:value.hourly.values[4],cloud_fraction:value.hourly.values[5],phase_model,rain_fraction:value.hourly.values[6],snow_fraction:value.hourly.values[7],hydrometeor_temperature_c:value.hourly.hydrometeor_temperature_c }, duration_seconds:value.duration_seconds })
