+struct PreChildRecorderProductionOutcomeV1 {
+    production: AdaptiveProductionOutcomeV1,
+    fixture: Option<serde_json::Value>,
+}
+
+#[derive(Clone, Copy)]
+enum PreChildRecorderPhaseV1 {
+    Covered,
+    FirstSnowFree,
+}
+
+impl PreChildRecorderPhaseV1 {
+    fn label(self) -> &'static str {
+        match self {
+            Self::Covered => "covered",
+            Self::FirstSnowFree => "first-snow-free",
+        }
+    }
+}
+
+fn pre_child_recorder_mode_label(
+    mode: crate::snow_stage3_v11_current_context_capture::PreChildRecorderTestModeV1,
+) -> &'static str {
+    use crate::snow_stage3_v11_current_context_capture::PreChildRecorderTestModeV1 as Mode;
+    match mode {
+        Mode::Disabled => "disabled",
+        Mode::ProductionNonTargetObserverEnabled => "production-non-target-observer-enabled",
+        Mode::EnabledCovered => "enabled-covered",
+        Mode::ForcedCoveredCaptureFailure => "forced-covered-capture-failure",
+        Mode::EnabledSnowFree => "enabled-snow-free",
+        Mode::ForcedSnowFreeCaptureFailure => "forced-snow-free-capture-failure",
+        Mode::ForcedSnowFreeWrongPhaseFailure => "forced-snow-free-wrong-phase-failure",
+        Mode::ForcedSnowFreeRequiredOmissionFailure => {
+            "forced-snow-free-required-omission-failure"
+        }
+    }
+}
+
+fn run_pre_child_recorder_fixture_on_large_stack(
+    mode: crate::snow_stage3_v11_current_context_capture::PreChildRecorderTestModeV1,
+) -> (
+    PreChildRecorderProductionOutcomeV1,
+    crate::snow_stage3_v11_current_context_capture::PreChildRecorderTestAuditV1,
+) {
+    use crate::v9_real_consumer_shadow::v11_covered::CanonicalCoveredPhysicalParityCaseV1 as Case;
+
+    CANONICAL_PARITY_CASE.with(|slot| slot.set(Some(Case::NativeMixedPhase)));
+    crate::snow_stage3_v11_current_context_capture::begin_pre_child_recorder_test_audit_v1(mode);
+    let native = run_native_mixed_phase_terminal_on_large_stack();
+    let outcome = PreChildRecorderProductionOutcomeV1 {
+        fixture: Some(native.fixture.canonical_comparison_payload()),
+        production: native.production,
+    };
+    let audit =
+        crate::snow_stage3_v11_current_context_capture::take_pre_child_recorder_test_audit_v1();
+    (outcome, audit)
+}
+
+fn run_with_pre_child_recorder(
+    mode: crate::snow_stage3_v11_current_context_capture::PreChildRecorderTestModeV1,
+    phase: PreChildRecorderPhaseV1,
+) -> (
+    PreChildRecorderProductionOutcomeV1,
+    crate::snow_stage3_v11_current_context_capture::PreChildRecorderTestAuditV1,
+) {
+    let phase_label = phase.label();
+    let fixture_label = "native-mixed-phase-terminal";
+    let parent_support_duration_ns = 1_800_000_000_000_u128;
+    let mode_label = pre_child_recorder_mode_label(mode);
+    eprintln!(
+        "B01_RECORDER_CONTROL_START phase={phase_label} mode={mode_label} fixture={fixture_label} parent_support_ns={parent_support_duration_ns} operation=producer-execution"
+    );
+    let result = std::thread::Builder::new()
+        .name(format!("recorder-{phase_label}-{mode_label}"))
+        .stack_size(64 * 1024 * 1024)
+        .spawn(move || run_pre_child_recorder_fixture_on_large_stack(mode))
+        .expect("spawn pre-child recorder production fixture")
+        .join()
+        .unwrap_or_else(|_| {
+            panic!(
+                "pre-child recorder control failed: phase={phase_label} mode={mode_label} fixture={fixture_label} parent_support_ns={parent_support_duration_ns} operation=producer-execution"
+            )
+        });
+    let selected_support = result
+        .1
+        .live_inputs
+        .first()
+        .map_or_else(|| "none".to_owned(), |row| row["support"].to_string());
+    eprintln!(
+        "B01_RECORDER_CONTROL_PASS phase={phase_label} mode={mode_label} fixture={fixture_label} parent_support_ns={parent_support_duration_ns} selected_support={selected_support} operation=producer-model-complete"
+    );
+    result
