+    let value: serde_json::Value = serde_json::from_slice(&std::fs::read(path).unwrap()).unwrap();
+    let lse: LandSurfaceEnergyConfiguration = serde_json::from_value(value["lse"].clone()).unwrap();
+    let veg: VegetationConfiguration = serde_json::from_value(value["vegetation"].clone()).unwrap();
+    for (ofe, tile, expected) in [
+        ("ofe-1", "fixture-lane-1-tile-1", false),
+        ("ofe-1", "fixture-lane-1-tile-2", false),
+        ("ofe-2", "fixture-lane-2-tile-1", true),
+        ("ofe-2", "fixture-lane-2-tile-2", false),
+    ] {
+        assert_eq!(
+            configured_destination_is_canopy_covered(&lse, &veg, ofe, tile).unwrap(),
+            expected
+        );
+    }
+    assert!(configured_destination_is_canopy_covered(&lse, &veg, "missing", "forest").is_err());
+    assert!(configured_destination_is_canopy_covered(&lse, &veg, "ofe-2", "missing").is_err());
+    let mut duplicate = lse.clone();
+    duplicate.ofes.push(duplicate.ofes[1].clone());
+    assert!(
+        configured_destination_is_canopy_covered(
+            &duplicate,
+            &veg,
+            "ofe-2",
+            "fixture-lane-2-tile-1"
+        )
+        .is_err()
+    );
+    let mut duplicate = lse.clone();
+    let tile = duplicate.ofes[1].tiles[0].clone();
+    duplicate.ofes[1].tiles.push(tile);
+    assert!(
+        configured_destination_is_canopy_covered(
+            &duplicate,
+            &veg,
+            "ofe-2",
+            "fixture-lane-2-tile-1"
+        )
+        .is_err()
+    );
+    let mut aliased = lse.clone();
+    aliased.ofes[0].tiles[0].tile_id = aliased.ofes[1].tiles[0].tile_id.clone();
+    assert!(
+        !configured_destination_is_canopy_covered(&aliased, &veg, "ofe-1", "fixture-lane-2-tile-1")
+            .unwrap()
+    );
+    assert!(
+        configured_destination_is_canopy_covered(&aliased, &veg, "ofe-2", "fixture-lane-2-tile-1")
+            .unwrap()
+    );
+}
