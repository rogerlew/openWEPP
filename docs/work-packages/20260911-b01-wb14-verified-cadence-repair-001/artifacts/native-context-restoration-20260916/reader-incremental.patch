+/// Restores the private diagnostic projection emitted for captured current
+/// context. Tuple-keyed destination receipts are intentionally represented as
+/// ordered rows in JSON, so this must share the canonical restart wire rather
+/// than deserialize the production receipt directly.
+pub(crate) fn diagnostic_restore_coupled_subslab_receipts_value_v2(
+    value: serde_json::Value,
+) -> Result<Vec<Stage3CoupledSubslabReceiptV1>, String> {
+    let rows: Vec<Stage3CoupledSubslabReceiptWireV2> =
+        serde_json::from_value(value).map_err(|error| error.to_string())?;
+    rows.into_iter()
+        .map(Stage3CoupledSubslabReceiptWireV2::restore)
+        .collect::<Result<Vec<_>, _>>()
+        .map_err(|error| error.to_string())
+}
