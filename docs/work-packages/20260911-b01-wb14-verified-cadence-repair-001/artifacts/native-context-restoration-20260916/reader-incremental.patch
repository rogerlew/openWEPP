+        .iter()
+        .filter(|entry| {
+            entry
+                .get("kinds")
+                .and_then(serde_json::Value::as_array)
+                .is_some_and(|kinds| {
+                    kinds
+                        .iter()
+                        .any(|kind| kind == "b01_wb14_snow_free_pre_child_current_context_v1")
+                })
+        })
+        .collect::<Vec<_>>();
