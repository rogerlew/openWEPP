+    fn canonical_event_field_substitution(
+        wire: &[u8],
+        event: &AcceptedEventReceiptV1,
+        field: &str,
+        replacement: &str,
+    ) -> Vec<u8> {
+        // This retains the typed wire's field order and changes one semantic
+        // event field only. Rebuilding through `Value` would exercise the
+        // restorer's canonical-byte guard instead of its event guard.
+        let event_value = serde_json::to_value(event).expect("event wire value");
+        let receipt_id = event_value["receipt_id"]
+            .as_str()
+            .expect("event receipt id");
+        let prior = event_value[field].as_str().expect("event field value");
+        let mut text = String::from_utf8(wire.to_vec()).expect("canonical UTF-8 wire");
+        let receipt_marker = format!(r#""receipt_id":"{receipt_id}""#);
+        let receipt_offset = text.find(&receipt_marker).expect("unique event receipt");
+        assert_eq!(text.matches(&receipt_marker).count(), 1);
+        let event_start = text[..receipt_offset].rfind('{').expect("event object start");
+        let event_end = text[receipt_offset..]
+            .find('}')
+            .map(|offset| receipt_offset + offset)
+            .expect("event object end");
+        let field_marker = format!(r#""{field}":"{prior}""#);
+        let field_offset = text[event_start..event_end]
+            .find(&field_marker)
+            .map(|offset| event_start + offset)
+            .expect("event field in selected receipt");
+        assert_eq!(text[event_start..event_end].matches(&field_marker).count(), 1);
+        text.replace_range(
+            field_offset..field_offset + field_marker.len(),
+            &format!(r#""{field}":"{replacement}""#),
+        );
+        text.into_bytes()
+    }
+
+    fn assert_archive_identity(
+        result: Result<RestoredStage3PublicationDayEvidenceV1, DirectV11RealConsumerError>,
+        expected: &'static str,
+    ) {
+        assert!(
+            matches!(result, Err(DirectV11RealConsumerError::Identity(actual)) if actual == expected),
+            "expected archive identity {expected}; got {result:?}"
+        );
+    }
