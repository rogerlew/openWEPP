ent melting-point node."},{"highlight_end":27,"highlight_start":1,"text":"                    Err(_)"},{"highlight_end":56,"highlight_start":1,"text":"                        if (self.terminal_endpoint_mode"},{"highlight_end":36,"highlight_start":1,"text":"                            || self"},{"highlight_end":56,"highlight_start":1,"text":"                                .stage3_forcing_by_lane"},{"highlight_end":47,"highlight_start":1,"text":"                                .get(&lane_id)"},{"highlight_end":90,"highlight_start":1,"text":"                                .is_some_and(|forcing| forcing.forcing.snowfall_m > 0.0))"},{"highlight_end":58,"highlight_start":1,"text":"                            && state.layers.is_empty() =>"},{"highlight_end":22,"highlight_start":1,"text":"                    {"},{"highlight_end":81,"highlight_start":1,"text":"                        (boundary.snow_temperature_k, boundary.latent_heat_j_kg)"},{"highlight_end":22,"highlight_start":1,"text":"                    }"},{"highlight_end":32,"highlight_start":1,"text":"                    Err(_) => {"},{"highlight_end":73,"highlight_start":1,"text":"                        return Err(DirectV11RealConsumerError::Identity("},{"highlight_end":84,"highlight_start":1,"text":"                            \"covered Stage-3 state boundary active-volume surface\","},{"highlight_end":28,"highlight_start":1,"text":"                        ));"},{"highlight_end":22,"highlight_start":1,"text":"                    }"},{"highlight_end":19,"highlight_start":1,"text":"                };"},{"highlight_end":51,"highlight_start":1,"text":"                let mut merged = boundary.clone();"},{"highlight_end":64,"highlight_start":1,"text":"                merged.snow_temperature_k = snow_temperature_k;"},{"highlight_end":60,"highlight_start":1,"text":"                merged.latent_heat_j_kg = latent_heat_j_kg;"},{"highlight_end":60,"highlight_start":1,"text":"                refresh_native_snow_exchange(&