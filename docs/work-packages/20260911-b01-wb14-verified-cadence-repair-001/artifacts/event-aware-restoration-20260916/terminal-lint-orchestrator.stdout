light_start":1,"text":"                .into());"},{"highlight_end":14,"highlight_start":1,"text":"            }"},{"highlight_end":90,"highlight_start":1,"text":"            let represented_snow_native_column_skips_frozen_litter_v3_v4_and_wb14 = true;"},{"highlight_end":88,"highlight_start":1,"text":"            let envelope = candidate.construct_stage3_covered_native_complete_envelope("},{"highlight_end":27,"highlight_start":1,"text":"                day_index,"},{"highlight_end":33,"highlight_start":1,"text":"                duration_s_bits,"},{"highlight_end":47,"highlight_start":1,"text":"                finalize_wb14_parent_interval,"},{"highlight_end":33,"highlight_start":1,"text":"                coupled_binding,"},{"highlight_end":24,"highlight_start":1,"text":"                &fixed,"},{"highlight_end":16,"highlight_start":1,"text":"            )?;"},{"highlight_end":75,"highlight_start":1,"text":"            let beginning_physical = self.frozen_litter_v3.as_ref().ok_or("},{"highlight_end":64,"highlight_start":1,"text":"                super::DirectV9RealConsumerError::OwnerClosure("},{"highlight_end":70,"highlight_start":1,"text":"                    \"represented-snow missing beginning V3 resident\","},{"highlight_end":19,"highlight_start":1,"text":"                ),"},{"highlight_end":16,"highlight_start":1,"text":"            )?;"},{"highlight_end":77,"highlight_start":1,"text":"            let ending_physical = candidate.frozen_litter_v3.as_ref().ok_or("},{"highlight_end":64,"highlight_start":1,"text":"                super::DirectV9RealConsumerError::OwnerClosure("},{"highlight_end":67,"highlight_start":1,"text":"                    \"represented-snow missing ending V3 resident\","},{"highlight_end":19,"highlight_start":1,"text":"                ),"},{"highlight_end":16,"highlight_start":1,"text":"            )?;"},{"highlight_end":78,"highlight_start":1,"text":"            // The candidate legitimately restages its WB14 parent before the"},{"highli