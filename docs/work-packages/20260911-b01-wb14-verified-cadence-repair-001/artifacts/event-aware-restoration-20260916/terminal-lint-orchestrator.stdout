 if let Some(physical) = self.frozen_litter_v3.as_ref() {"},{"highlight_end":71,"highlight_start":1,"text":"            serde_json::to_vec(physical.lse_state()).map_err(|error| {"},{"highlight_end":90,"highlight_start":1,"text":"                super::DirectV9RealConsumerError::Serialization(error.to_string()).into()"},{"highlight_end":15,"highlight_start":1,"text":"            })"},{"highlight_end":17,"highlight_start":1,"text":"        } else {"},{"highlight_end":72,"highlight_start":1,"text":"            serde_json::to_vec(&self.inner.lse_state).map_err(|error| {"},{"highlight_end":90,"highlight_start":1,"text":"                super::DirectV9RealConsumerError::Serialization(error.to_string()).into()"},{"highlight_end":15,"highlight_start":1,"text":"            })"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":82,"highlight_start":1,"text":"    /// Private projection view; the native restart separately owns these fields."},{"highlight_end":45,"highlight_start":1,"text":"    #[cfg(feature = \"persisted-restart-v1\")]"},{"highlight_end":53,"highlight_start":1,"text":"    pub fn restart_authority_native_without_routing("},{"highlight_end":15,"highlight_start":1,"text":"        &self,"},{"highlight_end":52,"highlight_start":1,"text":"    ) -> Result<Self, DirectV10RealConsumerError> {"},{"highlight_end":92,"highlight_start":1,"text":"        if openwepp_land_surface_energy::snow_accuracy_policy::Policy::current().identity()"},{"highlight_end":24,"highlight_start":1,"text":"            != Some(14)"},{"highlight_end":10,"highlight_start":1,"text":"        {"},{"highlight_end":24,"highlight_start":1,"text":"            return Err("},{"highlight_end":96,"highlight_start":1,"text":"                super::DirectV9RealConsumerError::OwnerClosure(\"native routing policy\").into(),"},{"highlight_end":15,"highlight_start":1,"text":"            );"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":42,"highlight_start":1,"text":"        let mut candidate = self.clone();"},{"highlight_end":61,"highlight_start":1,"text":"        candidate.inner.hydrology_frame.laned_active = None;"},{"highlight_end":69,"highlight_start":1,"text":"        candidate.inner.hydrology_frame.laned_active_summary = None;"},{"highlight_end":22,"highlight_start":1,"text":"        Ok(candidate)"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":45,"highlight_start":1,"text":"    #[cfg(feature = \"persisted-restart-v1\")]"},{"highlight_end":53,"highlight_start":1,"text":"    pub fn restart_authority_install_native_routing("},{"highlight_end":19,"highlight_start":1,"text":"        &mut self,"},{"highlight_end":61,"highlight_start":1,"text":"        config: Option<Box<crate::DirectLanedActiveConfig>>,"},{"highlight_end":66,"highlight_start":1,"text":"        summary: Option<Box<crate::DirectLanedActiveRunSummary>>,"},{"highlight_end":64,"highlight_start":1,"text":"        expected: &Option<Box<crate::DirectLanedActiveConfig>>,"},{"highlight_end":50,"highlight_start":1,"text":"    ) -> Result<(), DirectV10RealConsumerError> {"},{"highlight_end":49,"highlight_start":1,"text":"        let frame = &self.inner.hydrology_frame;"},{"highlight_end":92,"highlight_start":1,"text":"        if openwepp_land_surface_energy::snow_accuracy_policy::Policy::current().identity()"},{"highlight_end":24,"highlight_start":1,"text":"            != Some(14)"},{"highlight_end":35,"highlight_start":1,"text":"            || &config != expected"},{"highlight_end":44,"highlight_start":1,"text":"            || frame.laned_active.is_some()"},{"highlight_end":52,"highlight_start":1,"text":"            || frame.laned_active_summary.is_some()"},{"highlight_end":55,"highlight_start":1,"text":"            || (config.is_none() && summary.is_some())"},{"highlight_end":10,"hi