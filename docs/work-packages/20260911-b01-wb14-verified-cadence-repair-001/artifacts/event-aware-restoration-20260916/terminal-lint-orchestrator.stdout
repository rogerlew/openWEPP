      CoveredV8PhysicalOwner::MultiTile(v) => v.finalized_tiles().iter().map(tile).collect(),"},{"highlight_end":67,"highlight_start":1,"text":"            CoveredV8PhysicalOwner::FrozenLitterV3 {fixed,..} => {"},{"highlight_end":86,"highlight_start":1,"text":"                let mut rows: Vec<_> = fixed.legacy_tiles.iter().map(tile).collect();"},{"highlight_end":54,"highlight_start":1,"text":"                for v in &fixed.frozen_litter_tiles {"},{"highlight_end":72,"highlight_start":1,"text":"                    let c = &v.fixed_final.complete_physical_candidate;"},{"highlight_end":117,"highlight_start":1,"text":"                    rows.push(serde_json::json!({\"variant\":\"native_covered_litter\",\"identity\":identity(&c.identity),"},{"highlight_end":84,"highlight_start":1,"text":"                        \"evaluation\":v.fixed_final.accepted_fixed_final.evaluation,"},{"highlight_end":111,"highlight_start":1,"text":"                        \"occupancies\":c.energy_operands.occupancies,\"canopy_air\":c.energy_operands.canopy_air,"},{"highlight_end":103,"highlight_start":1,"text":"                        \"shortwave\":c.energy_operands.shortwave,\"longwave\":c.energy_operands.longwave,"},{"highlight_end":122,"highlight_start":1,"text":"                        \"litter_surface\":c.energy_operands.litter_surface,\"vegetation_operands\":c.vegetation_operands}));"},{"highlight_end":18,"highlight_start":1,"text":"                }"},{"highlight_end":52,"highlight_start":1,"text":"                for v in &fixed.open_litter_tiles {"},{"highlight_end":126,"highlight_start":1,"text":"                    rows.push(serde_json::json!({\"variant\":\"native_open_litter\",\"identity\":identity(&v.fixed_final.identity),"},{"highlight_end":76,"highlight_start":1,"text":"                        \"evaluation\":v.fixed_final.accepted_fixed_final}));"},{"highlight_end":18,"highlight_start":1,"text":"                }"},{"highlight_end":21,"highlight_start":1,"text":"                rows"},{"highlight_end":14,"highlight_start":1,"text":"            }"},{"highlight_end":11,"highlight_start":1,"text":"        };"},{"highlight_end":163,"highlight_start":1,"text":"        let problem_row = |id: &openwepp_land_surface_energy::RuntimeTileIdentity, problem: &openwepp_land_surface_energy::OpenSurfaceProblem| serde_json::json!({"},{"highlight_end":141,"highlight_start":1,"text":"            \"ofe_id\":id.ofe_id,\"tile_id\":id.tile_id,\"transaction_id\":id.transaction_id,\"soil_transaction_id\":id.soil_thermal_transaction_id,"},{"highlight_end":144,"highlight_start":1,"text":"            \"interval_s\":id.interval_s,\"beginning_soil_thermal_state_sha256\":id.beginning_soil_thermal_state_sha256,\"ground_problem\":problem});"},{"highlight_end":60,"highlight_start":1,"text":"        let problem_inputs: Vec<_> = match &self.physical {"},{"highlight_end":150,"highlight_start":1,"text":"            CoveredV8PhysicalOwner::Legacy(v) => vec![problem_row(v.potential().identity(), &v.potential().accuracy_observation_beginning().ground)],"},{"highlight_end":96,"highlight_start":1,"text":"            CoveredV8PhysicalOwner::MultiTile(v) => v.potential_tiles().iter().filter_map(|v| {"},{"highlight_end":26,"highlight_start":1,"text":"                match v {"},{"highlight_end":161,"highlight_start":1,"text":"                    super::multi_tile_runtime::PotentialTilePhase::Open {phase,..} => Some(problem_row(&phase.identity,phase.accuracy_observation_beginning())),"},{"highlight_end":173,"highlight_start":1,"text":"                    super::multi_tile_runtime::PotentialTilePhase::Covered {phase,..} => Some(problem_row(phase.identity(),&phase.accuracy_observation_beginning().ground)),"},{"highlight_end":96,"highlight_start":1,"text":"                    super::multi_tile_runtime::PotentialTilePhase::Stage3OpenSnow {..} => None,"},{"highlight_end":18,"highlight_start":1,"text":"                }"},{"highlight_end":26,"highlight_start":1,"text":"            }).collect(),"},{"highlight_end":104,"highlight_start":1,"text":"            CoveredV8PhysicalOwner::FrozenLitterV3 {fixed,..} => fixed.accuracy_problem_inputs.clone(),"},{"highlight_end":11,"highlight_start":1,"text":"        };"},{"highlight_end":126,"highlight_start":1,"text":"        let soil_children: Vec<_> = self.hydrology().pre_ingress_soil_thermal_candidates().iter().map(|v| serde_json::json!({"},{"highlight_end":156,"highlight_start":1,"text":"            \"ofe_id\":v.ofe_id,\"tile_id\":v.tile_id,\"beginning_state_sha256\":v.beginning_state_sha256,\"beginning_identity\":v.beginning_identity})).collect();"},{"highlight_end":105,"highlight_start":1,"text":"        serde_json::json!({\"tiles\":tiles,\"problem_inputs\":problem_inputs,\"soil_children\":soil_children})"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":2,"highlight_start":1,"text":"}"}]}]}],"level":"warning","message":"items after a test module","spans":[{"byte_end":100295,"byte_start":100286,"column_end":10,"column_start":1,"expansion":null,"file_name":"crates/openwepp-hillslope-orchestrator/src/land_surface_energy_shadow/covered_v8_owner.rs","is_primary":true,"label":null,"line_end":2500,"line_start":2500,"suggested_replacement":null,"suggestion_applicability":null,"text":[{"highlight_end":10,"highlight_start":1,"text":"mod tests {"}]},{"byte_end":105828,"byte_start":105790,"column_end":39,"column_start":1,"expansion":null,"file_name":"crates/openwepp-hillslope-orchestrator/src/land_surface_energy_shadow/covered_v8_owner.rs","is_primary":true,"label":null,"line_end":2644,"line_start":2644,"suggested_replacement":null,"suggestion_applicability":null,"text":[{"highlight_end":39,"highlight_start":1,"text":"impl UncommittedCoveredV8OwnerEnvelope {"}]}],"code":{"code":"clippy::items_after_test_module","explanation":null}}}
