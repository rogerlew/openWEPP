          }"},{"highlight_end":14,"highlight_start":1,"text":"            }"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":58,"highlight_start":1,"text":"        self.inner.hydrology_frame.laned_active = config;"},{"highlight_end":67,"highlight_start":1,"text":"        self.inner.hydrology_frame.laned_active_summary = summary;"},{"highlight_end":15,"highlight_start":1,"text":"        Ok(())"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":77,"highlight_start":1,"text":"    /// Install a hydrology frame reconstructed by the exact V2 restart only"},{"highlight_end":78,"highlight_start":1,"text":"    /// when every V1-owned field is bit-identical and the sole difference is"},{"highlight_end":68,"highlight_start":1,"text":"    /// the Stage-3 attachment containing authoritative V4 custody."},{"highlight_end":45,"highlight_start":1,"text":"    #[cfg(feature = \"persisted-restart-v1\")]"},{"highlight_end":63,"highlight_start":1,"text":"    pub fn restart_authority_install_exact_hydrology_frame_v2("},{"highlight_end":19,"highlight_start":1,"text":"        &mut self,"},{"highlight_end":41,"highlight_start":1,"text":"        restored: crate::DirectRunFrame,"},{"highlight_end":50,"highlight_start":1,"text":"    ) -> Result<(), DirectV10RealConsumerError> {"},{"highlight_end":43,"highlight_start":1,"text":"        let restored_attachment = restored"},{"highlight_end":40,"highlight_start":1,"text":"            .snow_stage3_v11_attachment"},{"highlight_end":24,"highlight_start":1,"text":"            .as_deref()"},{"highlight_end":91,"highlight_start":1,"text":"            .filter(|attachment| attachment.restart_authority_contains_frozen_litter_v4())"},{"highlight_end":67,"highlight_start":1,"text":"            .ok_or(super::DirectV9RealConsumerError::OwnerClosure("},{"highlight_end":74,"highlight_start":1,"text":"                \"exact hydrology V2 restore requires Stage-3 V4 custody\","},{"highlight_end":17,"highlight_start":1,"text":"            ))?;"},{"highlight_end":63,"highlight_start":1,"text":"        let mut expected = self.inner.hydrology_frame.clone();"},{"highlight_end":91,"highlight_start":1,"text":"        expected.snow_stage3_v11_attachment = Some(Box::new(restored_attachment.clone()));"},{"highlight_end":34,"highlight_start":1,"text":"        if expected != restored {"},{"highlight_end":71,"highlight_start":1,"text":"            return Err(super::DirectV9RealConsumerError::OwnerClosure("},{"highlight_end":75,"highlight_start":1,"text":"                \"exact hydrology V2 restore changed V1-owned frame state\","},{"highlight_end":14,"highlight_start":1,"text":"            )"},{"highlight_end":22,"highlight_start":1,"text":"            .into());"},{"highlight_end":10,"highlight_start":1,"text":"        }"},{"highlight_end":42,"highlight_start":1,"text":"        let mut candidate = self.clone();"},{"highlight_end":52,"highlight_start":1,"text":"        candidate.inner.hydrology_frame = restored;"},{"highlight_end":82,"highlight_start":1,"text":"        candidate.restart_authority_validate_v9_complete_owner_set_exact(false)?;"},{"highlight_end":27,"highlight_start":1,"text":"        *self = candidate;"},{"highlight_end":15,"highlight_start":1,"text":"        Ok(())"},{"highlight_end":6,"highlight_start":1,"text":"    }"},{"highlight_end":1,"highlight_start":1,"text":""},{"highlight_end":41,"highlight_start":1,"text":"    #[allow(clippy::too_many_arguments)]"},{"highlight_end":66,"highlight_start":1,"text":"    pub(crate) fn evaluate_covered_frozen_litter_v4_candidate_v1("},{"highlight_end":15,"highlight_start":1,"text":"        &self,"},{"highlight_end":26,"highlight_start":1,"text":"        day_index: usize,"},{"highlight_end":31,"highlight_start":1,"text":"        interval_index: usize,"},{"highlight_end":57,"highlight_start":1,"text":"        input: &super::DirectV11SnowCoveredSegmentInput,"},{"highlight_end":30,"high