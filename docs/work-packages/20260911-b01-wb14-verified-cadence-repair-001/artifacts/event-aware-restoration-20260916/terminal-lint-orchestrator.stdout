{"reason":"compiler-message","package_id":"path+file:///workdir/openwepp-experiments/b01-wb14-cadence/native-context-restoration-reader-20260916/crates/openwepp-hillslope-orchestrator#0.1.0","manifest_path":"/workdir/openwepp-experiments/b01-wb14-cadence/native-context-restoration-reader-20260916/crates/openwepp-hillslope-orchestrator/Cargo.toml","target":{"kind":["lib"],"crate_types":["lib"],"name":"openwepp_hillslope_orchestrator","src_path":"/workdir/openwepp-experiments/b01-wb14-cadence/native-context-restoration-reader-20260916/crates/openwepp-hillslope-orchestrator/src/lib.rs","edition":"2024","doc":true,"doctest":true,"test":true},"message":{"rendered":"warning: items after a test module\n    --> crates/openwepp-hillslope-orchestrator/src/land_surface_energy_shadow/covered_v8_owner.rs:2500:1\n     |\n2500 | mod tests {\n     | ^^^^^^^^^\n...\n2644 | impl UncommittedCoveredV8OwnerEnvelope {\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n     |\n     = help: for further information visit https://rust-lang.github.io/rust-clippy/master/index.html#items_after_test_module\n     = note: `-D clippy::items-after-test-module` implied by `-D warnings`\n     = help: to override `-D warnings` add `#[allow(clippy::items_after_test_module)]`\n     = help: move the items to before the test module was defined\n\n","$message_type":"diagnostic","children":[{"children":[],"code":null,"level":"help","message":"for further information visit https://rust-lang.github.io/rust-clippy/master/index.html#items_after_test_module","rendered":null,"spans":[]},{"children":[],"code":null,"level":"note","message":"`-D clippy::items-after-test-module` implied by `-D warnings`","rendered":null,"spans":[]},{"children":[],"code":null,"level":"help","message":"to override `-D warnings` add `#[allow(clippy::items_after_test_module)]`","rendered":null,"spans":[]},{"children":[],"code":null,"level":"help","message":"move the items to before the test module was defined","rendered":null,"spans":[{"byte_end":100271,"byte_start":100271,"column_end":2,"column_start":2,"expansion":null,"file_name":"crates/openwepp-hillslope-orchestrator/src/land_surface_energy_shadow/covered_v8_owner.rs","is_primary":true,"label":null,"line_end":2497,"line_start":2497,"suggested_replacement":"\n\n// Read-only projection of retained final solves. Admission is supplied by the\n// enclosing accepted-support observation, never by this DTO alone.\nimpl UncommittedCoveredV8OwnerEnvelope {\n    pub(crate) fn accuracy_final_energy_operands(&self) -> serde_json::Value {\n        fn identity(v: &openwepp_land_surface_energy::RuntimeTileIdentity) -> serde_json::Value {\n            serde_json::json!({\"transaction_id\":v.transaction_id,\"soil_transaction_id\":v.soil_thermal_transaction_id,\n                \"ofe_id\":v.ofe_id,\"tile_id\":v.tile_id,\"tile_fraction\":v.tile_fraction,\"interval_s\":v.interval_s,\n                \"configuration_sha256\":v.configuration_sha256,\"beginning_lse_state_sha256\":v.beginning_lse_state_sha256,\n                \"beginning_soil_thermal_state_sha256\":v.beginning_soil_thermal_state_sha256,\n                \"beginning_hydrology_snapshot_sha256\":v.beginning_hydrology_snapshot_sha256,\n                \"beginning_vegetation_state_sha256\":v.beginning_vegetation_state_sha256})\n        }\n        fn covered(v: &openwepp_land_surface_energy::FinalCoveredTileCandidate) -> serde_json::Value {\n            serde_json::json!({\"variant\":\"covered\",\"identity\":identity(&v.identity),\n                \"evaluation\":v.final_solver_candidate.evaluation,\"column\":v.energy_operands.column,\n                \"lower_boundary\":v.energy_operands.lower_boundary,\n                \"vegetation_operands\":v.vegetation_operands})\n        }\n        fn tile(v: &super::multi_tile_runtime::FinalizedRuntimeTile) -> serde_json::Value {\n            match v {\n                super::multi_tile_runtime::FinalizedRuntimeTile::Covered(v) => covered(v),\n                super::multi_tile_runtime::FinalizedRuntimeTile::Open(v) => serde_json::json!({\n                    \"variant\":\"open\",\"identity\":identity(&v.identity),\"evaluation\":v.final_solver_candidate.evaluation}),\n                super::multi_tile_runtime::FinalizedRuntimeTile::Stage3OpenSnow {identity:v,..} => serde_json::json!({\n                    \"variant\":\"open_snow_owned_by_stage3\",\"identity\":identity(v)}),\n            }\n        }\n        let tiles: Vec<_> = match &self.physical {\n            CoveredV8PhysicalOwner::Legacy(v) => vec![covered(v.final_tile())],\n            CoveredV8PhysicalOwner::MultiTile(v) => v.finalized_tiles().iter().map(tile).collect(),\n            CoveredV8PhysicalOwner::FrozenLitterV3 {fixed,..} => {\n                let mut rows: Vec<_> = fixed.legacy_tiles.iter().map(tile).collect();\n                for v in &fixed.frozen_litter_tiles {\n                    let c = &v.fixed_final.complete_physical_candidate;\n                    rows.push(serde_json::json!({\"variant\":\"native_covered_litter\",\"identity\":identity(&c.identity),\n                        \"evaluation\":v.fixed_final.accepted_fixed_final.evaluation,\n                        \"occupancies\":c.energy_operands.occupancies,\"canopy_air\":c.energy_operands.canopy_air,\n                        \"shortwave\":c.energy_operands.shortwave,\"longwave\":c.energy_operands.longwave,\n                        \"litter_surface\":c.energy_operands.litter_surface,\"vegetation_operands\":c.vegetation_operands}));\n                }\n                for v in &fixed.open_litter_tiles {\n                    rows.push(serde_json::json!({\"variant\":\"native_open_litter\",\"identity\":identity(&v.fixed_final.identity),\n                        \"evaluation\":v.fixed_final.accepted_fixed_final}));\n                }\n                rows\n            }\n        };\n        let problem_row = |id: &openwepp_land_surface_energy::RuntimeTileIdentity, problem: &openwepp_land_surface_energy::OpenSurfaceProblem| serde_json::json!({\n            \"ofe_id\":id.ofe_id,\"tile_id\":id.tile_id,\"transaction_id\":id.transaction_id,\"soil_transaction_id\":id.soil_thermal_transaction_id,\n            \"interval_s\":id.interval_s,\"beginning_soil_thermal_state_sha256\":id.beginning_soil_thermal_state_sha256,\"ground_problem\":problem});\n        let problem_inputs: Vec<_> = match &self.physical {\n            CoveredV8PhysicalOwner::Legacy(v) => vec![problem_row(v.potential().identity(), &v.potential().accuracy_observation_beginning().ground)],\n            CoveredV8PhysicalOwner::MultiTile(v) => v.potential_tiles().iter().filter_map(|v| {\n                match v {\n                    super::multi_tile_runtime::PotentialTilePhase::Open {phase,..} => Some(problem_row(&phase.identity,phase.accuracy_observation_beginning())),\n                    super::multi_tile_runtime::PotentialTilePhase::Covered {phase,..} => Some(problem_row(phase.identity(),&phase.accuracy_observation_beginning().ground)),\n                    super::multi_tile_runtime::PotentialTilePhase::Stage3OpenSnow {..} => None,\n                }\n            }).collect(),\n            CoveredV8PhysicalOwner::FrozenLitterV3 {fixed,..} => fixed.accuracy_problem_inputs.clone(),\n        };\n        let soil_children: Vec<_> = self.hydrology().pre_ingress_soil_thermal_candidates().iter().map(|v| serde_json::json!({\n            \"ofe_id\":v.ofe_id,\"tile_id\":v.tile_id,\"beginning_state_sha256\":v.beginning_state_sha256,\"beginning_identity\":v.beginning_identity})).collect();\n        serde_json::json!({\"tiles\":tiles,\"problem_inputs\":problem_inputs,\"soil_children\":soil_children})\n    }\n}","suggestion_applicability":"MachineApplicable","text":[{"highlight_end":2,"highlight_start":2,"text":"}"}]},{"byte_end":110869,"byte_start":105641,"column_end":2,"column_start":2,"expansion":null,"file_name":"crates/openwepp-hillslope-orchestrator/src/land_surface_energy_shadow/covered_v8_owner.rs","is_primary":true,"la