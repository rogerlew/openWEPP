+pub(super) fn restore(value: &Value) -> Result<crate::DirectRunConstructorInputs, String> {
+    let identity = value
+        .get("identity")
+        .ok_or("constructor identity missing")?;
+    let identity = crate::DirectRunIdentity::new(
+        field(identity, "run_id")?,
+        field(identity, "hillslope_id")?,
+        field(identity, "lane_count")?,
+        field(identity, "day_count")?,
+    )
+    .map_err(|error| error.to_string())?;
+    let phase_plan = crate::DirectPhasePlan::default();
+    let captured_ranks: Vec<usize> = field(value, "phase_plan_ranks")?;
+    let canonical_ranks = phase_plan
+        .phases()
+        .iter()
+        .map(|phase| phase.rank())
+        .collect::<Vec<_>>();
+    if captured_ranks != canonical_ranks {
+        return Err("captured constructor phase plan differs from canonical ordered plan".into());
+    }
+    let lanes = value
+        .get("lanes")
+        .and_then(Value::as_array)
+        .ok_or("constructor lanes missing")?
+        .iter()
+        .map(lane)
+        .collect::<Result<Vec<_>, _>>()?;
+    let restored = crate::DirectRunConstructorInputs {
+        identity,
+        lanes,
+        phase_plan,
+    };
+    if super::capture_direct_run_constructor_inputs(&restored) != *value {
+        return Err("constructor inverse canonical recapture mismatch".into());
+    }
+    Ok(restored)
+}
