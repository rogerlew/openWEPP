+    #[test]
+    fn terminal_event_tail_is_the_effective_ending_and_chronology_poisons_reject() {
+        // SC-COUPLEDTIME-001 sections 6, 8, and 9 admit a zero-duration
+        // handoff at a positive support endpoint.  The replayed event tail,
+        // rather than that support's local ending owner, is therefore the
+        // effective archive endpoint.
+        let supports = [support(22, 7, 0, 10, 1, 2)];
+        assert_eq!(
+            validate_accepted_publication_chronology_v1(&supports, &[])
+                .expect("no terminal event preserves support endpoint"),
+            Some(Digest32::from_bytes([2; 32])),
+        );
+        let one = [event(7, 10, 0, 2, 3)];
+        assert_eq!(
+            validate_accepted_publication_chronology_v1(&supports, &one)
+                .expect("one terminal event advances archive endpoint"),
+            Some(Digest32::from_bytes([3; 32])),
+        );
+        let multiple = [event(7, 10, 0, 2, 3), event(7, 10, 1, 3, 4)];
+        assert_eq!(
+            validate_accepted_publication_chronology_v1(&supports, &multiple)
+                .expect("multiple terminal events advance archive endpoint in order"),
+            Some(Digest32::from_bytes([4; 32])),
+        );
+        assert!(
+            validate_accepted_publication_chronology_v1(&supports, &[event(7, 10, 1, 2, 3)],)
+                .is_err(),
+            "wrong terminal ordinal",
+        );
+        assert!(
+            validate_accepted_publication_chronology_v1(&supports, &[event(7, 11, 0, 2, 3)],)
+                .is_err(),
+            "wrong terminal tick",
+        );
+        assert!(
+            validate_accepted_publication_chronology_v1(&supports, &[event(8, 10, 0, 2, 3)],)
+                .is_err(),
+            "foreign terminal parent",
+        );
+        assert!(
+            validate_accepted_publication_chronology_v1(&supports, &[multiple[1], multiple[0]])
+                .is_err(),
+            "reordered terminal events",
         );
