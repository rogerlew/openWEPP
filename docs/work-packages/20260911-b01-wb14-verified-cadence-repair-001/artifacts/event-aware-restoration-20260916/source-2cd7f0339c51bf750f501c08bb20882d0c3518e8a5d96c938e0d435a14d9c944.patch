+pub(crate) fn diagnostic_restore_coupled_subslab_receipts_value_v2(
+    value: serde_json::Value,
+) -> Result<Vec<Stage3CoupledSubslabReceiptV1>, String> {
+    let rows: Vec<Stage3CoupledSubslabReceiptWireV2> =
