+                .map(|span| (span.label, span.support_duration_ns))
+                .collect::<Vec<_>>()
+        };
+    assert_eq!(
+        performance_topology(&expected.5),
+        performance_topology(&actual.5),
+        "recorder changed controller evaluation topology",
+    );
+    let topology = |captures: &[AcceptedPublicationCaptureAuditV1]| {
+        captures
+            .iter()
+            .map(|capture| (capture.support, capture.regime))
+            .collect::<Vec<_>>()
+    };
