+fn assert_legacy_single_lane_terminal_fixture(result: &CompleteWb14CadenceFixtureResultV1) {
+    // The parent returns retained custody evidence, not pending custody. One terminal event occurs at 540 seconds and its produced parcel is consumed by the immediately following receiver support.
+    assert_eq!(result.event_groups.len(), 1);
+    let group = &result.event_groups[0];
+    assert_eq!(group.tick, ModelTimeNs::new(540_000_000_000));
+    let accepted_event = group
+        .accepted_event_receipt
+        .as_ref()
+        .expect("accepted terminal event evidence");
+    assert_eq!(accepted_event.tick(), group.tick);
+    assert_eq!(result.terminal_parcels.len(), 1);
+    let parcel = &result.terminal_parcels[0];
+    assert_eq!(
+        parcel.posture,
+        crate::snow_stage3_v11_attachment::DirectSnowStage3V11TerminalParcelPosture::Consumed
+    );
+    assert!(
+        group
+            .produced_unconsumed_parcel_digests
+            .contains(&parcel.parcel_digest)
+    );
+}
