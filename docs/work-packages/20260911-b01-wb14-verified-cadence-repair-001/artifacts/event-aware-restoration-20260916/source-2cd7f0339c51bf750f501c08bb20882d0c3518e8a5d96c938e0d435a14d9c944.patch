+        .accepted_event_receipt
+        .as_ref()
+        .expect("native terminal event receipt");
+    assert_eq!(accepted_event.tick(), group.tick);
+    assert_eq!(fixture.terminal_parcels.len(), 1);
+    let parcel = &fixture.terminal_parcels[0];
+    assert_eq!(
+        parcel.posture,
+        crate::snow_stage3_v11_attachment::DirectSnowStage3V11TerminalParcelPosture::Consumed
+    );
+    assert!(
+        group
+            .produced_unconsumed_parcel_digests
+            .contains(&parcel.parcel_digest)
+    );
+    assert!(!fixture.subslabs.is_empty());
+    assert_eq!(
+        fixture.subslabs[0].support.start_ns(),
+        openwepp_coupled_time::ModelTimeNs::new(0)
+    );
+    assert!(fixture.subslabs.iter().all(|receipt| {
+        receipt.lane_receipts.len() == 1 && receipt.lane_receipts.contains_key(&1)
+    }));
+    assert!(
+        fixture
+            .subslabs
+            .windows(2)
+            .all(|pair| pair[0].support.end_ns() == pair[1].support.start_ns())
+    );
+    assert_eq!(
+        fixture
+            .subslabs
+            .last()
+            .expect("terminal native subslab")
+            .support
+            .end_ns(),
+        group.tick
+    );
+    let first_successor = fixture
+        .snow_free_successor_receipts
+        .first()
+        .expect("first snow-free successor receipt");
+    assert_eq!(first_successor.successor_ordinal, 0);
+    assert_eq!(first_successor.support.start_ns(), group.tick);
+    assert_eq!(
+        first_successor.beginning_complete_owner_set_sha256,
+        accepted_event.ending_owner_set_digest()
+    );
+    assert!(first_successor.receiver_pending);
+    assert_ne!(
+        first_successor.beginning_pending_terminal_parcel_set_sha256,
+        first_successor.ending_pending_terminal_parcel_set_sha256
+    );
+    assert!(fixture.snow_free_successor_receipts.windows(2).all(|pair| {
+        pair[0].successor_ordinal + 1 == pair[1].successor_ordinal
+            && pair[0].support.end_ns() == pair[1].support.start_ns()
+            && pair[0].ending_complete_owner_set_sha256
