+pub(crate) fn diagnostic_coupled_subslab_receipts_value_v2(
+    receipts: &[Stage3CoupledSubslabReceiptV1],
+) -> Result<serde_json::Value, String> {
+    serde_json::to_value(Stage3CoupledSubslabReceiptsWireRefV2(receipts))
