+fn restore_native_result(
+    target: &Value,
+    context: &NativeRestorationContext<'_>,
+    inputs: crate::DirectRunConstructorInputs,
+    surface: &crate::DirectSurfaceLiquidConfiguration,
+    position: u128,
+    position_matches: bool,
+    gsi_matches: bool,
+) -> Result<(), String> {
+    let native = required(target, "native_consumer_constructor_operands")?;
+    let pin = context.pin;
+    let day = context.day;
+    let clock_parent = context.clock_parent;
+    let provider_configuration = context.provider_configuration;
+    let frame = restore_direct_run_frame_dynamic(
+        decode(required(
+            target,
+            "native_hydrology_frame_dynamic_constructor_operands",
+        )?)?,
+        inputs.clone(),
+        surface,
+    )?;
+    println!(
+        "composed immutable operands, current/deferred phase and provisional checks PASS; invoking canonical native constructor with original unadmitted position/GSI operands"
+    );
+    let native_result = DirectV10RealConsumerShadow::diagnostic_restore_native_consumer_v1(
+        native,
+        decode(required(target, "native_soil_v2_constructor_operands")?)?,
+        decode(required(
+            day,
+            "native_committed_bootstrap_soil_v2_constructor_operands",
+        )?)?,
+        decode(required(target, "native_lane_map_constructor_operands")?)?,
+        &clock_parent.clock,
+        frame,
+        surface,
+        &pin.lse,
+        &pin.lse,
+        provider_configuration,
+        std::sync::Arc::new(inputs),
+    )
+    .map_err(|error| format!("canonical native constructor refusal: {error}"));
+    println!(
+        "canonical native constructor: {}",
+        match &native_result {
+            Ok(_) => "accepted original operands".to_owned(),
+            Err(error) => error.clone(),
+        }
+    );
+    let consumer = match (native_result, position_matches && gsi_matches) {
+        (Err(error), false) => {
+            return Err(format!(
+                "reader position/GSI joins refused (outer={position}, captured={}, gsi_matches={gsi_matches}); {error}",
+                native["accepted_interval_count"]
+            ));
+        }
+        (Err(error), true) => return Err(error),
+        (Ok(_), false) => {
+            return Err(format!(
+                "reader position/GSI joins refused (outer={position}, captured={}, gsi_matches={gsi_matches}); canonical native constructor accepted original operands",
+                native["accepted_interval_count"]
+            ));
+        }
+        (Ok(consumer), true) => consumer,
+    };
+    let expected: BTreeMap<String, Vec<u8>> =
+        decode(required(target, "complete_owner_canonical_bytes")?)?;
+    if consumer
+        .canonical_v11_parent_owner_state_bytes()
+        .map_err(|error| error.to_string())?
+        != expected
+    {
+        return Err("native six-owner projection".into());
+    }
+    Ok(())
+}
