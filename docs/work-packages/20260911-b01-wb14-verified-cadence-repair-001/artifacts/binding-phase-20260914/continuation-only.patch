+    fn assert_bound_native_destinations_materialized(
+        attachment: &crate::DirectSnowStage3V11ShadowAttachment,
+        prepared: &crate::DirectSnowStage3V11PreparedDay,
+        interval_template: &DirectV9ShadowIntervalInput,
+        day_index: usize,
+    ) {
+        assert_eq!(interval_template.wb14_parameters.len(), 1);
+        let lane_ofe = &interval_template.wb14_parameters[0].ofe_id;
+        let configured_ofe = attachment
+            .committed
+            .real_consumer
+            .lse_configuration()
+            .ofes
+            .iter()
+            .find(|ofe| &ofe.ofe_id == lane_ofe)
+            .expect("native fixture bound lane/OFE configuration");
+        let expected_destinations = configured_ofe
+            .tiles
+            .iter()
+            .map(|tile| (configured_ofe.ofe_id.clone(), tile.tile_id.clone()))
+            .collect::<BTreeSet<_>>();
+
+        for (support_index, support) in prepared.supports().iter().enumerate() {
+            let bounds = support.support();
+            let (_, _, _, _, _, _, materialized, _) = support
+                .diagnostic_capture_parts_v1()
+                .unwrap_or_else(|error| {
+                    panic!(
+                        "native fixture bound destination diagnostics on day {day_index} support {support_index} [{}..{}): {error}",
