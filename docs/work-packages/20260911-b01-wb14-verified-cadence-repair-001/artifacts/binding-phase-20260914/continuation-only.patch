+                        bounds.end_ns().get()
+                    )
+                });
+            let actual_destinations = materialized.keys().cloned().collect::<BTreeSet<_>>();
+            let missing_destinations = expected_destinations
+                .difference(&actual_destinations)
+                .cloned()
+                .collect::<BTreeSet<_>>();
+            let extra_destinations = actual_destinations
+                .difference(&expected_destinations)
+                .cloned()
+                .collect::<BTreeSet<_>>();
+            assert!(
+                missing_destinations.is_empty() && extra_destinations.is_empty(),
+                "native fixture bound materialized destinations on day {day_index} support {support_index} [{}..{}): missing={missing_destinations:?} extra={extra_destinations:?}",
+                bounds.start_ns().get(),
+                bounds.end_ns().get()
+            );
+        }
