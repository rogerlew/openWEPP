+fn run_with_pre_child_recorder(
+    mode: crate::snow_stage3_v11_current_context_capture::PreChildRecorderTestModeV1,
+    snow_free_successor: bool,
+) -> (
+    AdaptiveProductionOutcomeV1,
+    crate::snow_stage3_v11_current_context_capture::PreChildRecorderTestAuditV1,
+) {
+    std::thread::Builder::new()
+        .name("adaptive-pre-child-recorder".to_owned())
+        .stack_size(64 * 1024 * 1024)
+        .spawn(move || {
+            use crate::v9_real_consumer_shadow::v11_covered::CanonicalCoveredPhysicalParityCaseV1 as Case;
+
+            CANONICAL_PARITY_CASE.with(|slot| slot.set(Some(Case::NativeMixedPhase)));
+            crate::snow_stage3_v11_current_context_capture::begin_pre_child_recorder_test_audit_v1(
+                mode,
+            );
+            let outcome = if snow_free_successor {
+                SHORT_SUPPORT_DURATION_NS.with(|value| value.set(1_800_000_000_000));
+                run_complete_owner_on_large_stack(
+                    0.000_6,
+                    Some(60_000_000_000),
+                    None,
+                    true,
+                    AdaptiveControllerTestPolicyV1::default(),
+                    false,
+                )
+            } else {
+                SHORT_SUPPORT_DURATION_NS.with(|value| value.set(60_000_000_000));
+                run_complete_owner_on_large_stack(
+                    0.02,
+                    None,
+                    None,
+                    false,
+                    AdaptiveControllerTestPolicyV1::default(),
+                    true,
+                )
+            };
+            let audit = crate::snow_stage3_v11_current_context_capture::
+                take_pre_child_recorder_test_audit_v1();
+            (outcome, audit)
+        })
+        .expect("spawn pre-child recorder production fixture")
+        .join()
+        .expect("join pre-child recorder production fixture")
+}
