+fn assert_recorder_preserved_model_result(
+    expected: &AdaptiveProductionOutcomeV1,
+    actual: &AdaptiveProductionOutcomeV1,
+) {
+    assert_eq!(
+        serde_json::to_vec(&expected.0).expect("expected receipt bytes"),
+        serde_json::to_vec(&actual.0).expect("actual receipt bytes"),
+        "recorder changed adaptive receipt/proof work",
+    );
+    assert_eq!(expected.1, actual.1, "recorder changed physical supports");
+    assert_eq!(expected.2, actual.2, "recorder changed terminal result");
+    assert_eq!(
+        expected.4, actual.4,
+        "recorder changed complete owner state"
+    );
+    assert_eq!(
+        expected.6, actual.6,
+        "recorder changed comparison proof work"
+    );
+    let topology = |captures: &[AcceptedPublicationCaptureAuditV1]| {
+        captures
+            .iter()
+            .map(|capture| (capture.support, capture.regime))
+            .collect::<Vec<_>>()
+    };
+    assert_eq!(
+        topology(&expected.3),
+        topology(&actual.3),
+        "recorder changed publication topology",
+    );
+}
