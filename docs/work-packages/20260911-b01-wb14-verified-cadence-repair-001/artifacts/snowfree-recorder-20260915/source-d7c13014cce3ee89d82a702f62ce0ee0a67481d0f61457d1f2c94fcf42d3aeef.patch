+                .map_err(|error| error.to_string())
+        })
+        .collect::<Result<BTreeMap<_, _>, _>>()?;
+    Ok(serde_json::json!({
+        "support": support.support(),
+        "active_snow_by_lane": active,
+        "support_forcing_by_lane": forcing,
+        "snow_free_interval": snow_free,
