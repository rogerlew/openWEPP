+    beginning
+        .install_frozen_litter_v4_resident(physical, exact_surface_owner)
+        .expect("host-bound native V3/V4 resident installation");
+    let physical = beginning
+        .frozen_litter_v3_resident()
+        .expect("installed native V3 resident")
+        .clone();
+    let exact = beginning
+        .frozen_litter_v4_resident()
+        .expect("installed native V4 resident")
+        .clone();
+    let soil_beginning = beginning
+        .inner
+        .soil_thermal
+        .prepare_unpublished_physical_beginning_v2(
