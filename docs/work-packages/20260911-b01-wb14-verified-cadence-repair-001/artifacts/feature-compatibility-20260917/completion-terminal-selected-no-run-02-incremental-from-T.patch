+        (audit.promotion_entry_count, audit.promotion_success_count),
+        promotion
+    );
+    assert_eq!(
+        (
+            audit.projection_promotion_entry_count,
+            audit.projection_promotion_success_count
+        ),
+        projection
+    );
+    assert_eq!(
+        audit.candidate_only_promotion_entry_count,
+        candidate_only_entries
+    );
