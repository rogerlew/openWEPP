+fn assert_integrated_promotion_case_stages_v1(
+    case_name: &str,
+    audit: crate::v9_real_consumer_shadow::IntegratedPromotionBoundaryAuditV1,
+    final_replay: (u32, u32),
+    promotion: (u32, u32),
