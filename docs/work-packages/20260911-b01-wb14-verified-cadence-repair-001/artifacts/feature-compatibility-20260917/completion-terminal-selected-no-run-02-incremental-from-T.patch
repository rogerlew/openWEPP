+                        value.native_physical_audit,
+                        value.carrier_live_audit,
+                    );
+                    (value, promotion_audit)
+                }
+                Err(panic) => {
+                    let promotion_audit = crate::v9_real_consumer_shadow::
+                        take_integrated_promotion_boundary_audit_v1();
+                    let native_physical = crate::v9_real_consumer_shadow::
+                        take_covered_native_physical_path_audit_v1();
