+fn native_mixed_phase_fixture_reaches_deferred_v4_promotion_boundary() {
+    let (value, promotion_audit) = std::thread::Builder::new()
+        .name("native-mixed-phase-integrated-promotion".to_owned())
+        .stack_size(64 * 1024 * 1024)
+        .spawn(|| {
+            use crate::v9_real_consumer_shadow::v11_covered::CanonicalCoveredPhysicalParityCaseV1 as Case;
