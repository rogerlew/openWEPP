+fn assert_native_mixed_phase_integrated_promotion_v1(
+    value: &NativeMixedPhaseFixtureOutcomeV1,
+    promotion_audit: crate::v9_real_consumer_shadow::IntegratedPromotionBoundaryAuditV1,
+) {
+    assert_eq!(
+        value.fixture.fixture_inputs["parity_profile"],
+        "native-mixed-phase"
+    );
+    assert_eq!(
+        value.fixture.fixture_inputs["hard_boundary_ns"],
+        serde_json::json!(60_000_000_000_u128)
+    );
+    assert_eq!(
+        value.production.0.parent_support,
+        openwepp_coupled_time::TimeSupport::new(
+            openwepp_coupled_time::ModelTimeNs::new(0),
+            openwepp_coupled_time::ModelTimeNs::new(1_800_000_000_000)
+        )
+        .expect("native parent support")
+    );
+    assert!(value.fixture.beginning_native_v3_resident_present);
+    assert!(value.fixture.beginning_native_v4_resident_present);
+    assert_ne!(
+        value.fixture.beginning_complete_owner_canonical_bytes,
+        value.fixture.ending_complete_owner_canonical_bytes,
+        "successful native mixed-phase execution installs a changed selected complete owner set"
+    );
+    assert_ne!(
+        value.fixture.beginning_parent_checkpoint_canonical_json,
+        value.fixture.ending_parent_checkpoint_canonical_json,
+        "successful execution advances the selected parent identity"
+    );
+    assert_eq!(value.fixture.finalized_accepted_segment_count, 8);
+    assert_eq!(promotion_audit.deferred_completion_count, 1);
+    assert_eq!(promotion_audit.v4_runtime_entry_count, 2);
+    assert_eq!(promotion_audit.v4_runtime_success_count, 2);
+    assert_eq!(promotion_audit.final_replay_entry_count, 1);
+    assert_eq!(promotion_audit.final_replay_success_count, 1);
+    assert_eq!(promotion_audit.promotion_attempt_count, 1);
+    assert_eq!(promotion_audit.promotion_entry_count, 1);
+    assert_eq!(promotion_audit.promotion_success_count, 1);
+    assert_eq!(promotion_audit.projection_promotion_entry_count, 1);
+    assert_eq!(promotion_audit.projection_promotion_success_count, 1);
+    assert_eq!(
+        promotion_audit.promotion_entry_count, promotion_audit.candidate_only_promotion_entry_count,
+        "only candidate-only V4 custody may enter deferred promotion"
+    );
+    assert_eq!(
+        value
+            .native_physical_audit
+            .snow_free_litter_physics_call_count,
+        0
+    );
+    assert_eq!(
+        value
+            .native_physical_audit
+            .snow_free_surface_physics_call_count,
+        0
+    );
+    assert_eq!(
+        value
+            .native_physical_audit
+            .snow_free_wb14_physics_call_count,
+        0
+    );
+    assert_eq!(promotion_audit.snow_free_litter_low_level_count, 2);
+    assert_eq!(promotion_audit.snow_free_surface_low_level_count, 2);
+    assert_eq!(promotion_audit.snow_free_wb14_low_level_count, 3);
