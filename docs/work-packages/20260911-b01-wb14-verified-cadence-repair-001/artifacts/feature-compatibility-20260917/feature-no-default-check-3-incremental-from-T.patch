+#[cfg(test)]
+fn assert_integrated_promotion_install_v1(
+    value: &DirectV10RealConsumerShadow,
+    before: &IntegratedPromotionInstallBeforeV1,
+    accepted: &crate::land_surface_energy_shadow::v3_execution::AcceptedFrozenLitterV4RuntimeCandidate,
+    beginning_physical: &FrozenLitterV3Resident,
+) -> Result<(), DirectV10RealConsumerError> {
+    assert_eq!(
+        before.non_v_debug,
+        integrated_promotion_non_v_debug_v1(value),
+        "promotion changes only V3/V4 residents"
+    );
+
+    let installed_v3 = value.frozen_litter_v3.as_ref().expect("installed V3");
+    let v3_after = installed_v3.accepted_publication_supports_canonical_bytes()?;
+    assert_eq!(v3_after.len(), before.v3_publications.len() + 1);
+    assert_eq!(
+        &v3_after[..before.v3_publications.len()],
+        before.v3_publications.as_slice()
+    );
+
+    let installed_v4 = value.frozen_litter_v4.as_ref().expect("installed V4");
+    let v4_after = installed_v4
+        .accepted_publication_supports_canonical_bytes()
+        .to_vec();
+    assert_eq!(v4_after.len(), before.v4_publications.len() + 1);
+    assert_eq!(
+        &v4_after[..before.v4_publications.len()],
+        before.v4_publications.as_slice()
+    );
+    assert_eq!(
+        v4_after.last(),
+        Some(&accepted.complete_owner_projection_canonical_bytes),
+        "V4 history appends the accepted canonical projection bytes"
+    );
+
+    assert_eq!(
+        installed_v3.surface_owner(),
+        &accepted.physical.ending_surface_owner
+    );
+    assert_eq!(
+        installed_v3.lse_state(),
+        &accepted.physical.ending_lse_state
+    );
+    assert_eq!(
+        installed_v4.exact_surface_owner(),
+        &accepted.ending_exact_surface_owner
+    );
+
+    let publication: serde_json::Value =
+        serde_json::from_slice(v3_after.last().expect("appended V3 publication bytes"))
+            .expect("V3 publication canonical JSON");
+    let projection = &accepted.physical.complete_owner_projection;
+    assert_eq!(
+        publication["canonical_projection_bytes"],
+        serde_json::json!(projection.canonical_bytes(beginning_physical.surface_configuration())?)
+    );
+    assert_eq!(
+        publication["projection_sha256"],
+        serde_json::json!(projection.projection_sha256())
+    );
+    assert_eq!(
+        publication["projection_receipt_chain_sha256"],
+        serde_json::json!(projection.identity().receipt_chain_sha256)
+    );
+    assert_eq!(
+        installed_v3.predecessor_receipt_chain_sha256(),
+        projection.identity().receipt_chain_sha256
+    );
+    assert_eq!(
+        installed_v3.wb14_parent(),
+        accepted.physical.ingress.parent_working_state()
+    );
+
+    super::record_integrated_promotion_boundary_v1("promotion-success", true);
+    let resident = value.inner.soil_thermal.v2()?;
+    println!(
+        "B01_INTEGRATED_INSTALLED {}",
+        serde_json::to_string(&serde_json::json!({
+            "soil_owner": resident.owner(),
+            "soil_latest_accepted": resident.latest_accepted(),
+            "v3_publication_support_bytes": value.frozen_litter_v3.as_ref()
+                .map(FrozenLitterV3Resident::accepted_publication_supports_canonical_bytes)
+                .transpose()?,
+            "v3_restart_parent_bytes": value.frozen_litter_v3.as_ref()
+                .map(FrozenLitterV3Resident::restart_wb14_parent_working_state_bytes)
+                .transpose()?,
+            "v4_publication_support_bytes": value.frozen_litter_v4.as_ref()
+                .map(integrated_promotion_v4_publication_bytes_v1),
+        }))
+        .expect("integrated installed JSON")
+    );
+    Ok(())
 }
 
