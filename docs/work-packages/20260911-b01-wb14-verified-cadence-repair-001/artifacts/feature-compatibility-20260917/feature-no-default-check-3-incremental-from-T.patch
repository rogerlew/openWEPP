+#[cfg(test)]
+struct IntegratedPromotionInstallBeforeV1 {
+    non_v_debug: String,
+    v3_publications: Vec<Vec<u8>>,
+    v4_publications: Vec<Vec<u8>>,
+}
+
+#[cfg(test)]
+fn integrated_promotion_non_v_debug_v1(value: &DirectV10RealConsumerShadow) -> String {
+    format!(
+        "{:?}",
+        (
+            &value.inner,
+            &value.vegetation_configuration,
+            &value.vegetation_state,
+            &value.lse_configuration,
+            &value.lse_state,
+            &value.gsi_owner_configuration,
+            &value.gsi_state,
+            &value.provider_static_configuration,
+            &value.provider_cursor,
+            &value.root_zone_hydraulic_configuration,
+            &value.accepted_publication_history,
+        )
+    )
+}
+
+#[cfg(test)]
+fn integrated_promotion_v4_publication_bytes_v1(resident: &FrozenLitterV4Resident) -> Vec<Vec<u8>> {
+    resident
+        .accepted_publication_supports_canonical_bytes()
+        .to_vec()
+}
+
+#[cfg(test)]
+fn capture_integrated_promotion_install_before_v1(
+    value: &DirectV10RealConsumerShadow,
+) -> Result<Option<IntegratedPromotionInstallBeforeV1>, DirectV10RealConsumerError> {
+    if !super::integrated_promotion_boundary_audit_enabled_v1() {
+        return Ok(None);
+    }
+    let v3_publications = value
+        .frozen_litter_v3
+        .as_ref()
+        .map(FrozenLitterV3Resident::accepted_publication_supports_canonical_bytes)
+        .transpose()?
+        .unwrap_or_default();
+    let v4_publications = value
+        .frozen_litter_v4
+        .as_ref()
+        .map(integrated_promotion_v4_publication_bytes_v1)
+        .unwrap_or_default();
+    Ok(Some(IntegratedPromotionInstallBeforeV1 {
+        non_v_debug: integrated_promotion_non_v_debug_v1(value),
+        v3_publications,
+        v4_publications,
+    }))
+}
