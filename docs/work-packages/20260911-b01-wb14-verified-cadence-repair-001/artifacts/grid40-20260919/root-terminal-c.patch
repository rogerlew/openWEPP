+#[test]
+fn grid40_shared_strict_fault_control_remains_within_b20() {
+    let column = covered_v8_assembled_column();
+    // This shared control stays inside b0..=20.  It verifies the real
+    // evaluator-fault lifecycle without relying on the treatment-only b21
+    // admission: at 2^-24 the fixed vector first admits b19, and an injected
+    // b19 evaluator error is followed by the ordinary b20 strict candidate.
+    let (shared_fault_column, shared_fault_trial) =
+        grid40_noncaptured_v10_vector_at_exponent(column.clone(), -24);
+    let _grid = crate::solver::grid40_install_strict_decrease_grid(
+        crate::solver::Grid40StrictDecreaseGrid::Treatment,
+    );
+    let shared_session =
+        crate::solver::grid40_begin_call_counts(crate::solver::Grid40StrictDecreaseGrid::Treatment);
+    let shared_fault_guard = crate::solver::grid40_force_strict_evaluator_error_for_test(19);
+    let shared_outcome = solve_covered_column(&shared_fault_column, None, shared_fault_trial);
+    let shared_counts = shared_session.finish();
+    assert!(shared_outcome.is_ok());
+    assert_eq!(shared_counts.errors, 1);
+    assert_eq!(shared_counts.accepted_strict_exponents.first(), Some(&20));
+    let shared_terminals = shared_counts
+        .events
+        .iter()
+        .filter(|event| {
+            event.counter_class == "strict" && matches!(event.phase, "error" | "completed")
+        })
+        .map(|event| (event.phase, event.strict_exponent))
+        .collect::<Vec<_>>();
+    let shared_error = shared_terminals
+        .iter()
+        .position(|terminal| *terminal == ("error", Some(19)))
+        .expect("the shared b19 injected error is terminally recorded");
+    let shared_complete = shared_terminals
+        .iter()
+        .position(|terminal| *terminal == ("completed", Some(20)))
+        .expect("the shared b20 completion follows the injected error");
+    assert!(shared_error < shared_complete);
+    assert!(shared_counts.events.iter().any(|event| {
+        event.counter_class == "strict"
+            && event.phase == "error"
+            && event.strict_exponent == Some(19)
+            && event
+                .typed_error
+                .as_deref()
+                .is_some_and(|error| error.contains("NumericalAcceptedResidual"))
+    }));
+    drop(shared_fault_guard);
+}
