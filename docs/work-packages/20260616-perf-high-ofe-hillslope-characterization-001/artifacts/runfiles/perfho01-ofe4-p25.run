schema = "openwepp-hillslope-runfile-v1"
run_name = "perfho01-arboreal-p25-ofe4-without-ui"
unit_system = "metric"

[inputs]
soil = "/tmp/perfho01/run-dirs/ofe4/p25.sol"
management = "/tmp/perfho01/run-dirs/ofe4/p25.man"
slope = "/tmp/perfho01/run-dirs/ofe4/p25.slp"
climate = "/tmp/perfho01/run-dirs/ofe4/p25.cli"
wepp_ui = false
pmetpara = "/tmp/perfho01/run-dirs/ofe4/pmetpara.txt"

[outputs]
pass = "/tmp/perfho01/outputs/ofe4/H25.hbp"
loss = "/tmp/perfho01/outputs/ofe4/H25.loss.json"
pass_parquet = "/tmp/perfho01/outputs/ofe4/H25.pass.parquet"
wat = "/tmp/perfho01/outputs/ofe4/H25.wat.parquet"
plot = "/tmp/perfho01/outputs/ofe4/H25.plot.parquet"
