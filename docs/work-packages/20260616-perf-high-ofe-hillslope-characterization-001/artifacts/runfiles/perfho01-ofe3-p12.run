schema = "openwepp-hillslope-runfile-v1"
run_name = "perfho01-arboreal-p12-ofe3-without-ui"
unit_system = "metric"

[inputs]
soil = "/tmp/perfho01/run-dirs/ofe3/p12.sol"
management = "/tmp/perfho01/run-dirs/ofe3/p12.man"
slope = "/tmp/perfho01/run-dirs/ofe3/p12.slp"
climate = "/tmp/perfho01/run-dirs/ofe3/p12.cli"
wepp_ui = false
pmetpara = "/tmp/perfho01/run-dirs/ofe3/pmetpara.txt"

[outputs]
pass = "/tmp/perfho01/outputs/ofe3/H12.hbp"
loss = "/tmp/perfho01/outputs/ofe3/H12.loss.json"
pass_parquet = "/tmp/perfho01/outputs/ofe3/H12.pass.parquet"
wat = "/tmp/perfho01/outputs/ofe3/H12.wat.parquet"
plot = "/tmp/perfho01/outputs/ofe3/H12.plot.parquet"
