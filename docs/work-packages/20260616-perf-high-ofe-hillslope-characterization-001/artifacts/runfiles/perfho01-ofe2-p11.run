schema = "openwepp-hillslope-runfile-v1"
run_name = "perfho01-arboreal-p11-ofe2-without-ui"
unit_system = "metric"

[inputs]
soil = "/tmp/perfho01/run-dirs/ofe2/p11.sol"
management = "/tmp/perfho01/run-dirs/ofe2/p11.man"
slope = "/tmp/perfho01/run-dirs/ofe2/p11.slp"
climate = "/tmp/perfho01/run-dirs/ofe2/p11.cli"
wepp_ui = false
pmetpara = "/tmp/perfho01/run-dirs/ofe2/pmetpara.txt"

[outputs]
pass = "/tmp/perfho01/outputs/ofe2/H11.hbp"
loss = "/tmp/perfho01/outputs/ofe2/H11.loss.json"
pass_parquet = "/tmp/perfho01/outputs/ofe2/H11.pass.parquet"
wat = "/tmp/perfho01/outputs/ofe2/H11.wat.parquet"
plot = "/tmp/perfho01/outputs/ofe2/H11.plot.parquet"
