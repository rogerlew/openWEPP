schema = "openwepp-hillslope-runfile-v1"
run_name = "perfho01-arboreal-p15-ofe1-without-ui"
unit_system = "metric"

[inputs]
soil = "/tmp/perfho01/run-dirs/ofe1/p15.sol"
management = "/tmp/perfho01/run-dirs/ofe1/p15.man"
slope = "/tmp/perfho01/run-dirs/ofe1/p15.slp"
climate = "/tmp/perfho01/run-dirs/ofe1/p15.cli"
wepp_ui = false
pmetpara = "/tmp/perfho01/run-dirs/ofe1/pmetpara.txt"

[outputs]
pass = "/tmp/perfho01/outputs/ofe1/H15.hbp"
loss = "/tmp/perfho01/outputs/ofe1/H15.loss.json"
pass_parquet = "/tmp/perfho01/outputs/ofe1/H15.pass.parquet"
wat = "/tmp/perfho01/outputs/ofe1/H15.wat.parquet"
plot = "/tmp/perfho01/outputs/ofe1/H15.plot.parquet"
