+struct CostedLivePreparedSupportDrop(Option<DirectSnowStage3V11PreparedSupport>);
+
+impl CostedLivePreparedSupportDrop {
+    fn new(support: DirectSnowStage3V11PreparedSupport) -> Self {
+        Self(Some(support))
+    }
+}
+
+impl std::ops::Deref for CostedLivePreparedSupportDrop {
+    type Target = DirectSnowStage3V11PreparedSupport;
+
+    fn deref(&self) -> &Self::Target {
+        match &self.0 {
+            Some(support) => support,
+            None => unreachable!(),
+        }
+    }
+}
+
+impl std::ops::DerefMut for CostedLivePreparedSupportDrop {
+    fn deref_mut(&mut self) -> &mut Self::Target {
+        match &mut self.0 {
+            Some(support) => support,
+            None => unreachable!(),
+        }
+    }
+}
+
+impl Drop for CostedLivePreparedSupportDrop {
+    fn drop(&mut self) {
+        let _cost = openwepp_land_surface_energy::solver_mechanism_audit::compact_cost::scope(
+            openwepp_land_surface_energy::solver_mechanism_audit::compact_cost::Bucket::LivePreparedSupportDrop,
+        );
+        drop(self.0.take());
+    }
+}
