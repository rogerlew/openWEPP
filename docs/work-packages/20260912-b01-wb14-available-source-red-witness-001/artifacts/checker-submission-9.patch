+    for i in (0, 1): blob(p, i, "beginning_typed_bytes", lambda x: x["continuations"][0].__setitem__(field, value))
+    blob(p, 1, "working_typed_bytes", lambda x: x["continuations"][0].__setitem__(field, value))
+    def owner(x):
