+        Some(CoveredFullTrialNoUpdateRefusal::DomainInvalid),
+        true,
+        at
+    ));
+    assert!(!covered_halved_no_update_witness(
+        &[2.0],
+        Some(CoveredFullTrialNoUpdateRefusal::DomainInvalid),
+        true,
+        at
+    ));
+    assert!(!covered_halved_no_update_witness(
+        &[0.5],
+        Some(CoveredFullTrialNoUpdateRefusal::DomainInvalid),
+        false,
+        at
+    ));
+    assert!(!covered_halved_no_update_witness(
+        &[0.5],
+        Some(CoveredFullTrialNoUpdateRefusal::DomainInvalid),
+        true,
+        above
+    ));
+}
