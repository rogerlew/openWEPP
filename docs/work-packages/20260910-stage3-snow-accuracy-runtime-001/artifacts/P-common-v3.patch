+//! Isolated experiment observation; never installed in primary runtime source.
+use serde_json::Value;
+use std::cell::RefCell;
+use std::collections::BTreeMap;
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicBool, Ordering};
+static PHYSICAL: AtomicBool = AtomicBool::new(false);
+static LEDGER_OVERFLOW: AtomicBool = AtomicBool::new(false);
+static LEDGERS: Mutex<BTreeMap<String,Value>> = Mutex::new(BTreeMap::new());
+static POISONED: AtomicBool = AtomicBool::new(false);
+static COUNTS: Mutex<Option<BTreeMap<&'static str, u64>>> = Mutex::new(None);
+
+#[derive(Default)]
+struct Capture {
+    physical: bool,
+    rows: Vec<Value>,
+    overflow: bool,
+}
+thread_local! { static CAPTURE: RefCell<Capture> = RefCell::new(Capture::default()); }
+
+pub fn begin(physical: bool) {
+    POISONED.store(false, Ordering::Relaxed);
+    PHYSICAL.store(physical, Ordering::Relaxed);
+    LEDGER_OVERFLOW.store(false, Ordering::Relaxed);
+    if let Ok(mut ledgers) = LEDGERS.lock() { ledgers.clear(); }
+    else { POISONED.store(true,Ordering::Relaxed); }
+    if let Ok(mut counts) = COUNTS.lock() {
+        *counts = Some(BTreeMap::new());
+    } else {
+        POISONED.store(true, Ordering::Relaxed);
+    }
+    CAPTURE.with(|c| {
+        *c.borrow_mut() = Capture {
+            physical,
+            ..Capture::default()
+        }
+    });
+}
+pub fn physical_enabled() -> bool {
+    CAPTURE.with(|c| c.borrow().physical)
+}
+pub fn count(key: &'static str) {
+    if let Ok(mut slot) = COUNTS.lock() {
+        if let Some(counts) = slot.as_mut() {
+            *counts.entry(key).or_default() += 1;
+        }
+    } else {
+        POISONED.store(true, Ordering::Relaxed);
+    }
+}
+pub fn physical_global_enabled() -> bool { PHYSICAL.load(Ordering::Relaxed) }
+pub fn ledger(key: String, row: Value) {
+    if let Ok(mut ledgers) = LEDGERS.lock() {
+        if let Some(existing) = ledgers.get(&key) {
+            if existing != &row { POISONED.store(true,Ordering::Relaxed); }
+        } else if ledgers.len() < 20_000 { ledgers.insert(key,row); }
+        else { LEDGER_OVERFLOW.store(true,Ordering::Relaxed); }
+    } else { POISONED.store(true,Ordering::Relaxed); }
+}
+pub fn record(row: Value) {
+    CAPTURE.with(|c| {
+        let mut c = c.borrow_mut();
+        if c.rows.len() < 20_000 {
+            c.rows.push(row);
+        } else {
+            c.overflow = true;
+        }
+    });
+}
+pub fn finish() -> Value {
+    CAPTURE.with(|c| {
+        let c = std::mem::take(&mut *c.borrow_mut());
+        serde_json::json!({"schema":"snow_accuracy_observation_v2", "physical_enabled":c.physical, "counts": COUNTS.lock().ok().and_then(|mut slot|slot.take()), "physical": c.rows, "overflow": c.overflow || LEDGER_OVERFLOW.load(Ordering::Relaxed), "physical_ledgers": LEDGERS.lock().ok().map(|mut rows|std::mem::take(&mut *rows)), "counts_poisoned": POISONED.load(Ordering::Relaxed)})
+    })
+}
