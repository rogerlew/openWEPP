+fn snow_accuracy_actual_terminal_conservation_poison() {
+    use openwepp_land_surface_energy::snow_accuracy_policy::Policy;
+    let name = std::env::var("OPENWEPP_ACCURACY_POLICY").expect("explicit P policy");
+    Policy::parse(&name).expect("known policy").install().expect("immutable policy");
+    let state = TerminalState { ice_kg_m2: 1.0, liquid_kg_m2: 0.0, cold_content_j_m2: 0.0 };
+    let good = TerminalFluxIntegral { complete_energy_j_m2: 0.1, vapor_mass_exchange_kg_m2: 0.0,
+        shortwave_energy_j_m2: 0.1, longwave_energy_j_m2: 0.0, sensible_energy_j_m2: 0.0,
+        latent_energy_j_m2: 0.0, advected_energy_j_m2: 0.0, snow_soil_heat_energy_j_m2: 0.0, external_liquid_kg_m2: 0.0 };
+    let trial = Wb11HydrologyKernel::terminal_transition(state, good).expect("balanced input");
+    assert!((trial.state.liquid_kg_m2 * STAGE3_LATENT_HEAT_FUSION_J_KG - 0.1).abs() < 1e-12);
+    let poison = TerminalFluxIntegral { complete_energy_j_m2: 0.11, ..good };
+    assert!(matches!(Wb11HydrologyKernel::terminal_transition(state, poison), Err(DirectSnowStage3EvaluationError::TerminalNumerics(SnowTerminalNumericsFailure::Closure))));
+    let nonfinite = TerminalFluxIntegral { complete_energy_j_m2: f64::NAN, ..good };
+    assert!(Wb11HydrologyKernel::terminal_transition(state, nonfinite).is_err());
+    assert_eq!(state.ice_kg_m2,1.0,"failed immutable trial has no inventory mutation");
+}
