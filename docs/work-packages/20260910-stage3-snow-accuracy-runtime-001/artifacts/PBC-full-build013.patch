+#[cfg(test)]
+#[test]
+#[ignore = "isolated C policy requires a fresh process"]
+fn snow_accuracy_cadence_actual_chronology_phase_and_null_lte() {
+    use openwepp_land_surface_energy::snow_accuracy_policy::Policy;
+    let policy =
+        Policy::parse(&std::env::var("OPENWEPP_ACCURACY_POLICY").expect("explicit C policy"))
+            .expect("known C policy");
+    policy.install().expect("immutable C policy");
+    let target = f64::from(policy.endpoint_interval_seconds().expect("C profile"));
+    let start = TerminalState {
+        ice_kg_m2: 0.5,
+        liquid_kg_m2: 0.0,
+        cold_content_j_m2: 0.0,
+    };
+    let flux = |energy| TerminalFluxIntegral {
+        complete_energy_j_m2: energy,
+        shortwave_energy_j_m2: energy,
+        longwave_energy_j_m2: 0.0,
+        sensible_energy_j_m2: 0.0,
+        latent_energy_j_m2: 0.0,
+        vapor_mass_exchange_kg_m2: 0.0,
+        advected_energy_j_m2: 0.0,
+        snow_soil_heat_energy_j_m2: 0.0,
+        external_liquid_kg_m2: 0.0,
+    };
+    let mut calls = Vec::new();
+    let mut evidence = <NoEvidence as TerminalEvidenceMode<()>>::new_state();
+    let (result, _, steps) =
+        Wb11HydrologyKernel::solve_terminal_enthalpy_event_with_evidence::<_, _, _, NoEvidence>(
+            HillslopeKernelPhaseClass::HydrologyRunoffReconciliation,
+            0,
+            0.0,
+            1800.0,
+            start,
+            (),
+            |_, _, _, _, at, dt, role, _| {
+                calls.push((at, dt));
+                assert_eq!(role, CoveredTerminalTrialRoleV1::Root);
+                Ok((flux(0.0), ()))
+            },
+            |_, joint| Ok(joint),
+            false,
+            false,
+            &mut evidence,
+        )
+        .expect("constant state");
+    assert_eq!(calls.len(), if target == 600.0 { 3 } else { 1 });
+    let mut cursor = 0.0;
+    for (at, dt) in calls {
+        assert_eq!(at, cursor);
+        assert!(dt <= target);
+        cursor += dt;
+    }
+    assert_eq!(cursor, 1800.0);
+    assert_eq!(steps.len(), result.accepted_trials as usize);
+    assert_eq!(result.end_ice_kg_m2, 0.5);
+    assert_eq!(result.maximum_scaled_error, None);
+    assert_eq!(result.lte_coarse_ice_kg_m2, None);
+    let (event, _, _) =
+        Wb11HydrologyKernel::solve_terminal_enthalpy_event_with_evidence::<_, _, _, NoEvidence>(
+            HillslopeKernelPhaseClass::HydrologyRunoffReconciliation,
+            0,
+            0.0,
+            1800.0,
+            start,
+            (),
+            |_, _, _, _, _, dt, _, _| Ok((flux(0.5 * 333_600.0 * dt / target), ())),
+            |_, joint| Ok(joint),
+            false,
+            false,
+            &mut evidence,
+        )
+        .expect("constant-energy melt");
+    assert!(event.event_occurred);
+    assert_eq!(event.evaluated_seconds, target);
+    assert_eq!(event.event_bracket_lower_seconds, 0.0);
+    assert_eq!(event.event_bracket_upper_seconds, target);
+    assert_eq!(event.event_bracket_width_seconds, target);
+    assert!((event.terminal_liquid_kg_m2 - 0.5).abs() < 1e-12);
+    assert!(event.energy_closure_residual_j_m2.abs() < 1e-6);
+    let digest = crate::snow_stage3_v11_attachment::canonical_terminal_event_result_digest;
+    assert!(digest(&event).is_ok());
+    let mut poison = event;
+    poison.event_bracket_width_seconds = 0.0;
+    assert!(digest(&poison).is_err());
+    poison = event;
+    poison.experimental_endpoint_interval_seconds = None;
+    assert!(digest(&poison).is_err());
+    poison = event;
+    poison.maximum_scaled_error = Some(0.0);
+    assert!(digest(&poison).is_err());
+
+    let invalid =
+        Wb11HydrologyKernel::solve_terminal_enthalpy_event_with_evidence::<_, _, _, NoEvidence>(
+            HillslopeKernelPhaseClass::HydrologyRunoffReconciliation,
+            0,
+            0.0,
+            1800.0,
+            start,
+            (),
+            |_, _, _, _, _, _, _, _| Ok((flux(f64::NAN), ())),
+            |_, joint| Ok(joint),
+            false,
+            false,
+            &mut evidence,
+        );
+    assert!(invalid.is_err());
+    assert_eq!(start.ice_kg_m2, 0.5);
+}
