+// A positive-support bulk drainage event changes exactly two physical owners.
+// Validate the complete typed transfer before replacing their pre-event bytes.
+fn experimental_bulk_receiver_owner_bridge_v1(
+    endpoint: &ExactCoveredTerminalEndpointV1,
+    receipt: &Stage3CoupledSubslabReceiptV1,
+) -> Result<BTreeMap<&'static str, (Vec<u8>, Vec<u8>)>, DirectSnowStage3V11AttachmentError> {
+    let mut result = BTreeMap::new();
+    if openwepp_land_surface_energy::snow_accuracy_policy::Policy::current()
+        .bulk_threshold()
+        .is_none()
+    {
+        return Ok(result);
+    }
+    receipt.validate_support_liquid_custody_v2()?;
+    let Some(custody) = receipt.support_liquid_custody_v2() else {
+        return Ok(result);
+    };
+    let configuration = endpoint.ending.shadow().surface_configuration();
+    let surface_before = custody
+        .surface_beginning_state
+        .canonical_bytes(configuration)
+        .map_err(|_| {
+            DirectSnowStage3V11AttachmentError::Identity("bulk receiver surface beginning bytes")
+        })?;
+    let surface_after = custody
+        .surface_ending_state
+        .canonical_bytes(configuration)
+        .map_err(|_| {
+            DirectSnowStage3V11AttachmentError::Identity("bulk receiver surface ending bytes")
+        })?;
+    let lse_before = serde_json::to_vec(&custody.lse_beginning_state).map_err(|_| {
+        DirectSnowStage3V11AttachmentError::Identity("bulk receiver LSE beginning bytes")
+    })?;
+    let lse_after = serde_json::to_vec(&custody.lse_ending_state).map_err(|_| {
+        DirectSnowStage3V11AttachmentError::Identity("bulk receiver LSE ending bytes")
+    })?;
+    if digest_bytes(&surface_before) != receipt.owner_join.surface_liquid_owner_sha256
+        || digest_bytes(&lse_before) != receipt.owner_join.land_surface_energy_owner_sha256
+    {
+        return Err(DirectSnowStage3V11AttachmentError::Identity(
+            "bulk receiver pre-event owner digest",
+        ));
+    }
+    result.insert("surface_liquid", (surface_before, surface_after));
+    result.insert("land_surface_energy", (lse_before, lse_after));
+    Ok(result)
+}
