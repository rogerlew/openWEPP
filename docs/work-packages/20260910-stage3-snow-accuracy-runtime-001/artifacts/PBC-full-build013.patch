+#[cfg(test)]
+#[test]
+#[ignore = "explicit fresh-process experiment policy"]
+fn snow_accuracy_policy_restart_and_foreign_state_rejection() {
+    use openwepp_land_surface_energy::snow_accuracy_policy::Policy;
+    let policy = Policy::parse(&std::env::var("OPENWEPP_ACCURACY_POLICY").expect("policy"))
+        .expect("declared");
+    policy.install().expect("immutable startup");
+    let state = Wb11HydrologyKernel::initialize_stage3_persistent_state_with_retained_liquid(
+        1,
+        vec![DirectSnowLayerState::new(0.00005, 0.0005, 100.0, 0.0)],
+        0.0,
+    )
+    .expect("lawful state");
+    let bytes = Wb11HydrologyKernel::serialize_stage3_persistent_state(&state).expect("serialize");
+    let restored: DirectSnowStage3PersistentState =
+        serde_json::from_slice(&bytes).expect("same-policy decode");
+    assert_eq!(
+        Wb11HydrologyKernel::restore_stage3_persistent_state(restored, 1, 0).expect("restore"),
+        state
+    );
+    let mut foreign = state.clone();
+    foreign.experimental_accuracy = Some((255, false));
+    foreign.fingerprint = Wb11HydrologyKernel::stage3_persistent_state_fingerprint(&foreign);
+    assert!(Wb11HydrologyKernel::restore_stage3_persistent_state(foreign, 1, 0).is_err());
+    let mut active = state.clone();
+    active.experimental_accuracy = policy.identity().map(|id| (id, true));
+    active.fingerprint = Wb11HydrologyKernel::stage3_persistent_state_fingerprint(&active);
+    if policy.bulk_threshold().is_some() {
+        let restored = Wb11HydrologyKernel::restore_stage3_persistent_state(active.clone(), 1, 0)
+            .expect("bulk hysteresis restore");
+        assert_eq!(restored, active);
+        assert!(stage3_is_bulk_experiment_domain(&restored));
+    } else if policy != Policy::R0 {
+        assert!(Wb11HydrologyKernel::restore_stage3_persistent_state(active, 1, 0).is_err());
+    }
+    assert_eq!(state.next_interval_index, 0);
+}
