 }
 thread_local! { static ACTIVE: RefCell<Option<State>> = const { RefCell::new(None) }; }
+
+/// Observation only. Intrinsic borrowed replay custody does not depend on an
+/// audit session. Parent joins in the trace identify the enclosing map.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct LifecycleContext {
+    pub generation: u64,
+    pub parent: Option<u64>,
+    pub solve: Option<u64>,
+    pub iteration: u64,
+}
+
+pub(crate) fn current_context() -> Option<LifecycleContext> {
+    ACTIVE.with(|active| {
+        active.borrow().as_ref().map(|state| LifecycleContext {
+            generation: state.generation,
+            parent: state.parent,
+            solve: state.solve,
+            iteration: state.iteration,
+        })
+    })
+}
