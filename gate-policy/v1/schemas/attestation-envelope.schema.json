{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwepp:gate-policy:attestation-envelope:1",
  "title": "openWEPP gate receipt attestation envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "envelope_id", "receipt_subject", "issuer", "provenance", "artifacts", "signature"],
  "properties": {
    "schema_version": { "const": "openwepp-gate-attestation-envelope-v1" },
    "envelope_id": { "$ref": "#/$defs/digest" },
    "receipt_subject": { "$ref": "#/$defs/receiptSubject" },
    "issuer": { "$ref": "#/$defs/issuer" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "artifacts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/artifactSubject" } },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]*$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitOid": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "receiptSubject": { "type": "object", "additionalProperties": false, "required": ["kind", "receipt_id", "sha256"], "properties": { "kind": { "const": "RECEIPT" }, "receipt_id": { "$ref": "#/$defs/digest" }, "sha256": { "$ref": "#/$defs/digest" } } },
    "artifactSubject": { "type": "object", "additionalProperties": false, "required": ["kind", "artifact_id", "sha256"], "properties": { "kind": { "const": "ARTIFACT" }, "artifact_id": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/digest" } } },
    "issuer": { "type": "object", "additionalProperties": false, "required": ["principal_id", "trust_class", "trust_root_id", "policy_generation", "revocation_generation"], "properties": { "principal_id": { "$ref": "#/$defs/id" }, "trust_class": { "enum": ["REPOSITORY_REVIEWED", "PROTECTED_CI"] }, "trust_root_id": { "$ref": "#/$defs/id" }, "policy_generation": { "type": "integer", "minimum": 1 }, "revocation_generation": { "type": "integer", "minimum": 1 } } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["repository", "source_commit", "source_ref", "workflow", "workflow_sha256", "job", "runner_image_sha256", "attempt", "plan_id", "execution_key", "issued_at"], "properties": { "repository": { "$ref": "#/$defs/id" }, "source_commit": { "$ref": "#/$defs/gitOid" }, "source_ref": { "$ref": "#/$defs/id" }, "workflow": { "$ref": "#/$defs/id" }, "workflow_sha256": { "$ref": "#/$defs/digest" }, "job": { "$ref": "#/$defs/id" }, "runner_image_sha256": { "$ref": "#/$defs/digest" }, "attempt": { "type": "integer", "minimum": 1 }, "plan_id": { "$ref": "#/$defs/digest" }, "execution_key": { "$ref": "#/$defs/digest" }, "issued_at": { "$ref": "#/$defs/timestamp" } } },
    "signature": { "type": "object", "additionalProperties": false, "required": ["format", "bundle_sha256", "offline_verifiable"], "properties": { "format": { "enum": ["SLSA_V1", "GITHUB_ARTIFACT_ATTESTATION_V1"] }, "bundle_sha256": { "$ref": "#/$defs/digest" }, "offline_verifiable": { "const": true } } }
  }
}
