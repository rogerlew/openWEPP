{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwepp:gate-policy:package-authority-chain:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_authority_chain_id",
    "status",
    "reason_codes",
    "base_commit",
    "head_commit",
    "intent_package_path",
    "intent_package_base_sha256",
    "prompt_owner",
    "changed_paths",
    "unauthorized_paths",
    "steps"
  ],
  "properties": {
    "schema_version": {"const": "openwepp-package-authority-chain-v1"},
    "package_authority_chain_id": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["READY", "INVALID"]},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "base_commit": {"$ref": "#/$defs/commit"},
    "head_commit": {"$ref": "#/$defs/commit"},
    "intent_package_path": {"type": "string", "pattern": "^docs/work-packages/[^/]+/package\\.md$"},
    "intent_package_base_sha256": {"$ref": "#/$defs/digest"},
    "prompt_owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_path", "package_sha256", "prompt_path", "prompt_sha256"],
      "properties": {
        "package_path": {"type": "string", "pattern": "^docs/work-packages/[^/]+/package\\.md$"},
        "package_sha256": {"$ref": "#/$defs/digest"},
        "prompt_path": {"type": "string", "pattern": "^docs/work-packages/[^/]+/prompts/active/[^/]+\\.md$"},
        "prompt_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "changed_paths": {"$ref": "#/$defs/paths"},
    "unauthorized_paths": {"$ref": "#/$defs/paths"},
    "steps": {
      "type": "array",
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_path",
        "package_sha256",
        "declared_write_set",
        "status",
        "authorizing",
        "introduced_commit",
        "introduction_sequence",
        "role",
        "authorized_paths"
      ],
      "properties": {
        "package_path": {"type": "string", "pattern": "^docs/work-packages/[^/]+/package\\.md$"},
        "package_sha256": {"$ref": "#/$defs/digest"},
        "declared_write_set": {"$ref": "#/$defs/paths"},
        "status": {"type": "string", "minLength": 1},
        "authorizing": {"const": true},
        "introduced_commit": {"$ref": "#/$defs/commit"},
        "introduction_sequence": {"type": "integer", "minimum": 0},
        "role": {"enum": ["ANCHOR", "SCAFFOLD", "PREEXISTING", "CLOSURE"]},
        "authorized_paths": {"$ref": "#/$defs/paths"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "parent_commit",
        "parent_tree",
        "commit",
        "commit_tree",
        "status",
        "reason_codes",
        "changed_paths",
        "unauthorized_paths",
        "primary_package_path",
        "authorities",
        "planning_scaffolds",
        "planning_authorized_paths",
        "planning_authorities"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "parent_commit": {"$ref": "#/$defs/commit"},
        "parent_tree": {"$ref": "#/$defs/commit"},
        "commit": {"$ref": "#/$defs/commit"},
        "commit_tree": {"$ref": "#/$defs/commit"},
        "status": {"enum": ["READY", "INVALID"]},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "changed_paths": {"$ref": "#/$defs/paths"},
        "unauthorized_paths": {"$ref": "#/$defs/paths"},
        "primary_package_path": {
          "oneOf": [
            {"type": "string", "pattern": "^docs/work-packages/[^/]+/package\\.md$"},
            {"type": "null"}
          ]
        },
        "authorities": {"type": "array", "items": {"$ref": "#/$defs/authority"}},
        "planning_scaffolds": {"$ref": "#/$defs/paths"},
        "planning_authorized_paths": {"$ref": "#/$defs/paths"},
        "planning_authorities": {"type": "array", "items": {"$ref": "#/$defs/planning_authority"}}
      },
      "allOf": [{
        "if": {
          "properties": {
            "status": {"const": "READY"},
            "planning_authorities": {"maxItems": 0}
          }
        },
        "then": {"properties": {"authorities": {"minItems": 1}}}
      }]
    },
    "planning_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "document_sha256",
        "status",
        "authorizing_revision",
        "introduced_commit",
        "role",
        "authorized_paths"
      ],
      "properties": {
        "path": {"type": "string", "pattern": "^docs/work-packages/[^/]+-execplan\\.md$"},
        "document_sha256": {"$ref": "#/$defs/digest"},
        "status": {"type": "string", "minLength": 1},
        "authorizing_revision": {"$ref": "#/$defs/commit"},
        "introduced_commit": {"$ref": "#/$defs/commit"},
        "role": {"enum": ["PLANNING_SCAFFOLD", "PLANNING_PREEXISTING"]},
        "authorized_paths": {"$ref": "#/$defs/paths"}
      }
    }
  }
}
