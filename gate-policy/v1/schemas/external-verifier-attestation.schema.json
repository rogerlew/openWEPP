{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwepp:gate-policy:external-verifier-attestation:1",
  "title": "openWEPP independent external verifier attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attestation_id",
    "capability_hash",
    "parent_dispatch_id",
    "transaction_id",
    "agent_task_id",
    "principal",
    "workflow",
    "job",
    "runner",
    "attempt",
    "script_sha256",
    "argv",
    "receipt_sha256",
    "freeze_digest",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "openwepp-external-verifier-attestation-v1"
    },
    "attestation_id": {
      "$ref": "#/$defs/digest"
    },
    "capability_hash": {
      "$ref": "#/$defs/digest"
    },
    "parent_dispatch_id": {
      "$ref": "#/$defs/id"
    },
    "transaction_id": {
      "$ref": "#/$defs/id"
    },
    "agent_task_id": {
      "$ref": "#/$defs/id"
    },
    "principal": {
      "$ref": "#/$defs/id"
    },
    "workflow": {
      "$ref": "#/$defs/id"
    },
    "job": {
      "$ref": "#/$defs/id"
    },
    "runner": {
      "$ref": "#/$defs/id"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "script_sha256": {
      "$ref": "#/$defs/digest"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "receipt_sha256": {
      "$ref": "#/$defs/digest"
    },
    "freeze_digest": {
      "$ref": "#/$defs/digest"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
