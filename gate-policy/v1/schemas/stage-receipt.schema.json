{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwepp:gate-policy:stage-receipt:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "stage_receipt_id", "stage", "plan_id", "plan_sha256",
    "execution_key", "executor_binary_sha256", "artifact_root_sha256", "roots", "attempts", "final_results",
    "executed_inventory", "unavailable_items", "started_at", "finished_at", "claims", "result"
  ],
  "properties": {
    "schema_version": {"const": "openwepp-gate-stage-receipt-v1"},
    "stage_receipt_id": {"$ref": "#/$defs/digest"},
    "stage": {"const": "LIGHT"},
    "plan_id": {"$ref": "#/$defs/digest"},
    "plan_sha256": {"$ref": "#/$defs/digest"},
    "execution_key": {"$ref": "#/$defs/digest"},
    "executor_binary_sha256": {"$ref": "#/$defs/digest"},
    "artifact_root_sha256": {"$ref": "#/$defs/digest"},
    "roots": {"type": "object", "additionalProperties": {}},
    "attempts": {"type": "array", "items": {"type": "object", "additionalProperties": {}}},
    "final_results": {"type": "object", "additionalProperties": {"enum": ["PASS", "FAIL", "BLOCKED", "INVALID"]}},
    "executed_inventory": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "unavailable_items": {"type": "array", "items": {"type": "object", "additionalProperties": {}}},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "claims": {"type": "object", "additionalProperties": {}},
    "result": {"enum": ["PASS", "FAIL", "BLOCKED", "INVALID"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
