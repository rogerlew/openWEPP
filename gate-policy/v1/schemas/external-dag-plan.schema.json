{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwepp:gate-policy:external-dag-plan:1",
  "title": "openWEPP external DAG transaction plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_id",
    "generation",
    "parent_plan",
    "source_identity",
    "source_plan",
    "source_contract",
    "authority",
    "transactions",
    "custody_commands"
  ],
  "properties": {
    "schema": {
      "const": "openwepp-external-dag-plan-v1"
    },
    "plan_id": {
      "$ref": "#/$defs/digest"
    },
    "generation": {"enum": ["A", "B"]},
    "parent_plan": {
      "oneOf": [{"$ref": "#/$defs/parentPlan"}, {"type": "null"}]
    },
    "source_identity": {
      "oneOf": [{"$ref": "#/$defs/repositoryIdentity"}, {"type": "null"}]
    },
    "source_plan": {
      "$ref": "#/$defs/source"
    },
    "source_contract": {
      "$ref": "#/$defs/source"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "transactions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/transaction"
      }
    },
    "custody_commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "parentPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "plan_id", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "plan_id": {"$ref": "#/$defs/digest"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "repositoryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "tree", "diff_sha256"],
      "properties": {
        "head": {"$ref": "#/$defs/digest"},
        "tree": {"$ref": "#/$defs/digest"},
        "diff_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_path", "base_commit", "cheap_gate_evidence"],
      "properties": {
        "package_path": {"$ref": "#/$defs/path"},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "cheap_gate_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/source"}
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id",
        "light",
        "heavy",
        "custody_prerequisites",
        "custody_receipts"
      ],
      "properties": {
        "transaction_id": {
          "$ref": "#/$defs/id"
        },
        "light": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "heavy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "custody_prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "custody_receipts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/custodyReceipt"
          }
        }
      }
    },
    "custodyReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "path", "sha256", "kind"],
      "properties": {
        "command_id": {"$ref": "#/$defs/id"},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/digest"},
        "kind": {"enum": ["TRANSACTION", "FREEZE"]}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "command_id",
        "argv",
        "env",
        "cwd",
        "prerequisites",
        "cost_class",
        "source_path",
        "declared_outputs",
        "timeout_seconds",
        "max_attempts",
        "handoff",
        "harvard_access"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "command_id": {
          "$ref": "#/$defs/id"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "cwd": {
          "$ref": "#/$defs/path"
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "cost_class": {
          "enum": [
            "QUICK",
            "DOMAIN",
            "HEAVY"
          ]
        },
        "source_path": {
          "$ref": "#/$defs/path"
        },
        "declared_outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "const": 1
        },
        "handoff": {
          "type": "string",
          "minLength": 1
        },
        "harvard_access": {
          "enum": [
            "NONE",
            "OPENS_HARVARD"
          ]
        }
      }
    }
  }
}
