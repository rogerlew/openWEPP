{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwepp:gate-policy:workflow-qualification:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "qualification_report_id", "subject_freeze_id", "matrix_id", "cases", "stopped_after", "result"],
  "properties": {
    "schema_version": {"const": "openwepp-testgate-workflow-qualification-v1"},
    "qualification_report_id": {"$ref": "#/$defs/digest"},
    "subject_freeze_id": {"$ref": "#/$defs/digest"},
    "matrix_id": {"type": "string", "minLength": 1},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}},
    "stopped_after": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "result": {"enum": ["PASS", "FAIL"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "case_id", "command", "exit_code", "expected_status", "observed_status", "expected_heavy_spawn_count", "observed_heavy_spawn_count", "artifacts", "result"],
      "properties": {
        "schema_version": {"const": "openwepp-testgate-qualification-case-v1"},
        "case_id": {"type": "string", "minLength": 1},
        "command": {"type": "array", "items": {"type": "string"}},
        "exit_code": {"type": "integer"},
        "expected_status": {"enum": ["PASS", "READY", "FAIL", "BLOCKED", "INVALID"]},
        "observed_status": {"oneOf": [{"enum": ["PASS", "READY", "FAIL", "BLOCKED", "INVALID"]}, {"type": "null"}]},
        "expected_heavy_spawn_count": {"type": "integer", "minimum": 0},
        "observed_heavy_spawn_count": {"type": "integer", "minimum": 0},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "result": {"enum": ["PASS", "FAIL"]}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}
    }
  }
}
