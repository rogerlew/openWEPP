{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwepp:gate-policy:external-output-manifest:1",
  "title": "openWEPP exhaustive external output manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_id",
    "root",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "openwepp-external-output-manifest-v1"
    },
    "manifest_id": {
      "$ref": "#/$defs/digest"
    },
    "root": {
      "$ref": "#/$defs/absolutePath"
    },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/[^\\u0000]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "file_type",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "file_type": {
          "const": "REGULAR"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
