{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwepp:gate-policy:package-audit:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "package_audit_id", "status", "reason_codes", "base_commit",
    "package_path", "base_package_sha256", "current_package_sha256", "declared_write_set",
    "changed_paths", "unauthorized_paths"
  ],
  "properties": {
    "schema_version": {"const": "openwepp-package-audit-v1"},
    "package_audit_id": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["READY", "BLOCKED", "INVALID"]},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "base_commit": {"type": "string", "minLength": 1},
    "package_path": {"type": "string", "minLength": 1},
    "base_package_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "current_package_sha256": {"$ref": "#/$defs/digest"},
    "declared_write_set": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "unauthorized_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
