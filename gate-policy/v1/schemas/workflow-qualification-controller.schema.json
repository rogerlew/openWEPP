{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwepp:gate-policy:workflow-qualification-controller:1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "matrix_id", "cases"],
  "properties": {
    "schema_version": {"const": "openwepp-testgate-qualification-controller-v1"},
    "matrix_id": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "helper_arguments", "expected_status", "expected_heavy_spawn_count"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "helper_arguments": {"type": "array", "items": {"type": "string"}},
          "expected_status": {"enum": ["PASS", "READY", "FAIL", "BLOCKED", "INVALID"]},
          "expected_heavy_spawn_count": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
