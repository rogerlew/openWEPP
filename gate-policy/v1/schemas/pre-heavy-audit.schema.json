{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwepp:gate-policy:pre-heavy-audit:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "audit_id", "status", "reason_codes", "plan_id", "plan_sha256",
    "execution_key", "executor_binary_sha256", "light_stage_receipt_id", "artifact_root_sha256", "ledger_path_sha256", "ledger_head_sha256",
    "node_manifest", "package_admission", "checks", "quality_disposition", "light_receipt"
  ],
  "properties": {
    "schema_version": {"const": "openwepp-pre-heavy-audit-v1"},
    "audit_id": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["READY", "BLOCKED", "INVALID"]},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "plan_id": {"$ref": "#/$defs/digest"},
    "plan_sha256": {"$ref": "#/$defs/digest"},
    "execution_key": {"$ref": "#/$defs/digest"},
    "executor_binary_sha256": {"$ref": "#/$defs/digest"},
    "light_stage_receipt_id": {"$ref": "#/$defs/digest"},
    "artifact_root_sha256": {"$ref": "#/$defs/digest"},
    "ledger_path_sha256": {"$ref": "#/$defs/digest"},
    "ledger_head_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "node_manifest": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["node_id", "execution_cost_class", "node_sha256"],
        "properties": {
          "node_id": {"$ref": "#/$defs/digest"},
          "execution_cost_class": {"enum": ["LIGHT", "HEAVY"]},
          "node_sha256": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "package_admission": {"type": ["object", "null"], "additionalProperties": true},
    "checks": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "prefixItems": [
        {"$ref": "#/$defs/packageAdmissionCheck"},
        {"$ref": "#/$defs/cheapPrerequisitesCheck"},
        {"$ref": "#/$defs/inventoryArgumentsCheck"},
        {"$ref": "#/$defs/executionIdentitiesCheck"},
        {"$ref": "#/$defs/attemptIsolationCheck"},
        {"$ref": "#/$defs/rootsEvidenceCheck"},
        {"$ref": "#/$defs/qualityDeferralCheck"},
        {"$ref": "#/$defs/orderingRetryCheck"},
        {"$ref": "#/$defs/durableLedgerCheck"},
        {"$ref": "#/$defs/openDefectsCheck"}
      ],
      "items": false
    },
    "quality_disposition": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "observations", "owner", "trigger", "closure_eligible", "prohibited_gate_definition_ids"],
      "properties": {
        "status": {"const": "DEFERRED_TO_QUALITY_CI"},
        "observations": {"const": ["COVERAGE", "CRAP"]},
        "owner": {"const": "openwepp-quality-observatory"},
        "trigger": {"const": "OPTIONAL_OPERATOR_DISPATCH"},
        "closure_eligible": {"const": true},
        "prohibited_gate_definition_ids": {
          "const": ["affected-adjudicated-crap-v1", "adjudicated-crap-v1", "combined-workspace-quality-v1"]
        }
      }
    },
    "light_receipt": {"type": "object", "additionalProperties": {}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "status", "reason_codes", "evidence_sha256"],
      "properties": {
        "check_id": {"type": "string"},
        "status": {"enum": ["PASS", "BLOCKED", "INVALID"]},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "evidence_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "packageAdmissionCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "PACKAGE_ADMISSION"}}}]},
    "cheapPrerequisitesCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "CHEAP_PREREQUISITES"}}}]},
    "inventoryArgumentsCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "INVENTORY_AND_ARGUMENTS"}}}]},
    "executionIdentitiesCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "EXECUTION_IDENTITIES"}}}]},
    "attemptIsolationCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "ATTEMPT_AND_OUTPUT_ISOLATION"}}}]},
    "rootsEvidenceCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "ROOTS_AND_EVIDENCE_REUSE"}}}]},
    "qualityDeferralCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "QUALITY_DEFERRAL"}}}]},
    "orderingRetryCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "ORDERING_RETRY_AND_HANDOFF"}}}]},
    "durableLedgerCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "DURABLE_ATTEMPT_LEDGER"}}}]},
    "openDefectsCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "OPEN_TOOLING_DEFECTS"}}}]}
  }
}
