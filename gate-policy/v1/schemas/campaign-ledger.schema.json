{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwepp:gate-policy:campaign-ledger:1",
  "title": "openWEPP append-only campaign gate ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger_id", "predecessor_ledger_id", "policy", "campaign", "lifecycle", "current_head", "expected_predecessor_head", "intent_plan_ids", "obligations", "events", "receipts", "investigation_records", "authorization_events", "backstop", "certification"],
  "properties": {
    "schema_version": { "const": "openwepp-campaign-ledger-v1" },
    "ledger_id": { "$ref": "#/$defs/digest" },
    "predecessor_ledger_id": { "$ref": "#/$defs/nullableDigest" },
    "policy": { "$ref": "#/$defs/policy" },
    "campaign": { "$ref": "#/$defs/campaign" },
    "lifecycle": { "enum": ["CREATED", "ACTIVE", "CLOSING", "CERTIFIED", "ABORTED", "SUPERSEDED"] },
    "current_head": { "$ref": "#/$defs/gitOid" },
    "expected_predecessor_head": { "$ref": "#/$defs/gitOid" },
    "intent_plan_ids": { "$ref": "#/$defs/digestList" },
    "obligations": { "type": "array", "items": { "$ref": "#/$defs/obligation" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "receipts": { "type": "array", "items": { "$ref": "#/$defs/receiptRef" } },
    "investigation_records": { "$ref": "#/$defs/idList" },
    "authorization_events": { "type": "array", "items": { "$ref": "#/$defs/authorization" } },
    "backstop": { "$ref": "#/$defs/backstop" },
    "certification": { "oneOf": [{ "$ref": "#/$defs/certification" }, { "type": "null" }] }
  },
  "allOf": [
    { "if": { "properties": { "lifecycle": { "const": "CERTIFIED" } }, "required": ["lifecycle"] }, "then": { "properties": { "obligations": { "minItems": 1, "not": { "contains": { "properties": { "state": { "enum": ["PENDING", "FAIL", "BLOCKED", "STALE", "DEFERRED", "LEGACY_UNVERIFIED"] } }, "required": ["state"] } } }, "events": { "minItems": 1 }, "receipts": { "minItems": 1 }, "authorization_events": { "minItems": 1 }, "backstop": { "properties": { "state": { "const": "CURRENT" } } }, "certification": { "$ref": "#/$defs/certification" } } }, "else": { "properties": { "certification": { "type": "null" } } } }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]*$" },
    "text": { "type": "string", "pattern": "\\S" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitOid": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "nullableDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "nullableGitOid": { "oneOf": [{ "$ref": "#/$defs/gitOid" }, { "type": "null" }] },
    "timestamp": { "type": "string", "format": "date-time" },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "digestList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
    "policy": { "type": "object", "additionalProperties": false, "required": ["policy_id", "policy_sha256", "impact_map_generation", "assurance_watch_generation"], "properties": { "policy_id": { "const": "ADR-0039" }, "policy_sha256": { "$ref": "#/$defs/digest" }, "impact_map_generation": { "type": "integer", "minimum": 1 }, "assurance_watch_generation": { "type": "integer", "minimum": 1 } } },
    "campaign": { "type": "object", "additionalProperties": false, "required": ["campaign_id", "owner", "base_commit", "integration_boundary", "domains", "consumer_surfaces", "admission_rule_id", "checkpoint_triggers", "closure_obligations", "release_obligations", "assurance_report_ids", "maximum_unresolved_seconds", "backstop_max_days", "backstop_max_increments"], "properties": { "campaign_id": { "$ref": "#/$defs/id" }, "owner": { "$ref": "#/$defs/id" }, "base_commit": { "$ref": "#/$defs/gitOid" }, "integration_boundary": { "$ref": "#/$defs/id" }, "domains": { "$ref": "#/$defs/idList" }, "consumer_surfaces": { "$ref": "#/$defs/idList" }, "admission_rule_id": { "$ref": "#/$defs/id" }, "checkpoint_triggers": { "$ref": "#/$defs/idList" }, "closure_obligations": { "$ref": "#/$defs/idList" }, "release_obligations": { "$ref": "#/$defs/idList" }, "assurance_report_ids": { "$ref": "#/$defs/idList" }, "maximum_unresolved_seconds": { "type": "integer", "minimum": 1 }, "backstop_max_days": { "type": "integer", "minimum": 1, "maximum": 14 }, "backstop_max_increments": { "type": "integer", "minimum": 1, "maximum": 10 } } },
    "obligation": { "type": "object", "additionalProperties": false, "required": ["obligation_id", "state", "owner", "boundary", "trigger", "reason", "receipt_id", "replacement_obligation_id", "imported_artifact_ids"], "properties": { "obligation_id": { "$ref": "#/$defs/id" }, "state": { "enum": ["PENDING", "PASS", "FAIL", "BLOCKED", "STALE", "DEFERRED", "NOT_APPLICABLE", "SUPERSEDED", "LEGACY_UNVERIFIED"] }, "owner": { "$ref": "#/$defs/id" }, "boundary": { "enum": ["INCREMENT", "CHECKPOINT", "CAMPAIGN", "RELEASE"] }, "trigger": { "$ref": "#/$defs/id" }, "reason": { "$ref": "#/$defs/text" }, "receipt_id": { "$ref": "#/$defs/nullableDigest" }, "replacement_obligation_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "imported_artifact_ids": { "$ref": "#/$defs/idList" } }, "allOf": [ { "if": { "properties": { "state": { "const": "PASS" } } }, "then": { "properties": { "receipt_id": { "$ref": "#/$defs/digest" } } } }, { "if": { "properties": { "state": { "const": "SUPERSEDED" } } }, "then": { "properties": { "replacement_obligation_id": { "$ref": "#/$defs/id" } } } } ] },
    "event": { "type": "object", "additionalProperties": false, "required": ["event_id", "predecessor_event_id", "event_type", "target_head", "authorized_by", "recorded_at", "payload"], "properties": { "event_id": { "$ref": "#/$defs/digest" }, "predecessor_event_id": { "$ref": "#/$defs/nullableDigest" }, "event_type": { "enum": ["CAMPAIGN_CREATED", "HEAD_ADVANCED", "OBLIGATION_TRANSITION", "EXECUTION_RECORDED", "AMENDMENT_DISCOVERED", "LIFECYCLE_TRANSITION", "BOOTSTRAP_LEGACY"] }, "target_head": { "$ref": "#/$defs/gitOid" }, "authorized_by": { "$ref": "#/$defs/id" }, "recorded_at": { "$ref": "#/$defs/timestamp" }, "payload": { "$ref": "#/$defs/eventPayload" } }, "allOf": [{ "if": { "properties": { "event_type": { "const": "CAMPAIGN_CREATED" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/campaignCreatedPayload" } } } }, { "if": { "properties": { "event_type": { "const": "HEAD_ADVANCED" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/headAdvancedPayload" } } } }, { "if": { "properties": { "event_type": { "const": "OBLIGATION_TRANSITION" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/obligationTransitionPayload" } } } }, { "if": { "properties": { "event_type": { "const": "EXECUTION_RECORDED" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/executionRecordedPayload" } } } }, { "if": { "properties": { "event_type": { "const": "AMENDMENT_DISCOVERED" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/amendmentPayload" } } } }, { "if": { "properties": { "event_type": { "const": "LIFECYCLE_TRANSITION" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/lifecyclePayload" } } } }, { "if": { "properties": { "event_type": { "const": "BOOTSTRAP_LEGACY" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/bootstrapPayload" } } } }] },
    "eventPayload": { "oneOf": [{ "$ref": "#/$defs/campaignCreatedPayload" }, { "$ref": "#/$defs/headAdvancedPayload" }, { "$ref": "#/$defs/obligationTransitionPayload" }, { "$ref": "#/$defs/executionRecordedPayload" }, { "$ref": "#/$defs/amendmentPayload" }, { "$ref": "#/$defs/lifecyclePayload" }, { "$ref": "#/$defs/bootstrapPayload" }] },
    "campaignCreatedPayload": { "type": "object", "additionalProperties": false, "required": ["kind", "campaign_id", "intent_plan_id"], "properties": { "kind": { "const": "CAMPAIGN_CREATED" }, "campaign_id": { "$ref": "#/$defs/id" }, "intent_plan_id": { "$ref": "#/$defs/digest" } } },
    "headAdvancedPayload": { "type": "object", "additionalProperties": false, "required": ["kind", "from_head", "to_head", "terminal_plan_id"], "properties": { "kind": { "const": "HEAD_ADVANCED" }, "from_head": { "$ref": "#/$defs/gitOid" }, "to_head": { "$ref": "#/$defs/gitOid" }, "terminal_plan_id": { "$ref": "#/$defs/digest" } } },
    "obligationTransitionPayload": { "type": "object", "additionalProperties": false, "required": ["kind", "obligation_id", "from_state", "to_state", "reason_code", "receipt_id", "replacement_obligation_id"], "properties": { "kind": { "const": "OBLIGATION_TRANSITION" }, "obligation_id": { "$ref": "#/$defs/id" }, "from_state": { "$ref": "#/$defs/nullableObligationState" }, "to_state": { "$ref": "#/$defs/obligationState" }, "reason_code": { "$ref": "#/$defs/id" }, "receipt_id": { "$ref": "#/$defs/nullableDigest" }, "replacement_obligation_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] } }, "allOf": [{ "if": { "properties": { "to_state": { "const": "PASS" } } }, "then": { "properties": { "receipt_id": { "$ref": "#/$defs/digest" } } } }, { "if": { "properties": { "to_state": { "const": "SUPERSEDED" } } }, "then": { "properties": { "replacement_obligation_id": { "$ref": "#/$defs/id" } } } }] },
    "executionRecordedPayload": { "type": "object", "additionalProperties": false, "required": ["kind", "obligation_id", "receipt_id", "envelope_id", "result"], "properties": { "kind": { "const": "EXECUTION_RECORDED" }, "obligation_id": { "$ref": "#/$defs/id" }, "receipt_id": { "$ref": "#/$defs/digest" }, "envelope_id": { "$ref": "#/$defs/digest" }, "result": { "enum": ["PASS", "PASS_WITH_RETRY", "FAIL", "BLOCKED", "INVALID"] } } },
    "amendmentPayload": { "type": "object", "additionalProperties": false, "required": ["kind", "changed_object_sha256", "terminal_plan_id", "new_obligation_id"], "properties": { "kind": { "const": "AMENDMENT_DISCOVERED" }, "changed_object_sha256": { "$ref": "#/$defs/digest" }, "terminal_plan_id": { "$ref": "#/$defs/digest" }, "new_obligation_id": { "$ref": "#/$defs/id" } } },
    "lifecyclePayload": { "type": "object", "additionalProperties": false, "required": ["kind", "from_lifecycle", "to_lifecycle", "authorization_id"], "properties": { "kind": { "const": "LIFECYCLE_TRANSITION" }, "from_lifecycle": { "enum": ["CREATED", "ACTIVE", "CLOSING", "CERTIFIED", "ABORTED", "SUPERSEDED"] }, "to_lifecycle": { "enum": ["CREATED", "ACTIVE", "CLOSING", "CERTIFIED", "ABORTED", "SUPERSEDED"] }, "authorization_id": { "$ref": "#/$defs/digest" } } },
    "bootstrapPayload": { "type": "object", "additionalProperties": false, "required": ["kind", "legacy_state", "imported_artifact_ids"], "properties": { "kind": { "const": "BOOTSTRAP_LEGACY" }, "legacy_state": { "const": "LEGACY_UNVERIFIED" }, "imported_artifact_ids": { "$ref": "#/$defs/idList" } } },
    "obligationState": { "enum": ["PENDING", "PASS", "FAIL", "BLOCKED", "STALE", "DEFERRED", "NOT_APPLICABLE", "SUPERSEDED", "LEGACY_UNVERIFIED"] },
    "nullableObligationState": { "oneOf": [{ "$ref": "#/$defs/obligationState" }, { "type": "null" }] },
    "receiptRef": { "type": "object", "additionalProperties": false, "required": ["receipt_id", "envelope_id", "obligation_ids"], "properties": { "receipt_id": { "$ref": "#/$defs/digest" }, "envelope_id": { "$ref": "#/$defs/digest" }, "obligation_ids": { "$ref": "#/$defs/idList" } } },
    "authorization": { "type": "object", "additionalProperties": false, "required": ["authorization_id", "principal_id", "role_id", "predecessor_ledger_id", "transition_sha256", "repository", "campaign_id", "target_head", "envelope_id"], "properties": { "authorization_id": { "$ref": "#/$defs/digest" }, "principal_id": { "$ref": "#/$defs/id" }, "role_id": { "$ref": "#/$defs/id" }, "predecessor_ledger_id": { "$ref": "#/$defs/nullableDigest" }, "transition_sha256": { "$ref": "#/$defs/digest" }, "repository": { "$ref": "#/$defs/id" }, "campaign_id": { "$ref": "#/$defs/id" }, "target_head": { "$ref": "#/$defs/gitOid" }, "envelope_id": { "$ref": "#/$defs/digest" } } },
    "backstop": { "type": "object", "additionalProperties": false, "required": ["state", "anchor_receipt_id", "anchor_envelope_id", "anchor_head", "authenticated_completed_at", "head_advances_since_anchor"], "properties": { "state": { "enum": ["CURRENT", "DUE", "OVERDUE"] }, "anchor_receipt_id": { "$ref": "#/$defs/nullableDigest" }, "anchor_envelope_id": { "$ref": "#/$defs/nullableDigest" }, "anchor_head": { "$ref": "#/$defs/nullableGitOid" }, "authenticated_completed_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }, "head_advances_since_anchor": { "type": "integer", "minimum": 0 } }, "allOf": [{ "if": { "properties": { "state": { "const": "CURRENT" } } }, "then": { "properties": { "anchor_receipt_id": { "$ref": "#/$defs/digest" }, "anchor_envelope_id": { "$ref": "#/$defs/digest" }, "anchor_head": { "$ref": "#/$defs/gitOid" }, "authenticated_completed_at": { "$ref": "#/$defs/timestamp" }, "head_advances_since_anchor": { "maximum": 9 } } }, "else": { "properties": { "anchor_receipt_id": { "type": "null" }, "anchor_envelope_id": { "type": "null" }, "anchor_head": { "type": "null" }, "authenticated_completed_at": { "type": "null" } } } }] },
    "certification": { "type": "object", "additionalProperties": false, "required": ["receipt_id", "envelope_id", "certified_head", "authenticated_completed_at", "authorization_id"], "properties": { "receipt_id": { "$ref": "#/$defs/digest" }, "envelope_id": { "$ref": "#/$defs/digest" }, "certified_head": { "$ref": "#/$defs/gitOid" }, "authenticated_completed_at": { "$ref": "#/$defs/timestamp" }, "authorization_id": { "$ref": "#/$defs/digest" } } }
  }
}
