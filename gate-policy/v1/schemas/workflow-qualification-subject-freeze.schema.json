{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwepp:gate-policy:workflow-qualification-subject-freeze:1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "subject_freeze_id", "implementation_commit", "paths"],
  "properties": {
    "schema_version": {"const": "openwepp-testgate-subject-freeze-v1"},
    "subject_freeze_id": {"$ref": "#/$defs/digest"},
    "implementation_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "sha256": {"$ref": "#/$defs/digest"}}}
  }
}
