{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwepp:gate-policy:holdout-opening-token-receipt:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "opening_token_receipt_id",
    "result",
    "token_path",
    "token_sha256",
    "freeze_digest",
    "holdout_execution_receipt_path",
    "holdout_execution_receipt_sha256"
  ],
  "properties": {
    "schema": {
      "const": "openwepp-holdout-opening-token-receipt-v1"
    },
    "opening_token_receipt_id": {
      "$ref": "#/$defs/digest"
    },
    "result": {
      "const": "PASS"
    },
    "token_path": {
      "type": "string",
      "minLength": 1
    },
    "token_sha256": {
      "$ref": "#/$defs/digest"
    },
    "freeze_digest": {
      "$ref": "#/$defs/digest"
    },
    "holdout_execution_receipt_path": {
      "type": "string",
      "minLength": 1
    },
    "holdout_execution_receipt_sha256": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
