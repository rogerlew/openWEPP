{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwepp:gate-policy:publication-receipt:1",
  "title": "openWEPP external result publication receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "transaction_receipt_id",
    "transaction_receipt_sha256",
    "source_manifest_id",
    "source_manifest_sha256",
    "source_root",
    "destination_root",
    "destination_baseline_sha256",
    "journal_path",
    "journal_sha256",
    "files",
    "started_at",
    "finished_at",
    "result",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": "openwepp-publication-receipt-v1"},
    "receipt_id": {"$ref": "#/$defs/digest"},
    "transaction_receipt_id": {"$ref": "#/$defs/digest"},
    "transaction_receipt_sha256": {"$ref": "#/$defs/digest"},
    "source_manifest_id": {"$ref": "#/$defs/digest"},
    "source_manifest_sha256": {"$ref": "#/$defs/digest"},
    "source_root": {"$ref": "#/$defs/absolutePath"},
    "destination_root": {"$ref": "#/$defs/absolutePath"},
    "destination_baseline_sha256": {"$ref": "#/$defs/digest"},
    "journal_path": {"$ref": "#/$defs/absolutePath"},
    "journal_sha256": {"$ref": "#/$defs/digest"},
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/file"}
    },
    "started_at": {"$ref": "#/$defs/timestamp"},
    "finished_at": {"$ref": "#/$defs/timestamp"},
    "result": {"enum": ["PASS", "NON_ACCEPTED", "FAIL", "INVALID"]},
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolutePath": {"type": "string", "pattern": "^/[^\\u0000]*$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_relative_path",
        "destination_relative_path",
        "sha256",
        "size_bytes",
        "prior_destination_sha256",
        "journal_sequence",
        "installed"
      ],
      "properties": {
        "source_relative_path": {"$ref": "#/$defs/relativePath"},
        "destination_relative_path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "prior_destination_sha256": {
          "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
        },
        "journal_sequence": {"type": "integer", "minimum": 1},
        "installed": {"type": "boolean"}
      }
    }
  }
}
