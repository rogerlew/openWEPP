{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwepp:gate-policy:assurance-impact:1",
  "title": "openWEPP assurance campaign impact record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "report_id", "assessed_realization_root", "source_root", "watch_generation", "campaign_id", "campaign_head", "policy_generation", "release_identity", "axes", "entries", "events", "aggregate_impact", "resolution_authority"],
  "properties": {
    "schema_version": { "const": "openwepp-assurance-impact-v1" },
    "record_id": { "$ref": "#/$defs/digest" },
    "report_id": { "$ref": "#/$defs/id" },
    "assessed_realization_root": { "$ref": "#/$defs/digest" },
    "source_root": { "$ref": "#/$defs/digest" },
    "watch_generation": { "type": "integer", "minimum": 1 },
    "campaign_id": { "$ref": "#/$defs/id" },
    "campaign_head": { "$ref": "#/$defs/gitOid" },
    "policy_generation": { "type": "integer", "minimum": 1 },
    "release_identity": { "$ref": "#/$defs/nullableDigest" },
    "axes": { "$ref": "#/$defs/axes" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "events": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/transferEvent" } },
    "aggregate_impact": { "enum": ["NO_IMPACT_DETECTED", "IMPACT_PENDING", "NO_MATERIAL_IMPACT_AUTHORIZED", "REFRESH_REQUIRED", "REFRESH_COMPLETE"] },
    "resolution_authority": { "$ref": "#/$defs/authority" }
  },
  "allOf": [
    {
      "if": { "properties": { "axes": { "properties": { "campaign_transfer_currency": { "const": "CURRENT" } } } } },
      "then": { "properties": { "axes": { "properties": { "campaign_transfer_request": { "const": "REQUESTED" }, "campaign_impact_disposition": { "enum": ["NO_IMPACT_DETECTED", "NO_MATERIAL_IMPACT_AUTHORIZED", "REFRESH_COMPLETE"] } } }, "events": { "contains": { "properties": { "event_type": { "const": "CAMPAIGN_TRANSFER" } }, "required": ["event_type"] }, "minContains": 1 } } }
    },
    {
      "if": { "properties": { "axes": { "properties": { "release_transfer_currency": { "const": "CURRENT" } } } } },
      "then": { "properties": { "release_identity": { "$ref": "#/$defs/digest" }, "axes": { "properties": { "release_transfer_request": { "const": "REQUESTED" } } }, "events": { "contains": { "properties": { "event_type": { "const": "RELEASE_TRANSFER" } }, "required": ["event_type"] }, "minContains": 1 } } }
    },
    {
      "if": { "properties": { "entries": { "contains": { "properties": { "state": { "enum": ["OPEN_UNKNOWN", "OPEN_ASSESSMENT", "REFRESH_REQUIRED"] } }, "required": ["state"] } } } },
      "then": { "properties": { "aggregate_impact": { "enum": ["IMPACT_PENDING", "REFRESH_REQUIRED"] }, "axes": { "properties": { "campaign_transfer_currency": { "const": "BLOCKED" }, "release_transfer_currency": { "const": "BLOCKED" } } } } }
    },
    {
      "if": { "properties": { "aggregate_impact": { "const": "REFRESH_COMPLETE" } }, "required": ["aggregate_impact"] },
      "then": { "properties": { "entries": { "contains": { "properties": { "state": { "const": "REFRESH_COMPLETE" } }, "required": ["state"] }, "not": { "contains": { "properties": { "state": { "enum": ["OPEN_UNKNOWN", "OPEN_ASSESSMENT", "REFRESH_REQUIRED"] } }, "required": ["state"] } } } } }
    },
    {
      "if": { "properties": { "entries": { "maxItems": 0 } }, "required": ["entries"] },
      "then": { "properties": { "aggregate_impact": { "const": "NO_IMPACT_DETECTED" }, "axes": { "properties": { "campaign_impact_disposition": { "const": "NO_IMPACT_DETECTED" } } } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@#-]*$" },
    "text": { "type": "string", "pattern": "\\S" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitOid": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "nullableDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "timestamp": { "type": "string", "format": "date-time" },
    "path": { "type": "string", "minLength": 1, "pattern": "^[^/]", "not": { "pattern": "(^|/)\\.{1,2}(/|$)" } },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "axes": { "type": "object", "additionalProperties": false, "required": ["assessed_realization_integrity", "campaign_impact_disposition", "campaign_transfer_request", "campaign_transfer_currency", "release_transfer_request", "release_transfer_currency"], "properties": { "assessed_realization_integrity": { "enum": ["CURRENT", "INVALIDATED_BY_EVIDENCE", "UNKNOWN"] }, "campaign_impact_disposition": { "enum": ["NO_IMPACT_DETECTED", "IMPACT_PENDING", "NO_MATERIAL_IMPACT_AUTHORIZED", "REFRESH_REQUIRED", "REFRESH_COMPLETE"] }, "campaign_transfer_request": { "enum": ["NOT_REQUESTED", "REQUESTED"] }, "campaign_transfer_currency": { "enum": ["BLOCKED", "CURRENT"] }, "release_transfer_request": { "enum": ["NOT_REQUESTED", "REQUESTED"] }, "release_transfer_currency": { "enum": ["BLOCKED", "CURRENT"] } } },
    "changedObject": { "type": "object", "additionalProperties": false, "required": ["path", "change_kind", "object_sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "change_kind": { "enum": ["ADD", "DELETE", "MODIFY", "TYPE_CHANGE"] }, "object_sha256": { "$ref": "#/$defs/nullableDigest" } } },
    "entry": { "type": "object", "additionalProperties": false, "required": ["impact_entry_id", "event_id", "predecessor_event_id", "event_type", "previous_state", "predecessor_ledger_id", "terminal_plan_id", "changed_object", "matching_watch_ids", "state", "owner_principal_id", "owner_role_id", "replacement_entry_id", "resolved_entry_ids", "result_receipt_ids", "report_root", "review_event_ids", "target_head", "rationale"], "properties": { "impact_entry_id": { "$ref": "#/$defs/digest" }, "event_id": { "$ref": "#/$defs/digest" }, "predecessor_event_id": { "$ref": "#/$defs/nullableDigest" }, "event_type": { "enum": ["IMPACT_DISCOVERED", "ASSESSMENT_RECORDED", "RESOLUTION_RECORDED", "SUPERSESSION_RECORDED", "WITHDRAWAL_RECORDED"] }, "previous_state": { "oneOf": [{ "enum": ["OPEN_UNKNOWN", "OPEN_ASSESSMENT", "NO_MATERIAL_IMPACT_AUTHORIZED", "REFRESH_REQUIRED", "REFRESH_COMPLETE", "SUPERSEDED", "WITHDRAWN"] }, { "type": "null" }] }, "predecessor_ledger_id": { "$ref": "#/$defs/digest" }, "terminal_plan_id": { "$ref": "#/$defs/digest" }, "changed_object": { "$ref": "#/$defs/changedObject" }, "matching_watch_ids": { "$ref": "#/$defs/idList" }, "state": { "enum": ["OPEN_UNKNOWN", "OPEN_ASSESSMENT", "NO_MATERIAL_IMPACT_AUTHORIZED", "REFRESH_REQUIRED", "REFRESH_COMPLETE", "SUPERSEDED", "WITHDRAWN"] }, "owner_principal_id": { "$ref": "#/$defs/id" }, "owner_role_id": { "$ref": "#/$defs/id" }, "replacement_entry_id": { "$ref": "#/$defs/nullableDigest" }, "resolved_entry_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } }, "result_receipt_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } }, "report_root": { "$ref": "#/$defs/digest" }, "review_event_ids": { "$ref": "#/$defs/idList" }, "target_head": { "$ref": "#/$defs/gitOid" }, "rationale": { "$ref": "#/$defs/text" } }, "allOf": [{ "if": { "properties": { "event_type": { "const": "IMPACT_DISCOVERED" } } }, "then": { "properties": { "previous_state": { "type": "null" }, "state": { "enum": ["OPEN_UNKNOWN", "OPEN_ASSESSMENT"] } } } }, { "if": { "properties": { "state": { "const": "NO_MATERIAL_IMPACT_AUTHORIZED" } } }, "then": { "properties": { "event_type": { "const": "RESOLUTION_RECORDED" }, "review_event_ids": { "minItems": 1 } } } }, { "if": { "properties": { "state": { "const": "REFRESH_COMPLETE" } } }, "then": { "properties": { "event_type": { "const": "RESOLUTION_RECORDED" }, "result_receipt_ids": { "minItems": 1 }, "review_event_ids": { "minItems": 1 } } } }, { "if": { "properties": { "state": { "const": "SUPERSEDED" } } }, "then": { "properties": { "event_type": { "const": "SUPERSESSION_RECORDED" }, "replacement_entry_id": { "$ref": "#/$defs/digest" } } } }] },
    "transferEvent": { "oneOf": [{ "$ref": "#/$defs/campaignTransferEvent" }, { "$ref": "#/$defs/releaseTransferEvent" }, { "$ref": "#/$defs/targetHeadChangedEvent" }, { "$ref": "#/$defs/principalRoleRevokedEvent" }] },
    "campaignTransferEvent": { "type": "object", "additionalProperties": false, "required": ["event_id", "predecessor_event_id", "event_type", "target_head", "request_id", "receipt_id", "envelope_id", "principal_id", "role_record_sha256", "recorded_at"], "properties": { "event_id": { "$ref": "#/$defs/digest" }, "predecessor_event_id": { "$ref": "#/$defs/nullableDigest" }, "event_type": { "const": "CAMPAIGN_TRANSFER" }, "target_head": { "$ref": "#/$defs/gitOid" }, "request_id": { "$ref": "#/$defs/digest" }, "receipt_id": { "$ref": "#/$defs/digest" }, "envelope_id": { "$ref": "#/$defs/digest" }, "principal_id": { "$ref": "#/$defs/id" }, "role_record_sha256": { "$ref": "#/$defs/digest" }, "recorded_at": { "$ref": "#/$defs/timestamp" } } },
    "releaseTransferEvent": { "type": "object", "additionalProperties": false, "required": ["event_id", "predecessor_event_id", "event_type", "target_head", "release_identity", "request_id", "receipt_id", "envelope_id", "principal_id", "role_record_sha256", "recorded_at"], "properties": { "event_id": { "$ref": "#/$defs/digest" }, "predecessor_event_id": { "$ref": "#/$defs/nullableDigest" }, "event_type": { "const": "RELEASE_TRANSFER" }, "target_head": { "$ref": "#/$defs/gitOid" }, "release_identity": { "$ref": "#/$defs/digest" }, "request_id": { "$ref": "#/$defs/digest" }, "receipt_id": { "$ref": "#/$defs/digest" }, "envelope_id": { "$ref": "#/$defs/digest" }, "principal_id": { "$ref": "#/$defs/id" }, "role_record_sha256": { "$ref": "#/$defs/digest" }, "recorded_at": { "$ref": "#/$defs/timestamp" } } },
    "targetHeadChangedEvent": { "type": "object", "additionalProperties": false, "required": ["event_id", "predecessor_event_id", "event_type", "previous_head", "target_head", "recorded_at"], "properties": { "event_id": { "$ref": "#/$defs/digest" }, "predecessor_event_id": { "$ref": "#/$defs/nullableDigest" }, "event_type": { "const": "TARGET_HEAD_CHANGED" }, "previous_head": { "$ref": "#/$defs/gitOid" }, "target_head": { "$ref": "#/$defs/gitOid" }, "recorded_at": { "$ref": "#/$defs/timestamp" } } },
    "principalRoleRevokedEvent": { "type": "object", "additionalProperties": false, "required": ["event_id", "predecessor_event_id", "event_type", "target_head", "principal_id", "role_record_sha256", "revocation_generation", "recorded_at"], "properties": { "event_id": { "$ref": "#/$defs/digest" }, "predecessor_event_id": { "$ref": "#/$defs/nullableDigest" }, "event_type": { "const": "PRINCIPAL_ROLE_REVOKED" }, "target_head": { "$ref": "#/$defs/gitOid" }, "principal_id": { "$ref": "#/$defs/id" }, "role_record_sha256": { "$ref": "#/$defs/digest" }, "revocation_generation": { "type": "integer", "minimum": 1 }, "recorded_at": { "$ref": "#/$defs/timestamp" } } },
    "authority": { "type": "object", "additionalProperties": false, "required": ["principal_id", "role_id", "role_record_sha256", "revocation_generation"], "properties": { "principal_id": { "$ref": "#/$defs/id" }, "role_id": { "$ref": "#/$defs/id" }, "role_record_sha256": { "$ref": "#/$defs/digest" }, "revocation_generation": { "type": "integer", "minimum": 1 } } }
  }
}
