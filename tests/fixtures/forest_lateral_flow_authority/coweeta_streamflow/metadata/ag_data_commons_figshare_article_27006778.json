"107", "108", "211", "212", "215", "216", "301", "303", "304", "305", "306", "Other"], "placeholder": "ARS National Program Number", "is_multiple": true}, "field_type": "dropdown", "order": null, "is_mandatory": false}, {"name": "ARIS Log Number", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "ARIS Log Number"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Primary article PubAg Handle", "value": "", "settings": {"placeholder": "LEAVE THIS FIELD BLANK - ADMINISTRATIVE USE ONLY", "is_multiple": true}, "field_type": "url", "order": null, "is_mandatory": false}, {"name": "Pending citation", "value": ["No"], "settings": {"options": ["Yes", "No"], "default_value": ["No"], "is_multiple": false}, "field_type": "dropdown", "order": null, "is_mandatory": false}, {"name": "Related material without URL", "value": "", "settings": {"validations": {"min_length": 10, "max_length": 2000}, "placeholder": "Related material without URL"}, "field_type": "textarea", "order": null, "is_mandatory": false}, {"name": "Public Access Level", "value": ["Public"], "settings": {"options": ["Public"], "default_value": ["Public"], "is_multiple": false}, "field_type": "dropdown", "order": null, "is_mandatory": false}, {"name": "Preferred dataset citation", "value": "", "settings": {"validations": {"min_length": 3, "max_length": 10000}, "placeholder": "Preferred dataset citation"}, "field_type": "textarea", "order": null, "is_mandatory": false}, {"name": "Identifier", "value": "RDS-2016-0025-2", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Identifier"}, "field_type": "text", "order": null, "is_mandatory": false}], "figshare_url": "https://agdatacommons.nal.usda.gov/articles/dataset/Daily_streamflow_data_for_watersheds_at_Coweeta_Hydrologic_Lab_North_Carolina/27006778", "download_disabled": false, "description": "These data include daily streamflow data for 15 experimental treatment and reference watersheds at Coweeta Hydrologic Laboratory in Macon County, North Carolina, USA. The station is operated by the USDA Forest Service, Southern Research Station. Data include streamflow for the following stream gages and water years: WS01 (1935-2022), WS02(1936-2022), WS06 (1938-2022), WS07 (1965-2022), WS08 (1935-2022), WS13 (1937-2022), WS14 (1937-2022), WS17 (1937-2022), WS18 (1937-2021), WS27 (1947-2021), WS31 (1981-2022), WS32 (1942-2022), WS34 (1955-2022), WS36 (1943-2022), and WS37 (1942-2022).<br>The Coweeta Hydrologic Laboratory was established in 1934 and is world-renowned for its research in forest hydrology. Coweeta was established to determine the fundamental effects of forest management on soil and water resources and to serve as a testing ground for theories in forest hydrology. To facilitate this, a network of high- and low- elevation experimental watersheds were established across the site. Streamflow from watersheds is gaged with 90-degree or 120-degree V-notch weirs every five minutes. Approximately half of the watersheds serve as \u201creferences\u201d with no purposeful disturbance, while the other watersheds serve as \u201cexperimental\u201d and have undergone land management treatments.<br>The first edition of these data (Miniat et al. 2016; https://doi.org/10.2737/RDS-2016-0025) included streamflow for four Coweeta watersheds (WS07, WS14, WS18, and WS27) up through 2021. This second edition includes data for 11 additional watersheds and provides data up through 2022. There were also some minor changes made to the data files in this newer edition, which are described in detail in the process steps section below. \n\t  \nFor more information about Coweeta: https://www.fs.usda.gov/research/srs/forestsandranges/locations/coweeta.", "funding": "USDA-FS", "funding_list": [{"id": 23999232, "title": "USDA-FS", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 2, "status": "public", "size": 0, "created_date": "2025-01-22T04:53:29Z", "modified_date": "2025-11-24T21:02:21Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 2, "name": "CC0", "url": "https://creativecommons.org/publicdomain/zero/1.0/"}, "tags": ["Ecology, Ecosystems, & Environment", "Natural Resource Management & Use", "streamflow", "forested watershed", "Water", "Climate change effects", "Hydrology, watersheds, sedimentation", "Climate change", "environment", "inlandWaters", "hydrology"], "keywords": ["Ecology, Ecosystems, & Environment", "Natural Resource Management & Use", "streamflow", "forested watershed", "Water", "Climate change effects", "Hydrology, watersheds, sedimentation", "Climate change", "environment", "inlandWaters", "hydrology"], "categories": [{"id": 33614, "title": "Environmental sciences", "parent_id": 0, "path": "/33614", "source_id": "41", "taxonomy_id": 102}], "references": ["https://doi.org/10.2737/RDS-2016-0025", "https://doi.org/10.1007/978-1-4612-3732-7_2", "https://doi.org/10.1890/10-2246.1", "https://www.fs.usda.gov/research/treesearch/38726", "https://doi.org/10.2307/2426063", "https://doi.org/10.2166/nh.2012.067", "https://www.fs.usda.gov/research/treesearch/42197", "https://doi.org/10.1002/hyp.14302", "https://www.fs.usda.gov/research/treesearch/62688", "https://www.fs.usda.gov/research/treesearch/46145", "https://doi.org/10.1007/978-1-4612-3732-7_3", "https://doi.org/10.1002/hyp.3360060206", "https://doi.org/10.1029/tr028i001p00105"], "has_linked_file": true, "citation": "Laboratory, USFS Coweeta Hydrologic (2023). Daily streamflow data for gauged watersheds at Coweeta Hydrologic Laboratory, North Carolina: 2nd edition. Forest Service Research Data Archive. Dataset. https://doi.org/10.2737/RDS-2016-0025-2", "related_materials": [{"id": 213108251, "identifier": "10.2737/RDS-2016-0025", "title": "Daily streamflow data for watersheds at Coweeta Hydrologic Lab, North Carolina(1st ed.)(2016)", "relat