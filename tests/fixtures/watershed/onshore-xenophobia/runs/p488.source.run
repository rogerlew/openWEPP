schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H488"
unit_system = "metric"

[inputs]
soil = "p488.sol"
management = "p488.man"
slope = "p488.slp"
climate = "p488.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H488.hbp"
loss = "unused/H488.loss.json"
