schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H250"
unit_system = "metric"

[inputs]
soil = "p250.sol"
management = "p250.man"
slope = "p250.slp"
climate = "p250.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H250.hbp"
loss = "unused/H250.loss.json"
