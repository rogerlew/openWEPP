schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1000"
unit_system = "metric"

[inputs]
soil = "p1000.sol"
management = "p1000.man"
slope = "p1000.slp"
climate = "p1000.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1000.hbp"
loss = "unused/H1000.loss.json"
