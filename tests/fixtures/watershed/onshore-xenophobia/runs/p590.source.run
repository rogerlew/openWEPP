schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H590"
unit_system = "metric"

[inputs]
soil = "p590.sol"
management = "p590.man"
slope = "p590.slp"
climate = "p590.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H590.hbp"
loss = "unused/H590.loss.json"
