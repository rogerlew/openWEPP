schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H521"
unit_system = "metric"

[inputs]
soil = "p521.sol"
management = "p521.man"
slope = "p521.slp"
climate = "p521.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H521.hbp"
loss = "unused/H521.loss.json"
