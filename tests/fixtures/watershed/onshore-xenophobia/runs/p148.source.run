schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H148"
unit_system = "metric"

[inputs]
soil = "p148.sol"
management = "p148.man"
slope = "p148.slp"
climate = "p148.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H148.hbp"
loss = "unused/H148.loss.json"
