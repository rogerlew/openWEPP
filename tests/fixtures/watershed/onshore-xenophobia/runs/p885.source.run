schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H885"
unit_system = "metric"

[inputs]
soil = "p885.sol"
management = "p885.man"
slope = "p885.slp"
climate = "p885.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H885.hbp"
loss = "unused/H885.loss.json"
