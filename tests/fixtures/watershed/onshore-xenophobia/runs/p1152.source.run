schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1152"
unit_system = "metric"

[inputs]
soil = "p1152.sol"
management = "p1152.man"
slope = "p1152.slp"
climate = "p1152.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1152.hbp"
loss = "unused/H1152.loss.json"
