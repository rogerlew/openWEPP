schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H385"
unit_system = "metric"

[inputs]
soil = "p385.sol"
management = "p385.man"
slope = "p385.slp"
climate = "p385.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H385.hbp"
loss = "unused/H385.loss.json"
