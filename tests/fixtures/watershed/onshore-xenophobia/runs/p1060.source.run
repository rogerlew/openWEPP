schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1060"
unit_system = "metric"

[inputs]
soil = "p1060.sol"
management = "p1060.man"
slope = "p1060.slp"
climate = "p1060.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1060.hbp"
loss = "unused/H1060.loss.json"
