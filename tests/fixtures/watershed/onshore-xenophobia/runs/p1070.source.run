schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1070"
unit_system = "metric"

[inputs]
soil = "p1070.sol"
management = "p1070.man"
slope = "p1070.slp"
climate = "p1070.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1070.hbp"
loss = "unused/H1070.loss.json"
