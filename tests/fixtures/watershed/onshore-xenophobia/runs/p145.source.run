schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H145"
unit_system = "metric"

[inputs]
soil = "p145.sol"
management = "p145.man"
slope = "p145.slp"
climate = "p145.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H145.hbp"
loss = "unused/H145.loss.json"
