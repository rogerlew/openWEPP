schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1082"
unit_system = "metric"

[inputs]
soil = "p1082.sol"
management = "p1082.man"
slope = "p1082.slp"
climate = "p1082.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1082.hbp"
loss = "unused/H1082.loss.json"
