schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1040"
unit_system = "metric"

[inputs]
soil = "p1040.sol"
management = "p1040.man"
slope = "p1040.slp"
climate = "p1040.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1040.hbp"
loss = "unused/H1040.loss.json"
