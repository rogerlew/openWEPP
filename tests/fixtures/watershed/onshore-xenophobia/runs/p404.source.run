schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H404"
unit_system = "metric"

[inputs]
soil = "p404.sol"
management = "p404.man"
slope = "p404.slp"
climate = "p404.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H404.hbp"
loss = "unused/H404.loss.json"
