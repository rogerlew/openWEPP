schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H135"
unit_system = "metric"

[inputs]
soil = "p135.sol"
management = "p135.man"
slope = "p135.slp"
climate = "p135.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H135.hbp"
loss = "unused/H135.loss.json"
