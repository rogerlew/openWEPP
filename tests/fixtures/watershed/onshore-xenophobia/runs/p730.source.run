schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H730"
unit_system = "metric"

[inputs]
soil = "p730.sol"
management = "p730.man"
slope = "p730.slp"
climate = "p730.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H730.hbp"
loss = "unused/H730.loss.json"
