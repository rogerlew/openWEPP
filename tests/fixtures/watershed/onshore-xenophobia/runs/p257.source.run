schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H257"
unit_system = "metric"

[inputs]
soil = "p257.sol"
management = "p257.man"
slope = "p257.slp"
climate = "p257.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H257.hbp"
loss = "unused/H257.loss.json"
