schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H570"
unit_system = "metric"

[inputs]
soil = "p570.sol"
management = "p570.man"
slope = "p570.slp"
climate = "p570.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H570.hbp"
loss = "unused/H570.loss.json"
