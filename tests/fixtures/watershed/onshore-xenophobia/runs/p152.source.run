schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H152"
unit_system = "metric"

[inputs]
soil = "p152.sol"
management = "p152.man"
slope = "p152.slp"
climate = "p152.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H152.hbp"
loss = "unused/H152.loss.json"
