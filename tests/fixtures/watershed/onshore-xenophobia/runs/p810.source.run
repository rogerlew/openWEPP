schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H810"
unit_system = "metric"

[inputs]
soil = "p810.sol"
management = "p810.man"
slope = "p810.slp"
climate = "p810.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H810.hbp"
loss = "unused/H810.loss.json"
