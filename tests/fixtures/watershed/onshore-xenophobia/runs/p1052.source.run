schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1052"
unit_system = "metric"

[inputs]
soil = "p1052.sol"
management = "p1052.man"
slope = "p1052.slp"
climate = "p1052.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1052.hbp"
loss = "unused/H1052.loss.json"
