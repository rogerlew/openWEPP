schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H681"
unit_system = "metric"

[inputs]
soil = "p681.sol"
management = "p681.man"
slope = "p681.slp"
climate = "p681.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H681.hbp"
loss = "unused/H681.loss.json"
