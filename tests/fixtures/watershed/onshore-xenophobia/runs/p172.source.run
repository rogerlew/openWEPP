schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H172"
unit_system = "metric"

[inputs]
soil = "p172.sol"
management = "p172.man"
slope = "p172.slp"
climate = "p172.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H172.hbp"
loss = "unused/H172.loss.json"
