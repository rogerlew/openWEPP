schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1020"
unit_system = "metric"

[inputs]
soil = "p1020.sol"
management = "p1020.man"
slope = "p1020.slp"
climate = "p1020.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1020.hbp"
loss = "unused/H1020.loss.json"
