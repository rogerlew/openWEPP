schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H500"
unit_system = "metric"

[inputs]
soil = "p500.sol"
management = "p500.man"
slope = "p500.slp"
climate = "p500.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H500.hbp"
loss = "unused/H500.loss.json"
