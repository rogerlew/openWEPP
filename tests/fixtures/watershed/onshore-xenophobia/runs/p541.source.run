schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H541"
unit_system = "metric"

[inputs]
soil = "p541.sol"
management = "p541.man"
slope = "p541.slp"
climate = "p541.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H541.hbp"
loss = "unused/H541.loss.json"
