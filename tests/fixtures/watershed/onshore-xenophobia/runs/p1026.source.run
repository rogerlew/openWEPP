schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1026"
unit_system = "metric"

[inputs]
soil = "p1026.sol"
management = "p1026.man"
slope = "p1026.slp"
climate = "p1026.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1026.hbp"
loss = "unused/H1026.loss.json"
