schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1120"
unit_system = "metric"

[inputs]
soil = "p1120.sol"
management = "p1120.man"
slope = "p1120.slp"
climate = "p1120.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1120.hbp"
loss = "unused/H1120.loss.json"
