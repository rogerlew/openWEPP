schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1022"
unit_system = "metric"

[inputs]
soil = "p1022.sol"
management = "p1022.man"
slope = "p1022.slp"
climate = "p1022.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1022.hbp"
loss = "unused/H1022.loss.json"
