schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H208"
unit_system = "metric"

[inputs]
soil = "p208.sol"
management = "p208.man"
slope = "p208.slp"
climate = "p208.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H208.hbp"
loss = "unused/H208.loss.json"
