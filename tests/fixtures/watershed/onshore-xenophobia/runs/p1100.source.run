schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1100"
unit_system = "metric"

[inputs]
soil = "p1100.sol"
management = "p1100.man"
slope = "p1100.slp"
climate = "p1100.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1100.hbp"
loss = "unused/H1100.loss.json"
