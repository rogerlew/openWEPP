schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1240"
unit_system = "metric"

[inputs]
soil = "p1240.sol"
management = "p1240.man"
slope = "p1240.slp"
climate = "p1240.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1240.hbp"
loss = "unused/H1240.loss.json"
