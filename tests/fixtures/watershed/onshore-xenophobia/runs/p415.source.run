schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H415"
unit_system = "metric"

[inputs]
soil = "p415.sol"
management = "p415.man"
slope = "p415.slp"
climate = "p415.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H415.hbp"
loss = "unused/H415.loss.json"
