schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H303"
unit_system = "metric"

[inputs]
soil = "p303.sol"
management = "p303.man"
slope = "p303.slp"
climate = "p303.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H303.hbp"
loss = "unused/H303.loss.json"
