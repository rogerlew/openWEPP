schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H252"
unit_system = "metric"

[inputs]
soil = "p252.sol"
management = "p252.man"
slope = "p252.slp"
climate = "p252.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H252.hbp"
loss = "unused/H252.loss.json"
