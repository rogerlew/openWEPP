schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H155"
unit_system = "metric"

[inputs]
soil = "p155.sol"
management = "p155.man"
slope = "p155.slp"
climate = "p155.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H155.hbp"
loss = "unused/H155.loss.json"
