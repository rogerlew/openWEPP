schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1200"
unit_system = "metric"

[inputs]
soil = "p1200.sol"
management = "p1200.man"
slope = "p1200.slp"
climate = "p1200.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1200.hbp"
loss = "unused/H1200.loss.json"
