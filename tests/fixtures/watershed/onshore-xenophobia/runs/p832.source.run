schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H832"
unit_system = "metric"

[inputs]
soil = "p832.sol"
management = "p832.man"
slope = "p832.slp"
climate = "p832.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H832.hbp"
loss = "unused/H832.loss.json"
