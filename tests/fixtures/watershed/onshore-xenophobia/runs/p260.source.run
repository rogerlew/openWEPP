schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H260"
unit_system = "metric"

[inputs]
soil = "p260.sol"
management = "p260.man"
slope = "p260.slp"
climate = "p260.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H260.hbp"
loss = "unused/H260.loss.json"
