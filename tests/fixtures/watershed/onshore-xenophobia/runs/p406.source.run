schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H406"
unit_system = "metric"

[inputs]
soil = "p406.sol"
management = "p406.man"
slope = "p406.slp"
climate = "p406.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H406.hbp"
loss = "unused/H406.loss.json"
