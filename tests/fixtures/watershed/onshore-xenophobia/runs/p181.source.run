schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H181"
unit_system = "metric"

[inputs]
soil = "p181.sol"
management = "p181.man"
slope = "p181.slp"
climate = "p181.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H181.hbp"
loss = "unused/H181.loss.json"
