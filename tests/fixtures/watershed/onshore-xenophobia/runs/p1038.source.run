schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1038"
unit_system = "metric"

[inputs]
soil = "p1038.sol"
management = "p1038.man"
slope = "p1038.slp"
climate = "p1038.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1038.hbp"
loss = "unused/H1038.loss.json"
