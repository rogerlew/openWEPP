schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H271"
unit_system = "metric"

[inputs]
soil = "p271.sol"
management = "p271.man"
slope = "p271.slp"
climate = "p271.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H271.hbp"
loss = "unused/H271.loss.json"
