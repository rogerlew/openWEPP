schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H249"
unit_system = "metric"

[inputs]
soil = "p249.sol"
management = "p249.man"
slope = "p249.slp"
climate = "p249.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H249.hbp"
loss = "unused/H249.loss.json"
