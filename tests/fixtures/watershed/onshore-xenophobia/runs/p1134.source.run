schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1134"
unit_system = "metric"

[inputs]
soil = "p1134.sol"
management = "p1134.man"
slope = "p1134.slp"
climate = "p1134.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1134.hbp"
loss = "unused/H1134.loss.json"
