schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H131"
unit_system = "metric"

[inputs]
soil = "p131.sol"
management = "p131.man"
slope = "p131.slp"
climate = "p131.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H131.hbp"
loss = "unused/H131.loss.json"
