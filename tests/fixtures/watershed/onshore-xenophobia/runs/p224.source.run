schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H224"
unit_system = "metric"

[inputs]
soil = "p224.sol"
management = "p224.man"
slope = "p224.slp"
climate = "p224.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H224.hbp"
loss = "unused/H224.loss.json"
