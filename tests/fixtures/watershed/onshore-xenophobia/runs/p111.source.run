schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H111"
unit_system = "metric"

[inputs]
soil = "p111.sol"
management = "p111.man"
slope = "p111.slp"
climate = "p111.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H111.hbp"
loss = "unused/H111.loss.json"
