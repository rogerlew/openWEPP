schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H251"
unit_system = "metric"

[inputs]
soil = "p251.sol"
management = "p251.man"
slope = "p251.slp"
climate = "p251.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H251.hbp"
loss = "unused/H251.loss.json"
