schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H421"
unit_system = "metric"

[inputs]
soil = "p421.sol"
management = "p421.man"
slope = "p421.slp"
climate = "p421.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H421.hbp"
loss = "unused/H421.loss.json"
