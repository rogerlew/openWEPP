schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H381"
unit_system = "metric"

[inputs]
soil = "p381.sol"
management = "p381.man"
slope = "p381.slp"
climate = "p381.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H381.hbp"
loss = "unused/H381.loss.json"
