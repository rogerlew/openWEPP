schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H507"
unit_system = "metric"

[inputs]
soil = "p507.sol"
management = "p507.man"
slope = "p507.slp"
climate = "p507.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H507.hbp"
loss = "unused/H507.loss.json"
