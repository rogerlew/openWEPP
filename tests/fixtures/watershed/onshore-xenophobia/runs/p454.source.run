schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H454"
unit_system = "metric"

[inputs]
soil = "p454.sol"
management = "p454.man"
slope = "p454.slp"
climate = "p454.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H454.hbp"
loss = "unused/H454.loss.json"
