schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H451"
unit_system = "metric"

[inputs]
soil = "p451.sol"
management = "p451.man"
slope = "p451.slp"
climate = "p451.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H451.hbp"
loss = "unused/H451.loss.json"
