schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H292"
unit_system = "metric"

[inputs]
soil = "p292.sol"
management = "p292.man"
slope = "p292.slp"
climate = "p292.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H292.hbp"
loss = "unused/H292.loss.json"
