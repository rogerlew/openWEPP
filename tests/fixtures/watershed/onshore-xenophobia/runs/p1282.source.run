schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1282"
unit_system = "metric"

[inputs]
soil = "p1282.sol"
management = "p1282.man"
slope = "p1282.slp"
climate = "p1282.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1282.hbp"
loss = "unused/H1282.loss.json"
