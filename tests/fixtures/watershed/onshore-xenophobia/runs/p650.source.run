schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H650"
unit_system = "metric"

[inputs]
soil = "p650.sol"
management = "p650.man"
slope = "p650.slp"
climate = "p650.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H650.hbp"
loss = "unused/H650.loss.json"
