schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1150"
unit_system = "metric"

[inputs]
soil = "p1150.sol"
management = "p1150.man"
slope = "p1150.slp"
climate = "p1150.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1150.hbp"
loss = "unused/H1150.loss.json"
