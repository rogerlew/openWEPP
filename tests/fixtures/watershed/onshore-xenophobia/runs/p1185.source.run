schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1185"
unit_system = "metric"

[inputs]
soil = "p1185.sol"
management = "p1185.man"
slope = "p1185.slp"
climate = "p1185.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1185.hbp"
loss = "unused/H1185.loss.json"
