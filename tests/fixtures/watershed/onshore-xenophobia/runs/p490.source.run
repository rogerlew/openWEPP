schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H490"
unit_system = "metric"

[inputs]
soil = "p490.sol"
management = "p490.man"
slope = "p490.slp"
climate = "p490.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H490.hbp"
loss = "unused/H490.loss.json"
