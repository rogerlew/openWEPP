schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1212"
unit_system = "metric"

[inputs]
soil = "p1212.sol"
management = "p1212.man"
slope = "p1212.slp"
climate = "p1212.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1212.hbp"
loss = "unused/H1212.loss.json"
