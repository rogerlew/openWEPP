schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H460"
unit_system = "metric"

[inputs]
soil = "p460.sol"
management = "p460.man"
slope = "p460.slp"
climate = "p460.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H460.hbp"
loss = "unused/H460.loss.json"
