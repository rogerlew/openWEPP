schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H388"
unit_system = "metric"

[inputs]
soil = "p388.sol"
management = "p388.man"
slope = "p388.slp"
climate = "p388.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H388.hbp"
loss = "unused/H388.loss.json"
