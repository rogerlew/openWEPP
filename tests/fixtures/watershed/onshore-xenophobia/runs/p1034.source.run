schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1034"
unit_system = "metric"

[inputs]
soil = "p1034.sol"
management = "p1034.man"
slope = "p1034.slp"
climate = "p1034.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1034.hbp"
loss = "unused/H1034.loss.json"
