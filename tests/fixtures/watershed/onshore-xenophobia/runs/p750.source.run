schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H750"
unit_system = "metric"

[inputs]
soil = "p750.sol"
management = "p750.man"
slope = "p750.slp"
climate = "p750.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H750.hbp"
loss = "unused/H750.loss.json"
