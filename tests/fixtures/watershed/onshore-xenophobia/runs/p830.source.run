schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H830"
unit_system = "metric"

[inputs]
soil = "p830.sol"
management = "p830.man"
slope = "p830.slp"
climate = "p830.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H830.hbp"
loss = "unused/H830.loss.json"
