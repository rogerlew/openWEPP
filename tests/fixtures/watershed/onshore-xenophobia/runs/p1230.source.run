schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1230"
unit_system = "metric"

[inputs]
soil = "p1230.sol"
management = "p1230.man"
slope = "p1230.slp"
climate = "p1230.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1230.hbp"
loss = "unused/H1230.loss.json"
