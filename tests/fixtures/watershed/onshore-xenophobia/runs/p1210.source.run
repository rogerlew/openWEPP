schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1210"
unit_system = "metric"

[inputs]
soil = "p1210.sol"
management = "p1210.man"
slope = "p1210.slp"
climate = "p1210.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1210.hbp"
loss = "unused/H1210.loss.json"
