schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H850"
unit_system = "metric"

[inputs]
soil = "p850.sol"
management = "p850.man"
slope = "p850.slp"
climate = "p850.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H850.hbp"
loss = "unused/H850.loss.json"
