schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H147"
unit_system = "metric"

[inputs]
soil = "p147.sol"
management = "p147.man"
slope = "p147.slp"
climate = "p147.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H147.hbp"
loss = "unused/H147.loss.json"
