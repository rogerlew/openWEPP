schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H538"
unit_system = "metric"

[inputs]
soil = "p538.sol"
management = "p538.man"
slope = "p538.slp"
climate = "p538.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H538.hbp"
loss = "unused/H538.loss.json"
