schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1112"
unit_system = "metric"

[inputs]
soil = "p1112.sol"
management = "p1112.man"
slope = "p1112.slp"
climate = "p1112.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1112.hbp"
loss = "unused/H1112.loss.json"
