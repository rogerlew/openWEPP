schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1280"
unit_system = "metric"

[inputs]
soil = "p1280.sol"
management = "p1280.man"
slope = "p1280.slp"
climate = "p1280.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1280.hbp"
loss = "unused/H1280.loss.json"
