schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1050"
unit_system = "metric"

[inputs]
soil = "p1050.sol"
management = "p1050.man"
slope = "p1050.slp"
climate = "p1050.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1050.hbp"
loss = "unused/H1050.loss.json"
