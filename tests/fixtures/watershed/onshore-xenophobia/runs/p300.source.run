schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H300"
unit_system = "metric"

[inputs]
soil = "p300.sol"
management = "p300.man"
slope = "p300.slp"
climate = "p300.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H300.hbp"
loss = "unused/H300.loss.json"
