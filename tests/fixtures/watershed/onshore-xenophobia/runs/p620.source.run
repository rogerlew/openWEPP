schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H620"
unit_system = "metric"

[inputs]
soil = "p620.sol"
management = "p620.man"
slope = "p620.slp"
climate = "p620.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H620.hbp"
loss = "unused/H620.loss.json"
