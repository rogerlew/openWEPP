schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H694"
unit_system = "metric"

[inputs]
soil = "p694.sol"
management = "p694.man"
slope = "p694.slp"
climate = "p694.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H694.hbp"
loss = "unused/H694.loss.json"
