schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H142"
unit_system = "metric"

[inputs]
soil = "p142.sol"
management = "p142.man"
slope = "p142.slp"
climate = "p142.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H142.hbp"
loss = "unused/H142.loss.json"
