schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H286"
unit_system = "metric"

[inputs]
soil = "p286.sol"
management = "p286.man"
slope = "p286.slp"
climate = "p286.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H286.hbp"
loss = "unused/H286.loss.json"
