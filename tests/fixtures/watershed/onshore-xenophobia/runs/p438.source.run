schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H438"
unit_system = "metric"

[inputs]
soil = "p438.sol"
management = "p438.man"
slope = "p438.slp"
climate = "p438.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H438.hbp"
loss = "unused/H438.loss.json"
