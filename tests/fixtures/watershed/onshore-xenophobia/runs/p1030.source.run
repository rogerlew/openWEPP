schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1030"
unit_system = "metric"

[inputs]
soil = "p1030.sol"
management = "p1030.man"
slope = "p1030.slp"
climate = "p1030.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1030.hbp"
loss = "unused/H1030.loss.json"
