schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H225"
unit_system = "metric"

[inputs]
soil = "p225.sol"
management = "p225.man"
slope = "p225.slp"
climate = "p225.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H225.hbp"
loss = "unused/H225.loss.json"
