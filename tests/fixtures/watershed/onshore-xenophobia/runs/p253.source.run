schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H253"
unit_system = "metric"

[inputs]
soil = "p253.sol"
management = "p253.man"
slope = "p253.slp"
climate = "p253.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H253.hbp"
loss = "unused/H253.loss.json"
