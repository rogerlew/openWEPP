schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H289"
unit_system = "metric"

[inputs]
soil = "p289.sol"
management = "p289.man"
slope = "p289.slp"
climate = "p289.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H289.hbp"
loss = "unused/H289.loss.json"
