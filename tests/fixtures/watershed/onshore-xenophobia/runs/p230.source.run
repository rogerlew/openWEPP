schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H230"
unit_system = "metric"

[inputs]
soil = "p230.sol"
management = "p230.man"
slope = "p230.slp"
climate = "p230.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H230.hbp"
loss = "unused/H230.loss.json"
