schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H709"
unit_system = "metric"

[inputs]
soil = "p709.sol"
management = "p709.man"
slope = "p709.slp"
climate = "p709.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H709.hbp"
loss = "unused/H709.loss.json"
