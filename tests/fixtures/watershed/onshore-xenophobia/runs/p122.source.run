schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H122"
unit_system = "metric"

[inputs]
soil = "p122.sol"
management = "p122.man"
slope = "p122.slp"
climate = "p122.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H122.hbp"
loss = "unused/H122.loss.json"
