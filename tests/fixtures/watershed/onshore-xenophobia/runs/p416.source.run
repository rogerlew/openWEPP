schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H416"
unit_system = "metric"

[inputs]
soil = "p416.sol"
management = "p416.man"
slope = "p416.slp"
climate = "p416.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H416.hbp"
loss = "unused/H416.loss.json"
