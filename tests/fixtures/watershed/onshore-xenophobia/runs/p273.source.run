schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H273"
unit_system = "metric"

[inputs]
soil = "p273.sol"
management = "p273.man"
slope = "p273.slp"
climate = "p273.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H273.hbp"
loss = "unused/H273.loss.json"
