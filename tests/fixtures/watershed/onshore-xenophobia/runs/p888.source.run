schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H888"
unit_system = "metric"

[inputs]
soil = "p888.sol"
management = "p888.man"
slope = "p888.slp"
climate = "p888.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H888.hbp"
loss = "unused/H888.loss.json"
