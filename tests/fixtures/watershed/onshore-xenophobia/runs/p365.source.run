schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H365"
unit_system = "metric"

[inputs]
soil = "p365.sol"
management = "p365.man"
slope = "p365.slp"
climate = "p365.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H365.hbp"
loss = "unused/H365.loss.json"
