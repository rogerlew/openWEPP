schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1090"
unit_system = "metric"

[inputs]
soil = "p1090.sol"
management = "p1090.man"
slope = "p1090.slp"
climate = "p1090.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1090.hbp"
loss = "unused/H1090.loss.json"
