schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H502"
unit_system = "metric"

[inputs]
soil = "p502.sol"
management = "p502.man"
slope = "p502.slp"
climate = "p502.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H502.hbp"
loss = "unused/H502.loss.json"
