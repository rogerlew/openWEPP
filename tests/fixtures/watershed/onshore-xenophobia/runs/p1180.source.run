schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1180"
unit_system = "metric"

[inputs]
soil = "p1180.sol"
management = "p1180.man"
slope = "p1180.slp"
climate = "p1180.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1180.hbp"
loss = "unused/H1180.loss.json"
