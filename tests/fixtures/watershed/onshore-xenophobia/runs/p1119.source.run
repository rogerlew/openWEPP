schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1119"
unit_system = "metric"

[inputs]
soil = "p1119.sol"
management = "p1119.man"
slope = "p1119.slp"
climate = "p1119.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1119.hbp"
loss = "unused/H1119.loss.json"
