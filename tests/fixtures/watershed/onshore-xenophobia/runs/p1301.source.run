schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1301"
unit_system = "metric"

[inputs]
soil = "p1301.sol"
management = "p1301.man"
slope = "p1301.slp"
climate = "p1301.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1301.hbp"
loss = "unused/H1301.loss.json"
