schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H283"
unit_system = "metric"

[inputs]
soil = "p283.sol"
management = "p283.man"
slope = "p283.slp"
climate = "p283.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H283.hbp"
loss = "unused/H283.loss.json"
