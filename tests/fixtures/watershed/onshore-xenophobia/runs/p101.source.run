schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H101"
unit_system = "metric"

[inputs]
soil = "p101.sol"
management = "p101.man"
slope = "p101.slp"
climate = "p101.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H101.hbp"
loss = "unused/H101.loss.json"
