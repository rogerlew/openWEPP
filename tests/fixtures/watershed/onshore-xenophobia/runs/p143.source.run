schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H143"
unit_system = "metric"

[inputs]
soil = "p143.sol"
management = "p143.man"
slope = "p143.slp"
climate = "p143.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H143.hbp"
loss = "unused/H143.loss.json"
