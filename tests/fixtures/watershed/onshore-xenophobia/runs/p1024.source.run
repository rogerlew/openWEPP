schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1024"
unit_system = "metric"

[inputs]
soil = "p1024.sol"
management = "p1024.man"
slope = "p1024.slp"
climate = "p1024.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1024.hbp"
loss = "unused/H1024.loss.json"
