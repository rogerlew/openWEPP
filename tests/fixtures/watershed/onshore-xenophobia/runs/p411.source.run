schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H411"
unit_system = "metric"

[inputs]
soil = "p411.sol"
management = "p411.man"
slope = "p411.slp"
climate = "p411.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H411.hbp"
loss = "unused/H411.loss.json"
