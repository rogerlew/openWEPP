schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H807"
unit_system = "metric"

[inputs]
soil = "p807.sol"
management = "p807.man"
slope = "p807.slp"
climate = "p807.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H807.hbp"
loss = "unused/H807.loss.json"
