schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H182"
unit_system = "metric"

[inputs]
soil = "p182.sol"
management = "p182.man"
slope = "p182.slp"
climate = "p182.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H182.hbp"
loss = "unused/H182.loss.json"
