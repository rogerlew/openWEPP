schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H156"
unit_system = "metric"

[inputs]
soil = "p156.sol"
management = "p156.man"
slope = "p156.slp"
climate = "p156.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H156.hbp"
loss = "unused/H156.loss.json"
