schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H995"
unit_system = "metric"

[inputs]
soil = "p995.sol"
management = "p995.man"
slope = "p995.slp"
climate = "p995.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H995.hbp"
loss = "unused/H995.loss.json"
