schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H146"
unit_system = "metric"

[inputs]
soil = "p146.sol"
management = "p146.man"
slope = "p146.slp"
climate = "p146.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H146.hbp"
loss = "unused/H146.loss.json"
