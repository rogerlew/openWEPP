schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H231"
unit_system = "metric"

[inputs]
soil = "p231.sol"
management = "p231.man"
slope = "p231.slp"
climate = "p231.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H231.hbp"
loss = "unused/H231.loss.json"
