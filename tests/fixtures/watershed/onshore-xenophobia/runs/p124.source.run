schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H124"
unit_system = "metric"

[inputs]
soil = "p124.sol"
management = "p124.man"
slope = "p124.slp"
climate = "p124.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H124.hbp"
loss = "unused/H124.loss.json"
