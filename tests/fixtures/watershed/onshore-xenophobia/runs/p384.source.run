schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H384"
unit_system = "metric"

[inputs]
soil = "p384.sol"
management = "p384.man"
slope = "p384.slp"
climate = "p384.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H384.hbp"
loss = "unused/H384.loss.json"
