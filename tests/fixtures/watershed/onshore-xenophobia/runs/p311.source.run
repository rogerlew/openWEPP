schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H311"
unit_system = "metric"

[inputs]
soil = "p311.sol"
management = "p311.man"
slope = "p311.slp"
climate = "p311.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H311.hbp"
loss = "unused/H311.loss.json"
