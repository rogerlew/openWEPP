schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H238"
unit_system = "metric"

[inputs]
soil = "p238.sol"
management = "p238.man"
slope = "p238.slp"
climate = "p238.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H238.hbp"
loss = "unused/H238.loss.json"
