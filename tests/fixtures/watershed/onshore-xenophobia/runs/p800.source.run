schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H800"
unit_system = "metric"

[inputs]
soil = "p800.sol"
management = "p800.man"
slope = "p800.slp"
climate = "p800.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H800.hbp"
loss = "unused/H800.loss.json"
