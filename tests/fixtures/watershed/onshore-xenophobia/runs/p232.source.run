schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H232"
unit_system = "metric"

[inputs]
soil = "p232.sol"
management = "p232.man"
slope = "p232.slp"
climate = "p232.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H232.hbp"
loss = "unused/H232.loss.json"
