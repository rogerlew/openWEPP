schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H216"
unit_system = "metric"

[inputs]
soil = "p216.sol"
management = "p216.man"
slope = "p216.slp"
climate = "p216.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H216.hbp"
loss = "unused/H216.loss.json"
