schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H102"
unit_system = "metric"

[inputs]
soil = "p102.sol"
management = "p102.man"
slope = "p102.slp"
climate = "p102.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H102.hbp"
loss = "unused/H102.loss.json"
