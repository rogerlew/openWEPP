schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H190"
unit_system = "metric"

[inputs]
soil = "p190.sol"
management = "p190.man"
slope = "p190.slp"
climate = "p190.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H190.hbp"
loss = "unused/H190.loss.json"
