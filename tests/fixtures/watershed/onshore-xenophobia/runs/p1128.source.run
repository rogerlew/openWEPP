schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1128"
unit_system = "metric"

[inputs]
soil = "p1128.sol"
management = "p1128.man"
slope = "p1128.slp"
climate = "p1128.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1128.hbp"
loss = "unused/H1128.loss.json"
