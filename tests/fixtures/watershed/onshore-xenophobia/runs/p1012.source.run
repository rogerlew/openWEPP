schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1012"
unit_system = "metric"

[inputs]
soil = "p1012.sol"
management = "p1012.man"
slope = "p1012.slp"
climate = "p1012.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1012.hbp"
loss = "unused/H1012.loss.json"
