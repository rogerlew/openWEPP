schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1025"
unit_system = "metric"

[inputs]
soil = "p1025.sol"
management = "p1025.man"
slope = "p1025.slp"
climate = "p1025.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1025.hbp"
loss = "unused/H1025.loss.json"
