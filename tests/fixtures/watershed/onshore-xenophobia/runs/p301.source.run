schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H301"
unit_system = "metric"

[inputs]
soil = "p301.sol"
management = "p301.man"
slope = "p301.slp"
climate = "p301.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H301.hbp"
loss = "unused/H301.loss.json"
