schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H682"
unit_system = "metric"

[inputs]
soil = "p682.sol"
management = "p682.man"
slope = "p682.slp"
climate = "p682.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H682.hbp"
loss = "unused/H682.loss.json"
