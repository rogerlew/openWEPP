schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1037"
unit_system = "metric"

[inputs]
soil = "p1037.sol"
management = "p1037.man"
slope = "p1037.slp"
climate = "p1037.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1037.hbp"
loss = "unused/H1037.loss.json"
