schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H739"
unit_system = "metric"

[inputs]
soil = "p739.sol"
management = "p739.man"
slope = "p739.slp"
climate = "p739.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H739.hbp"
loss = "unused/H739.loss.json"
