schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H886"
unit_system = "metric"

[inputs]
soil = "p886.sol"
management = "p886.man"
slope = "p886.slp"
climate = "p886.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H886.hbp"
loss = "unused/H886.loss.json"
