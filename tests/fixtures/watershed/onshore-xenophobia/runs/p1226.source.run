schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1226"
unit_system = "metric"

[inputs]
soil = "p1226.sol"
management = "p1226.man"
slope = "p1226.slp"
climate = "p1226.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1226.hbp"
loss = "unused/H1226.loss.json"
