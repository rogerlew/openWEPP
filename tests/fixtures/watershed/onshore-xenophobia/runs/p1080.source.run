schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1080"
unit_system = "metric"

[inputs]
soil = "p1080.sol"
management = "p1080.man"
slope = "p1080.slp"
climate = "p1080.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1080.hbp"
loss = "unused/H1080.loss.json"
