schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H341"
unit_system = "metric"

[inputs]
soil = "p341.sol"
management = "p341.man"
slope = "p341.slp"
climate = "p341.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H341.hbp"
loss = "unused/H341.loss.json"
