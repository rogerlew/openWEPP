schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H112"
unit_system = "metric"

[inputs]
soil = "p112.sol"
management = "p112.man"
slope = "p112.slp"
climate = "p112.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H112.hbp"
loss = "unused/H112.loss.json"
