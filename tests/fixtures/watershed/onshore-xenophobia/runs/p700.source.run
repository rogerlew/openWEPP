schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H700"
unit_system = "metric"

[inputs]
soil = "p700.sol"
management = "p700.man"
slope = "p700.slp"
climate = "p700.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H700.hbp"
loss = "unused/H700.loss.json"
