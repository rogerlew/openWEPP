schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H870"
unit_system = "metric"

[inputs]
soil = "p870.sol"
management = "p870.man"
slope = "p870.slp"
climate = "p870.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H870.hbp"
loss = "unused/H870.loss.json"
