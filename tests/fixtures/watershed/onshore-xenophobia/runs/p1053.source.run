schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1053"
unit_system = "metric"

[inputs]
soil = "p1053.sol"
management = "p1053.man"
slope = "p1053.slp"
climate = "p1053.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1053.hbp"
loss = "unused/H1053.loss.json"
