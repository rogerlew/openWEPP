schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H855"
unit_system = "metric"

[inputs]
soil = "p855.sol"
management = "p855.man"
slope = "p855.slp"
climate = "p855.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H855.hbp"
loss = "unused/H855.loss.json"
