schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1220"
unit_system = "metric"

[inputs]
soil = "p1220.sol"
management = "p1220.man"
slope = "p1220.slp"
climate = "p1220.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1220.hbp"
loss = "unused/H1220.loss.json"
