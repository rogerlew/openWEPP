schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H413"
unit_system = "metric"

[inputs]
soil = "p413.sol"
management = "p413.man"
slope = "p413.slp"
climate = "p413.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H413.hbp"
loss = "unused/H413.loss.json"
