schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1003"
unit_system = "metric"

[inputs]
soil = "p1003.sol"
management = "p1003.man"
slope = "p1003.slp"
climate = "p1003.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1003.hbp"
loss = "unused/H1003.loss.json"
