schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H379"
unit_system = "metric"

[inputs]
soil = "p379.sol"
management = "p379.man"
slope = "p379.slp"
climate = "p379.cli"
wepp_ui = true
