schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1140"
unit_system = "metric"

[inputs]
soil = "p1140.sol"
management = "p1140.man"
slope = "p1140.slp"
climate = "p1140.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1140.hbp"
loss = "unused/H1140.loss.json"
