schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H217"
unit_system = "metric"

[inputs]
soil = "p217.sol"
management = "p217.man"
slope = "p217.slp"
climate = "p217.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H217.hbp"
loss = "unused/H217.loss.json"
