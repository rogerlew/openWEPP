schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H910"
unit_system = "metric"

[inputs]
soil = "p910.sol"
management = "p910.man"
slope = "p910.slp"
climate = "p910.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H910.hbp"
loss = "unused/H910.loss.json"
