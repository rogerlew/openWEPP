schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H775"
unit_system = "metric"

[inputs]
soil = "p775.sol"
management = "p775.man"
slope = "p775.slp"
climate = "p775.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H775.hbp"
loss = "unused/H775.loss.json"
