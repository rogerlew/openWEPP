schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H400"
unit_system = "metric"

[inputs]
soil = "p400.sol"
management = "p400.man"
slope = "p400.slp"
climate = "p400.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H400.hbp"
loss = "unused/H400.loss.json"
