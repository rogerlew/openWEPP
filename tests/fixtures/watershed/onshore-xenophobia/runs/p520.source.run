schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H520"
unit_system = "metric"

[inputs]
soil = "p520.sol"
management = "p520.man"
slope = "p520.slp"
climate = "p520.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H520.hbp"
loss = "unused/H520.loss.json"
