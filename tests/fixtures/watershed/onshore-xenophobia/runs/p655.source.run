schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H655"
unit_system = "metric"

[inputs]
soil = "p655.sol"
management = "p655.man"
slope = "p655.slp"
climate = "p655.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H655.hbp"
loss = "unused/H655.loss.json"
