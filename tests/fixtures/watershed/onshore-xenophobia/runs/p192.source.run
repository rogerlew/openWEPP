schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H192"
unit_system = "metric"

[inputs]
soil = "p192.sol"
management = "p192.man"
slope = "p192.slp"
climate = "p192.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H192.hbp"
loss = "unused/H192.loss.json"
