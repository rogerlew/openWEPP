schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H610"
unit_system = "metric"

[inputs]
soil = "p610.sol"
management = "p610.man"
slope = "p610.slp"
climate = "p610.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H610.hbp"
loss = "unused/H610.loss.json"
