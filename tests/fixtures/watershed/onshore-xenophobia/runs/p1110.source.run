schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1110"
unit_system = "metric"

[inputs]
soil = "p1110.sol"
management = "p1110.man"
slope = "p1110.slp"
climate = "p1110.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1110.hbp"
loss = "unused/H1110.loss.json"
