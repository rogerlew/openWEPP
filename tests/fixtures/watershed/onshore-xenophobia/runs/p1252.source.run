schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1252"
unit_system = "metric"

[inputs]
soil = "p1252.sol"
management = "p1252.man"
slope = "p1252.slp"
climate = "p1252.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H1252.hbp"
loss = "unused/H1252.loss.json"
