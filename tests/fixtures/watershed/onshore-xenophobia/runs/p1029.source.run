schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H1029"
unit_system = "metric"

[inputs]
soil = "p1029.sol"
management = "p1029.man"
slope = "p1029.slp"
climate = "p1029.cli"
