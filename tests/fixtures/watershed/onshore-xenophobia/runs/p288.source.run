schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H288"
unit_system = "metric"

[inputs]
soil = "p288.sol"
management = "p288.man"
slope = "p288.slp"
climate = "p288.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H288.hbp"
loss = "unused/H288.loss.json"
