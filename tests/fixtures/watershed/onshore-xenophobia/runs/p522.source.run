schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H522"
unit_system = "metric"

[inputs]
soil = "p522.sol"
management = "p522.man"
slope = "p522.slp"
climate = "p522.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H522.hbp"
loss = "unused/H522.loss.json"
