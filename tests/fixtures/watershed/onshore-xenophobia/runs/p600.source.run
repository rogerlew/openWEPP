schema = "openwepp-hillslope-runfile-v1"
run_name = "onshore-xenophobia-H600"
unit_system = "metric"

[inputs]
soil = "p600.sol"
management = "p600.man"
slope = "p600.slp"
climate = "p600.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "unused/H600.hbp"
loss = "unused/H600.loss.json"
