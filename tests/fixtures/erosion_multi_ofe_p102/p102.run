schema = "openwepp-hillslope-runfile-v1"
run_name = "p102-e3-multi-ofe-chain"
unit_system = "metric"

[inputs]
soil = "p102.sol"
management = "p102.man"
slope = "p102.slp"
climate = "p102.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "output/H102.hbp"
loss = "output/H102.loss.json"
pass_parquet = "output/H102.pass.parquet"
