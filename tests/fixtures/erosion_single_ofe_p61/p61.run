schema = "openwepp-hillslope-runfile-v1"
run_name = "p61-erosion-gate6"
unit_system = "metric"

[inputs]
soil = "p61.sol"
management = "p61.man"
slope = "p61.slp"
climate = "p61.cli"
wepp_ui = true
pmetpara = "pmetpara.txt"

[outputs]
pass = "output/H61.hbp"
loss = "output/H61.loss.json"
pass_parquet = "output/H61.pass.parquet"
