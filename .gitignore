# - `references/copyrighted/` is local cache only.
references/copyrighted/**
!references/copyrighted/.gitkeep

# Python
*.pyc
__pycache__/

# Local replay bundles (can be very large; avoid accidental repo bloat)
docs/work-packages/**/artifacts/replay-run-*/

